<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev nástroj (NEpatří do EDISON2.sln): vyrenderuje loose XAML offscreen ve světlém i tmavém
       režimu do PNG, aby šlo vizuálně ověřit theming/dark mode místo hádání. Viz skill /theme-render. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ukázková loose XAML nejsou Page (nekompilují se do BAML) -->
    <Page Remove="samples\**\*.xaml" />
    <None Include="samples\**\*.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EDControls\dotnet\EDControls.csproj" />
  </ItemGroup>

</Project>
