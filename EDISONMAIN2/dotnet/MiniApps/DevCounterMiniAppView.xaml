<UserControl x:Class="EDISONMAIN2.MiniApps.DevCounterMiniAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="8">
        <TextBlock Text="{Binding Count, StringFormat='Počet: {0}'}" FontSize="16" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal">
            <Button Content="+1"    Command="{Binding IncrementCommand}" Width="60" Margin="0,0,4,0"/>
            <Button Content="Reset" Command="{Binding ResetCommand}"     Width="60"/>
        </StackPanel>
    </StackPanel>
</UserControl>
