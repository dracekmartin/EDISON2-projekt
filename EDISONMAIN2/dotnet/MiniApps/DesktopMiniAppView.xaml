<UserControl x:Class="EDISONMAIN2.MiniApps.DesktopMiniAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ma="clr-namespace:EDISONMAIN2.MiniApps"
             xmlns:modules="clr-namespace:EDISONMAIN2.Windows.EdisonMainWindow.Modules">
    <!-- AllowDrop na kořeni: přetažení modulu ze stromu (přidání) i dlaždice (přemístění na slot). -->
    <Grid AllowDrop="True" Background="Transparent" DragOver="Desktop_DragOver" Drop="Desktop_Drop">
        <!-- Prázdný stav: výzva k přetažení modulů ze stromu. -->
        <TextBlock Text="Přetáhněte sem moduly ze stromu, nebo je přidejte přes ★ v kontextovém menu."
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource EDTheme.Text.Secondary}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Responzivní mřížka dlaždic; pozice = DesktopShortcut.Slot (mezery povolené). Klik spustí, tažení přemístí. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <ItemsControl x:Name="TilesHost" ItemsSource="{Binding Items}" Margin="6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ma:SlotGridPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="ma:SlotGridPanel.Slot" Value="{Binding Slot}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type modules:DesktopShortcut}">
                        <Border Width="128" Height="72" Margin="6" Padding="6" AllowDrop="True"
                                Background="{DynamicResource EDTheme.Bg.Surface}"
                                BorderBrush="{DynamicResource EDTheme.Border.Light}"
                                BorderThickness="1" CornerRadius="4" Cursor="Hand"
                                ToolTip="{Binding TreePath}"
                                MouseLeftButtonUp="Tile_MouseLeftButtonUp"
                                PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown"
                                MouseMove="Tile_MouseMove">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="{StaticResource EDIcons.Module}" Width="24" Height="24"
                                       Margin="0,0,0,4" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding DisplayedLongName}" TextWrapping="Wrap"
                                           TextAlignment="Center" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource EDTheme.Text.Primary}"/>
                            </StackPanel>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Odebrat z plochy"
                                              Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Border.Tag>
                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            </Border.Tag>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
