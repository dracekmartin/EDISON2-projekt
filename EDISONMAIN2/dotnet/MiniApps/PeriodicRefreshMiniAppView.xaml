<UserControl x:Class="EDISONMAIN2.MiniApps.PeriodicRefreshMiniAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="8">
        <CheckBox Content="Automaticky obnovovat ostatní miniaplikace"
                  IsChecked="{Binding IsEnabled}" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Interval:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding SelectedInterval}"
                      DisplayMemberPath="Label" MinWidth="80" IsEnabled="{Binding IsEnabled}"/>
        </StackPanel>

        <Button Content="Obnovit teď" Command="{Binding RefreshNowCommand}"
                HorizontalAlignment="Left" Padding="10,2" Margin="0,0,0,8"/>

        <TextBlock Text="{Binding LastRefresh, StringFormat='Poslední obnova: {0}'}"/>
    </StackPanel>
</UserControl>
