<UserControl x:Class="EDISONMAIN2.MiniApps.SupportCarouselMiniAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel>
        <!-- Ovládání cyklení — jen když se nevejdou všechny stránky vedle sebe. -->
        <DockPanel DockPanel.Dock="Top" Margin="4,2"
                   Visibility="{Binding ShowCycleControls, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Left" Style="{StaticResource EDTheme.ToolbarButton}"
                    Command="{Binding PrevCommand}" ToolTip="Předchozí stránka">
                <TextBlock Text="&#x2039;" FontSize="{DynamicResource EDTheme.FontSize.Large}" Margin="6,-2"/>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource EDTheme.ToolbarButton}"
                    Command="{Binding NextCommand}" ToolTip="Další stránka">
                <TextBlock Text="&#x203A;" FontSize="{DynamicResource EDTheme.FontSize.Large}" Margin="6,-2"/>
            </Button>
            <TextBlock Text="{Binding PageIndicator}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource EDTheme.Text.Muted}"
                       ToolTip="Stránky se přepínají samy; dokud jste v panelu, odpočet stojí"/>
        </DockPanel>

        <!-- Lišta auto-posunu: doběhne za 15 s → skok na další stránku; při hoveru/fokusu stojí (ztmavená). -->
        <ProgressBar DockPanel.Dock="Top" Height="3" BorderThickness="0"
                     Visibility="{Binding ShowCycleControls, Converter={StaticResource BoolToVis}}"
                     Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                     Background="{DynamicResource EDTheme.Bg.Pressed}"
                     Foreground="{DynamicResource EDTheme.Accent.Blue}">
            <ProgressBar.Style>
                <!-- ProgressBar není themovaný (stock template) → lokální Style bez BasedOn. -->
                <Style TargetType="ProgressBar">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                            <Setter Property="Opacity" Value="0.3"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- 1–N sloupců podle šířky; elementy stránek se cachují ve VM (swap bez reloadu). -->
        <ItemsControl ItemsSource="{Binding VisiblePages}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2,0">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,2"/>
                        <ContentControl Content="{Binding Content}" Focusable="False"/>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
