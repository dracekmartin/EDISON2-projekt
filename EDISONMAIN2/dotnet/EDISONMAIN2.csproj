<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.17763 (ne windows7.0): WebView2CompositionControl potřebuje WinRT projekce
         (Microsoft.Windows.SDK.NET) — s nižší platform version build projde, ale runtime spadne
         na FileNotFoundException při prvním zobrazení widgetu. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EDISONMAIN2.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="4.74.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="EDISONAPI">
      <HintPath>C:\Edison\EDISONAPI.dll</HintPath>
    </Reference>
    <Reference Include="EDLicence">
      <HintPath>C:\Edison\EDLicence.dll</HintPath>
    </Reference>
    <Reference Include="MLRest">
      <HintPath>C:\Edison\MLRest.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EDControls\dotnet\EDControls.csproj" />
    <ProjectReference Include="..\..\EDISONMAIN2.LegacyMiniApps\dotnet\EDISONMAIN2.LegacyMiniApps.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.local.json')" />
  </ItemGroup>

  <!-- Transitivní závislosti EDLibrary (WinForms grid, přímý DB klient, mail), které shell
       nenačítá — z single-file bundle ven jako loose soubory. V C:\Edison\ už leží z legacy
       buildů, takže případná obskurní code path je vedle exe pořád najde. Sidecar .pdb/.xml
       do publish výstupu nepatří vůbec. -->
  <!-- Hook musí být po ComputeResolvedFilesToPublishList (ne ComputeFilesToPublish — ten má
       bundling už v dependencies, takže by změny přišly pozdě). -->
  <Target Name="SlimSingleFilePublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Condition="'%(Filename)' == 'C1.Win.4.5.2' Or '%(Filename)' == 'C1.Win.C1FlexGrid.4.5.2' Or '%(Filename)' == 'C1.Win.C1Sizer.4' Or '%(Filename)' == 'InterSystems.Data.CacheClient' Or '%(Filename)' == 'AegisImplicitMail'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.pdb' Or '%(Extension)' == '.xml'" />
    </ItemGroup>
  </Target>

</Project>
