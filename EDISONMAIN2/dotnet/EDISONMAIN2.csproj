<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <OutputPath>C:\Edison\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EDISONMAIN2.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="EDISONAPI">
      <HintPath>C:\Edison\EDISONAPI.dll</HintPath>
    </Reference>
    <Reference Include="EDISONMAIN2API">
      <HintPath>C:\Edison\EDISONMAIN2API.dll</HintPath>
    </Reference>
    <Reference Include="MLRest">
      <HintPath>C:\Edison\MLRest.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EDControls\dotnet\EDControls.csproj" />
  </ItemGroup>

</Project>
