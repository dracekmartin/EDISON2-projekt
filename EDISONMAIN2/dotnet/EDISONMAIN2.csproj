<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Bez platform version: HWND WebView2 (FontZoomWebView) nepotřebuje WinRT projekce.
         Composition varianta vyžadovala windows10.0.17763 + 23 MB Microsoft.Windows.SDK.NET.dll
         v single-file bundlu - HWND ji z buildu úplně vyřazuje. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Úzký gate místo TreatWarningsAsErrors: WPF si generuje _wpftmp projekty zvlášť
         a umí v generovaném kódu překvapit. Rozšiřuj po kategoriích, ne naráz. -->
    <WarningsAsErrors>Nullable;CS0108</WarningsAsErrors>
    <!-- Připnutá aplikace na liště a okno bez Icon berou ikonu z exe, ne z okna - bez ní výchozí ikona .NET. -->
    <ApplicationIcon>..\..\EDControls\dotnet\EDIcons\cube_molecule.ico</ApplicationIcon>
    <!-- Legacy DLL z C:\Edison bere shell z instalace, se stejnou verzí jako agendy vedle něj
         (SingleFilePublish.targets). Nové legacy API, které shell volá, musí být na instalaci dřív než shell. -->
    <LegacyAssembliesFromInstallation>true</LegacyAssembliesFromInstallation>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EDISONMAIN2.Tests" />
    <InternalsVisibleTo Include="EDISON2.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="EDUpdateContract" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="4.74.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.74.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="EDISONAPI">
      <HintPath>C:\Edison\EDISONAPI.dll</HintPath>
    </Reference>
    <Reference Include="EDLicence">
      <HintPath>C:\Edison\EDLicence.dll</HintPath>
    </Reference>
    <!-- Stažení licence z M-line + feedback (UpdateLicFromMlineServer), parita se starým shellem. -->
    <Reference Include="EDUsers">
      <HintPath>C:\Edison\EDUsers.dll</HintPath>
    </Reference>
    <Reference Include="MLRest">
      <HintPath>C:\Edison\MLRest.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EDControls\dotnet\EDControls.csproj" />
    <ProjectReference Include="..\..\EDISONMAIN2.LegacyMiniApps\dotnet\EDISONMAIN2.LegacyMiniApps.csproj" />
    <ProjectReference Include="..\..\EDUpdateContract\dotnet\EDUpdateContract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dev připojení; publish ho vydat nesmí - v C:\Edison\ leží živý EDISONini.xml legacy aplikací. -->
    <None Update="EDISONini.xml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <Import Project="..\..\SingleFilePublish.targets" />

</Project>
