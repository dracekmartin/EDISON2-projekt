<Window x:Class="EDISONMAIN2.Windows.ConnectionWindow.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ef="clr-namespace:EDControls.EDFooter;assembly=EDControls"
        Title="Připojit k databázi"
        Width="480" Height="480" MinWidth="380" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource EDTheme.Bg.Base}"
        Icon="{StaticResource EDIcons.Molecule}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>
        <ef:EDFooter DockPanel.Dock="Bottom" FooterMode="OkCancel"/>

        <!-- Nové připojení se přidá do seznamu a uloží hned; OK jen spustí vybrané. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,8">
            <TextBlock Text="Nové připojení:" Margin="0,0,0,4"
                       Foreground="{DynamicResource EDTheme.Text.Secondary}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Název:" Margin="0,0,0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Server:" Margin="0,0,0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="REST port:" Margin="0,0,0,2"/>
                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding NewServer, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding NewRestPort, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{StaticResource EDStrings.Add}" Command="{Binding AddCommand}"
                        MinWidth="80" Padding="14,4" Margin="0,0,8,0"/>
                <Button Content="{StaticResource EDStrings.Delete}" Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding CanRemove}" MinWidth="80" Padding="14,4"/>
            </StackPanel>
            <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource EDTheme.Semantic.Danger}"
                       Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <ListBox x:Name="ConnectionList" Margin="8"
                 ItemsSource="{Binding Choices}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <!-- BasedOn povinné - theming (font, dark mode) žije v implicitním stylu. -->
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                    <!-- Dvojklik = potvrzení výběru, ať se nemusí chodit na tlačítko. -->
                    <EventSetter Event="MouseDoubleClick" Handler="ConnectionItem_MouseDoubleClick"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}"/>
                        <TextBlock Text="{Binding Address}"
                                   FontSize="{DynamicResource EDTheme.FontSize.Caption}"
                                   Foreground="{DynamicResource EDTheme.Text.Muted}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
