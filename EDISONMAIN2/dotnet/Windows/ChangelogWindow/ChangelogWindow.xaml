<Window x:Class="EDISONMAIN2.Windows.ChangelogWindow.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ef="clr-namespace:EDControls.EDFooter;assembly=EDControls"
        mc:Ignorable="d"
        Title="Novinky"
        Width="760" Height="560" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource EDTheme.Bg.Base}"
        Icon="{StaticResource EDIcons.Molecule}">

    <DockPanel>
        <ef:EDFooter DockPanel.Dock="Bottom">
            <ef:EDFooter.LeftContent>
                <!-- Bez _DIFF (vynucené zobrazení celé historie) není co odložit - hash chybí. -->
                <CheckBox Content="Nezobrazovat do příští změny"
                          IsChecked="{Binding SnoozeChecked}"
                          IsEnabled="{Binding HasChanges, Mode=OneTime}"
                          VerticalAlignment="Center"/>
            </ef:EDFooter.LeftContent>
        </ef:EDFooter>

        <DockPanel DockPanel.Dock="Top" Margin="12,10,12,8" LastChildFill="False">
            <TextBlock Text="{Binding ModuleTitle}"
                       FontWeight="SemiBold"
                       FontSize="{DynamicResource EDTheme.FontSize.Title}"
                       VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="Jen změny"
                             IsChecked="{Binding ShowChangesOnly}"
                             IsEnabled="{Binding HasChanges, Mode=OneTime}"
                             Margin="0,0,12,0"/>
                <RadioButton Content="Celá historie"
                             IsChecked="{Binding ShowFullHistory}"/>
            </StackPanel>
        </DockPanel>

        <!-- NoWrap: položky INF drží odsazení pokračovacích řádků, zalomení by ho rozbilo. -->
        <TextBox Margin="12,0,12,4"
                 IsReadOnly="True"
                 Text="{Binding DisplayText, Mode=OneWay}"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
