<Window x:Class="EDISONMAIN2.EDInputFormTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ed="clr-namespace:EDControls.EDInputForm;assembly=EDControls"
        xmlns:ef="clr-namespace:EDControls.EDFooter;assembly=EDControls"
        mc:Ignorable="d"
        Title="Test EDInputForm" Height="480" Width="460"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Init"     Click="Init_Click"     ToolTip="Načíst definici formuláře z Caché"/>
            <Separator/>
            <Button Content="Validate" Click="Validate_Click" ToolTip="Ověřit zadané hodnoty v Caché"/>
            <Button Content="Save"     Click="Save_Click"     ToolTip="Uložit hodnoty do Caché"/>
        </ToolBar>
        <ef:EDFooter DockPanel.Dock="Bottom" FooterMode="OkCancel">
            <ef:EDFooter.LeftContent>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
            </ef:EDFooter.LeftContent>
        </ef:EDFooter>
        <ed:EDInputForm x:Name="TheInputForm" Margin="4"/>
    </DockPanel>
</Window>
