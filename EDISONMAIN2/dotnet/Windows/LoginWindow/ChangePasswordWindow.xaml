<Window x:Class="EDISONMAIN2.Windows.LoginWindow.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Změna hesla"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="{StaticResource EDIcons.Molecule}">
    <StackPanel Margin="20" Width="280">
        <TextBlock x:Name="HeaderText" TextWrapping="Wrap" Margin="0,0,0,12" FontWeight="SemiBold"/>

        <TextBlock Text="Původní heslo:" Margin="0,0,0,4"/>
        <PasswordBox x:Name="OldPasswordBox" Margin="0,0,0,12"/>

        <TextBlock Text="Nové heslo:" Margin="0,0,0,4"/>
        <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,12"/>

        <TextBlock Text="Nové heslo znovu:" Margin="0,0,0,4"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,12"/>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource EDTheme.Semantic.Danger}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{StaticResource EDStrings.Ok}" Width="80"
                    IsDefault="True" Click="OkBtn_Click" Margin="0,0,8,0"/>
            <Button Content="{StaticResource EDStrings.Cancel}" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
