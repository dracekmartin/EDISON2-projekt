<Window x:Class="EDISONMAIN2.Windows.LoginWindow.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Přihlášení EDISON"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Height="800" Width="1200" MinHeight="600" MinWidth="900"
        Background="{DynamicResource EDTheme.Bg.Base}"
        Icon="{StaticResource EDIcons.Molecule}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Accent.Blue z LinkButtonu by na tmavé brandové ploše zanikl. -->
        <Style x:Key="BrandLink" TargetType="Button" BasedOn="{StaticResource EDTheme.LinkButton}">
            <Setter Property="Foreground" Value="{DynamicResource EDTheme.BrandPanel.TextMuted}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource EDTheme.BrandPanel.LinkHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Primary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Brandová plocha podle přihlášení portálu podpory. Dialog přihlášení jiného uživatele ji skrývá. -->
        <Border x:Name="BrandPanel" Grid.Column="0" Padding="48,40"
                Background="{DynamicResource EDTheme.BrandPanel.Bg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="M-line EDISON" FontWeight="Bold"
                           FontSize="{DynamicResource EDTheme.FontSize.Hero}"
                           Foreground="{DynamicResource EDTheme.OnAccent.Text}"/>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="440">
                    <TextBlock Text="Software pro veřejnou dopravu." TextWrapping="Wrap" FontWeight="SemiBold"
                               FontSize="{DynamicResource EDTheme.FontSize.Display}"
                               Foreground="{DynamicResource EDTheme.OnAccent.Text}"/>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="Jízdní řády, plánování a řízení provozu, vozidla, tržby i ekonomika dopravce v jednom systému."
                               Foreground="{DynamicResource EDTheme.BrandPanel.TextMuted}"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="M-line software s.r.o."
                               Foreground="{DynamicResource EDTheme.BrandPanel.TextMuted}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Style="{StaticResource BrandLink}" Content="www.m-line.cz" Click="MlineWeb_Click"/>
                        <TextBlock Text="·" Margin="8,0"
                                   Foreground="{DynamicResource EDTheme.BrandPanel.TextMuted}"/>
                        <Button Style="{StaticResource BrandLink}" Content="podpora.m-line.cz" Click="MlineSupport_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="FormArea" Grid.Column="1">
            <!-- Glyph a popisek nastavuje code-behind podle aktuálního motivu. -->
            <Button x:Name="ThemeToggle" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                    Style="{StaticResource EDTheme.ToolbarButton}" Click="ThemeToggle_Click">
                <TextBlock x:Name="ThemeGlyph" FontFamily="Segoe MDL2 Assets"
                           FontSize="{DynamicResource EDTheme.IconSize.Default}"
                           Foreground="{DynamicResource EDTheme.Text.Secondary}"/>
            </Button>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360" Margin="32">
                <Path Width="112" Height="112" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,36"
                      Data="{StaticResource EDIcons.MlineMarkGeometry}" Fill="{DynamicResource EDTheme.MlineLogo}"/>

                <TextBlock Text="Uživatel" Style="{StaticResource FieldLabel}"/>
                <!-- PropertyChanged: OK přes Enter (IsDefault) přijde, než pole ztratí fokus. -->
                <TextBox x:Name="UsernameBox" Margin="0,0,0,12"
                         Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsEditable}"/>

                <TextBlock Text="Heslo" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,12" IsEnabled="{Binding IsEditable}"/>

                <CheckBox x:Name="RememberBox" Content="Zapamatovat heslo" Margin="0,0,0,12"
                          IsChecked="{Binding RememberPassword}" IsEnabled="{Binding IsEditable}"
                          Visibility="{Binding ShowRemember, Converter={StaticResource BoolToVis}}"/>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource EDTheme.Semantic.Danger}"
                           TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding ErrorMessage}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

                <!-- Zrušení je křížek okna nebo Esc (code-behind). -->
                <Button x:Name="OkBtn" Content="Přihlásit se" Style="{StaticResource EDTheme.PrimaryButton}" Margin="0,4,0,0"
                        IsDefault="True" Click="OkBtn_Click" IsEnabled="{Binding IsEditable}"/>

                <!-- Progress startupu po úspěšném loginu - jen text, spinner by na blokovaném UI threadu
                     zamrzl. Hidden, ne Collapsed: řádek je rezervovaný a zobrazení nehne vycentrovaným formulářem. -->
                <TextBlock x:Name="ProgressText" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource EDTheme.Text.Secondary}" Text="{Binding ProgressMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasProgress}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
