<Window x:Class="EDISONMAIN2.Windows.LoginWindow.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Přihlášení EDISON"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Height="800" Width="1200" MinHeight="600" MinWidth="900"
        Background="{DynamicResource EDTheme.Bg.Base}"
        Icon="{StaticResource EDIcons.Molecule}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource EDTheme.Bg.Panel}"
                BorderBrush="{DynamicResource EDTheme.Border.Light}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Border VerticalAlignment="Top" Height="160"
                        Background="{DynamicResource EDTheme.Bg.PanelAlt}"
                        BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,0,0,1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="{StaticResource EDIcons.Molecule}" Width="56" Height="56"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="EDISON" FontSize="{DynamicResource EDTheme.FontSize.Display}" FontWeight="Bold"
                                   Foreground="{DynamicResource EDTheme.Text.Header}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                    <TextBlock Text="Uživatel:" Foreground="{DynamicResource EDTheme.Text.Primary}"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="UsernameBox" Margin="0,0,0,12"/>

                    <TextBlock Text="Heslo:" Foreground="{DynamicResource EDTheme.Text.Primary}"
                               Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PasswordBox" Margin="0,0,0,12"/>

                    <CheckBox x:Name="RememberBox" Content="Zapamatovat heslo" Margin="0,0,0,12"/>

                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource EDTheme.Semantic.Danger}"
                               TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Progress startupu po úspěšném loginu - jen text, spinner by na blokovaném UI threadu
                             zamrzl. Vlevo od tlačítek, ať zobrazení nehne layoutem. -->
                        <TextBlock x:Name="ProgressText" Grid.Column="0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource EDTheme.Text.Secondary}"
                                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="OkBtn" Content="{StaticResource EDStrings.Ok}" Width="90"
                                    IsDefault="True" Click="OkBtn_Click" Margin="0,0,8,0"/>
                            <Button x:Name="CancelBtn" Content="{StaticResource EDStrings.Cancel}" Width="90"
                                    IsCancel="True" Click="CancelBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Patička karty: značka dodavatele + prokliky na web a portál podpory.
                     Musí zůstat v levém sloupci - přes WebView2 widgety vpravo se WPF obsah
                     kvůli airspace nevykreslí. -->
                <Border VerticalAlignment="Bottom" Padding="16,10"
                        Background="{DynamicResource EDTheme.Bg.PanelAlt}"
                        BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="{StaticResource EDIcons.MlineLogo}" Width="36" Height="36"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="M-line software s.r.o."
                                       Foreground="{DynamicResource EDTheme.Text.Primary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Button Style="{StaticResource EDTheme.LinkButton}" Margin="0,0,12,0"
                                        Content="www.m-line.cz" Click="MlineWeb_Click"/>
                                <Button Style="{StaticResource EDTheme.LinkButton}"
                                        Content="podpora.m-line.cz" Click="MlineSupport_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Týž widget podpory jako fixní pruh shellu - jeden blok, ne mirror tří miniaplikací. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource EDTheme.Bg.Footer}" Padding="12,6">
                <TextBlock Text="Informace podpory" FontWeight="SemiBold"
                           Foreground="{DynamicResource EDTheme.Text.Header}"/>
            </Border>
            <Border x:Name="SupportHost" Grid.Row="1" Background="{DynamicResource EDTheme.Bg.Base}"/>
        </Grid>
    </Grid>
</Window>
