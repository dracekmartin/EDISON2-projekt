<Window x:Class="EDISONMAIN2.Windows.LoginWindow.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Přihlášení — EDISON"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="{StaticResource EDIcons.Molecule}">
    <StackPanel Margin="20" Width="280">
        <TextBlock Text="Uživatel:" Margin="0,0,0,4"/>
        <TextBox x:Name="UsernameBox" Margin="0,0,0,12"/>

        <TextBlock Text="Heslo:" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,12"/>

        <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{StaticResource EDStrings.Ok}" Width="80"
                    IsDefault="True" Click="OkBtn_Click" Margin="0,0,8,0"/>
            <Button Content="{StaticResource EDStrings.Cancel}" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
