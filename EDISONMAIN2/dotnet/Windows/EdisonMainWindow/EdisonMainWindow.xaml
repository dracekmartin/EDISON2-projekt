<Window x:Class="EDISONMAIN2.EdisonMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:local="clr-namespace:EDISONMAIN2"
        xmlns:designTime="clr-namespace:EDISONMAIN2.Windows.EdisonMainWindow.DesignTimeData"
        xmlns:modules="clr-namespace:EDISONMAIN2.Windows.EdisonMainWindow.Modules"
        xmlns:edvm="clr-namespace:EDControls.EDViewModel;assembly=EDControls"
        xmlns:edfc="clr-namespace:EDControls.EDFilterComboBox;assembly=EDControls"
        d:DataContext="{d:DesignInstance Type=designTime:EdisonMainWindowDesignTimeData, IsDesignTimeCreatable=True}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="800" Width="1200" Icon="{StaticResource EDIcons.Molecule}" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Closed">
            <b:InvokeCommandAction Command="{Binding CloseAllCommand}"/>
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <!-- Skryté klávesové zkratky (RESPONSIBILITIES §15.1). Ctrl+W+W chord řeší
         PreviewKeyDown v code-behind (víc-krokový stav, nelze přes KeyBinding). -->
    <Window.InputBindings>
        <KeyBinding Key="B" Modifiers="Control+Shift" Command="{Binding ShowBgTasksCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Strom modulů (launcher) | splitter | plocha miniaplikací (DockingManager). -->
            <ColumnDefinition Width="*" MinWidth="150"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- Auto — StatusBar musí růst se zvolenou velikostí fontu (user preference).
                 Pevná výška by ořízla text při větším fontu. -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top-level menu — replikuje pořadí a obsah legacy frmNoMDI.mnuMain.
             Combobox firem nahrazuje legacy "Firma" label (původně jen statický).
             "Test funkcí" je dev-only nadstavba, v legacy je tam "Test funkcí (M-line)" s debug položkami.
             Border drží spodní 1px linku přes celou šířku; Menu lokálně potlačí svoji vlastní linku, ta by končila u TextBlocku. -->
        <Border Grid.Row="0" Grid.ColumnSpan="100"
                Background="{DynamicResource EDTheme.Bg.Footer}"
                BorderBrush="{DynamicResource EDTheme.Border.Light}"
                BorderThickness="0,0,0,1">
        <DockPanel>
            <TextBlock Text="{Binding InformationText}" DockPanel.Dock="Right"
                       VerticalAlignment="Center" Margin="8,0,8,0"/>
            <!-- Přepínač firem MUSÍ být mimo <Menu>: Menu si přebírá fokus/myš pro navigaci a
                 editovatelnému comboboxu uvnitř kradlo fokus (klik do textu "odkliknul"). -->
            <edfc:EDFilterComboBox DockPanel.Dock="Left" StrictSelection="True"
                                   Suggestions="{Binding CompanySuggestions}"
                                   SelectedKey="{Binding SelectedCompanyId, Mode=TwoWay}"
                                   MinWidth="220" VerticalAlignment="Center" Margin="4,0,8,0"/>
            <Menu x:Name="TopMenu" BorderThickness="0">
            <MenuItem Header="EDISON">
                <MenuItem Header="Připojit k databázi"   Command="{Binding ConnectToDatabaseCommand}"/>
                <MenuItem Header="Spustit další EDISON"  Command="{Binding RunEdisonCopyCommand}"/>
                <Separator/>
                <MenuItem Header="Konec"                 Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="Uživatel">
                <MenuItem Header="Přihlásit jiného uživatele"     Command="{Binding LoginAsAnotherUserCommand}"/>
                <MenuItem Header="Aktuální uživatel"              Command="{Binding ShowUserEditCommand}"/>
                <MenuItem Header="Úlohy na pozadí"                Command="{Binding ShowBgTasksCommand}"/>
                <MenuItem Header="Možnosti">
                    <MenuItem Header="Spouštět okna jako dialogy" IsCheckable="True" IsChecked="{Binding ShowWindowsAsDialogs}"/>
                </MenuItem>
                <MenuItem Header="Obnovit výchozí nastavení oken" Command="{Binding ResetFormsCommand}"/>
            </MenuItem>
            <MenuItem Header="Spuštěné moduly" ItemsSource="{Binding RunningModules}">
                <!-- MouseEnter, ne SubmenuOpened — prázdný submenu by se neotevřel a chicken-and-egg by zablokoval refresh. -->
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="MouseEnter">
                        <b:InvokeCommandAction Command="{Binding RefreshRunningModulesCommand}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
                <MenuItem.ItemContainerStyle>
                    <!-- ElementName ne AncestorType=Menu — submenu items jsou v Popup mimo Menu's visual tree. -->
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding DisplayName}"/>
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                        <Setter Property="Command" Value="{Binding DataContext.ActivateModuleCommand, ElementName=TopMenu}"/>
                        <Setter Property="CommandParameter" Value="{Binding}"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="Miniaplikace" ItemsSource="{Binding MiniApps}">
                <MenuItem.ItemContainerStyle>
                    <!-- ElementName=TopMenu — položky jsou v Popup mimo Menu's visual tree (jako Spuštěné moduly). -->
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Title}"/>
                        <Setter Property="Command" Value="{Binding DataContext.OpenMiniAppCommand, ElementName=TopMenu}"/>
                        <Setter Property="CommandParameter" Value="{Binding}"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="Nástroje">
                <MenuItem Header="Aktualizovat licenci"        Command="{Binding RefreshLicenseCommand}"/>
                <MenuItem Header="Správa zámků"                Command="{Binding ShowUsersLocksCommand}"/>
                <MenuItem Header="Aktivita uživatelů"          Command="{Binding ShowUsersActivityCommand}"/>
                <Separator/>
                <MenuItem Header="Nastavení jazyka"            Command="{Binding ShowLanguageSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="Odeslat systémové soubory"   Command="{Binding SendSystemLogCommand}"/>
            </MenuItem>
            <MenuItem Header="Nápověda">
                <MenuItem Header="Informace o verzi" Command="{Binding ShowInfoCommand}"/>
                <MenuItem Header="Helpdesk, Wiki"    Command="{Binding OpenHelpdeskWebCommand}"/>
            </MenuItem>
            <MenuItem Header="Styl">
                <MenuItem Header="Použít"       IsCheckable="True" IsChecked="{Binding FontApplied}"/>
                <MenuItem Header="Zvolený font" Command="{Binding SelectFontCommand}"/>
            </MenuItem>
            <MenuItem Header="Test funkcí">
                <MenuItem Header="Test InputForm"    Command="{Binding OpenInputFormTestCommand}"/>
                <MenuItem Header="Test EDList"       Command="{Binding OpenEDListTestCommand}"/>
                <MenuItem Header="Test EDViewModel"  Command="{Binding OpenEDComponentAndViewModelTestCommand}"/>
                <MenuItem Header="Test odhlašovacího countdownu" Command="{Binding OpenLogoutCountdownTestCommand}"/>
                <MenuItem Header="Vyvolat chybu" Command="{Binding TriggerErrorCommand}"/>
                <Separator/>
                <MenuItem Header="TemplateDesigner"  Command="{Binding OpenTemplateDesignerCommand}"/>
            </MenuItem>
            </Menu>
        </DockPanel>
        </Border>

        <!-- Tři stromy odpovídají legacy edisonnavbar.xml: Hlavní nabídka (id=-2),
             Správa systému (id=-3), Partnerská řešení (id=-4). -->
        <Grid Grid.Column="0" Grid.Row="1">
            <Grid.Resources>
                <edvm:HexToBrushConverter x:Key="HexToBrush"/>
                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                <HierarchicalDataTemplate ItemsSource="{Binding NestedModules}" DataType="{x:Type modules:ModuleFamily}">
                    <!-- Color "" → UnsetValue → default Foreground; v DEBUG nastaveno agregací (stub/broken).
                         Tag = VM (z TabControl) — most pro ContextMenu mimo visual tree. -->
                    <TextBlock Text="{Binding DisplayedName}"
                               Foreground="{Binding Color, Converter={StaticResource HexToBrush}}"
                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}">
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <!-- Hromadné přepnutí celé rodiny (např. MHD). Header dle IsFavorite
                                     (= všechny moduly v ní oblíbené). Sem mohou přibýt další akce. -->
                                <MenuItem Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="Přidat vše do oblíbených"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Header" Value="Odebrat vše z oblíbených"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type modules:ExecutableModule}">
                    <!-- Tag = VM (z TabControl DataContext) — most pro ContextMenu, který není ve visual tree. -->
                    <StackPanel Orientation="Horizontal"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}">
                        <!-- Color "" → UnsetValue → fallback na default TextBlock Foreground z EDTheme. -->
                        <TextBlock Text="{Binding DisplayedName}"
                                   Foreground="{Binding Color, Converter={StaticResource HexToBrush}}"/>
                        <!-- Zlatá ★ na konci názvu, jen u oblíbených (prázdná se nezobrazuje). -->
                        <TextBlock Text="&#x2605;" Margin="6,0,0,0" Foreground="#FFC107" VerticalAlignment="Center"
                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <!-- Toggle oblíbeného. Header dle IsFavorite (ContextMenu dědí DataContext = modul).
                                     Command jde na VM přes PlacementTarget.Tag. Sem přibydou další akce nad modulem. -->
                                <MenuItem Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="Přidat do oblíbených"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Header" Value="Odebrat z oblíbených"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                    </StackPanel>
                </DataTemplate>
                <Style TargetType="{x:Type TreeViewItem}">
                    <!-- TwoWay → rozbalení/sbalení uživatelem se propíše do modelu (VM ho persistuje). -->
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <!-- Skryje uzly nevyhovující vyhledávání (VM nastaví IsVisibleBySearch). -->
                    <Setter Property="Visibility" Value="{Binding IsVisibleBySearch, Converter={StaticResource BoolToVis}}"/>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Vyhledávání napříč všemi stromy — filtruje uzly dle názvu (VM.TreeSearchText). -->
            <Grid Grid.Row="0" Margin="4,4,4,2">
                <TextBox x:Name="TreeSearchBox"
                         Text="{Binding TreeSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Hledat modul…" Margin="6,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource EDTheme.Text.Secondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TreeSearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Pamatuje poslední otevřenou záložku (per-user × IDFa); při prvním spuštění výchozí dle oblíbených. -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTreeTabIndex, Mode=TwoWay}">
                <TabItem Header="Hlavní nabídka">
                    <TreeView x:Name="MainMenuTreeView" ItemsSource="{Binding MainMenuTree}" BorderThickness="0">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="MouseDoubleClick">
                                <b:InvokeCommandAction Command="{Binding OpenModuleCommand}"
                                                       CommandParameter="{Binding SelectedItem, ElementName=MainMenuTreeView}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </TreeView>
                </TabItem>
                <TabItem Header="Správa systému">
                    <TreeView x:Name="SystemAdminTreeView" ItemsSource="{Binding SystemAdminTree}" BorderThickness="0">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="MouseDoubleClick">
                                <b:InvokeCommandAction Command="{Binding OpenModuleCommand}"
                                                       CommandParameter="{Binding SelectedItem, ElementName=SystemAdminTreeView}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </TreeView>
                </TabItem>
                <TabItem Header="Partnerská řešení">
                    <TreeView x:Name="PartnerSolutionsTreeView" ItemsSource="{Binding PartnerSolutionsTree}" BorderThickness="0">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="MouseDoubleClick">
                                <b:InvokeCommandAction Command="{Binding OpenModuleCommand}"
                                                       CommandParameter="{Binding SelectedItem, ElementName=PartnerSolutionsTreeView}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </TreeView>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Oblíbené"/>
                            <TextBlock Text="&#x2605;" Foreground="#FFC107" Margin="5,0,0,0"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <TreeView x:Name="FavoritesTreeView" ItemsSource="{Binding FavoritesTree}" BorderThickness="0">
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="MouseDoubleClick">
                                    <b:InvokeCommandAction Command="{Binding OpenModuleCommand}"
                                                           CommandParameter="{Binding SelectedItem, ElementName=FavoritesTreeView}"/>
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </TreeView>
                        <!-- Empty-state coaching — nenucená pobídka k používání oblíbených. -->
                        <TextBlock Visibility="{Binding HasNoFavorites, Converter={StaticResource BoolToVis}}"
                                   Margin="16" TextWrapping="Wrap" VerticalAlignment="Top"
                                   Foreground="{DynamicResource EDTheme.Text.Secondary}"
                                   Text="Zatím nemáte oblíbené moduly. Klikněte pravým tlačítkem na modul a zvolte „Přidat do oblíbených“ (nebo ho připněte v záložce Používané) — zobrazí se jen ty, které opravdu potřebujete."/>
                    </Grid>
                </TabItem>
                <TabItem Header="Používané">
                    <ListBox x:Name="UsedModulesList" ItemsSource="{Binding UsedModules}" BorderThickness="0"
                             HorizontalContentAlignment="Stretch">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="MouseDoubleClick">
                                <b:InvokeCommandAction Command="{Binding OpenModuleCommand}"
                                                       CommandParameter="{Binding SelectedItem, ElementName=UsedModulesList}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </ListBox>
                </TabItem>
            </TabControl>
        </Grid>
        <GridSplitter Grid.Column="1" Grid.Row="1"  Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <!-- Hostitel miniaplikací. Panely vkládá programově MiniAppManager (code-behind drží
             AvalonDockHost nad tímto DockingManagerem). -->
        <avalonDock:DockingManager x:Name="DockManager" Grid.Column="2" Grid.Row="1"
                                   Background="{DynamicResource EDTheme.Bg.Panel}"
                                   Foreground="{DynamicResource EDTheme.Text.Primary}"
                                   BorderBrush="{DynamicResource EDTheme.Border.Light}"
                                   FontFamily="{DynamicResource EDTheme.FontFamily}"
                                   FontSize="{DynamicResource EDTheme.FontSize.Body}">
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal"/>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

        <StatusBar Grid.Row="2" Grid.ColumnSpan="100">
            <TextBlock Text="{Binding Server, StringFormat='Server: {0}'}"/>
            <TextBlock Text="{Binding RestPort, StringFormat='RestPort: {0}'}"/>
            <TextBlock Text="{Binding Namespace, StringFormat='Namespace: {0}'}"/>
            <TextBlock Text="{Binding Idfa, StringFormat='Idfa: {0}'}"/>
            <TextBlock Text="{Binding UserName, StringFormat='UserName: {0}'}"/>
            <TextBlock Text="{Binding FullName, StringFormat='FullName: {0}'}"/>
            <TextBlock Text="{Binding Mlp, StringFormat='Mlp: {0}'}"/>
            <TextBlock Text="{Binding Version, StringFormat='Verze: {0}'}"/>
            <!-- Chord hint pro Ctrl+W+W. Prázdný text = neaktivní stav. -->
            <TextBlock Text="{Binding ChordHintText}" FontStyle="Italic"/>
        </StatusBar>

    </Grid>

</Window>
