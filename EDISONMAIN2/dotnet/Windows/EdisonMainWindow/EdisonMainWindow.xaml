<Window x:Class="EDISONMAIN2.EdisonMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:local="clr-namespace:EDISONMAIN2"
        xmlns:designTime="clr-namespace:EDISONMAIN2.Windows.EdisonMainWindow.DesignTimeData"
        xmlns:modules="clr-namespace:EDISONMAIN2.Windows.EdisonMainWindow.Modules"
        xmlns:edvm="clr-namespace:EDControls.EDViewModel;assembly=EDControls"
        xmlns:edfc="clr-namespace:EDControls.EDFilterComboBox;assembly=EDControls"
        xmlns:edstx="clr-namespace:EDControls.EDSearchTextBox;assembly=EDControls"
        xmlns:edib="clr-namespace:EDControls.EDInfoBar;assembly=EDControls"
        xmlns:edaip="clr-namespace:EDControls.EDActionInProgress;assembly=EDControls"
        xmlns:edct="clr-namespace:EDControls.EDComponentToolbar;assembly=EDControls"
        d:DataContext="{d:DesignInstance Type=designTime:EdisonMainWindowDesignTimeData, IsDesignTimeCreatable=True}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="800" Width="1200" MinHeight="600" MinWidth="900" Icon="{StaticResource EDIcons.Molecule}" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Closed">
            <b:InvokeCommandAction Command="{Binding CloseAllCommand}"/>
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <!-- Skryté klávesové zkratky (RESPONSIBILITIES §15.1). Ctrl+W+W chord řeší
         PreviewKeyDown v code-behind (víc-krokový stav, nelze přes KeyBinding). -->
    <Window.InputBindings>
        <KeyBinding Key="B" Modifiers="Control+Shift" Command="{Binding ShowBgTasksCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <!-- Most na VM pro bindingy mimo vizuální strom (CompositeCollection v menu Miniaplikace).
             x:Reference na TopMenu nejde — při BAML loadu skončí cyklickou závislostí. -->
        <edvm:BindingProxy x:Key="VmProxy" Data="{Binding}"/>
        <!-- Prázdný transientní text musí segment status baru sbalit, ne nechat mezeru s dividerem. -->
        <edct:NonEmptyStringToVisibleConverter x:Key="NonEmptyToVis"/>
        <!-- Velikost z tokenu — FontService ji škáluje s user fontem (natvrdo 16 by nerostla). -->
        <Style x:Key="StatusIcon" TargetType="Image">
            <Setter Property="Width"  Value="{DynamicResource EDTheme.IconSize.Default}"/>
            <Setter Property="Height" Value="{DynamicResource EDTheme.IconSize.Default}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Strom modulů (launcher) | splitter | plocha miniaplikací (DockingManager).
                 Šířku stromu persistuje VM per IDFa (viz AttachTreeLayout) — restore ji přepíše na px.
                 Min. šířku plochy miniaplikací drží code-behind (MiniAppArea_SizeChanged) — GridSplitter
                 MinWidth star sloupce u fixní px šířky stromu obchází, layout MinWidth by přetékal. -->
            <ColumnDefinition x:Name="TreeColumn" Width="*" MinWidth="150"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- Auto — StatusBar musí růst se zvolenou velikostí fontu (user preference).
                 Pevná výška by ořízla text při větším fontu. -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top-level menu — obsah vychází z legacy frmNoMDI.mnuMain, seskupení je vlastní:
             Uživatel = jen identita/session, Nastavení konsoliduje preference (font, jazyk,
             okna), support diagnostika pod Nápovědou, Nápověda předposlední (Windows konvence).
             Combobox firem nahrazuje legacy "Firma" label (původně jen statický).
             "Test funkcí" je dev-only nadstavba, v legacy je tam "Test funkcí (M-line)" s debug položkami.
             Border drží spodní 1px linku přes celou šířku; Menu lokálně potlačí svoji vlastní linku, ta by končila u TextBlocku. -->
        <Border Grid.Row="0" Grid.ColumnSpan="100"
                Background="{DynamicResource EDTheme.Bg.Footer}"
                BorderBrush="{DynamicResource EDTheme.Border.Light}"
                BorderThickness="0,0,0,1">
        <DockPanel>
            <TextBlock Text="{Binding InformationText}" DockPanel.Dock="Right"
                       VerticalAlignment="Center" Margin="8,0,8,0"/>
            <!-- Menu je rozdělené na dva controly, aby přepínač firem stál hned za položkou EDISON
                 (hlavní nabídka patří na začátek lišty). Cena: šipkami se mezi oběma menu nepřejde. -->
            <Menu x:Name="EdisonMenu" DockPanel.Dock="Left" BorderThickness="0">
            <MenuItem Header="EDISON">
                <MenuItem.Icon><Image Source="{StaticResource EDIcons.Molecule}" Width="16" Height="16"/></MenuItem.Icon>
                <MenuItem Header="Připojit k databázi"   Command="{Binding ConnectToDatabaseCommand}"/>
                <MenuItem Header="Spustit další EDISON"  Command="{Binding RunEdisonCopyCommand}"/>
                <Separator/>
                <MenuItem Header="Konec"                 Command="{Binding ExitCommand}"/>
            </MenuItem>
            </Menu>
            <!-- Přepínač firem MUSÍ být mimo <Menu>: Menu si přebírá fokus/myš pro navigaci a
                 editovatelnému comboboxu uvnitř kradlo fokus (klik do textu "odkliknul"). -->
            <edfc:EDFilterComboBox DockPanel.Dock="Left" StrictSelection="True"
                                   Suggestions="{Binding CompanySuggestions}"
                                   SelectedKey="{Binding SelectedCompanyId, Mode=TwoWay}"
                                   MinWidth="220" VerticalAlignment="Center" Margin="4,0,8,0"/>
            <Menu x:Name="TopMenu" BorderThickness="0">
            <MenuItem Header="Uživatel">
                <MenuItem.Icon><Image Source="{StaticResource EDIcons.User}" Width="16" Height="16"/></MenuItem.Icon>
                <MenuItem Header="Přihlásit jiného uživatele" Command="{Binding LoginAsAnotherUserCommand}"/>
                <MenuItem Header="Aktuální uživatel"          Command="{Binding ShowUserEditCommand}"/>
                <MenuItem Header="Změnit heslo"               Command="{Binding ChangePasswordCommand}"/>
            </MenuItem>
            <MenuItem Header="Spuštěné moduly" ItemsSource="{Binding RunningModules}">
                <MenuItem.Icon><Image Source="{StaticResource EDIcons.Module}" Width="16" Height="16"/></MenuItem.Icon>
                <!-- MouseEnter, ne SubmenuOpened — prázdný submenu by se neotevřel a chicken-and-egg by zablokoval refresh. -->
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="MouseEnter">
                        <b:InvokeCommandAction Command="{Binding RefreshRunningModulesCommand}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
                <MenuItem.ItemContainerStyle>
                    <!-- ElementName ne AncestorType=Menu — submenu items jsou v Popup mimo Menu's visual tree.
                         BasedOn povinné — bez něj explicitní styl přebije implicitní themed styl (Role→template) → dark mode bílé submenu. -->
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding DisplayName}"/>
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                        <Setter Property="Command" Value="{Binding DataContext.ActivateModuleCommand, ElementName=TopMenu}"/>
                        <Setter Property="CommandParameter" Value="{Binding}"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="Miniaplikace">
                <MenuItem.Icon><Image Source="{StaticResource EDIcons.Panels}" Width="16" Height="16"/></MenuItem.Icon>
                <MenuItem.ItemContainerStyle>
                    <!-- Skupiny (per provider) — jen rozbalují, žádný Command. Statické položky dole
                         mají lokální Style, takže se na ně tenhle ItemContainerStyle nepoužije.
                         BasedOn povinné — bez něj se ztratí implicitní themed styl (Role→template) → dark mode bílé submenu. -->
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Title}"/>
                        <Setter Property="ItemsSource" Value="{Binding Apps}"/>
                        <!-- Explicitní vnitřní styl přebije děděný — Command jen na listech.
                             ElementName=TopMenu — položky jsou v Popup mimo Menu's visual tree (jako Spuštěné moduly). -->
                        <Setter Property="ItemContainerStyle">
                            <Setter.Value>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding Title}"/>
                                    <Setter Property="Command" Value="{Binding DataContext.OpenMiniAppCommand, ElementName=TopMenu}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </MenuItem.ItemContainerStyle>
                <MenuItem.ItemsSource>
                    <CompositeCollection>
                        <!-- Statické položky nejsou ve stromu/namescope (CompositeCollection) —
                             DataContext ani ElementName nefungují, vše jde přes VmProxy.
                             Lokální Style na nich zamezí aplikaci ItemContainerStyle skupin. -->
                        <CollectionContainer Collection="{Binding Data.MiniAppGroups, Source={StaticResource VmProxy}}"/>
                        <Separator Style="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}"/>
                        <MenuItem Header="Zavřít miniaplikace" Style="{StaticResource {x:Type MenuItem}}"
                                  Command="{Binding Data.CloseMiniAppsCommand, Source={StaticResource VmProxy}}"/>
                        <MenuItem Header="Resetovat miniaplikace" Style="{StaticResource {x:Type MenuItem}}"
                                  Command="{Binding Data.ResetMiniAppsCommand, Source={StaticResource VmProxy}}"/>
                    </CompositeCollection>
                </MenuItem.ItemsSource>
            </MenuItem>
            <MenuItem Header="Nástroje">
                <MenuItem.Icon><Image Source="{StaticResource EDIcons.Tools}" Width="16" Height="16"/></MenuItem.Icon>
                <MenuItem Header="Úlohy na pozadí"      Command="{Binding ShowBgTasksCommand}"/>
                <MenuItem Header="Aktualizovat licenci" Command="{Binding RefreshLicenseCommand}"/>
                <Separator/>
                <!-- Admin-only (command gate přes IsAdmin) — separator je odděluje od běžných nástrojů. -->
                <MenuItem Header="Správa zámků"         Command="{Binding ShowUsersLocksCommand}"/>
                <MenuItem Header="Aktivita uživatelů"   Command="{Binding ShowUsersActivityCommand}"/>
            </MenuItem>
            <MenuItem Header="Nastavení">
                <MenuItem.Icon><Image Source="{StaticResource EDIcons.Settings}" Width="16" Height="16"/></MenuItem.Icon>
                <MenuItem Header="Nastavení fontu…" Command="{Binding FontSettingsCommand}"/>
                <MenuItem Header="Tmavý režim"  IsCheckable="True" IsChecked="{Binding IsDarkMode}"/>
                <Separator/>
                <MenuItem Header="Nastavení jazyka" Command="{Binding ShowLanguageSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="Spouštět okna jako dialogy"     IsCheckable="True" IsChecked="{Binding ShowWindowsAsDialogs}"/>
                <MenuItem Header="Obnovit výchozí nastavení oken" Command="{Binding ResetFormsCommand}"/>
            </MenuItem>
            <MenuItem Header="Nápověda">
                <MenuItem.Icon><Image Source="{StaticResource EDIcons.Help}" Width="16" Height="16"/></MenuItem.Icon>
                <MenuItem Header="Informace o verzi" Command="{Binding ShowInfoCommand}"/>
                <MenuItem Header="Helpdesk, Wiki"    Command="{Binding OpenHelpdeskWebCommand}"/>
                <Separator/>
                <!-- Support diagnostika — dělá se na vyžádání helpdesku, proto u Nápovědy. -->
                <MenuItem Header="Odeslat systémové soubory" Command="{Binding SendSystemLogCommand}"/>
            </MenuItem>
            <MenuItem Header="Test funkcí">
                <MenuItem Header="Test InputForm"    Command="{Binding OpenInputFormTestCommand}"/>
                <MenuItem Header="Test EDList"       Command="{Binding OpenEDListTestCommand}"/>
                <MenuItem Header="Test EDViewModel"  Command="{Binding OpenEDComponentAndViewModelTestCommand}"/>
                <MenuItem Header="Test odhlašovacího countdownu" Command="{Binding OpenLogoutCountdownTestCommand}"/>
                <MenuItem Header="Vyvolat chybu" Command="{Binding TriggerErrorCommand}"/>
                <Separator/>
                <MenuItem Header="TemplateDesigner"  Command="{Binding OpenTemplateDesignerCommand}"/>
            </MenuItem>
            </Menu>
        </DockPanel>
        </Border>

        <!-- Tři stromy odpovídají legacy edisonnavbar.xml: Hlavní nabídka (id=-2),
             Správa systému (id=-3), Partnerská řešení (id=-4).
             Bg.Sunken → chrome panelu je zapuštěné a strom na něm leží jako karta z Bg.Surface;
             v light je totiž Bg.Base == Bg.Surface a bez toho by celý panel splynul s obsahem. -->
        <Grid Grid.Column="0" Grid.Row="1" Background="{DynamicResource EDTheme.Bg.Sunken}">
            <Grid.Resources>
                <edvm:HexToBrushConverter x:Key="HexToBrush"/>
                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                <HierarchicalDataTemplate ItemsSource="{Binding NestedModules}" DataType="{x:Type modules:ModuleFamily}">
                    <!-- Tag = VM (přes VmProxy) — most pro ContextMenu mimo visual tree. Proxy, ne
                         ancestor: tenhle template se používá ve stromech i v ListBoxu Používané.
                         Transparent → hit-test i napravo od textu (ContextMenu na celém řádku). -->
                    <StackPanel Orientation="Horizontal" Background="Transparent"
                                Tag="{Binding Data, Source={StaticResource VmProxy}}">
                        <Image Source="{StaticResource EDIcons.Folder}" Width="16" Height="16"
                               Margin="0,0,6,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <!-- Color "" → prázdná → themed text; v DEBUG nastaveno agregací (stub/broken). -->
                        <TextBlock Text="{Binding DisplayedName}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{Binding Color, Converter={StaticResource HexToBrush}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Color}" Value="">
                                            <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Primary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <!-- Hromadné přepnutí celé rodiny (např. MHD). Header dle IsFavorite
                                     (= všechny moduly v ní oblíbené). Sem mohou přibýt další akce. -->
                                <MenuItem Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="Přidat vše do oblíbených"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Header" Value="Odebrat vše z oblíbených"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <Separator/>
                                <!-- Rozbalit/sbalit: „vše" = celý aktivní strom (bez param), „úroveň" = tato větev (param = rodina). -->
                                <MenuItem Header="Rozbalit vše"
                                          Command="{Binding PlacementTarget.Tag.ExpandAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Rozbalit úroveň"
                                          Command="{Binding PlacementTarget.Tag.ExpandSubtreeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Sbalit vše"
                                          Command="{Binding PlacementTarget.Tag.CollapseAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Sbalit úroveň"
                                          Command="{Binding PlacementTarget.Tag.CollapseSubtreeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                    </StackPanel>
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type modules:ExecutableModule}">
                    <!-- Tag = VM (přes VmProxy) — most pro ContextMenu, který není ve visual tree.
                         Transparent → hit-test i napravo od textu (ContextMenu na celém řádku). -->
                    <StackPanel Orientation="Horizontal" Background="Transparent"
                                Tag="{Binding Data, Source={StaticResource VmProxy}}">
                        <Image Source="{StaticResource EDIcons.Module}" Width="16" Height="16"
                               Margin="0,0,6,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <!-- Barva z modelu (launchability); prázdná → themed Text.Primary z BasedOn
                             implicit stylu (jinak by byla černá = neviditelná v dark). -->
                        <TextBlock Text="{Binding DisplayedName}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{Binding Color, Converter={StaticResource HexToBrush}}"/>
                                    <Style.Triggers>
                                        <!-- Prázdná barva → themed text (jinak by binding dal černou, v dark neviditelnou). -->
                                        <DataTrigger Binding="{Binding Color}" Value="">
                                            <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Primary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Zlatá ★ na konci názvu, jen u oblíbených (prázdná se nezobrazuje). -->
                        <TextBlock Text="&#x2605;" Margin="6,0,0,0" Foreground="{DynamicResource EDTheme.Semantic.Favorite}" VerticalAlignment="Center"
                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                        <!-- Značka výchozího okna (shell ho auto-otevře po loginu). -->
                        <TextBlock Text="(výchozí)" Margin="6,0,0,0" FontSize="{DynamicResource EDTheme.FontSize.Caption}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource EDTheme.Text.Muted}"
                                   Visibility="{Binding IsStartupWindow, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <!-- Toggle oblíbeného. Header dle IsFavorite (ContextMenu dědí DataContext = modul).
                                     Command jde na VM přes PlacementTarget.Tag. -->
                                <MenuItem Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="Přidat do oblíbených"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Header" Value="Odebrat z oblíbených"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <Separator/>
                                <!-- Výchozí okno: nastaví tento modul / zruší jakýkoli. Command na VM přes Tag. -->
                                <MenuItem Header="Nastavit jako výchozí okno"
                                          Command="{Binding PlacementTarget.Tag.SetStartupWindowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Zrušit výchozí okno"
                                          Command="{Binding PlacementTarget.Tag.ClearStartupWindowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                    </StackPanel>
                </DataTemplate>
                <!-- BasedOn → zdědí moderní template (chevron, hover, accent) z EDControlStyles;
                     bez něj by lokální styl spadl na default WPF TreeViewItem šablonu. -->
                <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <!-- TwoWay → rozbalení/sbalení uživatelem se propíše do modelu (VM ho persistuje). -->
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <!-- Skryje uzly nevyhovující vyhledávání (VM nastaví IsVisibleBySearch). -->
                    <Setter Property="Visibility" Value="{Binding IsVisibleBySearch, Converter={StaticResource BoolToVis}}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <!-- Single-click: složka toggle expand, modul spustí (handler v code-behind). -->
                    <EventSetter Event="MouseLeftButtonUp" Handler="TreeItem_MouseLeftButtonUp"/>
                    <!-- Pravý klik označí položku, aby kontextové menu vizuálně sedělo na cíli. -->
                    <EventSetter Event="MouseRightButtonDown" Handler="TreeItem_MouseRightButtonDown"/>
                    <!-- Drag modulu do miniaplikace Oblíbené (práh odliší od kliku = spuštění). -->
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeItem_PreviewMouseLeftButtonDown"/>
                    <EventSetter Event="MouseMove" Handler="TreeItem_MouseMove"/>
                </Style>

                <!-- Ikonový tab — text nese ToolTip, aby se všech pět záložek vešlo na jeden řádek
                     vedle akčního toolbaru. BasedOn povinné (theming + FocusVisual žijí v implicitním stylu). -->
                <Style x:Key="TreeTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="Padding" Value="4,6"/>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Přepínač záložek + akce nad aktivním stromem na jednom řádku. TabControl tu drží
                 jen tab strip: TabItemy jsou záměrně bez Contentu (stromy jsou pod hledáním v kartě
                 níž, přepínané Is*TabActive) — content row jeho šablony tak zkolabuje na nulu.
                 Přetemplatovat TabControl lokálně nelze, viz EDControls/CLAUDE.md.
                 Záložky vs. akce se nesmí slít do jedné řady ikon (obě skupiny mají ★): taby sedí
                 na kartě (Bg.Surface, spojité s hledáním i stromem = patří k obsahu), akce zůstávají
                 vpravo na zapuštěném chrome. Odsazení vpravo drží Auto sloupec. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" HorizontalAlignment="Left" Margin="4,4,0,0" CornerRadius="3,3,0,0"
                        Background="{DynamicResource EDTheme.Bg.Surface}"
                        BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="1,1,1,0">
                    <!-- Pamatuje poslední otevřenou záložku (per-user × IDFa); při prvním spuštění výchozí dle oblíbených.
                         BorderThickness=0 — spodní linku kreslí až rámeček řádku s hledáním, spojitě přes celou šířku. -->
                    <TabControl x:Name="TreeTabControl" BorderThickness="0"
                                SelectedIndex="{Binding SelectedTreeTabIndex, Mode=TwoWay}"
                                SelectionChanged="TreeTab_SelectionChanged">
                        <!-- Ikona patří do Headeru, ne do Contentu — ten se vůbec nezobrazuje (viz výše). -->
                        <TabItem Style="{StaticResource TreeTab}" ToolTip="Hlavní nabídka">
                            <TabItem.Header><Image Source="{StaticResource EDIcons.Home}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/></TabItem.Header>
                        </TabItem>
                        <TabItem Style="{StaticResource TreeTab}" ToolTip="Správa systému">
                            <TabItem.Header><Image Source="{StaticResource EDIcons.Gears}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/></TabItem.Header>
                        </TabItem>
                        <TabItem Style="{StaticResource TreeTab}" ToolTip="Partnerská řešení">
                            <TabItem.Header><Image Source="{StaticResource EDIcons.Component}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/></TabItem.Header>
                        </TabItem>
                        <TabItem Style="{StaticResource TreeTab}" ToolTip="Oblíbené">
                            <TabItem.Header><Image Source="{StaticResource EDIcons.Star}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/></TabItem.Header>
                        </TabItem>
                        <TabItem Style="{StaticResource TreeTab}" ToolTip="Používané">
                            <TabItem.Header><Image Source="{StaticResource EDIcons.History}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/></TabItem.Header>
                        </TabItem>
                    </TabControl>
                </Border>
                <!-- Rozbalit/sbalit cílí na aktivní strom (VM.ActiveExpandableTree), zbytek na vybraný
                     uzel — jedna instance pro všechny záložky. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,2,4,2">
                    <Button Style="{StaticResource EDTheme.ToolbarButton}" ToolTip="Rozbalit vše"
                            Command="{Binding ExpandAllCommand}">
                        <Image Source="{StaticResource EDIcons.ExpandAll}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                    <Button Style="{StaticResource EDTheme.ToolbarButton}" ToolTip="Sbalit vše"
                            Command="{Binding CollapseAllCommand}">
                        <Image Source="{StaticResource EDIcons.CollapseAll}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                    <Border Width="1" Margin="4,4" Background="{DynamicResource EDTheme.Border.Medium}"/>
                    <Button Style="{StaticResource EDTheme.ToolbarButton}" ToolTip="Přidat/odebrat z oblíbených"
                            Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding SelectedModule}"
                            IsEnabled="{Binding HasSelection}">
                        <Image Source="{StaticResource EDIcons.Star}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                    <Button Style="{StaticResource EDTheme.ToolbarButton}" ToolTip="Nastavit jako výchozí okno"
                            Command="{Binding SetStartupWindowCommand}" CommandParameter="{Binding SelectedModule}"
                            IsEnabled="{Binding CanSetStartup}">
                        <Image Source="{StaticResource EDIcons.StartupWindow}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Vyhledávání napříč všemi stromy — filtruje uzly dle názvu (VM.TreeSearchText).
                 Rámeček navazuje na pruh záložek i na kartu se stromem (jedna spojitá plocha). -->
            <Border Grid.Row="1" Margin="4,0,4,0" Padding="4"
                    Background="{DynamicResource EDTheme.Bg.Surface}"
                    BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="1,1,1,0">
                <edstx:EDSearchTextBox x:Name="TreeSearchBox"
                                       Placeholder="Hledat modul…"
                                       Text="{Binding TreeSearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </Border>

            <!-- Karta s obsahem aktivní záložky — Bg.Surface proti zapuštěnému Bg.Sunken panelu.
                 Přepínání viditelností (ne TabControl.Content): tab strip a hledání musí zůstat
                 nad kartou. Vedlejší efekt je žádoucí — stromy zůstávají živé, stav rozbalení
                 přepnutí záložky přežije. -->
            <Border Grid.Row="2" Margin="4,0,4,4" CornerRadius="0,0,3,3"
                    Background="{DynamicResource EDTheme.Bg.Surface}"
                    BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="1,0,1,1">
                <Grid>
                    <TreeView x:Name="MainMenuTreeView" ItemsSource="{Binding MainMenuTree}" BorderThickness="0"
                              Visibility="{Binding IsMainMenuTabActive, Converter={StaticResource BoolToVis}}"/>
                    <TreeView x:Name="SystemAdminTreeView" ItemsSource="{Binding SystemAdminTree}" BorderThickness="0"
                              Visibility="{Binding IsSystemAdminTabActive, Converter={StaticResource BoolToVis}}"/>
                    <TreeView x:Name="PartnerSolutionsTreeView" ItemsSource="{Binding PartnerSolutionsTree}" BorderThickness="0"
                              Visibility="{Binding IsPartnerSolutionsTabActive, Converter={StaticResource BoolToVis}}"/>
                    <Grid Visibility="{Binding IsFavoritesTabActive, Converter={StaticResource BoolToVis}}">
                        <TreeView x:Name="FavoritesTreeView" ItemsSource="{Binding FavoritesTree}" BorderThickness="0"/>
                        <!-- Empty-state coaching — nenucená pobídka k používání oblíbených. -->
                        <TextBlock Visibility="{Binding HasNoFavorites, Converter={StaticResource BoolToVis}}"
                                   Margin="16" TextWrapping="Wrap" VerticalAlignment="Top"
                                   Foreground="{DynamicResource EDTheme.Text.Secondary}"
                                   Text="Zatím nemáte oblíbené moduly. Klikněte pravým tlačítkem na modul a zvolte „Přidat do oblíbených“ (nebo ho připněte v záložce Používané) — zobrazí se jen ty, které opravdu potřebujete."/>
                    </Grid>
                    <ListBox x:Name="UsedModulesList" ItemsSource="{Binding UsedModules}" BorderThickness="0"
                             HorizontalContentAlignment="Stretch" Background="Transparent"
                             Visibility="{Binding IsUsedModulesTabActive, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Cursor" Value="Hand"/>
                                <!-- Single-click spustí modul — konzistentní se stromy výše. -->
                                <EventSetter Event="MouseLeftButtonUp" Handler="UsedModuleItem_MouseLeftButtonUp"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Upozornění, že miniaplikace Plocha není zobrazená (přišel by o rychlý přístup
                 k připnutým zástupcům). Skryje se, jakmile je otevřená (HasOpenDesktop). -->
            <edib:EDInfoBar Grid.Row="3"
                            Text="Miniaplikace Plocha není zobrazena."
                            Icon="{StaticResource EDIcons.Star}"
                            ActionText="Zobrazit"
                            ActionCommand="{Binding ShowDesktopMiniAppCommand}">
                <edib:EDInfoBar.Style>
                    <Style TargetType="{x:Type edib:EDInfoBar}" BasedOn="{StaticResource {x:Type edib:EDInfoBar}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOpenDesktop}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </edib:EDInfoBar.Style>
            </edib:EDInfoBar>
        </Grid>
        <GridSplitter Grid.Column="1" Grid.Row="1"  Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{DynamicResource EDTheme.Border.Light}"/>
        <!-- Hostitel miniaplikací. Panely vkládá programově MiniAppManager (code-behind drží
             AvalonDockHost nad tímto DockingManagerem). -->
        <!-- AllowMixedOrientation: bez něj AvalonDock skryje boční drop targety, jakmile by
             vyžadovaly vnořený panel s jinou orientací (např. dokovat vedle karuselu, který
             po collect-garbage sedí přímo ve svislém rootu; nebo nad/pod pane ve vodorovném pásu). -->
        <avalonDock:DockingManager x:Name="DockManager" Grid.Column="2" Grid.Row="1"
                                   AllowMixedOrientation="True"
                                   Background="{DynamicResource EDTheme.Bg.Panel}"
                                   Foreground="{DynamicResource EDTheme.Text.Primary}"
                                   BorderBrush="{DynamicResource EDTheme.Border.Light}"
                                   FontFamily="{DynamicResource EDTheme.FontFamily}"
                                   FontSize="{DynamicResource EDTheme.FontSize.Body}">
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <!-- Miniaplikace = dokumenty v tomto pane → vyplní plochu, další jdou jako taby. -->
                    <avalonDock:LayoutDocumentPane/>
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

        <!-- Prázdný dock: výzva + tlačítko na výchozí rozložení. Skryje se, jakmile je otevřená mini-app. -->
        <StackPanel Grid.Column="2" Grid.Row="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasOpenMiniApps}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="V horní liště si vyberte miniaplikace k zobrazení."
                       TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource EDTheme.Text.Secondary}"
                       Margin="0,0,0,12"/>
            <Button Content="Zobrazit výchozí miniaplikace"
                    Command="{Binding OpenDefaultMiniAppsCommand}"
                    HorizontalAlignment="Center" Padding="12,6"/>
        </StackPanel>

        <!-- Segment = ikona + hodnota, technika (namespace, port, login, Mlp) je v ToolTipu.
             Separator jen mezi vždy viditelnými segmenty — u sbalitelných by zůstal viset. -->
        <StatusBar Grid.Row="2" Grid.ColumnSpan="100">
            <StatusBarItem>
                <StatusBarItem.ToolTip>
                    <StackPanel>
                        <TextBlock Text="{Binding Idfa, StringFormat='Firma: {0}'}"/>
                        <TextBlock Text="{Binding Namespace, StringFormat='Databáze: {0}'}"/>
                    </StackPanel>
                </StatusBarItem.ToolTip>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource EDIcons.Company}" Style="{StaticResource StatusIcon}"/>
                    <TextBlock Text="{Binding Idfa}" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <StatusBarItem.ToolTip>
                    <StackPanel>
                        <TextBlock Text="{Binding FullName, StringFormat='Uživatel: {0}'}"/>
                        <TextBlock Text="{Binding UserName, StringFormat='Přihlašovací jméno: {0}'}"/>
                        <TextBlock Text="{Binding Mlp, StringFormat='ID: {0}'}"/>
                    </StackPanel>
                </StatusBarItem.ToolTip>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource EDIcons.User}" Style="{StaticResource StatusIcon}"/>
                    <TextBlock Text="{Binding UserDisplay}" VerticalAlignment="Center"
                               MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <StatusBarItem.ToolTip>
                    <StackPanel>
                        <TextBlock Text="{Binding Server, StringFormat='Server: {0}'}"/>
                        <TextBlock Text="{Binding RestPort, StringFormat='REST port: {0}'}"/>
                    </StackPanel>
                </StatusBarItem.ToolTip>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource EDIcons.Server}" Style="{StaticResource StatusIcon}"/>
                    <TextBlock Text="{Binding ConnectionText}" VerticalAlignment="Center"
                               Foreground="{DynamicResource EDTheme.Text.Secondary}"
                               MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <StatusBarItem.ToolTip>
                    <StackPanel>
                        <TextBlock Text="{Binding Version, StringFormat='Verze EDISONu: {0}'}"/>
                        <!-- Potvrzení aktuálnosti z release serveru; prázdné = nezjištěno (offline, dev build). -->
                        <TextBlock Text="{Binding UpToDateText}"
                                   Visibility="{Binding UpToDateText, Converter={StaticResource NonEmptyToVis}}"
                                   Foreground="{DynamicResource EDTheme.Text.Secondary}"/>
                    </StackPanel>
                </StatusBarItem.ToolTip>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource EDIcons.Info}" Style="{StaticResource StatusIcon}"/>
                    <TextBlock Text="{Binding Version, StringFormat='Verze {0}'}" VerticalAlignment="Center"
                               Foreground="{DynamicResource EDTheme.Text.Secondary}"/>
                </StackPanel>
            </StatusBarItem>

            <!-- Pravá zóna: dokovaný jde k pravému okraji, další nalevo od něj. Chip je první,
                 aby ho naskočení chord hintu neposunulo. Dock funguje jen na explicitním StatusBarItem. -->
            <StatusBarItem DockPanel.Dock="Right"
                           Visibility="{Binding NewVersionText, Converter={StaticResource NonEmptyToVis}}">
                <!-- Rámeček drží chip čitelný i v light modu, kde BlueBg na Bg.Panel splývá. -->
                <Border Background="{DynamicResource EDTheme.Accent.BlueBg}"
                        BorderBrush="{DynamicResource EDTheme.Accent.BlueBorder}" BorderThickness="1"
                        CornerRadius="3" Padding="8,1"
                        ToolTip="{Binding NewVersionTooltip}">
                    <TextBlock Text="{Binding NewVersionText}" FontWeight="SemiBold"
                               Foreground="{DynamicResource EDTheme.Accent.BlueDark}"
                               MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                </Border>
            </StatusBarItem>
            <!-- Chord hint pro Ctrl+W+W. Prázdný text = neaktivní stav. -->
            <StatusBarItem DockPanel.Dock="Right"
                           Visibility="{Binding ChordHintText, Converter={StaticResource NonEmptyToVis}}">
                <TextBlock Text="{Binding ChordHintText}" FontStyle="Italic"
                           Foreground="{DynamicResource EDTheme.Text.Secondary}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Overlay „akce probíhá" (náběh spouštěného modulu) — neviditelný controller,
             karta se kreslí ve vlastním owned okně (nad WebView2 widgety).
             Auto-binduje se na VM.IsActionInProgress. -->
        <edaip:EDActionInProgress/>

    </Grid>

</Window>
