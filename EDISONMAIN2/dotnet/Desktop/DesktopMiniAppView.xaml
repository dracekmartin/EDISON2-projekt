<UserControl x:Class="EDISONMAIN2.Desktop.DesktopMiniAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="clr-namespace:EDISONMAIN2.Desktop">
    <!-- AllowDrop na kořeni: přetažení modulu ze stromu (přidání) i dlaždice (přemístění na buňku). -->
    <Grid AllowDrop="True" Background="Transparent" DragOver="Desktop_DragOver" Drop="Desktop_Drop"
          SizeChanged="Desktop_SizeChanged">
        <TextBlock Text="Přetáhněte sem moduly ze stromu, nebo je přidejte přes ★ v kontextovém menu."
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource EDTheme.Text.Secondary}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Mřížka dlaždic; pozice = DesktopShortcut.Col/Row (absolutní, mezery povolené). Klik spustí, tažení přemístí.
             Background: prázdná plocha mezi dlaždicemi jinak není hit-testable a kolečko myši jde mimo ScrollViewer. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <ItemsControl x:Name="TilesHost" ItemsSource="{Binding Items}" Margin="6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <desktop:TileGridPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="desktop:TileGridPanel.Column" Value="{Binding Col}"/>
                        <Setter Property="desktop:TileGridPanel.Row" Value="{Binding Row}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type desktop:DesktopShortcut}">
                        <Border Width="128" Height="72" Margin="6" Padding="6" AllowDrop="True"
                                Background="{DynamicResource EDTheme.Bg.Surface}"
                                BorderBrush="{DynamicResource EDTheme.Border.Light}"
                                BorderThickness="1" CornerRadius="4" Cursor="Hand"
                                ToolTip="{Binding TreePath}"
                                MouseLeftButtonUp="Tile_MouseLeftButtonUp"
                                PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown"
                                MouseMove="Tile_MouseMove">
                            <!-- Width = vnitřní šířka dlaždice (zlomy řádků na plnou šířku), MaxHeight je
                                 podlaha zmenšení: Viewbox neklesne pod ~0,76 a delší text se ořízne (celý je v ToolTipu).
                                 Fixní hodnota - z tokenu FontSize se přes DynamicResource spočítat nedá. -->
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                <TextBlock Text="{Binding DisplayedDistinctName}" Width="114" MaxHeight="76"
                                           TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource EDTheme.Text.Primary}"/>
                            </Viewbox>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Novinky v aktualizaci"
                                              Command="{Binding PlacementTarget.Tag.ShowChangelogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="Odebrat z plochy"
                                              Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Border.Tag>
                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            </Border.Tag>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
