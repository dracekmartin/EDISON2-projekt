<Window x:Class="EDUPDATE2.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aktualizace klienta systému EDISON"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="White">
    <!-- Bez EDControls/EDTheme: updater tyhle DLL vyměňuje, nesmí je držet načtené.
         Barvy natvrdo jsou tu vědomá výjimka z theme pravidel. -->
    <StackPanel Margin="16">
        <TextBlock x:Name="PhaseText" FontWeight="SemiBold" Foreground="#1F1F1F"
                   TextWrapping="Wrap" Text="Připravuji aktualizaci..." />
        <TextBlock x:Name="DetailText" Foreground="#5A5A5A" TextWrapping="Wrap" Margin="0,4,0,0" />
        <ProgressBar x:Name="Progress" Height="18" Margin="0,12,0,0" Minimum="0" Maximum="100"
                     IsIndeterminate="True" />
        <Button x:Name="CloseButton" Content="Zavřít" HorizontalAlignment="Right" Margin="0,12,0,0"
                Padding="24,4" IsEnabled="False" Click="CloseButton_Click" />
    </StackPanel>
</Window>
