<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <WarningsAsErrors>Nullable;CS0108</WarningsAsErrors>
    <!-- Jen build-time soubor, ne závislost na EDControls.dll: okno updateru nemá Icon a bere ikonu z exe. -->
    <ApplicationIcon>..\..\EDControls\dotnet\EDIcons\cube_molecule.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EDUPDATE2.Tests" />
  </ItemGroup>

  <!-- Sdílený zdroj místo reference: updater nesmí záviset na žádné DLL z C:\Edison
       (vyměňuje je za běhu) a dvě kopie porovnávání verzí by tiše divergovaly. -->
  <ItemGroup>
    <Compile Include="..\..\EDISONMAIN2\dotnet\Startup\VerzeInf.cs" Link="VerzeInf.cs" />
  </ItemGroup>

  <Import Project="..\..\SingleFilePublish.targets" />

</Project>
