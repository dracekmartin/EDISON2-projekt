<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <WarningsAsErrors>Nullable;CS0108</WarningsAsErrors>
    <!-- Jen build-time soubor, ne závislost na EDControls.dll: okno updateru nemá Icon a bere ikonu z exe. -->
    <ApplicationIcon>..\..\EDControls\dotnet\EDIcons\cube_molecule.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EDUPDATE2.Tests" />
    <Using Include="EDUpdateContract" />
  </ItemGroup>

  <!-- Jediná reference: kontrakt se shellem, sám bez závislostí (single-file ho zabalí do exe). -->
  <ItemGroup>
    <ProjectReference Include="..\..\EDUpdateContract\dotnet\EDUpdateContract.csproj" />
  </ItemGroup>

  <Import Project="..\..\SingleFilePublish.targets" />

</Project>
