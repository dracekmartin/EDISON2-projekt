<UserControl x:Class="EDISONMAIN2.LegacyMiniApps.LegacyDashboardMiniAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lma="clr-namespace:EDISONMAIN2.LegacyMiniApps"
             xmlns:edc="clr-namespace:EDControls;assembly=EDControls"
             xmlns:edct="clr-namespace:EDControls.EDComponentToolbar;assembly=EDControls"
             xmlns:edvm="clr-namespace:EDControls.EDViewModel;assembly=EDControls">
    <UserControl.Resources>
        <edvm:HexToBrushConverter x:Key="HexToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <edct:NonEmptyStringToVisibleConverter x:Key="TextToVis"/>

        <DataTemplate DataType="{x:Type lma:DashboardLabel}">
            <TextBlock Text="{Binding Text}" Margin="6,3" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type lma:DashboardTable}">
            <!-- Sekce je na výšku obsahu, roluje vnější ScrollViewer - kolečko nad tabulkou mu musí dojít. -->
            <DataGrid ItemsSource="{Binding Rows}"
                      lma:DashboardTableColumns.Columns="{Binding Columns}"
                      edc:ScrollWheelBubbling.IsEnabled="True"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" Margin="6,3">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground"
                                Value="{Binding ForeColorHtml, Converter={StaticResource HexToBrush}}"/>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
            <Button Content="Načíst" Command="{Binding RefreshCommand}" Padding="10,2" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding LastUpdated, StringFormat='Aktualizováno: {0}'}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sections}"/>
            </ScrollViewer>
            <TextBlock Text="Načítám data…" Margin="6"
                       Foreground="{DynamicResource EDTheme.Text.Muted}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding ErrorText}" Margin="6" TextWrapping="Wrap"
                       Foreground="{DynamicResource EDTheme.Semantic.Danger}"
                       Visibility="{Binding ErrorText, Converter={StaticResource TextToVis}}"/>
            <TextBlock Text="Žádná data k zobrazení." Margin="6"
                       Foreground="{DynamicResource EDTheme.Text.Muted}"
                       Visibility="{Binding HasNoData, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </DockPanel>
</UserControl>
