<UserControl x:Class="EDISONMAIN2.LegacyMiniApps.LegacyDashboardMiniAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:lma="clr-namespace:EDISONMAIN2.LegacyMiniApps"
             xmlns:edc="clr-namespace:EDControls;assembly=EDControls"
             xmlns:edct="clr-namespace:EDControls.EDComponentToolbar;assembly=EDControls"
             xmlns:edib="clr-namespace:EDControls.EDInfoBar;assembly=EDControls"
             xmlns:edl="clr-namespace:EDControls.EDList;assembly=EDControls"
             xmlns:edma="clr-namespace:EDControls.MiniApps;assembly=EDControls">
    <UserControl.Resources>
        <lma:LegacyForeColorConverter x:Key="LegacyFore"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <sys:Double x:Key="TableMaxHeight">0</sys:Double>
        <edct:NonEmptyStringToVisibleConverter x:Key="TextToVis"/>

        <!-- Barva řádku patří na buňku: implicitní DataGridCell styl si Foreground nastavuje
             setterem a ten přebíjí hodnotu děděnou z řádku (viz EDControls/CLAUDE.md).
             "_fore" je skrytý sloupec EDListu, čte se přes indexer řádku. -->
        <Style x:Key="DashboardCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Foreground" Value="{Binding [_fore], Converter={StaticResource LegacyFore}}"/>
        </Style>

        <DataTemplate DataType="{x:Type lma:DashboardLabel}">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold"
                       FontSize="{DynamicResource EDTheme.FontSize.Header}"
                       Foreground="{DynamicResource EDTheme.Text.Header}"
                       Margin="2,12,2,4"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type lma:DashboardTable}">
            <!-- Rám i pozadí kreslí DataGrid uvnitř EDListu (karta okolo = dvojitá linka), nadpis nese pruh EDListu.
                 Strop na výšku panelu (plní code-behind): s neomezenou výškou DataGrid nevirtualizuje a tisíce řádků
                 staví při načtení i seřazení. Odsazení je Padding, ať se vejde pod strop. -->
            <Border Padding="0,0,0,10" MaxHeight="{DynamicResource TableMaxHeight}">
                <edl:EDList lma:DashboardListSource.Table="{Binding}"
                            edc:ScrollWheelBubbling.IsEnabled="True"
                            CellStyle="{StaticResource DashboardCell}"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <edma:EDMiniAppBar DockPanel.Dock="Top"
                           ActionCommand="{Binding RefreshCommand}"
                           IsBusy="{Binding IsLoading}"
                           StatusText="{Binding StatusText}"/>

        <edib:EDInfoBar DockPanel.Dock="Top"
                        Text="{Binding ErrorText}"
                        Icon="{StaticResource EDIcons.Info}"
                        Foreground="{DynamicResource EDTheme.Semantic.Danger}"
                        BorderThickness="0,0,0,1"
                        ActionText="Zkusit znovu"
                        ActionCommand="{Binding RefreshCommand}"
                        Visibility="{Binding ErrorText, Converter={StaticResource TextToVis}}"/>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4,8,8"
                          ScrollChanged="OnScrollChanged">
                <ItemsControl x:Name="SectionsHost" ItemsSource="{Binding Sections}"/>
            </ScrollViewer>
            <TextBlock Text="Načítám data…"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       MaxWidth="320" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource EDTheme.Text.Muted}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="Pro tuhle agendu nejsou data. Zkuste Načíst."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       MaxWidth="320" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource EDTheme.Text.Muted}"
                       Visibility="{Binding HasNoData, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </DockPanel>
</UserControl>
