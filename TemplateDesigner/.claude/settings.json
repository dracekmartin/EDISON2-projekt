      "Bash(dotnet run *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet add *)",
      "Bash(dotnet list *)",
      "Bash(dotnet format *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git fetch *)",
      "Bash(git stash)",
      "Bash(git stash list)",
      "Bash(git stash pop *)",
      "Bash(git stash apply *)",
      "Bash(git blame *)",
      "Bash(git shortlog *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git cat-file *)",
      "Bash(git name-rev *)",
      "Bash(git describe *)",
      "Bash(git config --get *)",
      "Bash(git config --list)",
      "Bash(git remote -v)",
