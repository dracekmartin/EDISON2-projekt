<Window x:Class="TemplateDesigner.ElementPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TemplateDesigner.Controls"
        Title="Vlastnosti"
        Width="290" MinWidth="220" MaxWidth="520"
        MinHeight="120" MaxHeight="640"
        SizeToContent="Height"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">

    <DockPanel LastChildFill="True">

        <!-- Tlačítka dole -->
        <Border DockPanel.Dock="Bottom"
                Padding="8,6,8,6"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0"
                Background="#F8F8F8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK"     Width="72" IsDefault="True" Click="BtnOK_Click"
                        Margin="0,0,6,0" Padding="0,4"/>
                <Button Content="Zrušit" Width="72"                   Click="BtnCancel_Click"
                        Padding="0,4"/>
            </StackPanel>
        </Border>

        <!-- Panel vlastností (scrollovatelný) -->
        <controls:PropertiesPanel x:Name="PropertiesPanel"/>

    </DockPanel>
</Window>
