<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <NoWarn>NU1701</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
<PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.2" />
<PackageReference Include="PdfPig" Version="0.1.13" />
<PackageReference Include="ZXing.Net" Version="0.16.9" />
    <!-- MLRest.dll očekává Newtonsoft.Json 7.0.0.0 — bez této reference CLR knihovnu neresolvne. -->
    <PackageReference Include="Newtonsoft.Json" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="EDISONAPI">
        <HintPath>C:\Edison\EDISONAPI.dll</HintPath>
    </Reference>
    <Reference Include="MLRest">
        <HintPath>C:\Edison\MLRest.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EDControls\dotnet\EDControls.csproj" />
  </ItemGroup>


  <!-- Kopírovat schema soubory a konfiguraci do výstupní složky -->
  <ItemGroup>
    <Content Include="schemas\*.schema.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Vlastní název kvůli sdílené složce C:\Edison\ — generický appsettings.json
         tam patří jiným Edison aplikacím (např. EdisonCacheMcp) a docházelo by ke konfliktu. -->
    <!-- Hlavní config je embedded resource → .exe je self-contained, žádný sidecar soubor není potřeba.
         Externí soubor vedle .exe (pokud existuje) má přednost před embedded. -->
    <EmbeddedResource Include="templatedesigner.appsettings.json" LogicalName="templatedesigner.appsettings.json" />

    <!-- Lokální override (gitignored) — kopírujeme jen do bin/, ne do publish (každý si ho dropne sám). -->
    <Content Include="templatedesigner.appsettings.local.json" Condition="Exists('templatedesigner.appsettings.local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>

    <!-- Embedded fonty: stačí hodit .ttf/.otf do složky Fonts/ — glob je zabalí do assembly
         (a single-file .exe), FontResolver je auto-načte podle názvu rodiny (bez úpravy kódu).
         POZOR na licenci: jen fonty s právem redistribuce (OFL/Apache — Arimo, Liberation Sans),
         NE komerční (Helvetica/Arial). -->
    <EmbeddedResource Include="Fonts\**\*.ttf" />
    <EmbeddedResource Include="Fonts\**\*.otf" />

    <!-- Systémové (M-line) výchozí šablony: JSON ze složky SystemTemplates/ se zabalí do .exe;
         SystemTemplateSeeder je při startu nalije do MLINE větve DB (governance v1 distribuce). -->
    <EmbeddedResource Include="SystemTemplates\**\*.json" />
  </ItemGroup>

</Project>