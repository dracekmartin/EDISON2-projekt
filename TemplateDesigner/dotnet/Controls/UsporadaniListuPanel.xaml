<UserControl x:Class="TemplateDesigner.Controls.UsporadaniListuPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TemplateDesigner">
    <!-- Uspořádání na list: uživatel volí jen papír a co se na něj skládá, počet míst se spočítá
         z velikosti stránky. Nákres jen ukazuje, co kam padne. List je bílý záměrně mimo theme -
         kreslí papír, ne plochu aplikace. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate x:Key="MistoTemplate" DataType="{x:Type local:MistoListuVM}">
            <Border Margin="1" CornerRadius="2" BorderThickness="1"
                    Width="{Binding DataContext.MistoSirkaPx, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Height="{Binding DataContext.MistoVyskaPx, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Background="{DynamicResource EDTheme.Accent.BlueBg}"
                    BorderBrush="{DynamicResource EDTheme.Accent.BlueBorder}">
                <TextBlock Text="{Binding Popis}" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="2"
                           Foreground="{DynamicResource EDTheme.Text.Primary}"
                           FontSize="{DynamicResource EDTheme.FontSize.Caption}"/>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="MrizkaMist">
            <UniformGrid Rows="{Binding DataContext.Radku, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Columns="{Binding DataContext.Sloupcu, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
        <TextBlock Text="Uspořádání na list" FontWeight="SemiBold" Margin="0,0,0,2"
                   FontSize="{DynamicResource EDTheme.FontSize.Header}"/>
        <!-- Kdy to chtít, jednou větou - bez ní uživatel zkouší nastavovat i to, co nepotřebuje. -->
        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource EDTheme.Text.Secondary}"
                   Text="Jen když chcete na jeden papír víc stránek a list pak rozříznout, např. dva doklady A5 na A4. Jinak nechte Vypnuto."/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Papír:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding Formaty}" DisplayMemberPath="Popis" SelectedItem="{Binding VybranyFormat}"
                      Width="300"
                      ToolTip="Kolik stránek se na papír vejde, se spočítá z velikosti stránky šablony (bez zmenšování)."/>
        </StackPanel>

        <StackPanel Visibility="{Binding JeZapnuto, Converter={StaticResource BoolToVis}}">
            <!-- Doklad o víc stránkách: jediná otázka je, kam jde druhá stránka. „Oboustranně" jako
                 název volby mátlo - oboustranně jde tisknout i stránky vedle sebe (nález Jan 28. 9.). -->
            <StackPanel Visibility="{Binding NabiziOboustranne, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Druhá stránka dokladu:" Margin="0,0,0,4"/>
                <RadioButton GroupName="RezimListu" Content="Na stejnou stranu listu, vedle první" IsChecked="{Binding ZaSebou}" Margin="0,0,0,4"/>
                <RadioButton GroupName="RezimListu" Content="Na zadní stranu listu, za první" IsChecked="{Binding Oboustranne}" Margin="0,0,0,4"/>
            </StackPanel>

            <!-- Kopie jen pro toho, kdo ji má uloženou z dřívějška. -->
            <StackPanel Visibility="{Binding NabiziKopie, Converter={StaticResource BoolToVis}}">
                <RadioButton GroupName="RezimListu" Content="Stránky po řadě" IsChecked="{Binding ZaSebou}" Margin="0,0,0,4"
                             Visibility="{Binding JednaStranka, Converter={StaticResource BoolToVis}}"/>
                <RadioButton GroupName="RezimListu" Content="Kopie přes celý list" IsChecked="{Binding Kopie}" Margin="0,0,0,4"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                        Visibility="{Binding MaNakres, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Přední strana listu" Foreground="{DynamicResource EDTheme.Text.Secondary}"
                               FontSize="{DynamicResource EDTheme.FontSize.Caption}" Margin="0,0,0,4"/>
                    <Border Width="{Binding ListSirkaPx}" Height="{Binding ListVyskaPx}" Background="White"
                            BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="1">
                        <ItemsControl ItemsSource="{Binding PredniMista}" ItemTemplate="{StaticResource MistoTemplate}"
                                      ItemsPanel="{StaticResource MrizkaMist}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <StackPanel Visibility="{Binding Oboustranne, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Zadní strana listu" Foreground="{DynamicResource EDTheme.Text.Secondary}"
                               FontSize="{DynamicResource EDTheme.FontSize.Caption}" Margin="0,0,0,4"/>
                    <Border Width="{Binding ListSirkaPx}" Height="{Binding ListVyskaPx}" Background="White"
                            BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="1">
                        <ItemsControl ItemsSource="{Binding ZadniMista}" ItemTemplate="{StaticResource MistoTemplate}"
                                      ItemsPanel="{StaticResource MrizkaMist}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding NabiziOrezoveZnacky, Converter={StaticResource BoolToVis}}">
                <CheckBox Content="Ořezové značky" IsChecked="{Binding OrezoveZnacky}" Margin="0,10,0,0"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
