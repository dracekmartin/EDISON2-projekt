<UserControl x:Class="TemplateDesigner.Controls.FormatToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="RootBorder" Background="#F8F8F8"
            BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
            Padding="4,3">
        <StackPanel Orientation="Horizontal">

            <!-- ── Tučné / Kurzíva / Podtržení / Přeškrtnuté ── -->
            <ToggleButton x:Name="BtnBold" Style="{StaticResource ToolbarToggle}"
                          ToolTip="Tučné" MinWidth="24" MinHeight="24"
                          Click="BtnBold_Click">
                <TextBlock Text="B" FontWeight="Bold" FontSize="12"/>
            </ToggleButton>
            <ToggleButton x:Name="BtnItalic" Style="{StaticResource ToolbarToggle}"
                          ToolTip="Kurzíva" MinWidth="24" MinHeight="24"
                          Click="BtnItalic_Click">
                <TextBlock Text="I" FontStyle="Italic" FontSize="12"/>
            </ToggleButton>
            <ToggleButton x:Name="BtnUnderline" Style="{StaticResource ToolbarToggle}"
                          ToolTip="Podtržení" MinWidth="24" MinHeight="24"
                          Click="BtnUnderline_Click">
                <TextBlock Text="U" FontSize="12" TextDecorations="Underline"/>
            </ToggleButton>
            <ToggleButton x:Name="BtnStrikethrough" Style="{StaticResource ToolbarToggle}"
                          ToolTip="Přeškrtnuté" MinWidth="24" MinHeight="24"
                          Click="BtnStrikethrough_Click">
                <TextBlock Text="S" FontSize="12">
                    <TextBlock.TextDecorations>
                        <TextDecoration Location="Strikethrough"/>
                    </TextBlock.TextDecorations>
                </TextBlock>
            </ToggleButton>

            <Rectangle Width="1" Height="16" Fill="#CCCCCC" Margin="3,0" VerticalAlignment="Center"/>

            <!-- ── Vodorovné zarovnání ── -->
            <ToggleButton x:Name="BtnAlignLeft" Style="{StaticResource ToolbarToggle}"
                          ToolTip="Vlevo" MinWidth="24" MinHeight="24"
                          Click="BtnAlignLeft_Click">
                <TextBlock Text="L" FontSize="11" FontFamily="Consolas"/>
            </ToggleButton>
            <ToggleButton x:Name="BtnAlignCenter" Style="{StaticResource ToolbarToggle}"
                          ToolTip="Na střed" MinWidth="24" MinHeight="24"
                          Click="BtnAlignCenter_Click">
                <TextBlock Text="C" FontSize="11" FontFamily="Consolas"/>
            </ToggleButton>
            <ToggleButton x:Name="BtnAlignRight" Style="{StaticResource ToolbarToggle}"
                          ToolTip="Vpravo" MinWidth="24" MinHeight="24"
                          Click="BtnAlignRight_Click">
                <TextBlock Text="R" FontSize="11" FontFamily="Consolas"/>
            </ToggleButton>
            <ToggleButton x:Name="BtnAlignJustify" Style="{StaticResource ToolbarToggle}"
                          ToolTip="Do bloku" MinWidth="24" MinHeight="24"
                          Click="BtnAlignJustify_Click">
                <TextBlock Text="J" FontSize="11" FontFamily="Consolas"/>
            </ToggleButton>

            <Rectangle Width="1" Height="16" Fill="#CCCCCC" Margin="3,0" VerticalAlignment="Center"/>

            <!-- ── Svislé zarovnání ── -->
            <ToggleButton x:Name="BtnVAlignTop" Style="{StaticResource ToolbarToggle}"
                          ToolTip="Nahoře" MinWidth="24" MinHeight="24"
                          Click="BtnVAlignTop_Click">
                <TextBlock Text="▲" FontSize="10"/>
            </ToggleButton>
            <ToggleButton x:Name="BtnVAlignMiddle" Style="{StaticResource ToolbarToggle}"
                          ToolTip="Na střed (svisle)" MinWidth="24" MinHeight="24"
                          Click="BtnVAlignMiddle_Click">
                <TextBlock Text="▬" FontSize="10"/>
            </ToggleButton>
            <ToggleButton x:Name="BtnVAlignBottom" Style="{StaticResource ToolbarToggle}"
                          ToolTip="Dole" MinWidth="24" MinHeight="24"
                          Click="BtnVAlignBottom_Click">
                <TextBlock Text="▼" FontSize="10"/>
            </ToggleButton>

        </StackPanel>
    </Border>
</UserControl>
