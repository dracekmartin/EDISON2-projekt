<UserControl x:Class="TemplateDesigner.Controls.CellStyleEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TemplateDesigner.Controls"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:NullOrEmptyToVisibleConverter x:Key="NullToVis"/>
        <local:NotNullToVisibleConverter x:Key="NotNullToVis"/>
        <local:FirstNonEmptyHexToBrushConverter x:Key="FirstColorToBrush"/>
        <local:HAlignToLabelConverter x:Key="HAlignToLabel"/>
        <local:VAlignToLabelConverter x:Key="VAlignToLabel"/>

        <!-- Malé „×" tlačítko pro reset pole na „dědit". CommandParameter = název property. -->
        <Style x:Key="ResetButton" TargetType="Button">
            <Setter Property="Content" Value="×"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="{DynamicResource EDTheme.FontSize.Caption}"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="Vrátit hodnotu z nadřazeného stylu"/>
            <Setter Property="Command" Value="{Binding ResetFieldCommand}"/>
        </Style>

        <!-- Šedivý italic placeholder zobrazující zděděnou hodnotu když pole není explicitně nastavené. -->
        <Style x:Key="InheritedPlaceholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Muted}"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>

        <!-- Popisek v levém sdíleném sloupci (styl EDInputFormu): pravý okraj, jednotná šířka. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <!-- Jednotka za polem, jako ve formuláři prvku -->
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Muted}"/>
        </Style>
    </UserControl.Resources>

    <!-- Dvousloupcová mřížka: popisky ve sdíleném levém sloupci (SharedSizeGroup), prvky pod sebou.
         Každý řádek = samostatný Grid s vlastní Visibility → skrytá volba nezabere výšku a nic se
         vodorovně nezalamuje (dřív WrapPanel praskal v úzkém dialogu). -->
    <StackPanel Grid.IsSharedSizeScope="True">
        <StackPanel.Resources>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,3"/>
            </Style>
        </StackPanel.Resources>

        <!-- Pořadí a popisky = sada stylu formuláře prvku (StyleFields.cls), hlídá EditorStyluSloupceTests -->
        <Grid Visibility="{Binding EditOptions.AllowFontFamily, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Font" Style="{StaticResource FieldLabel}"/>
            <Grid Grid.Column="1" Width="130" HorizontalAlignment="Left">
                <ComboBox x:Name="FontFamilyBox"
                          IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                          ItemsSource="{Binding FontFamilyOptions, ElementName=Root}"
                          ToolTip="Prázdné = převezme se z nadřazeného stylu; vyberte nebo napište font"
                          Text="{Binding FontFamily, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
                <TextBlock Style="{StaticResource InheritedPlaceholder}"
                           Text="{Binding Inherited.FontFamily}"
                           IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=FontFamilyBox, Converter={StaticResource NullToVis}}"/>
            </Grid>
        </Grid>

        <!-- Řez (váha) - nabídka reálných řezů vybrané rodiny; Automaticky = null -->
        <Grid Visibility="{Binding EditOptions.AllowFontFamily, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Řez" Style="{StaticResource FieldLabel}"/>
            <ComboBox Grid.Column="1" x:Name="FontWeightBox" Width="130" HorizontalAlignment="Left"
                      ItemsSource="{Binding WeightOptions}"
                      DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding FontWeight, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="Řez (váha) písma - nabídka dle reálných řezů vybraného fontu"/>
        </Grid>

        <Grid Visibility="{Binding EditOptions.AllowFontSize, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Velikost" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Grid Width="70">
                    <ComboBox x:Name="FontSizeBox"
                              IsEditable="True"
                              ToolTip="Prázdné = převezme se z nadřazeného stylu. Rozsah 3 až 72 pt."
                              ItemsSource="{Binding FontSizeOptions, ElementName=Root}"
                              Text="{Binding FontSize, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
                    <TextBlock Style="{StaticResource InheritedPlaceholder}"
                               Text="{Binding Inherited.FontSize}"
                               Visibility="{Binding Text, ElementName=FontSizeBox, Converter={StaticResource NullToVis}}"/>
                </Grid>
                <TextBlock Text="pt" Style="{StaticResource Unit}"/>
            </StackPanel>
        </Grid>

        <!-- Zaškrtávátka ukazují efektivní hodnotu, × jen při přepsání -->
        <Grid Visibility="{Binding EditOptions.AllowBold, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Tučné" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <CheckBox VerticalAlignment="Center"
                          IsChecked="{Binding EffectiveBold, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Kliknutím nastavíte explicitně. Pokud není přepsáno, dědí se."/>
                <Button Style="{StaticResource ResetButton}" CommandParameter="Bold"
                        Visibility="{Binding HasExplicitBold, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>

        <Grid Visibility="{Binding EditOptions.AllowItalic, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Kurzíva" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <CheckBox VerticalAlignment="Center"
                          IsChecked="{Binding EffectiveItalic, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Style="{StaticResource ResetButton}" CommandParameter="Italic"
                        Visibility="{Binding HasExplicitItalic, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>

        <Grid Visibility="{Binding EditOptions.AllowUnderline, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Podtržení" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <CheckBox VerticalAlignment="Center"
                          IsChecked="{Binding EffectiveUnderline, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Style="{StaticResource ResetButton}" CommandParameter="Underline"
                        Visibility="{Binding HasExplicitUnderline, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>

        <Grid Visibility="{Binding EditOptions.AllowStrikethrough, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Přeškrtnutí" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <CheckBox VerticalAlignment="Center"
                          IsChecked="{Binding EffectiveStrikethrough, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Style="{StaticResource ResetButton}" CommandParameter="Strikethrough"
                        Visibility="{Binding HasExplicitStrikethrough, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>

        <!-- Vzorek = efektivní barva; textový zápis umí i barvu z dat ({BARVA_LINKY}), kterou výběr barvy nenabídne -->
        <Grid Visibility="{Binding EditOptions.AllowTextColor, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Barva textu" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="28" Height="22" Padding="0" Margin="0,0,2,0"
                        Command="{Binding PickTextColorCommand}"
                        ToolTip="Vybrat barvu textu">
                    <Border BorderBrush="{DynamicResource EDTheme.Border.Strong}" BorderThickness="1" Width="20" Height="14">
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource FirstColorToBrush}">
                                <Binding Path="TextColor"/>
                                <Binding Path="Inherited.TextColor"/>
                            </MultiBinding>
                        </Border.Background>
                    </Border>
                </Button>
                <Grid Width="110" Margin="0,0,2,0">
                    <TextBox x:Name="TextColorBox"
                             Text="{Binding TextColor, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                             ToolTip="#RRGGBB, #AARRGGBB, nebo {BARVA_LINKY} / {BARVA_LINKY_2} pro barvu z jízdního řádu. Prázdné = dědit."/>
                    <TextBlock Style="{StaticResource InheritedPlaceholder}"
                               Text="{Binding Inherited.TextColor}"
                               Visibility="{Binding Text, ElementName=TextColorBox, Converter={StaticResource NullToVis}}"/>
                </Grid>
                <Button Style="{StaticResource ResetButton}"
                        Command="{Binding ClearTextColorCommand}"
                        Visibility="{Binding TextColor, Converter={StaticResource NotNullToVis}}"/>
            </StackPanel>
        </Grid>

        <Grid Visibility="{Binding EditOptions.AllowBackgroundColor, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Barva pozadí" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="28" Height="22" Padding="0" Margin="0,0,2,0"
                        Command="{Binding PickBgColorCommand}"
                        ToolTip="Vybrat barvu pozadí">
                    <Border BorderBrush="{DynamicResource EDTheme.Border.Strong}" BorderThickness="1" Width="20" Height="14">
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource FirstColorToBrush}">
                                <Binding Path="BgColor"/>
                                <Binding Path="Inherited.BackgroundColor"/>
                            </MultiBinding>
                        </Border.Background>
                    </Border>
                </Button>
                <Grid Width="110" Margin="0,0,2,0">
                    <TextBox x:Name="BgColorBox"
                             Text="{Binding BgColor, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                             ToolTip="#RRGGBB, #AARRGGBB, nebo {BARVA_LINKY} / {BARVA_LINKY_2} pro barvu z jízdního řádu. Prázdné = dědit."/>
                    <TextBlock Style="{StaticResource InheritedPlaceholder}"
                               Text="{Binding Inherited.BackgroundColor}"
                               Visibility="{Binding Text, ElementName=BgColorBox, Converter={StaticResource NullToVis}}"/>
                </Grid>
                <Button Style="{StaticResource ResetButton}"
                        Command="{Binding ClearBgColorCommand}"
                        Visibility="{Binding BgColor, Converter={StaticResource NotNullToVis}}"/>
            </StackPanel>
        </Grid>

        <Grid Visibility="{Binding EditOptions.AllowHAlign, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Zarovnání vodorovně" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Grid Width="120">
                    <ComboBox x:Name="HAlignBox"
                              ItemsSource="{Binding HAlignOptions, ElementName=Root}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding HAlign}"/>
                    <TextBlock Style="{StaticResource InheritedPlaceholder}"
                               Text="{Binding Inherited.HAlign, Converter={StaticResource HAlignToLabel}, ConverterParameter=cs}"
                               Visibility="{Binding HAlign, Converter={StaticResource NullToVis}}"/>
                </Grid>
                <Button Style="{StaticResource ResetButton}" CommandParameter="HAlign"
                        Visibility="{Binding HasExplicitHAlign, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>

        <Grid Visibility="{Binding EditOptions.AllowVAlign, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Zarovnání svisle" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Grid Width="120">
                    <ComboBox x:Name="VAlignBox"
                              ItemsSource="{Binding VAlignOptions, ElementName=Root}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding VAlign}"/>
                    <TextBlock Style="{StaticResource InheritedPlaceholder}"
                               Text="{Binding Inherited.VAlign, Converter={StaticResource VAlignToLabel}, ConverterParameter=cs}"
                               Visibility="{Binding VAlign, Converter={StaticResource NullToVis}}"/>
                </Grid>
                <Button Style="{StaticResource ResetButton}" CommandParameter="VAlign"
                        Visibility="{Binding HasExplicitVAlign, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>

        <Grid Visibility="{Binding EditOptions.AllowPadding, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Vnitřní okraj nahoře" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Grid Width="70">
                    <TextBox x:Name="PaddingTopBox" ToolTip="Prázdné = převezme se z nadřazeného stylu. Rozsah 0 až 20 mm."
                             Text="{Binding PaddingTop, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
                    <TextBlock Style="{StaticResource InheritedPlaceholder}"
                               Text="{Binding Inherited.PaddingTop}"
                               Visibility="{Binding Text, ElementName=PaddingTopBox, Converter={StaticResource NullToVis}}"/>
                </Grid>
                <TextBlock Text="mm" Style="{StaticResource Unit}"/>
            </StackPanel>
        </Grid>

        <Grid Visibility="{Binding EditOptions.AllowPadding, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Vnitřní okraj vpravo" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Grid Width="70">
                    <TextBox x:Name="PaddingRightBox" ToolTip="Prázdné = převezme se z nadřazeného stylu. Rozsah 0 až 20 mm."
                             Text="{Binding PaddingRight, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
                    <TextBlock Style="{StaticResource InheritedPlaceholder}"
                               Text="{Binding Inherited.PaddingRight}"
                               Visibility="{Binding Text, ElementName=PaddingRightBox, Converter={StaticResource NullToVis}}"/>
                </Grid>
                <TextBlock Text="mm" Style="{StaticResource Unit}"/>
            </StackPanel>
        </Grid>

        <Grid Visibility="{Binding EditOptions.AllowPadding, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Vnitřní okraj dole" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Grid Width="70">
                    <TextBox x:Name="PaddingBottomBox" ToolTip="Prázdné = převezme se z nadřazeného stylu. Rozsah 0 až 20 mm."
                             Text="{Binding PaddingBottom, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
                    <TextBlock Style="{StaticResource InheritedPlaceholder}"
                               Text="{Binding Inherited.PaddingBottom}"
                               Visibility="{Binding Text, ElementName=PaddingBottomBox, Converter={StaticResource NullToVis}}"/>
                </Grid>
                <TextBlock Text="mm" Style="{StaticResource Unit}"/>
            </StackPanel>
        </Grid>

        <Grid Visibility="{Binding EditOptions.AllowPadding, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Vnitřní okraj vlevo" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Grid Width="70">
                    <TextBox x:Name="PaddingLeftBox" ToolTip="Prázdné = převezme se z nadřazeného stylu. Rozsah 0 až 20 mm."
                             Text="{Binding PaddingLeft, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
                    <TextBlock Style="{StaticResource InheritedPlaceholder}"
                               Text="{Binding Inherited.PaddingLeft}"
                               Visibility="{Binding Text, ElementName=PaddingLeftBox, Converter={StaticResource NullToVis}}"/>
                </Grid>
                <TextBlock Text="mm" Style="{StaticResource Unit}"/>
            </StackPanel>
        </Grid>

        <!-- LineSpacing není editovatelný pro cell-based elementy: CellRenderer je single-line.
             Výška řádku tabulkových elementů = samostatná property „Výška řádku" v properties panelu. -->

    </StackPanel>
</UserControl>
