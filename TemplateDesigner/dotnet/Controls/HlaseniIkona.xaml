<UserControl x:Class="TemplateDesigner.Controls.HlaseniIkona"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="14" Height="14" x:Name="Root">
    <!-- Ikona závažnosti hlášky (B178): chyba = červené kolečko s vykřičníkem, upozornění = oranžový
         trojúhelník s vykřičníkem, informace = šedé kolečko s „i". Kreslená tvary, ne obrázkem -
         obě témata ji tak dostanou z barevných tokenů. White/Black záměrně mimo theme: znak na
         Danger / Warning / Text.Secondary podkladu drží kontrast v obou tématech. -->
    <Grid>
        <Grid x:Name="Chyba" Visibility="Collapsed">
            <Ellipse Fill="{DynamicResource EDTheme.Semantic.Danger}"/>
            <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="10"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
        </Grid>
        <Grid x:Name="Upozorneni" Visibility="Collapsed">
            <Path Data="M 7,0.5 L 13.5,13 L 0.5,13 Z" Fill="{DynamicResource EDTheme.Semantic.Warning}" Stretch="Fill"/>
            <TextBlock Text="!" Foreground="Black" FontWeight="Bold" FontSize="9"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0"/>
        </Grid>
        <Grid x:Name="Informace" Visibility="Collapsed">
            <Ellipse Fill="{DynamicResource EDTheme.Text.Secondary}"/>
            <TextBlock Text="i" Foreground="White" FontWeight="Bold" FontSize="10" FontStyle="Italic"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
        </Grid>
    </Grid>
</UserControl>
