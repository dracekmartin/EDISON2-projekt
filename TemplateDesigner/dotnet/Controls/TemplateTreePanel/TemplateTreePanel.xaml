<UserControl x:Class="TemplateDesigner.Controls.TemplateTreePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                Background="#F0F0F0" Padding="8,5">
            <TextBlock Text="Strom šablony — klik = výběr, dvojklik = vlastnosti"
                       FontSize="10" Foreground="#555555"/>
        </Border>
        <TreeView x:Name="Tree"
                  BorderThickness="0"
                  Background="Transparent"
                  Focusable="True"
                  SelectedItemChanged="Tree_SelectedItemChanged"
                  MouseDoubleClick="Tree_MouseDoubleClick"
                  PreviewKeyDown="Tree_PreviewKeyDown"
                  FontSize="11">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True"/>
                    <Setter Property="Focusable" Value="True"/>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
    </DockPanel>
</UserControl>
