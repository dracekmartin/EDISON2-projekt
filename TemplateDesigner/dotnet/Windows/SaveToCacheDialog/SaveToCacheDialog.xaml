<Window x:Class="TemplateDesigner.SaveToCacheDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:eif="clr-namespace:EDControls.EDInputForm;assembly=EDControls"
        Title="Uložit do databáze"
        Width="700" Height="320"
        MinWidth="620" MinHeight="240"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <!-- Buttons -->
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" x:Name="BtnSave" Content="{StaticResource EDStrings.Save}" IsDefault="True"
                    Click="SaveButton_Click" IsEnabled="False"
                    Width="80" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Content="{StaticResource EDStrings.Cancel}" IsCancel="True" Width="80"/>
        </Grid>

        <!-- Form (definice z Caché) -->
        <eif:EDInputForm x:Name="TheForm"
                         CacheClass="ALVA.TemplateDesigner.EDInputForm.SaveTemplate"/>
    </DockPanel>
</Window>
