<!--
    HelpDialog.xaml - Nápověda: zkratky, workflow, tipy + fulltext hledání (Ctrl+F).

    OBSAH NEPATŘÍ SEM - je datově řízený v HelpDialogViewModel.BuildContent().
    Při přidání zkratky/featury aktualizovat tam (a ux-conventions.md tabulku).
-->
<Window x:Class="TemplateDesigner.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TemplateDesigner"
        Title="Nápověda - Ovládání a klávesové zkratky"
        Height="640" Width="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="CategoryHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource EDTheme.FontSize.Large}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource EDTheme.Accent.BlueDark}"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <Style x:Key="ActionText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Primary}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ShortcutText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource EDTheme.Accent.Blue}"/>
            <Setter Property="Margin" Value="16,2,0,2"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="TipText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Muted}"/>
            <Setter Property="Margin" Value="16,4,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>

        <!-- Jedna kategorie: nadpis + řádky + tip -->
        <DataTemplate DataType="{x:Type local:HelpSection}">
            <StackPanel Grid.IsSharedSizeScope="True">
                <TextBlock Text="{Binding Title}" Style="{StaticResource CategoryHeader}"/>
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:HelpEntry}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="150" SharedSizeGroup="Shortcut"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Action}" Style="{StaticResource ActionText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Shortcut}" Style="{StaticResource ShortcutText}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Tip}" Style="{StaticResource TipText}">
                    <TextBlock.Visibility>
                        <Binding Path="HasTip">
                            <Binding.Converter>
                                <BooleanToVisibilityConverter/>
                            </Binding.Converter>
                        </Binding>
                    </TextBlock.Visibility>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Header + hledání -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource EDTheme.Bg.InfoBanner}" Padding="16,12"
                BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Nápověda - ovládání Návrháře sestav"
                               FontSize="{DynamicResource EDTheme.FontSize.Large}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource EDTheme.Accent.BlueDark}"/>
                    <TextBlock Text="Klávesové zkratky, základní postupy a tipy"
                               FontSize="{DynamicResource EDTheme.FontSize.Body}"
                               Foreground="{DynamicResource EDTheme.Text.Muted}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center" Width="220">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" VerticalContentAlignment="Center"
                             KeyDown="SearchBox_KeyDown"/>
                    <TextBlock Text="Hledat…  (Ctrl+F)"
                               Margin="9,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource EDTheme.Text.Muted}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource EDTheme.Bg.Footer}" Padding="12"
                BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,1,0,0">
            <Button Content="{StaticResource EDStrings.Close}"
                    IsDefault="True"
                    IsCancel="True"
                    Padding="20,6"
                    HorizontalAlignment="Right"/>
        </Border>

        <!-- Obsah -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,12">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding FilteredSections}"/>

                <TextBlock Text="Nic nenalezeno - zkuste jiný výraz."
                           Margin="0,24,0,0" FontStyle="Italic"
                           Foreground="{DynamicResource EDTheme.Text.Muted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NothingFound}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
