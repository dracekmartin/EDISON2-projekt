<Window x:Class="TemplateDesigner.TableEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TemplateDesigner.Controls"
        Title="Editor tabulky"
        Width="760" Height="620"
        MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- BasedOn: bez něj implicitní styl přebije EDControls flat theme (default WPF 3D vzhled) -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="TabControl">

            <!-- ── Obecné (výchozí styl pro celou tabulku) ──────────── -->
            <TabItem Header="Obecné">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <TextBlock Text="Výchozí styl pro všechny sloupce. V tabu Styl sloupců můžete nastavení jednotlivých sloupců přepsat."
                                   FontStyle="Italic" Foreground="{DynamicResource EDTheme.Text.Muted}" FontSize="{DynamicResource EDTheme.FontSize.Body}" Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Styl záhlaví" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <controls:CellStyleEditor
                            DataContext="{Binding ElementHeaderStyle}"
                            EditOptions="{Binding DataContext.HeaderEditOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                            PickTextColorCommand="{Binding DataContext.PickElementHeaderTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ClearTextColorCommand="{Binding DataContext.ClearElementHeaderTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            PickBgColorCommand="{Binding DataContext.PickElementHeaderBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ClearBgColorCommand="{Binding DataContext.ClearElementHeaderBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>

                        <Separator Margin="0,8,0,8"/>

                        <TextBlock Text="Styl datových buněk" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <controls:CellStyleEditor
                            DataContext="{Binding ElementDataStyle}"
                            EditOptions="{Binding DataContext.DataEditOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                            PickTextColorCommand="{Binding DataContext.PickElementDataTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ClearTextColorCommand="{Binding DataContext.ClearElementDataTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            PickBgColorCommand="{Binding DataContext.PickElementDataBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ClearBgColorCommand="{Binding DataContext.ClearElementDataBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>

                        <Button Content="Resetovat výchozí styl" Command="{Binding ResetElementStyleCommand}"
                                HorizontalAlignment="Left" Padding="10,3" Margin="0,12,0,12"/>

                        <TextBlock Text="Ostatní nastavení elementu (režim, rámeček, zebra, ...) najdete v panelu Vlastnosti po zavření dialogu."
                                   FontStyle="Italic" Foreground="{DynamicResource EDTheme.Text.Muted}" FontSize="{DynamicResource EDTheme.FontSize.Body}" Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Sloupce ─────────────────────────────────────────── -->
            <TabItem Header="Sloupce">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="ColumnsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource EDTheme.Border.Medium}"
                              ItemsSource="{Binding ColumnVMs}"
                              SelectedItem="{Binding SelectedColumnVM, Mode=TwoWay}"
                              PreviewKeyDown="Grid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn   Header="Záhlaví"   Binding="{Binding Header,  UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                            <DataGridTemplateColumn Header="Pole" Width="120" SortMemberPath="Field">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Pole" ToolTip="Název pole ze schématu (bez závorek {}). Červeně = pole nenalezeno ve schématu."/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Field}" Padding="2,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFieldValid}" Value="False">
                                                            <Setter Property="Foreground" Value="OrangeRed"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="ToolTip" Value="Pole nenalezeno ve schématu agendy."/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  StaysOpenOnEdit="True"
                                                  Text="{Binding Field, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.FieldNameOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  BorderThickness="0"
                                                  FontSize="{DynamicResource EDTheme.FontSize.Body}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn   Header="Šířka"     Binding="{Binding Width,   UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridComboBoxColumn Header="Šířka v"
                                                   SelectedItemBinding="{Binding WidthMode, UpdateSourceTrigger=PropertyChanged}"
                                                   Width="70">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.WidthModeOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.WidthModeOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridComboBoxColumn Header="Zarovnání"
                                                   SelectedItemBinding="{Binding AlignmentLabel, UpdateSourceTrigger=PropertyChanged}"
                                                   Width="90">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.AlignmentOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.AlignmentOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn   Header="Formát"    Binding="{Binding Format,  UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridCheckBoxColumn Header="Viditelný" Binding="{Binding Visible, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ Přidat"  Command="{Binding AddColumnCommand}"/>
                            <Button Content="↑" Width="28" Command="{Binding MoveColumnUpCommand}"/>
                            <Button Content="↓" Width="28" Command="{Binding MoveColumnDownCommand}"/>
                            <Button Content="Odebrat"   Command="{Binding RemoveColumnCommand}"/>
                            <Button Content="Ze šablony..." Command="{Binding LoadTemplateCommand}"
                                    Margin="16,0,0,0"
                                    Visibility="{Binding ShowLoadTemplate, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource EDTheme.FontSize.Body}" Foreground="{DynamicResource EDTheme.Text.Muted}"
                                   Text="Pole: název ze schématu bez závorek (nebo s závorkami — {ZASTAVKA} i ZASTAVKA je přijato)."/>

                        <!-- Warning při přesahu šířky -->
                        <TextBlock Text="{Binding ColumnOverflowText}"
                                   Foreground="{DynamicResource EDTheme.Semantic.Danger}" FontSize="{DynamicResource EDTheme.FontSize.Body}" Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasColumnOverflow, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Přizpůsobit sloupce k šířce elementu"
                                Command="{Binding FitColumnsToWidthCommand}"
                                ToolTip="Proporcionálně zmenší/zvětší šířky všech sloupců, aby součet odpovídal šířce elementu."
                                HorizontalAlignment="Left" Padding="6,3" Margin="0,4,0,0"
                                Visibility="{Binding HasColumnOverflow, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ── Řádky (Fixed mód) ───────────────────────────────── -->
            <TabItem Header="Řádky"
                     Visibility="{Binding ShowRowsTab, Converter={StaticResource BoolToVis}}">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Seznam řádků -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox x:Name="RowsList"
                                 ItemsSource="{Binding RowVMs}"
                                 SelectedItem="{Binding SelectedRowVM, Mode=TwoWay}"
                                 BorderThickness="1" BorderBrush="{DynamicResource EDTheme.Border.Medium}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RowSummary}" Margin="4,2"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,6,0">
                            <Button Content="+" Width="28" Command="{Binding AddRowCommand}"/>
                            <Button Content="↑" Width="28" Command="{Binding MoveRowUpCommand}"/>
                            <Button Content="↓" Width="28" Command="{Binding MoveRowDownCommand}"/>
                            <Button Content="✕" Width="28" Command="{Binding RemoveRowCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Editor buněk vybraného řádku -->
                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Podmínka viditelnosti řádku -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Viditelnost řádku:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBox FontFamily="Consolas" FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                     IsEnabled="{Binding IsRowSelected}"
                                     Text="{Binding SelectedRowVM.VisibilityExpression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Výraz podmíněné viditelnosti. Prázdné = vždy viditelný."/>
                            <TextBlock Text="Výraz — prázdné = vždy viditelný  |  dostupné: {POLE}, &gt;, &lt;, ==, !=, &amp;&amp;, ||, !"
                                       FontSize="{DynamicResource EDTheme.FontSize.Caption}" Foreground="{DynamicResource EDTheme.Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Buňky vybraného řádku:" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <DataGrid x:Name="CellsGrid"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource EDTheme.Border.Medium}"
                                  ItemsSource="{Binding SelectedRowVM.Cells}"
                                  PreviewKeyDown="Grid_PreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Záhlaví sloupce" Binding="{Binding ColumnHeader}" IsReadOnly="True" Width="130"/>
                                <DataGridTextColumn Header="Obsah"           Binding="{Binding Content, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── Styl sloupců ───────────────────────────────────── -->
            <TabItem Header="Styl sloupců">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" MinWidth="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vlevo: seznam sloupců -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Sloupce:" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding ColumnVMs}"
                                 SelectedItem="{Binding SelectedColumnVM, Mode=TwoWay}"
                                 BorderThickness="1" BorderBrush="{DynamicResource EDTheme.Border.Medium}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <TextBlock Text="{Binding Header}"/>
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource EDTheme.Accent.Blue}" Margin="6,0,0,0"
                                                 VerticalAlignment="Center"
                                                 ToolTip="Má vlastní nastavení stylu (přepisuje výchozí z Obecné)"
                                                 Visibility="{Binding HasAnyOverride, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Vpravo: detail vybraného sloupce -->
                    <ScrollViewer Grid.Column="1" Margin="8,0,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Prázdné pole = dědí výchozí styl elementu."
                                       FontStyle="Italic" Foreground="{DynamicResource EDTheme.Text.Muted}" FontSize="{DynamicResource EDTheme.FontSize.Body}" Margin="0,0,0,8"/>

                            <TextBlock Text="Styl záhlaví" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <controls:CellStyleEditor
                                DataContext="{Binding SelectedColumnVM.HeaderStyle}"
                                EditOptions="{Binding DataContext.HeaderEditOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                PickTextColorCommand="{Binding DataContext.PickHeaderTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ClearTextColorCommand="{Binding DataContext.ClearHeaderTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                PickBgColorCommand="{Binding DataContext.PickHeaderBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ClearBgColorCommand="{Binding DataContext.ClearHeaderBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>

                            <Separator Margin="0,8,0,8"/>

                            <TextBlock Text="Styl datových buněk" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <controls:CellStyleEditor
                                DataContext="{Binding SelectedColumnVM.DataStyle}"
                                EditOptions="{Binding DataContext.DataEditOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                PickTextColorCommand="{Binding DataContext.PickDataTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ClearTextColorCommand="{Binding DataContext.ClearDataTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                PickBgColorCommand="{Binding DataContext.PickDataBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ClearBgColorCommand="{Binding DataContext.ClearDataBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Resetovat styl sloupce"
                                        Command="{Binding ResetStyleCommand}"
                                        Padding="10,3" Margin="0,0,6,0"/>
                                <Button Content="Resetovat všechny sloupce"
                                        Command="{Binding ResetAllColumnStylesCommand}"
                                        ToolTip="Smaže per-sloupec overrides — všechny sloupce budou dědit z tabu Obecné"
                                        Padding="10,3"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ── Souhrn (zápatí s agregacemi) ────────────────────── -->
            <TabItem Header="Souhrn">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Seznam souhrnných řádků -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox x:Name="SummaryList"
                                 ItemsSource="{Binding SummaryVMs}"
                                 SelectedItem="{Binding SelectedSummaryVM, Mode=TwoWay}"
                                 BorderThickness="1" BorderBrush="{DynamicResource EDTheme.Border.Medium}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RowSummary}" Margin="4,2"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,6,0">
                            <Button Content="+" Width="28" Command="{Binding AddSummaryCommand}"/>
                            <Button Content="✕" Width="28" Command="{Binding RemoveSummaryCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Editor buněk vybraného souhrnného řádku -->
                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Buňky souhrnného řádku:" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <DataGrid x:Name="SummaryCellsGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource EDTheme.Border.Medium}"
                                  ItemsSource="{Binding SelectedSummaryVM.Cells}"
                                  PreviewKeyDown="Grid_PreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sloupec" Binding="{Binding ColumnHeader}" IsReadOnly="True" Width="130"/>
                                <DataGridTextColumn Header="Obsah"   Binding="{Binding Content, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Margin="0,4,0,0"
                                   FontSize="{DynamicResource EDTheme.FontSize.Body}" Foreground="{DynamicResource EDTheme.Text.Muted}"
                                   Text="Agregace: SUM({POLE}), COUNT(), AVG({POLE}), MIN({POLE}), MAX({POLE})"/>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Tlačítka OK / Storno -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{StaticResource EDStrings.Ok}"     Width="80" IsDefault="True" Command="{Binding OkCommand}"/>
            <Button Content="{StaticResource EDStrings.Cancel}" Width="80" IsCancel="True"  Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
