<Window x:Class="TemplateDesigner.TableEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor tabulky"
        Width="760" Height="520"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="TabControl">

            <!-- ── Sloupce ─────────────────────────────────────────── -->
            <TabItem Header="Sloupce">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="ColumnsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              BorderThickness="1"
                              BorderBrush="#CCCCCC"
                              ItemsSource="{Binding ColumnVMs}"
                              SelectedItem="{Binding SelectedColumnVM, Mode=TwoWay}"
                              PreviewKeyDown="Grid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn   Header="Záhlaví"   Binding="{Binding Header,  UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                            <DataGridTemplateColumn Header="Pole" Width="120" SortMemberPath="Field">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Pole" ToolTip="Název pole ze schématu (bez závorek {}). Červeně = pole nenalezeno ve schématu."/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Field}" Padding="2,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFieldValid}" Value="False">
                                                            <Setter Property="Foreground" Value="OrangeRed"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="ToolTip" Value="Pole nenalezeno ve schématu agendy."/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  StaysOpenOnEdit="True"
                                                  Text="{Binding Field, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.FieldNameOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  BorderThickness="0"
                                                  FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn   Header="Šířka"     Binding="{Binding Width,   UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridComboBoxColumn Header="Šířka v"
                                                   SelectedItemBinding="{Binding WidthMode, UpdateSourceTrigger=PropertyChanged}"
                                                   Width="70">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.WidthModeOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.WidthModeOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridComboBoxColumn Header="Zarovnání"
                                                   SelectedItemBinding="{Binding AlignmentLabel, UpdateSourceTrigger=PropertyChanged}"
                                                   Width="90">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.AlignmentOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.AlignmentOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn   Header="Formát"    Binding="{Binding Format,  UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridCheckBoxColumn Header="Viditelný" Binding="{Binding Visible, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ Přidat"  Command="{Binding AddColumnCommand}"/>
                            <Button Content="↑" Width="28" Command="{Binding MoveColumnUpCommand}"/>
                            <Button Content="↓" Width="28" Command="{Binding MoveColumnDownCommand}"/>
                            <Button Content="Odebrat"   Command="{Binding RemoveColumnCommand}"/>
                            <Button Content="Ze šablony..." Command="{Binding LoadTemplateCommand}"
                                    Margin="16,0,0,0"
                                    Visibility="{Binding ShowLoadTemplate, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#888888"
                                   Text="Pole: název ze schématu bez závorek (nebo s závorkami — {ZASTAVKA} i ZASTAVKA je přijato)."/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ── Řádky (Fixed mód) ───────────────────────────────── -->
            <TabItem Header="Řádky"
                     Visibility="{Binding ShowRowsTab, Converter={StaticResource BoolToVis}}">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Seznam řádků -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox x:Name="RowsList"
                                 ItemsSource="{Binding RowVMs}"
                                 SelectedItem="{Binding SelectedRowVM, Mode=TwoWay}"
                                 BorderThickness="1" BorderBrush="#CCCCCC">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RowSummary}" Margin="4,2"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,6,0">
                            <Button Content="+" Width="28" Command="{Binding AddRowCommand}"/>
                            <Button Content="↑" Width="28" Command="{Binding MoveRowUpCommand}"/>
                            <Button Content="↓" Width="28" Command="{Binding MoveRowDownCommand}"/>
                            <Button Content="✕" Width="28" Command="{Binding RemoveRowCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Editor buněk vybraného řádku -->
                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Podmínka viditelnosti řádku -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Viditelnost řádku:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBox FontFamily="Consolas" FontSize="12"
                                     IsEnabled="{Binding IsRowSelected}"
                                     Text="{Binding SelectedRowVM.VisibilityExpression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Výraz podmíněné viditelnosti. Prázdné = vždy viditelný."/>
                            <TextBlock Text="Výraz — prázdné = vždy viditelný  |  dostupné: {POLE}, &gt;, &lt;, ==, !=, &amp;&amp;, ||, !"
                                       FontSize="10" Foreground="#888888" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Buňky vybraného řádku:" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <DataGrid x:Name="CellsGrid"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  BorderThickness="1"
                                  BorderBrush="#CCCCCC"
                                  ItemsSource="{Binding SelectedRowVM.Cells}"
                                  PreviewKeyDown="Grid_PreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Záhlaví sloupce" Binding="{Binding ColumnHeader}" IsReadOnly="True" Width="130"/>
                                <DataGridTextColumn Header="Obsah"           Binding="{Binding Content, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Tlačítka OK / Storno -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{StaticResource EDStrings.Ok}"     Width="80" IsDefault="True" Command="{Binding OkCommand}"/>
            <Button Content="{StaticResource EDStrings.Cancel}" Width="80" IsCancel="True"  Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
