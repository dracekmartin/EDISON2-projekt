<Window x:Class="TemplateDesigner.PdfImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import PDF do šablony"
        Height="440" Width="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <DockPanel Margin="16">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource EDTheme.Bg.InfoBanner}" Padding="12" Margin="-16,-16,-16,0"
                BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Import PDF do šablony"
                           FontSize="{DynamicResource EDTheme.FontSize.Large}" FontWeight="Bold" Foreground="{DynamicResource EDTheme.Accent.BlueDark}"/>
                <TextBlock Text="Vyberte PDF soubor a převeďte ho na editovatelnou šablonu."
                           FontSize="{DynamicResource EDTheme.FontSize.Body}" Foreground="{DynamicResource EDTheme.Text.Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource EDTheme.Bg.Footer}" Padding="12" Margin="-16,16,-16,-16"
                BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0" Height="24" Margin="0,0,12,0" IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <Button Grid.Column="1"
                        Content="Importovat"
                        Command="{Binding OkCommand}"
                        IsEnabled="{Binding CanImport}"
                        Padding="16,6" Margin="0,0,8,0"
                        IsDefault="True"/>

                <Button Grid.Column="2"
                        Content="{StaticResource EDStrings.Cancel}"
                        Padding="16,6"
                        IsCancel="True"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <StackPanel Margin="0,16,0,0">
            <!-- Výběr souboru -->
            <TextBlock Text="PDF soubor" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding PdfFilePath, Mode=OneWay}"
                         IsReadOnly="True" Padding="6,4" VerticalContentAlignment="Center"/>

                <Button Grid.Column="1" Content="Procházet..."
                        Command="{Binding BrowsePdfCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        Padding="12,4" Margin="8,0,0,0"/>
            </Grid>

            <!-- Výběr stránek -->
            <StackPanel Margin="0,12,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMultiplePages}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="Stránky" FontWeight="SemiBold" Margin="0,0,0,6"/>

                <!-- JŘ import: právě jedna stránka (jedna vývěska) -->
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScheduleImport}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Jízdní řád se importuje z jedné stránky:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding PageFrom, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="6,0"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    <TextBlock Text="{Binding PageRangeInfo}" VerticalAlignment="Center" Foreground="{DynamicResource EDTheme.Text.Muted}"/>
                </StackPanel>

                <!-- Obecný import: všechny / rozsah -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScheduleImport}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <RadioButton Content="Všechny stránky" IsChecked="{Binding ImportAllPages}" GroupName="Pages"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <RadioButton Content="Stránky od" IsChecked="{Binding ImportPageRange}" GroupName="Pages"
                                     VerticalContentAlignment="Center"/>
                        <TextBox Text="{Binding PageFrom, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="6,0"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 IsEnabled="{Binding ImportPageRange}"/>
                        <TextBlock Text="do" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding PageTo, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="6,0"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 IsEnabled="{Binding ImportPageRange}"/>
                        <TextBlock Text="{Binding PageRangeInfo}" VerticalAlignment="Center" Foreground="{DynamicResource EDTheme.Text.Muted}" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Režim importu — odvozen z aktuální agendy, uživatel nevolí -->
            <TextBlock Text="Režim importu" FontWeight="SemiBold" Margin="0,12,0,6"/>
            <Border Background="{DynamicResource EDTheme.Bg.InfoBanner}"
                    BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="1"
                    CornerRadius="3" Padding="10,8">
                <TextBlock Text="{Binding ImportModeInfo}" TextWrapping="Wrap"/>
            </Border>

            <!-- JŘ import bez dostupné AI je zablokovaný -->
            <TextBlock Text="{Binding ImportBlockedText}"
                       Foreground="Firebrick" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ImportBlocked}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Debug — jen pro vývojáře (lokální dev klíč) -->
            <CheckBox Content="Debug log (uloží .import-debug.txt vedle PDF)"
                      IsChecked="{Binding EnableDebug}"
                      Margin="0,8,0,0" FontSize="{DynamicResource EDTheme.FontSize.Body}" Foreground="{DynamicResource EDTheme.Text.Muted}">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDevMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>

            <!-- Status -->
            <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0"
                       FontSize="{DynamicResource EDTheme.FontSize.Body}"
                       Foreground="{DynamicResource EDTheme.Text.Header}" TextWrapping="Wrap"/>
        </StackPanel>
    </DockPanel>
</Window>
