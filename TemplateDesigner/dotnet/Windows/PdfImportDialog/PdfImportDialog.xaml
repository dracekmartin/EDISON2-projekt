<Window x:Class="TemplateDesigner.PdfImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import PDF do šablony"
        Height="640" Width="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <DockPanel Margin="16">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#F0F4F8" Padding="12" Margin="-16,-16,-16,0"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Import PDF do šablony"
                           FontSize="16" FontWeight="Bold" Foreground="#1A5276"/>
                <TextBlock Text="Vyberte PDF soubor a převeďte ho na editovatelnou šablonu."
                           FontSize="11" Foreground="#666666" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#F8F8F8" Padding="12" Margin="-16,16,-16,-16"
                BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0" Height="24" Margin="0,0,12,0" IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <Button Grid.Column="1"
                        Content="Importovat"
                        Command="{Binding OkCommand}"
                        IsEnabled="{Binding CanImport}"
                        Padding="16,6" Margin="0,0,8,0"
                        IsDefault="True"/>

                <Button Grid.Column="2"
                        Content="{StaticResource EDStrings.Cancel}"
                        Padding="16,6"
                        IsCancel="True"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <StackPanel Margin="0,16,0,0">
            <!-- Výběr souboru -->
            <TextBlock Text="PDF soubor" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding PdfFilePath, Mode=OneWay}"
                         IsReadOnly="True" Padding="6,4" VerticalContentAlignment="Center"/>

                <Button Grid.Column="1" Content="Procházet..."
                        Command="{Binding BrowsePdfCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        Padding="12,4" Margin="8,0,0,0"/>
            </Grid>

            <!-- Výběr stránek -->
            <StackPanel Margin="0,12,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMultiplePages}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="Stránky" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <RadioButton Content="Všechny stránky" IsChecked="{Binding ImportAllPages}" GroupName="Pages"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <RadioButton Content="Stránky od" IsChecked="{Binding ImportPageRange}" GroupName="Pages"
                                 VerticalContentAlignment="Center"/>
                    <TextBox Text="{Binding PageFrom, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="6,0"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             IsEnabled="{Binding ImportPageRange}"/>
                    <TextBlock Text="do" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding PageTo, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="6,0"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             IsEnabled="{Binding ImportPageRange}"/>
                    <TextBlock Text="{Binding PageRangeInfo}" VerticalAlignment="Center" Foreground="#888888" Margin="4,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Typ importu -->
            <TextBlock Text="Typ importu" FontWeight="SemiBold" Margin="0,12,0,6"/>
            <RadioButton Content="Obecný layout (faktury, dokumenty, ...)"
                         IsChecked="{Binding IsImportGeneral}" GroupName="ImportType" Margin="0,0,0,2"/>
            <RadioButton Content="Zastávkový JŘ MHD (detekce zastávek, odjezdů a poznámek)"
                         IsChecked="{Binding IsImportZastavkovyJr}" GroupName="ImportType"/>

            <!-- Nastavení importu — sloučení grafiky (jen pro obecný import) -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGraphicsModeVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Sloučení grafiky" FontWeight="SemiBold" Margin="0,12,0,6"/>
                <RadioButton Content="Žádné — každý prvek jako samostatný element"
                             IsChecked="{Binding IsMergeModeNone}" GroupName="Merge" Margin="0,0,0,2"/>
                <RadioButton Content="Pouze čáry — sloučí čáry do pozadí, obdélníky a obrázky zůstanou"
                             IsChecked="{Binding IsMergeModeLinesOnly}" GroupName="Merge" Margin="0,0,0,2"/>
                <RadioButton Content="Vše — čáry, obdélníky i obrázky do jednoho pozadí"
                             IsChecked="{Binding IsMergeModeAll}" GroupName="Merge"/>
            </StackPanel>

            <!-- AI obohacení (viditelné jen při JŘ importu) -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAiSectionVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="AI asistence" FontWeight="SemiBold" Margin="0,12,0,6"/>

                <!-- AI Vision import (nový — screenshot → Sonnet → schedule elementy) -->
                <CheckBox IsChecked="{Binding UseAiVision}"
                          Margin="0,0,0,4">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Content" Value="AI Vision import (Sonnet — rozpoznání struktury z obrázku)"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasApiKey}" Value="False">
                                    <Setter Property="Content" Value="AI Vision import (API klíč chybí v appsettings.json)"/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAiVisionAgendaVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Agenda:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding AvailableAgendas}"
                              SelectedValue="{Binding SelectedAgendaCode}"
                              SelectedValuePath="Code"
                              DisplayMemberPath="Name"
                              Width="200" Padding="4,2"/>
                </StackPanel>

                <!-- AI enrichment (stávající — mapování DB polí textem) -->
                <CheckBox IsChecked="{Binding UseAiEnrichment}"
                          Margin="0,4,0,0">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Content" Value="AI obohacení textem (Haiku — mapování DB polí v heuristickém režimu)"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasApiKey}" Value="False">
                                    <Setter Property="Content" Value="AI obohacení textem (API klíč chybí)"/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding UseAiVision}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Foreground" Value="#999999"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding UseAiEnrichment}" Value="True"/>
                                        <Condition Binding="{Binding UseAiVision}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Agenda:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding AvailableAgendas}"
                              SelectedValue="{Binding SelectedAgendaCode}"
                              SelectedValuePath="Code"
                              DisplayMemberPath="Name"
                              Width="200" Padding="4,2"/>
                </StackPanel>
            </StackPanel>

            <!-- Debug -->
            <CheckBox Content="Debug log (uloží .import-debug.txt vedle PDF)"
                      IsChecked="{Binding EnableDebug}"
                      Margin="0,4,0,0" FontSize="11" Foreground="#888888"/>

            <!-- Status -->
            <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0"
                       FontSize="11" Foreground="#444444" TextWrapping="Wrap"/>
        </StackPanel>
    </DockPanel>
</Window>
