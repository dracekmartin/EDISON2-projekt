<Window x:Class="TemplateDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:local="clr-namespace:TemplateDesigner"
        xmlns:controls="clr-namespace:TemplateDesigner.Controls"
        Title="Template Designer" Height="768" Width="1280"
        WindowState="Maximized"
        Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Sdílené šablony parametrů (preview lišta + PrintDialog používají stejné). -->
                <ResourceDictionary Source="/Controls/ParameterTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PanelHeader" TargetType="TextBlock">
                <Setter Property="Background"   Value="#F0F0F0"/>
                <Setter Property="Padding"      Value="8,6"/>
                <Setter Property="FontWeight"   Value="SemiBold"/>
                <Setter Property="FontSize"     Value="12"/>
                <Setter Property="Foreground"   Value="#333333"/>
            </Style>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- ── Section item DataTemplate ── -->
            <DataTemplate x:Key="SectionItemTemplate" DataType="{x:Type local:SectionVM}">
                <Border Margin="0,2,0,0"
                        Padding="8,5,4,5"
                        CornerRadius="3"
                        Cursor="Hand"
                        Tag="{Binding}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"       Value="#F5F5F5"/>
                            <Setter Property="BorderBrush"      Value="#D2D2D2"/>
                            <Setter Property="BorderThickness"  Value="1"/>
                            <Style.Triggers>
                                <!-- Dynamic (non-active) -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsDynamic}" Value="True"/>
                                        <Condition Binding="{Binding IsActive}"  Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background"  Value="#EAF3FF"/>
                                    <Setter Property="BorderBrush" Value="#B4D2F5"/>
                                </MultiDataTrigger>
                                <!-- Active -->
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Background"      Value="#D2E6FF"/>
                                    <Setter Property="BorderBrush"     Value="#2196F3"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.Tag,
                                      RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Vlastnosti sekce…"
                                      Command="{Binding ShowPropertiesCommand}"/>
                            <MenuItem Header="Přesunout nahoru"
                                      Command="{Binding MoveUpCommand}"/>
                            <MenuItem Header="Přesunout dolů"
                                      Command="{Binding MoveDownCommand}"/>
                            <MenuItem Header="Uložit jako šablonu…"
                                      Command="{Binding SaveTemplateCommand}"/>
                            <Separator/>
                            <MenuItem Header="Smazat sekci"
                                      Foreground="DarkRed"
                                      Command="{Binding DeleteCommand}"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="▼" Width="18" Height="16" FontSize="8"
                                Padding="0" Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding MoveDownCommand}"
                                ToolTip="Přesunout dolů (Ctrl+Shift+↓)"/>
                        <Button DockPanel.Dock="Right"
                                Content="▲" Width="18" Height="16" FontSize="8"
                                Padding="0" Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding MoveUpCommand}"
                                ToolTip="Přesunout nahoru (Ctrl+Shift+↑)"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Subtitle}"
                                       FontSize="10"
                                       Foreground="Gray"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSubtitle}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </DataTemplate>

            <!-- Parameter DataTemplates jsou ve sdílené ResourceDictionary (viz MergedDictionaries výše).
                 Klíče: ParamBoolTemplate, ParamEnumTemplate, ParamStringTemplate, ParamCommitStringTemplate, ParamTemplateSelector. -->
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ═══ Menu ═══ -->
        <Menu DockPanel.Dock="Top" Background="#F8F8F8">
            <MenuItem Header="Soubor">
                <MenuItem x:Name="MenuNew"    Header="Nová šablona"  InputGestureText="Ctrl+N" Click="MenuNew_Click"/>
                <MenuItem x:Name="MenuOpen"   Header="Otevřít ze souboru..."  InputGestureText="Ctrl+O" Click="MenuOpen_Click"/>
                <MenuItem x:Name="MenuOpenFromCache" Header="Otevřít z Caché..." Command="{Binding OpenFromCacheCommand}"/>
                <Separator/>
                <MenuItem x:Name="MenuSave"   Header="Uložit"        InputGestureText="Ctrl+S" Click="MenuSave_Click"/>
                <MenuItem x:Name="MenuSaveAs" Header="Uložit jako soubor..."                  Click="MenuSaveAs_Click"/>
                <MenuItem x:Name="MenuSaveToCache"   Header="Uložit do Caché"          Command="{Binding SaveToCacheCommand}"/>
                <MenuItem x:Name="MenuSaveToCacheAs" Header="Uložit do Caché jako..." Command="{Binding SaveToCacheAsCommand}"/>
                <Separator/>
                <MenuItem x:Name="MenuExportPdf" Header="Exportovat náhled jako PDF..." Click="MenuExportPdf_Click"/>
                <MenuItem x:Name="MenuExportPng" Header="Exportovat náhled jako PNG..." Click="MenuExportPng_Click"/>
                <MenuItem x:Name="MenuPrint" Header="Tisk..." InputGestureText="Ctrl+P" Click="MenuPrint_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuPageProps" Header="Vlastnosti stránky…" InputGestureText="Ctrl+Shift+P" Click="MenuPageProps_Click"/>
                <Separator/>
                <MenuItem Header="Konec" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Upravit">
                <MenuItem x:Name="MenuUndo"   Header="Zpět"   InputGestureText="Ctrl+Z"
                          Command="{Binding UndoCommand}"/>
                <MenuItem x:Name="MenuRedo"   Header="Vpřed"  InputGestureText="Ctrl+Y"
                          Command="{Binding RedoCommand}"/>
                <Separator/>
                <MenuItem x:Name="MenuDelete" Header="Smazat" InputGestureText="Del"    Click="MenuDelete_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuZForward"  Header="Přenést dopředu"       InputGestureText="Ctrl+PgUp"       Click="BtnZForward_Click"/>
                <MenuItem x:Name="MenuZBackward" Header="Odeslat dozadu"        InputGestureText="Ctrl+PgDn"       Click="BtnZBackward_Click"/>
                <MenuItem x:Name="MenuZFront"    Header="Přenést zcela dopředu" InputGestureText="Ctrl+Shift+PgUp" Click="BtnZFront_Click"/>
                <MenuItem x:Name="MenuZBack"     Header="Odeslat zcela dozadu"  InputGestureText="Ctrl+Shift+PgDn" Click="BtnZBack_Click"/>
                <Separator/>
                <MenuItem Header="Zarovnat vlevo"               Click="BtnAlignLeft_Click"/>
                <MenuItem Header="Zarovnat vpravo"              Click="BtnAlignRight_Click"/>
                <MenuItem Header="Zarovnat na střed (vodorovně)" Click="BtnAlignCenterH_Click"/>
                <MenuItem Header="Zarovnat nahoru"              Click="BtnAlignTop_Click"/>
                <MenuItem Header="Zarovnat dolů"                Click="BtnAlignBottom_Click"/>
                <MenuItem Header="Zarovnat na střed (svisle)"  Click="BtnAlignMiddleV_Click"/>
                <Separator/>
                <MenuItem Header="Rozložit vodorovně"           Click="BtnDistributeH_Click"/>
                <MenuItem Header="Rozložit svisle"              Click="BtnDistributeV_Click"/>
                <Separator/>
                <MenuItem Header="Normalizovat pozice…" InputGestureText="Ctrl+Shift+N" Click="MenuNormalizePositions_Click"/>
                <Separator/>
                <MenuItem Header="Kopírovat styl"  InputGestureText="Ctrl+Shift+C" Click="MenuCopyStyle_Click"/>
                <MenuItem Header="Vložit styl"     InputGestureText="Ctrl+Shift+V" Click="MenuPasteStyle_Click"/>
            </MenuItem>
            <MenuItem Header="Zobrazit">
                <MenuItem x:Name="MenuGrid" Header="Mřížka" IsCheckable="True"
                          IsChecked="{Binding ShowGrid, Mode=TwoWay}"/>
                <MenuItem x:Name="MenuSnap" Header="Přichytit na mřížku" IsCheckable="True"
                          IsChecked="{Binding SnapToGrid, Mode=TwoWay}"/>
                <MenuItem x:Name="MenuSnapElements" Header="Přichytit k elementům" IsCheckable="True"
                          IsChecked="{Binding SnapToElements, Mode=TwoWay}"/>
                <MenuItem Header="Záhlaví sekcí" IsCheckable="True"
                          IsChecked="{Binding ShowSectionHeaders, Mode=TwoWay}"/>
                <Separator/>
                <MenuItem x:Name="MenuSectionsPanel" Header="Panel sekcí" IsCheckable="True" IsChecked="True"
                          Checked="MenuPanelSection_Changed" Unchecked="MenuPanelSection_Changed"/>
                <MenuItem x:Name="MenuPreview" Header="Live náhled" IsCheckable="True" IsChecked="True"
                          Checked="MenuPreview_Changed" Unchecked="MenuPreview_Changed"/>
            </MenuItem>
            <MenuItem Header="Nástroje">
                <MenuItem x:Name="MenuChangeAgenda" Header="Změnit agendu..." InputGestureText="Ctrl+Shift+A"
                          Command="{Binding ChangeAgendaCommand}"/>
                <MenuItem x:Name="MenuManageCacheTemplates" Header="Šablony v Caché..."
                          Command="{Binding OpenFromCacheCommand}"/>
                <Separator/>
                <MenuItem x:Name="MenuAiAssistant" Header="AI Asistent šablon..." Click="MenuAiAssistant_Click"/>
                <MenuItem x:Name="MenuImportPdf" Header="Import PDF..." Click="MenuImportPdf_Click"/>
            </MenuItem>
            <MenuItem Header="Nápověda">
                <MenuItem x:Name="MenuHelp" Header="Klávesové zkratky a ovládání" InputGestureText="F1" Click="MenuHelp_Click"/>
            </MenuItem>
        </Menu>

        <!-- ═══ Toolbar ═══ -->
        <Border DockPanel.Dock="Top" Background="#F8F8F8" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="4,2">
            <StackPanel Orientation="Horizontal">

                <!-- ── 1. Soubor ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnNew" Style="{StaticResource ToolbarButton}" ToolTip="Nová šablona (Ctrl+N)" Click="MenuNew_Click">
                            <Image Source="{StaticResource EDIcons.New}" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="BtnOpen" Style="{StaticResource ToolbarButton}" ToolTip="Otevřít (Ctrl+O)" Click="MenuOpen_Click">
                            <Image Source="{StaticResource EDIcons.Open}" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="BtnSave" Style="{StaticResource ToolbarButton}" ToolTip="Uložit (Ctrl+S)" Click="MenuSave_Click">
                            <Image Source="{StaticResource EDIcons.Save}" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="BtnPrint" Style="{StaticResource ToolbarButton}" ToolTip="Tisk (Ctrl+P)" Click="MenuPrint_Click">
                            <Image Source="{StaticResource EDIcons.Print}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Soubor" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 2. Upravit ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnUndo" Style="{StaticResource ToolbarButton}" ToolTip="Zpět (Ctrl+Z)" Command="{Binding UndoCommand}">
                            <Image Source="{StaticResource EDIcons.Undo}" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="BtnRedo" Style="{StaticResource ToolbarButton}" ToolTip="Vpřed (Ctrl+Y)" Command="{Binding RedoCommand}">
                            <Image Source="{StaticResource EDIcons.Redo}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Upravit" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 3. Přidat ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnAddSection" Style="{StaticResource ToolbarButton}" ToolTip="Přidat sekci" Click="BtnAddSection_Click">
                            <Image Source="{StaticResource EDIcons.AddSection}" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="BtnAddElement" Style="{StaticResource ToolbarButton}" ToolTip="Přidat element" Click="BtnAddElement_Click">
                            <Image Source="{StaticResource EDIcons.AddElement}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Přidat" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 4. Elementy (drag-to-canvas paleta) ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PaletteButton}" ToolTip="Text — táhni na canvas" Tag="TextElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.TextElement}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource PaletteButton}" ToolTip="Obdélník — táhni na canvas" Tag="RectangleElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.RectElement}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource PaletteButton}" ToolTip="Čára — táhni na canvas" Tag="LineElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.LineElement}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource PaletteButton}" ToolTip="Obrázek — táhni na canvas" Tag="ImageElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.ImageElement}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource PaletteButton}" ToolTip="Tabulka — táhni na canvas" Tag="TableElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.TableElement}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource PaletteButton}" ToolTip="Kód (QR, čárový, ...) — táhni na canvas" Tag="BarcodeElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.QrCode}" Width="16" Height="16"/>
                        </Button>
                        <Border Width="1" Background="#E0E0E0" Margin="3,2" VerticalAlignment="Stretch"/>
                        <Button Style="{StaticResource PaletteButton}" ToolTip="Seznam zastávek — táhni na canvas" Tag="StopListElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.StopList}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource PaletteButton}" ToolTip="Mřížka odjezdů — táhni na canvas" Tag="DepartureGridElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.DepartureGrid}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource PaletteButton}" ToolTip="Legenda poznámek — táhni na canvas" Tag="NotesLegendElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.NotesLegend}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Elementy" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 5. Vrstva (Z-order) ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnZForward" Style="{StaticResource ToolbarButton}" ToolTip="Přenést dopředu (Ctrl+PgUp)" Click="BtnZForward_Click">
                            <Image Source="{StaticResource EDIcons.ZForward}" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="BtnZBackward" Style="{StaticResource ToolbarButton}" ToolTip="Odeslat dozadu (Ctrl+PgDn)" Click="BtnZBackward_Click">
                            <Image Source="{StaticResource EDIcons.ZBackward}" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="BtnZFront" Style="{StaticResource ToolbarButton}" ToolTip="Přenést zcela dopředu (Ctrl+Shift+PgUp)" Click="BtnZFront_Click">
                            <Image Source="{StaticResource EDIcons.ZFront}" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="BtnZBack" Style="{StaticResource ToolbarButton}" ToolTip="Odeslat zcela dozadu (Ctrl+Shift+PgDn)" Click="BtnZBack_Click">
                            <Image Source="{StaticResource EDIcons.ZBack}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Vrstva" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 6. Zarovnat ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Zarovnat vlevo" Click="BtnAlignLeft_Click">
                            <Image Source="{StaticResource EDIcons.AlignLeft}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Zarovnat na střed (vodorovně)" Click="BtnAlignCenterH_Click">
                            <Image Source="{StaticResource EDIcons.AlignCenterH}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Zarovnat vpravo" Click="BtnAlignRight_Click">
                            <Image Source="{StaticResource EDIcons.AlignRight}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Zarovnat nahoru" Click="BtnAlignTop_Click">
                            <Image Source="{StaticResource EDIcons.AlignTop}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Zarovnat na střed (svisle)" Click="BtnAlignMiddleV_Click">
                            <Image Source="{StaticResource EDIcons.AlignCenterV}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Zarovnat dolů" Click="BtnAlignBottom_Click">
                            <Image Source="{StaticResource EDIcons.AlignBottom}" Width="16" Height="16"/>
                        </Button>
                        <Border Width="1" Background="#E0E0E0" Margin="3,2" VerticalAlignment="Stretch"/>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Rozložit rovnoměrně vodorovně (min 3)" Click="BtnDistributeH_Click">
                            <Image Source="{StaticResource EDIcons.DistributeH}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Rozložit rovnoměrně svisle (min 3)" Click="BtnDistributeV_Click">
                            <Image Source="{StaticResource EDIcons.DistributeV}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Zarovnat" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 7. Zobrazení ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="BtnGrid" Style="{StaticResource ToolbarToggle}" ToolTip="Zobrazit/skrýt mřížku"
                                      IsChecked="{Binding ShowGrid, Mode=TwoWay}">
                            <Image Source="{StaticResource EDIcons.Grid}" Width="16" Height="16"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnSnap" Style="{StaticResource ToolbarToggle}" ToolTip="Přichytit na mřížku"
                                      IsChecked="{Binding SnapToGrid, Mode=TwoWay}">
                            <Image Source="{StaticResource EDIcons.Snap}" Width="16" Height="16"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnSnapElements" Style="{StaticResource ToolbarToggle}" ToolTip="Přichytávat k objektům (elementy + okraje sekce)"
                                      IsChecked="{Binding SnapToElements, Mode=TwoWay}">
                            <Image Source="{StaticResource EDIcons.Snap}" Width="16" Height="16" Opacity="0.6"/>
                        </ToggleButton>
                        <ComboBox x:Name="CmbGridSize" Width="70" VerticalAlignment="Center" Margin="2,0"
                                  ToolTip="Velikost mřížky" SelectedIndex="4"
                                  SelectionChanged="CmbGridSize_SelectionChanged">
                            <ComboBoxItem Content="0,1 mm" Tag="0.1"/>
                            <ComboBoxItem Content="0,5 mm" Tag="0.5"/>
                            <ComboBoxItem Content="1 mm"   Tag="1"/>
                            <ComboBoxItem Content="2 mm"   Tag="2"/>
                            <ComboBoxItem Content="5 mm"   Tag="5"/>
                            <ComboBoxItem Content="10 mm"  Tag="10"/>
                        </ComboBox>
                        <ComboBox x:Name="CmbSnapGap" Width="90" VerticalAlignment="Center" Margin="2,0"
                                  ToolTip="Mezera mezi objekty při snapu a duplikaci"
                                  SelectedIndex="2"
                                  SelectionChanged="CmbSnapGap_SelectionChanged">
                            <ComboBoxItem Content="bez mezery" Tag="0"/>
                            <ComboBoxItem Content="1 mm"  Tag="1"/>
                            <ComboBoxItem Content="2 mm"  Tag="2"/>
                            <ComboBoxItem Content="3 mm"  Tag="3"/>
                            <ComboBoxItem Content="5 mm"  Tag="5"/>
                            <ComboBoxItem Content="10 mm" Tag="10"/>
                        </ComboBox>
                        <ComboBox x:Name="CmbZoom" Width="80" SelectedIndex="2" VerticalAlignment="Center" Margin="4,0"
                                  SelectionChanged="CmbZoom_SelectionChanged">
                            <ComboBoxItem Content="  50 %"/>
                            <ComboBoxItem Content="  75 %"/>
                            <ComboBoxItem Content=" 100 %"/>
                            <ComboBoxItem Content=" 150 %"/>
                            <ComboBoxItem Content=" 200 %"/>
                            <ComboBoxItem Content=" 300 %"/>
                            <ComboBoxItem Content=" 400 %"/>
                            <ComboBoxItem Content=" 500 %"/>
                            <ComboBoxItem Content=" 800 %"/>
                            <ComboBoxItem Content="1000 %"/>
                        </ComboBox>
                        <Button x:Name="BtnResetView" Style="{StaticResource ToolbarButton}"
                                ToolTip="Resetovat zoom designeru i náhledu na 100 %"
                                Click="BtnResetView_Click" Content="1:1" FontSize="11" FontWeight="SemiBold"/>
                        <ToggleButton x:Name="BtnPreview" Style="{StaticResource ToolbarToggle}" ToolTip="Zobrazit/skrýt live náhled"
                                      IsChecked="True" Checked="BtnPreview_Changed" Unchecked="BtnPreview_Changed">
                            <Image Source="{StaticResource EDIcons.Eye}" Width="16" Height="16"/>
                        </ToggleButton>
                        <Border Width="1" Background="#D0D0D0" Margin="4,2" VerticalAlignment="Stretch"/>
                        <ComboBox x:Name="CmbScale" Width="90" VerticalAlignment="Center" Margin="2,0"
                                  ToolTip="Škálovat celou šablonu"
                                  SelectionChanged="CmbScale_SelectionChanged">
                            <ComboBoxItem Content="Škálovat..." IsEnabled="False"/>
                            <ComboBoxItem Content="50 %"  Tag="0.5"/>
                            <ComboBoxItem Content="75 %"  Tag="0.75"/>
                            <ComboBoxItem Content="90 %"  Tag="0.9"/>
                            <ComboBoxItem Content="100 %" Tag="1.0"/>
                            <ComboBoxItem Content="110 %" Tag="1.1"/>
                            <ComboBoxItem Content="125 %" Tag="1.25"/>
                            <ComboBoxItem Content="150 %" Tag="1.5"/>
                            <ComboBoxItem Content="200 %" Tag="2.0"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="Zobrazení" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ═══ Hlavní obsah ═══ -->
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <!-- Panel sekcí -->
                <ColumnDefinition x:Name="SectionsColumn" Width="200" MinWidth="120"/>
                <ColumnDefinition Width="4"/>
                <!-- Canvas -->
                <ColumnDefinition x:Name="CanvasColumn" Width="*" MinWidth="300"/>
                <ColumnDefinition Width="4"/>
                <!-- Live preview -->
                <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <!-- Hlavní plocha -->
                <RowDefinition Height="*" MinHeight="100"/>
                <!-- Status bar -->
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- ── Panel sekcí + pole agendy ── -->
            <Border Grid.Column="0" Grid.Row="0"
                    BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
                <TabControl x:Name="LeftTabControl" SelectionChanged="LeftTabControl_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- ── Záložka Sekce ── -->
                    <TabItem Header="▣ Sekce">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom"
                                    BorderBrush="#DDDDDD" BorderThickness="0,1,0,0"
                                    Padding="6" Background="#FAFAFA">
                                <Button x:Name="BtnAddSectionPanel" Content="+ Přidat sekci"
                                        Click="BtnAddSection_Click" HorizontalAlignment="Stretch" Padding="4,4"/>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <!-- Data-bound sections list -->
                                <ListBox x:Name="SectionsList"
                                         ItemsSource="{Binding Sections}"
                                         ItemTemplate="{StaticResource SectionItemTemplate}"
                                         Margin="6,4"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         SelectionChanged="SectionsList_SelectionChanged"
                                         MouseDoubleClick="SectionsList_MouseDoubleClick">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding"         Value="0"/>
                                            <Setter Property="Margin"          Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <!-- Remove default selection highlight — SectionVM.IsActive drives the visual -->
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- ── Záložka Pole agendy ── -->
                    <TabItem Header="⊞ Pole agendy" x:Name="TabFields">
                        <DockPanel>
                            <!-- Záhlaví: název agendy -->
                            <Border DockPanel.Dock="Top"
                                    BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                                    Background="#F0F0F0" Padding="8,5"
                                    Cursor="Hand"
                                    ToolTip="Klikni pro změnu agendy (Ctrl+Shift+A)">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding ChangeAgendaCommand}"/>
                                </Border.InputBindings>
                                <TextBlock x:Name="AgendaNameTextBlock"
                                           Text="{Binding AgendaNameText}"
                                           FontSize="11" Foreground="#555555"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <!-- Tip dole -->
                            <Border DockPanel.Dock="Bottom"
                                    BorderBrush="#DDDDDD" BorderThickness="0,1,0,0"
                                    Background="#FAFAFA" Padding="6,4">
                                <TextBlock Text="💡 Dvojklik = vložit {POLE}"
                                           FontSize="10" Foreground="#888888"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <!-- Data-bound schema tree -->
                            <TreeView x:Name="SchemaTree"
                                      ItemsSource="{Binding SchemaGroups}"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      MouseDoubleClick="SchemaTree_MouseDoubleClick">
                                <TreeView.Resources>
                                    <!-- SchemaGroupVM: expandable group -->
                                    <HierarchicalDataTemplate DataType="{x:Type local:SchemaGroupVM}"
                                                              ItemsSource="{Binding Fields}">
                                        <TextBlock Text="{Binding Header}"
                                                   FontWeight="SemiBold" FontSize="11"
                                                   Foreground="#444444"/>
                                    </HierarchicalDataTemplate>
                                    <!-- SchemaFieldVM: leaf field -->
                                    <DataTemplate DataType="{x:Type local:SchemaFieldVM}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FieldName}"
                                                       FontFamily="Consolas" FontSize="11"
                                                       Foreground="#1A5276"/>
                                            <TextBlock Text="{Binding LabelDisplay}"
                                                       FontSize="10" Foreground="#666666"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="True"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </DockPanel>
                    </TabItem>
                    <!-- ── Záložka Vlastnosti (inline properties panel) ── -->
                    <TabItem Header="Vlastnosti" x:Name="TabProperties">
                        <DockPanel>
                            <controls:FormatToolbar x:Name="FormatToolbar" DockPanel.Dock="Top"/>
                            <controls:PropertiesPanel x:Name="InlinePropertiesPanel"/>
                        </DockPanel>
                    </TabItem>
                    <!-- ── Záložka Strom šablony ── -->
                    <TabItem Header="Strom" x:Name="TabTree">
                        <controls:TemplateTreePanel x:Name="TreePanel"/>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- ── GridSplitter levý ── -->
            <GridSplitter Grid.Column="1" Grid.Row="0"
                          HorizontalAlignment="Stretch" Background="#DDDDDD" Cursor="SizeWE"/>

            <!-- ── Canvas ── -->
            <ScrollViewer Grid.Column="2" Grid.Row="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="#E0E0E0"
                          x:Name="CanvasScrollViewer">
                <skia:SKElement x:Name="skCanvas" Width="900" Height="1200"/>
            </ScrollViewer>

            <!-- ── GridSplitter pravý ── -->
            <GridSplitter Grid.Column="3" Grid.Row="0"
                          HorizontalAlignment="Stretch" Background="#DDDDDD" Cursor="SizeWE"/>

            <!-- ── Live Preview (výchozí: skrytý, panel se zobrazí togglem) ── -->
            <Border Grid.Column="4" Grid.Row="0"
                    BorderBrush="#DDDDDD" BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- Záhlaví preview panelu -->
                    <Border DockPanel.Dock="Top"
                            Background="#F0F0F0"
                            BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="PNG"
                                    Click="MenuExportPng_Click" Padding="8,2" Margin="4,0,0,0"
                                    ToolTip="Exportovat náhled jako PNG..."/>
                            <Button DockPanel.Dock="Right" Content="PDF"
                                    Click="MenuExportPdf_Click" Padding="8,2"
                                    ToolTip="Exportovat náhled jako PDF..."/>
                            <ComboBox x:Name="CmbPreviewZoom" DockPanel.Dock="Right"
                                      Width="80" SelectedIndex="2" VerticalAlignment="Center" Margin="4,0"
                                      ToolTip="Zoom náhledu (Ctrl+Scroll)"
                                      SelectionChanged="CmbPreviewZoom_SelectionChanged">
                                <ComboBoxItem Content="  50 %"/>
                                <ComboBoxItem Content="  75 %"/>
                                <ComboBoxItem Content=" 100 %"/>
                                <ComboBoxItem Content=" 150 %"/>
                                <ComboBoxItem Content=" 200 %"/>
                                <ComboBoxItem Content=" 300 %"/>
                                <ComboBoxItem Content=" 400 %"/>
                                <ComboBoxItem Content=" 500 %"/>
                                <ComboBoxItem Content=" 800 %"/>
                                <ComboBoxItem Content="1000 %"/>
                            </ComboBox>
                            <TextBlock Text="Náhled  ·  vzorová data ze schématu"
                                       FontSize="11" Foreground="#666666"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <!-- Parametry sestavy -->
                    <Border x:Name="PreviewParamsBorder" DockPanel.Dock="Top"
                            Visibility="{Binding HasParameters, Converter={StaticResource BoolToVis}}"
                            Background="#FAFAFA"
                            BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <ItemsControl ItemsSource="{Binding PreviewParameters}"
                                      ItemTemplateSelector="{StaticResource ParamTemplateSelector}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>

                    <!-- Stránkování dat -->
                    <Border DockPanel.Dock="Top"
                            Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolToVis}}"
                            Background="#F5F5F5"
                            BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                            Padding="8,3">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="◀" Command="{Binding PreviousPageCommand}"
                                    FontSize="11" Padding="8,1" MinWidth="28"/>
                            <TextBlock Text="{Binding PageNavigationText}"
                                       FontSize="11" Foreground="#444444"
                                       VerticalAlignment="Center" Margin="8,0"
                                       MinWidth="40" TextAlignment="Center"/>
                            <Button Content="▶" Command="{Binding NextPageCommand}"
                                    FontSize="11" Padding="8,1" MinWidth="28"/>
                        </StackPanel>
                    </Border>

                    <!-- Scrollovatelný canvas náhledu -->
                    <ScrollViewer x:Name="PreviewScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="#E8E8E8">
                        <skia:SKElement x:Name="skPreview" HorizontalAlignment="Left" Height="800"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ── Status bar ── -->
            <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="5"
                    Background="#F0F0F0" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1) Agenda chip (klikatelný — ChangeAgendaCommand) -->
                    <Border Grid.Column="0"
                            Background="#E8F5E9" Padding="10,3"
                            Cursor="Hand"
                            ToolTip="Klikni pro změnu agendy (Ctrl+Shift+A)">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ChangeAgendaCommand}"/>
                        </Border.InputBindings>
                        <TextBlock Text="{Binding AgendaNameText}"
                                   FontSize="11" Foreground="#1B5E20" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="1" Width="1" Background="#DDDDDD"/>

                    <!-- 2) Instance chip (klikatelný — OpenInstancePicker) -->
                    <Border Grid.Column="2"
                            Background="#E3F2FD" Padding="10,3"
                            Cursor="Hand"
                            ToolTip="Klikni pro výběr instancí (linky, faktury, ...)">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenInstancePickerCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="◀" Command="{Binding PreviousInstanceCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="4,0"
                                    FontSize="11" Foreground="#0D47A1"
                                    Cursor="Hand" Margin="0,0,4,0"
                                    ToolTip="Předchozí instance"/>
                            <TextBlock Text="{Binding ActiveInstanceText}"
                                       FontSize="11" Foreground="#0D47A1" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button Content="▶" Command="{Binding NextInstanceCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="4,0"
                                    FontSize="11" Foreground="#0D47A1"
                                    Cursor="Hand" Margin="4,0,0,0"
                                    ToolTip="Další instance"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Width="1" Background="#DDDDDD"/>

                    <!-- 3) Dynamický kontextový status -->
                    <TextBlock x:Name="StatusText" Grid.Column="4"
                               Text="{Binding StatusText}"
                               VerticalAlignment="Center" Margin="10,0"
                               FontSize="11" Foreground="#555555"/>
                </Grid>
            </Border>

        </Grid>
    </DockPanel>
</Window>
