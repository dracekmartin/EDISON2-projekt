<Window x:Class="TemplateDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:local="clr-namespace:TemplateDesigner"
        Title="Template Designer" Height="768" Width="1280"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="Background"   Value="#F0F0F0"/>
            <Setter Property="Padding"      Value="8,6"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="#333333"/>
        </Style>
        <Style x:Key="ToolbarSep" TargetType="Separator">
            <Setter Property="Margin" Value="4,2"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ── Section item DataTemplate ── -->
        <DataTemplate x:Key="SectionItemTemplate" DataType="{x:Type local:SectionVM}">
            <Border Margin="0,2,0,0"
                    Padding="8,5,4,5"
                    CornerRadius="3"
                    Cursor="Hand"
                    Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background"       Value="#F5F5F5"/>
                        <Setter Property="BorderBrush"      Value="#D2D2D2"/>
                        <Setter Property="BorderThickness"  Value="1"/>
                        <Style.Triggers>
                            <!-- Dynamic (non-active) -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDynamic}" Value="True"/>
                                    <Condition Binding="{Binding IsActive}"  Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background"  Value="#EAF3FF"/>
                                <Setter Property="BorderBrush" Value="#B4D2F5"/>
                            </MultiDataTrigger>
                            <!-- Active -->
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background"      Value="#D2E6FF"/>
                                <Setter Property="BorderBrush"     Value="#2196F3"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag,
                                  RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Vlastnosti sekce…"
                                  Command="{Binding ShowPropertiesCommand}"/>
                        <MenuItem Header="Přesunout nahoru"
                                  Command="{Binding MoveUpCommand}"/>
                        <MenuItem Header="Přesunout dolů"
                                  Command="{Binding MoveDownCommand}"/>
                        <MenuItem Header="Uložit jako šablonu…"
                                  Command="{Binding SaveTemplateCommand}"/>
                        <Separator/>
                        <MenuItem Header="Smazat sekci"
                                  Foreground="DarkRed"
                                  Command="{Binding DeleteCommand}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="▼" Width="18" Height="16" FontSize="8"
                            Padding="0" Margin="2,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding MoveDownCommand}"
                            ToolTip="Přesunout dolů (Ctrl+Shift+↓)"/>
                    <Button DockPanel.Dock="Right"
                            Content="▲" Width="18" Height="16" FontSize="8"
                            Padding="0" Margin="2,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding MoveUpCommand}"
                            ToolTip="Přesunout nahoru (Ctrl+Shift+↑)"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Subtitle}"
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSubtitle}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- ── Parameter DataTemplates ── -->
        <DataTemplate x:Key="BoolParamTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                <CheckBox Content="{Binding Label}"
                          IsChecked="{Binding Value, Mode=TwoWay}"
                          VerticalAlignment="Center" FontSize="11"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="EnumParamTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Label, StringFormat='{}{0}:'}"
                           VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                <ComboBox Width="90" FontSize="11"
                          ItemsSource="{Binding Options}"
                          SelectedItem="{Binding Value, Mode=TwoWay}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="StringParamTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Label, StringFormat='{}{0}:'}"
                           VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                <TextBox Width="80" FontSize="11"
                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <local:ParameterTemplateSelector x:Key="ParamTemplateSelector"
            BoolTemplate="{StaticResource BoolParamTemplate}"
            EnumTemplate="{StaticResource EnumParamTemplate}"
            DefaultTemplate="{StaticResource StringParamTemplate}"/>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ═══ Menu ═══ -->
        <Menu DockPanel.Dock="Top" Background="#F8F8F8">
            <MenuItem Header="Soubor">
                <MenuItem x:Name="MenuNew"    Header="Nová šablona"  InputGestureText="Ctrl+N" Click="MenuNew_Click"/>
                <MenuItem x:Name="MenuOpen"   Header="Otevřít..."    InputGestureText="Ctrl+O" Click="MenuOpen_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuSave"   Header="Uložit"        InputGestureText="Ctrl+S" Click="MenuSave_Click"/>
                <MenuItem x:Name="MenuSaveAs" Header="Uložit jako..."                          Click="MenuSaveAs_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuExportPdf" Header="Exportovat náhled jako PDF..." Click="MenuExportPdf_Click"/>
                <MenuItem x:Name="MenuPrint" Header="Tisk..." InputGestureText="Ctrl+P" Click="MenuPrint_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuPageProps" Header="Vlastnosti stránky…" InputGestureText="Ctrl+Shift+P" Click="MenuPageProps_Click"/>
                <Separator/>
                <MenuItem Header="Konec" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Upravit">
                <MenuItem x:Name="MenuUndo"   Header="Zpět"   InputGestureText="Ctrl+Z"
                          Command="{Binding UndoCommand}"/>
                <MenuItem x:Name="MenuRedo"   Header="Vpřed"  InputGestureText="Ctrl+Y"
                          Command="{Binding RedoCommand}"/>
                <Separator/>
                <MenuItem x:Name="MenuDelete" Header="Smazat" InputGestureText="Del"    Click="MenuDelete_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuZForward"  Header="Přenést dopředu"       InputGestureText="Ctrl+PgUp"       Click="BtnZForward_Click"/>
                <MenuItem x:Name="MenuZBackward" Header="Odeslat dozadu"        InputGestureText="Ctrl+PgDn"       Click="BtnZBackward_Click"/>
                <MenuItem x:Name="MenuZFront"    Header="Přenést zcela dopředu" InputGestureText="Ctrl+Shift+PgUp" Click="BtnZFront_Click"/>
                <MenuItem x:Name="MenuZBack"     Header="Odeslat zcela dozadu"  InputGestureText="Ctrl+Shift+PgDn" Click="BtnZBack_Click"/>
                <Separator/>
                <MenuItem Header="Zarovnat vlevo"               Click="BtnAlignLeft_Click"/>
                <MenuItem Header="Zarovnat vpravo"              Click="BtnAlignRight_Click"/>
                <MenuItem Header="Zarovnat na střed (vodorovně)" Click="BtnAlignCenterH_Click"/>
                <MenuItem Header="Zarovnat nahoru"              Click="BtnAlignTop_Click"/>
                <MenuItem Header="Zarovnat dolů"                Click="BtnAlignBottom_Click"/>
                <MenuItem Header="Zarovnat na střed (svisle)"  Click="BtnAlignMiddleV_Click"/>
                <Separator/>
                <MenuItem Header="Rozložit vodorovně"           Click="BtnDistributeH_Click"/>
                <MenuItem Header="Rozložit svisle"              Click="BtnDistributeV_Click"/>
            </MenuItem>
            <MenuItem Header="Zobrazit">
                <MenuItem x:Name="MenuGrid" Header="Mřížka" IsCheckable="True"
                          IsChecked="{Binding ShowGrid, Mode=TwoWay}"/>
                <MenuItem x:Name="MenuSnap" Header="Přichytit na mřížku" IsCheckable="True"
                          IsChecked="{Binding SnapToGrid, Mode=TwoWay}"/>
                <MenuItem x:Name="MenuSnapElements" Header="Přichytit k elementům" IsCheckable="True"
                          IsChecked="{Binding SnapToElements, Mode=TwoWay}"/>
                <Separator/>
                <MenuItem x:Name="MenuSectionsPanel" Header="Panel sekcí" IsCheckable="True" IsChecked="True"
                          Checked="MenuPanelSection_Changed" Unchecked="MenuPanelSection_Changed"/>
                <MenuItem x:Name="MenuPreview" Header="Live náhled" IsCheckable="True"
                          Checked="MenuPreview_Changed" Unchecked="MenuPreview_Changed"/>
            </MenuItem>
            <MenuItem Header="Nástroje">
                <MenuItem x:Name="MenuAiAssistant" Header="🤖 AI Asistent šablon..." Click="MenuAiAssistant_Click"/>
            </MenuItem>
            <MenuItem Header="Nápověda">
                <MenuItem x:Name="MenuHelp" Header="Klávesové zkratky a ovládání" InputGestureText="F1" Click="MenuHelp_Click"/>
            </MenuItem>
        </Menu>

        <!-- ═══ Toolbar ═══ -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True" Background="#F8F8F8">
            <ToolBar Band="0" BandIndex="0">
                <Button x:Name="BtnAddSection" Content="+ Sekce"   ToolTip="Přidat sekci"   Click="BtnAddSection_Click" Padding="6,3"/>
                <Button x:Name="BtnAddElement" Content="+ Element" ToolTip="Přidat element" Click="BtnAddElement_Click" Padding="6,3"/>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <Button x:Name="BtnUndo" Content="↩" ToolTip="Zpět (Ctrl+Z)"
                        Command="{Binding UndoCommand}" Padding="6,3" FontSize="14"/>
                <Button x:Name="BtnRedo" Content="↪" ToolTip="Vpřed (Ctrl+Y)"
                        Command="{Binding RedoCommand}" Padding="6,3" FontSize="14"/>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="4,0" Foreground="#555555"/>
                <ComboBox x:Name="CmbZoom" Width="80" SelectedIndex="2"
                          SelectionChanged="CmbZoom_SelectionChanged">
                    <ComboBoxItem Content=" 50 %"/>
                    <ComboBoxItem Content=" 75 %"/>
                    <ComboBoxItem Content="100 %"/>
                    <ComboBoxItem Content="150 %"/>
                    <ComboBoxItem Content="200 %"/>
                </ComboBox>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <ToggleButton x:Name="BtnGrid" Content="Mřížka" Padding="6,3"
                              IsChecked="{Binding ShowGrid, Mode=TwoWay}"
                              ToolTip="Zobrazit/skrýt mřížku"/>
                <ToggleButton x:Name="BtnSnap" Content="Snap" Padding="6,3"
                              IsChecked="{Binding SnapToGrid, Mode=TwoWay}"
                              ToolTip="Přichytit na mřížku"/>
                <ToggleButton x:Name="BtnSnapElements" Content="Snap elem." Padding="6,3"
                              IsChecked="{Binding SnapToElements, Mode=TwoWay}"
                              ToolTip="Přichytávat k ostatním elementům"/>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <Button x:Name="BtnZForward"  Content="↑Z" ToolTip="Přenést dopředu (Ctrl+PgUp)"         Click="BtnZForward_Click"  Padding="6,3"/>
                <Button x:Name="BtnZBackward" Content="↓Z" ToolTip="Odeslat dozadu (Ctrl+PgDn)"           Click="BtnZBackward_Click" Padding="6,3"/>
                <Button x:Name="BtnZFront"    Content="⤒Z" ToolTip="Přenést zcela dopředu (Ctrl+Shift+PgUp)" Click="BtnZFront_Click"    Padding="6,3"/>
                <Button x:Name="BtnZBack"     Content="⤓Z" ToolTip="Odeslat zcela dozadu (Ctrl+Shift+PgDn)"  Click="BtnZBack_Click"     Padding="6,3"/>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <Button x:Name="BtnSave" Content="Uložit" Click="MenuSave_Click" Padding="6,3" FontWeight="SemiBold"/>
                <Button x:Name="BtnOpen" Content="Otevřít" Click="MenuOpen_Click" Padding="6,3"/>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <ToggleButton x:Name="BtnPreview" Content="👁 Náhled" Padding="6,3"
                              Checked="BtnPreview_Changed" Unchecked="BtnPreview_Changed"
                              ToolTip="Zobrazit/skrýt live náhled (vzorová data ze schématu)"/>
            </ToolBar>
            <ToolBar Band="1" BandIndex="0">
                <TextBlock Text="Elementy:" VerticalAlignment="Center" Margin="4,0,2,0" Foreground="#555555" FontSize="11"/>
                <Button ToolTip="Text — táhni na canvas" Tag="TextElement"
                        PreviewMouseLeftButtonDown="ElementPalette_MouseDown"
                        Padding="5,3" FontSize="12" FontWeight="Bold" Content="T"/>
                <Button ToolTip="Obdélník — táhni na canvas" Tag="RectangleElement"
                        PreviewMouseLeftButtonDown="ElementPalette_MouseDown"
                        Padding="5,3">
                    <Rectangle Width="14" Height="10" Stroke="Black" StrokeThickness="1"/>
                </Button>
                <Button ToolTip="Čára — táhni na canvas" Tag="LineElement"
                        PreviewMouseLeftButtonDown="ElementPalette_MouseDown"
                        Padding="5,3">
                    <Line X1="0" Y1="5" X2="16" Y2="5" Stroke="Black" StrokeThickness="1"/>
                </Button>
                <Button ToolTip="Obrázek — táhni na canvas" Tag="ImageElement"
                        PreviewMouseLeftButtonDown="ElementPalette_MouseDown"
                        Padding="5,3" FontSize="12" Content="🖼"/>
                <Button ToolTip="Tabulka — táhni na canvas" Tag="TableElement"
                        PreviewMouseLeftButtonDown="ElementPalette_MouseDown"
                        Padding="5,3" FontSize="12" Content="▦"/>
                <Button ToolTip="QR kód — táhni na canvas" Tag="BarcodeQR"
                        PreviewMouseLeftButtonDown="ElementPalette_MouseDown"
                        Padding="5,3" FontSize="10" Content="QR"/>
                <Button ToolTip="Čárový kód — táhni na canvas" Tag="BarcodeCode128"
                        PreviewMouseLeftButtonDown="ElementPalette_MouseDown"
                        Padding="5,3" FontSize="10" Content="|||"/>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <TextBlock Text="Zarovnat:" VerticalAlignment="Center" Margin="4,0,2,0" Foreground="#555555" FontSize="11"/>
                <Button Content="←" ToolTip="Zarovnat vlevo"               Click="BtnAlignLeft_Click"    Padding="5,3" FontSize="13"/>
                <Button Content="→" ToolTip="Zarovnat vpravo"              Click="BtnAlignRight_Click"   Padding="5,3" FontSize="13"/>
                <Button Content="↔" ToolTip="Zarovnat na střed (vodorovně)" Click="BtnAlignCenterH_Click" Padding="5,3" FontSize="13"/>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <Button Content="↑" ToolTip="Zarovnat nahoru"              Click="BtnAlignTop_Click"     Padding="5,3" FontSize="13"/>
                <Button Content="↓" ToolTip="Zarovnat dolů"                Click="BtnAlignBottom_Click"  Padding="5,3" FontSize="13"/>
                <Button Content="↕" ToolTip="Zarovnat na střed (svisle)"   Click="BtnAlignMiddleV_Click" Padding="5,3" FontSize="13"/>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <Button Content="⇔" ToolTip="Rozložit rovnoměrně vodorovně (min 3 elementy)" Click="BtnDistributeH_Click" Padding="5,3" FontSize="13"/>
                <Button Content="⇕" ToolTip="Rozložit rovnoměrně svisle (min 3 elementy)"   Click="BtnDistributeV_Click" Padding="5,3" FontSize="13"/>
            </ToolBar>
        </ToolBarTray>

        <!-- ═══ Hlavní obsah ═══ -->
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <!-- Panel sekcí -->
                <ColumnDefinition x:Name="SectionsColumn" Width="200" MinWidth="120"/>
                <ColumnDefinition Width="4"/>
                <!-- Canvas -->
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="4"/>
                <!-- Live preview (skrytý) -->
                <ColumnDefinition x:Name="PreviewColumn" Width="0" MinWidth="0"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <!-- Hlavní plocha -->
                <RowDefinition Height="*" MinHeight="100"/>
                <!-- Status bar -->
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- ── Panel sekcí + pole agendy ── -->
            <Border Grid.Column="0" Grid.Row="0"
                    BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
                <TabControl x:Name="LeftTabControl" SelectionChanged="LeftTabControl_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- ── Záložka Sekce ── -->
                    <TabItem Header="▣ Sekce">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom"
                                    BorderBrush="#DDDDDD" BorderThickness="0,1,0,0"
                                    Padding="6" Background="#FAFAFA">
                                <Button x:Name="BtnAddSectionPanel" Content="+ Přidat sekci"
                                        Click="BtnAddSection_Click" HorizontalAlignment="Stretch" Padding="4,4"/>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <!-- Data-bound sections list -->
                                <ListBox x:Name="SectionsList"
                                         ItemsSource="{Binding Sections}"
                                         ItemTemplate="{StaticResource SectionItemTemplate}"
                                         Margin="6,4"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         SelectionChanged="SectionsList_SelectionChanged"
                                         MouseDoubleClick="SectionsList_MouseDoubleClick">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding"         Value="0"/>
                                            <Setter Property="Margin"          Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <!-- Remove default selection highlight — SectionVM.IsActive drives the visual -->
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- ── Záložka Pole agendy ── -->
                    <TabItem Header="⊞ Pole agendy" x:Name="TabFields">
                        <DockPanel>
                            <!-- Záhlaví: název agendy -->
                            <Border DockPanel.Dock="Top"
                                    BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                                    Background="#F0F0F0" Padding="8,5">
                                <TextBlock x:Name="AgendaNameTextBlock"
                                           Text="{Binding AgendaNameText}"
                                           FontSize="11" Foreground="#555555"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <!-- Tip dole -->
                            <Border DockPanel.Dock="Bottom"
                                    BorderBrush="#DDDDDD" BorderThickness="0,1,0,0"
                                    Background="#FAFAFA" Padding="6,4">
                                <TextBlock Text="💡 Dvojklik = vložit {POLE}"
                                           FontSize="10" Foreground="#888888"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <!-- Data-bound schema tree -->
                            <TreeView x:Name="SchemaTree"
                                      ItemsSource="{Binding SchemaGroups}"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      MouseDoubleClick="SchemaTree_MouseDoubleClick">
                                <TreeView.Resources>
                                    <!-- SchemaGroupVM: expandable group -->
                                    <HierarchicalDataTemplate DataType="{x:Type local:SchemaGroupVM}"
                                                              ItemsSource="{Binding Fields}">
                                        <TextBlock Text="{Binding Header}"
                                                   FontWeight="SemiBold" FontSize="11"
                                                   Foreground="#444444"/>
                                    </HierarchicalDataTemplate>
                                    <!-- SchemaFieldVM: leaf field -->
                                    <DataTemplate DataType="{x:Type local:SchemaFieldVM}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FieldName}"
                                                       FontFamily="Consolas" FontSize="11"
                                                       Foreground="#1A5276"/>
                                            <TextBlock Text="{Binding LabelDisplay}"
                                                       FontSize="10" Foreground="#666666"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="True"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- ── GridSplitter levý ── -->
            <GridSplitter Grid.Column="1" Grid.Row="0"
                          HorizontalAlignment="Stretch" Background="#DDDDDD" Cursor="SizeWE"/>

            <!-- ── Canvas ── -->
            <ScrollViewer Grid.Column="2" Grid.Row="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="#E0E0E0"
                          x:Name="CanvasScrollViewer">
                <skia:SKElement x:Name="skCanvas" Width="900" Height="1200"/>
            </ScrollViewer>

            <!-- ── GridSplitter pravý ── -->
            <GridSplitter Grid.Column="3" Grid.Row="0"
                          HorizontalAlignment="Stretch" Background="#DDDDDD" Cursor="SizeWE"/>

            <!-- ── Live Preview (výchozí: skrytý, panel se zobrazí togglem) ── -->
            <Border Grid.Column="4" Grid.Row="0"
                    BorderBrush="#DDDDDD" BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- Záhlaví preview panelu -->
                    <Border DockPanel.Dock="Top"
                            Background="#F0F0F0"
                            BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="PDF"
                                    Click="MenuExportPdf_Click" Padding="8,2"
                                    ToolTip="Exportovat náhled jako PDF..."/>
                            <TextBlock Text="Náhled  ·  vzorová data ze schématu"
                                       FontSize="11" Foreground="#666666"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <!-- Parametry sestavy -->
                    <Border x:Name="PreviewParamsBorder" DockPanel.Dock="Top"
                            Visibility="{Binding HasParameters, Converter={StaticResource BoolToVis}}"
                            Background="#FAFAFA"
                            BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <ItemsControl ItemsSource="{Binding PreviewParameters}"
                                      ItemTemplateSelector="{StaticResource ParamTemplateSelector}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>

                    <!-- Scrollovatelný canvas náhledu -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="#E8E8E8">
                        <skia:SKElement x:Name="skPreview" HorizontalAlignment="Left" Height="800"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ── Status bar ── -->
            <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="5"
                    Background="#F0F0F0" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center" Margin="10,0"
                           FontSize="11" Foreground="#555555"/>
            </Border>

        </Grid>
    </DockPanel>
</Window>
