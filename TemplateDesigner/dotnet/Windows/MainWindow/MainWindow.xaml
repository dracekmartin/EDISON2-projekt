<Window x:Class="TemplateDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:local="clr-namespace:TemplateDesigner"
        xmlns:td="clr-namespace:TemplateDesigner.Designer"
        xmlns:controls="clr-namespace:TemplateDesigner.Controls"
        xmlns:aiguide="clr-namespace:TemplateDesigner.Windows.AiGuideDialog"
        xmlns:eif="clr-namespace:EDControls.EDInputForm;assembly=EDControls"
        xmlns:edstx="clr-namespace:EDControls.EDSearchTextBox;assembly=EDControls"
        Title="Návrhář sestav" Height="768" Width="1280"
        Icon="{StaticResource EDIcons.Molecule}"
        WindowState="Maximized"
        Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Sdílené šablony parametrů (preview lišta + PrintDialog používají stejné). -->
                <ResourceDictionary Source="/Controls/ParameterTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PanelHeader" TargetType="TextBlock">
                <Setter Property="Background"   Value="{DynamicResource EDTheme.Bg.Panel}"/>
                <Setter Property="Padding"      Value="8,6"/>
                <Setter Property="FontWeight"   Value="SemiBold"/>
                <Setter Property="FontSize"     Value="{DynamicResource EDTheme.FontSize.Header}"/>
                <Setter Property="Foreground"   Value="{DynamicResource EDTheme.Text.Primary}"/>
            </Style>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Položka rozbalovacího seznamu instancí. Ne tlačítko: sdílená šablona tlačítka
                 sází obsah na střed napevno, takže by čísla linek stála každé jinde. -->
            <Style x:Key="InstanceListItemRow" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding"    Value="8,4"/>
                <Setter Property="Cursor"     Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource EDTheme.Bg.Hover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Rozměr ikon v toolbaru/paletě - FontService škáluje token spolu s user fontem. -->
            <Style x:Key="ToolbarIconStyle" TargetType="Image">
                <Setter Property="Width"  Value="{DynamicResource EDTheme.IconSize.Default}"/>
                <Setter Property="Height" Value="{DynamicResource EDTheme.IconSize.Default}"/>
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            </Style>

            <!-- ── Section item DataTemplate ── -->
            <DataTemplate x:Key="SectionItemTemplate" DataType="{x:Type local:SectionVM}">
                <StackPanel>
                <TextBlock Text="{Binding ZahlaviStranky}" Margin="2,8,0,2"
                           FontSize="{DynamicResource EDTheme.FontSize.Caption}"
                           Foreground="{DynamicResource EDTheme.Text.Secondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MaZahlaviStranky}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ZahlaviAktivni}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource EDTheme.Accent.Blue}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border Margin="0,2,0,0"
                        Padding="8,5,4,5"
                        CornerRadius="3"
                        Cursor="Hand"
                        Tag="{Binding}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"       Value="{DynamicResource EDTheme.Bg.PanelAlt}"/>
                            <Setter Property="BorderBrush"      Value="{DynamicResource EDTheme.Border.Light}"/>
                            <Setter Property="BorderThickness"  Value="1"/>
                            <Style.Triggers>
                                <!-- Dynamic (non-active) -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsDynamic}" Value="True"/>
                                        <Condition Binding="{Binding IsActive}"  Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background"  Value="{DynamicResource EDTheme.Accent.BlueBg}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource EDTheme.Accent.BlueBorder}"/>
                                </MultiDataTrigger>
                                <!-- Active -->
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Background"      Value="{DynamicResource EDTheme.Accent.BlueSelected}"/>
                                    <Setter Property="BorderBrush"     Value="{DynamicResource EDTheme.Accent.Blue}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.Tag,
                                      RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Vlastnosti sekce…"
                                      Command="{Binding ShowPropertiesCommand}"/>
                            <MenuItem Header="Přesunout nahoru"
                                      Command="{Binding MoveUpCommand}"/>
                            <MenuItem Header="Přesunout dolů"
                                      Command="{Binding MoveDownCommand}"/>
                            <MenuItem Header="Uložit jako šablonu…"
                                      Command="{Binding SaveTemplateCommand}"/>
                            <Separator/>
                            <MenuItem Header="Smazat sekci"
                                      Foreground="{DynamicResource EDTheme.Semantic.Danger}"
                                      Command="{Binding DeleteCommand}"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="▼" MinWidth="18" Padding="2,0" FontSize="{DynamicResource EDTheme.FontSize.Small}"
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding MoveDownCommand}"
                                ToolTip="{td:Tip MoveSectionDown, Text='Přesunout dolů'}"/>
                        <Button DockPanel.Dock="Right"
                                Content="▲" MinWidth="18" Padding="2,0" FontSize="{DynamicResource EDTheme.FontSize.Small}"
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding MoveUpCommand}"
                                ToolTip="{td:Tip MoveSectionUp, Text='Přesunout nahoru'}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="{DynamicResource EDTheme.FontSize.Header}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Subtitle}"
                                       FontSize="{DynamicResource EDTheme.FontSize.Caption}"
                                       Foreground="{DynamicResource EDTheme.Text.Muted}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSubtitle}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBlock Text="{Binding SpolecneNaStrance}" Margin="8,2,0,0" FontStyle="Italic"
                           FontSize="{DynamicResource EDTheme.FontSize.Caption}"
                           Foreground="{DynamicResource EDTheme.Text.Muted}" TextTrimming="CharacterEllipsis"
                           ToolTip="Tiskne se i na této stránce - upravuje se v oddílu Na každé stránce">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MaSpolecneNaStrance}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                </StackPanel>
            </DataTemplate>

            <!-- Parameter DataTemplates jsou ve sdílené ResourceDictionary (viz MergedDictionaries výše).
                 Klíče: ParamBoolTemplate, ParamEnumTemplate, ParamStringTemplate, ParamCommitStringTemplate, ParamTemplateSelector. -->
        </ResourceDictionary>
    </Window.Resources>

    <!-- Kořen: obsah okna a nad ním úvodní obrazovka přes celé okno. -->
    <Grid>
    <DockPanel LastChildFill="True">

        <!-- ═══ Menu ═══ -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource EDTheme.Bg.Footer}">
            <MenuItem Header="Soubor">
                <MenuItem x:Name="MenuNew"    Header="Nová šablona"  InputGestureText="{td:Gesture New}" Click="MenuNew_Click"/>
                <MenuItem x:Name="MenuOpen"   Header="Otevřít z databáze…"  InputGestureText="{td:Gesture Open}" Click="MenuOpen_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuSave"   Header="Uložit do databáze"        InputGestureText="{td:Gesture Save}" Click="MenuSave_Click"/>
                <MenuItem x:Name="MenuSaveAs" Header="Uložit do databáze jako…"                  Click="MenuSaveAs_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuImportJson" Header="Importovat ze souboru…" Command="{Binding ImportJsonCommand}"/>
                <MenuItem x:Name="MenuExportJson" Header="Exportovat do souboru…" Command="{Binding ExportJsonCommand}"/>
                <MenuItem x:Name="MenuRecentFiles" Header="Otevřít poslední soubor"/>
                <Separator/>
                <MenuItem x:Name="MenuPrint" Header="Tisk…" InputGestureText="{td:Gesture Print}" Click="MenuPrint_Click"/>
                <MenuItem x:Name="MenuKontrola" Header="{Binding KontrolaMenuText}" Click="BtnKontrola_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuPageProps" Header="Vlastnosti stránky…" InputGestureText="{td:Gesture PageProperties}" Click="MenuPageProps_Click"/>
                <Separator/>
                <MenuItem Header="Konec" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Upravit">
                <MenuItem x:Name="MenuUndo"   Header="Zpět"   InputGestureText="{td:Gesture Undo}"
                          Command="{Binding UndoCommand}"/>
                <MenuItem x:Name="MenuRedo"   Header="Vpřed"  InputGestureText="{td:Gesture Redo}"
                          Command="{Binding RedoCommand}"/>
                <Separator/>
                <MenuItem x:Name="MenuDelete" Header="Smazat" InputGestureText="{td:Gesture Delete}" Click="MenuDelete_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuZForward"  Header="{td:Action BringForward}" InputGestureText="{td:Gesture BringForward}" Click="BtnZForward_Click"/>
                <MenuItem x:Name="MenuZBackward" Header="{td:Action SendBackward}" InputGestureText="{td:Gesture SendBackward}" Click="BtnZBackward_Click"/>
                <MenuItem x:Name="MenuZFront"    Header="{td:Action BringToFront}" InputGestureText="{td:Gesture BringToFront}" Click="BtnZFront_Click"/>
                <MenuItem x:Name="MenuZBack"     Header="{td:Action SendToBack}" InputGestureText="{td:Gesture SendToBack}" Click="BtnZBack_Click"/>
                <Separator/>
                <MenuItem Header="Zarovnat vlevo"               Click="BtnAlignLeft_Click"/>
                <MenuItem Header="Zarovnat vpravo"              Click="BtnAlignRight_Click"/>
                <MenuItem Header="Zarovnat na střed (vodorovně)" Click="BtnAlignCenterH_Click"/>
                <MenuItem Header="Zarovnat nahoru"              Click="BtnAlignTop_Click"/>
                <MenuItem Header="Zarovnat dolů"                Click="BtnAlignBottom_Click"/>
                <MenuItem Header="Zarovnat na střed (svisle)"  Click="BtnAlignMiddleV_Click"/>
                <Separator/>
                <MenuItem Header="Rozložit vodorovně"           Click="BtnDistributeH_Click"/>
                <MenuItem Header="Rozložit svisle"              Click="BtnDistributeV_Click"/>
                <Separator/>
                <MenuItem Header="Normalizovat pozice…" InputGestureText="{td:Gesture NormalizePositions}" Click="MenuNormalizePositions_Click"/>
                <Separator/>
                <!-- ⚠️ Mění souřadnice prvků v ŠABLONĚ - původní velikost tím zaniká. Měřítko
                     TISKU je něco jiného a bydlí v tiskovém dialogu (`B132`); dokud se obojí
                     jmenovalo „škálovat", nešlo je od sebe poznat. -->
                <MenuItem Header="Přepočítat šablonu na jinou velikost">
                    <MenuItem Header="50 %"  Tag="0.5"  Click="MenuScale_Click"/>
                    <MenuItem Header="75 %"  Tag="0.75" Click="MenuScale_Click"/>
                    <MenuItem Header="90 %"  Tag="0.9"  Click="MenuScale_Click"/>
                    <MenuItem Header="100 %" Tag="1.0"  Click="MenuScale_Click"/>
                    <MenuItem Header="110 %" Tag="1.1"  Click="MenuScale_Click"/>
                    <MenuItem Header="125 %" Tag="1.25" Click="MenuScale_Click"/>
                    <MenuItem Header="150 %" Tag="1.5"  Click="MenuScale_Click"/>
                    <MenuItem Header="200 %" Tag="2.0"  Click="MenuScale_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Kopírovat styl"  InputGestureText="{td:Gesture CopyStyle}" Click="MenuCopyStyle_Click"/>
                <MenuItem Header="Vložit styl"     InputGestureText="{td:Gesture PasteStyle}" Click="MenuPasteStyle_Click"/>
                <Separator/>
                <!-- Prvek s vlastním fontem přebíjí výchozí font dokumentu, takže v šabloně, kde ho
                     má každý prvek u sebe, volba „Výchozí font" nic nedělá. Tohle ho u prvků smaže. -->
                <MenuItem Header="Použít výchozí font u všech prvků"
                          ToolTip="Smaže font nastavený u jednotlivých prvků, aby převzaly výchozí font dokumentu"
                          Click="MenuPrevzitVychoziFont_Click"/>
            </MenuItem>
            <MenuItem Header="Zobrazit">
                <MenuItem x:Name="MenuGrid" Header="Mřížka plátna" IsCheckable="True"
                          IsChecked="{Binding ShowGrid, Mode=TwoWay}"/>
                <MenuItem x:Name="MenuSnap" Header="Přichytit k mřížce plátna" IsCheckable="True"
                          IsChecked="{Binding SnapToGrid, Mode=TwoWay}"/>
                <MenuItem x:Name="MenuSnapElements" Header="Přichytit k prvkům" IsCheckable="True"
                          IsChecked="{Binding SnapToElements, Mode=TwoWay}"/>
                <MenuItem Header="Záhlaví sekcí" IsCheckable="True"
                          IsChecked="{Binding ShowSectionHeaders, Mode=TwoWay}"/>
                <MenuItem Header="Pravítka" IsCheckable="True"
                          IsChecked="{Binding ShowRuler, Mode=TwoWay}"/>
                <Separator/>
                <MenuItem x:Name="MenuSectionsPanel" Header="Levý panel" InputGestureText="{td:Gesture ToggleLeftPanel}" IsCheckable="True" IsChecked="True"
                          Checked="MenuPanelSection_Changed" Unchecked="MenuPanelSection_Changed"/>
                <MenuItem x:Name="MenuPreview" Header="Živý náhled" IsCheckable="True" IsChecked="True"
                          Checked="MenuPreview_Changed" Unchecked="MenuPreview_Changed"/>
            </MenuItem>
            <MenuItem Header="Nástroje">
                <MenuItem x:Name="MenuChangeAgenda" Header="Změnit agendu…" InputGestureText="{td:Gesture ChangeAgenda}"
                          Command="{Binding ChangeAgendaCommand}"/>
                <MenuItem x:Name="MenuManageCacheTemplates" Header="Šablony v databázi…"
                          Command="{Binding OpenFromCacheCommand}"/>
                <MenuItem Header="Úvodní obrazovka" Command="{Binding ShowStartPanelCommand}"/>
                <Separator x:Name="MenuAiSep"/>
                <MenuItem x:Name="MenuAiAssistant" Header="AI Asistent šablon…" Click="MenuAiAssistant_Click"/>
                <Separator x:Name="MenuDevSep" Visibility="Collapsed"/>
                <MenuItem x:Name="MenuImportPdf" Header="Import PDF… (DEV)" Click="MenuImportPdf_Click" Visibility="Collapsed"/>
                <MenuItem x:Name="MenuDevSwitchFirm" Header="Přepnout firmu (DEV)" Visibility="Collapsed"/>
            </MenuItem>
            <MenuItem Header="Nápověda">
                <MenuItem x:Name="MenuHelp" Header="Klávesové zkratky a ovládání" InputGestureText="{td:Gesture Help}" Click="MenuHelp_Click"/>
            </MenuItem>
        </Menu>

        <!-- ═══ Toolbar ═══ -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource EDTheme.Bg.Footer}" BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,0,0,1" Padding="4,2">
            <StackPanel Orientation="Horizontal">

                <!-- ── 1. Soubor ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnNew" Style="{StaticResource ToolbarButton}" ToolTip="{td:Tip New}" Click="MenuNew_Click">
                            <Image Source="{StaticResource EDIcons.New}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button x:Name="BtnOpen" Style="{StaticResource ToolbarButton}" ToolTip="{td:Tip Open}" Click="MenuOpen_Click">
                            <Image Source="{StaticResource EDIcons.Open}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button x:Name="BtnSave" Style="{StaticResource ToolbarButton}" ToolTip="{td:Tip Save}" Click="MenuSave_Click">
                            <Image Source="{StaticResource EDIcons.Save}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Soubor" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 2. Upravit ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnUndo" Style="{StaticResource ToolbarButton}" ToolTip="{td:Tip Undo}" Command="{Binding UndoCommand}">
                            <Image Source="{StaticResource EDIcons.Undo}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button x:Name="BtnRedo" Style="{StaticResource ToolbarButton}" ToolTip="{td:Tip Redo}" Command="{Binding RedoCommand}">
                            <Image Source="{StaticResource EDIcons.Redo}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Upravit" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 3. Stránka a sekce ── (elementy se přetahují z palety, ne přes seznam) -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnPageProps" Style="{StaticResource ToolbarButton}" ToolTip="{td:Tip PageProperties}" Click="MenuPageProps_Click">
                            <Image Source="{StaticResource EDIcons.Document}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button x:Name="BtnAddSection" Style="{StaticResource ToolbarButton}" ToolTip="Přidat sekci" Click="BtnAddSection_Click">
                            <Image Source="{StaticResource EDIcons.AddSection}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Stránka a sekce" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 4. Prvky (tažení na plátno) - tlačítka staví BuildElementPalette() z katalogu prvků ── -->
                <StackPanel>
                    <StackPanel x:Name="ElementPaletteItems" Orientation="Horizontal"/>
                    <TextBlock Text="Prvky" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 5. Vrstva (Z-order) ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnZForward" Style="{StaticResource ToolbarButton}" ToolTip="{td:Tip BringForward}" Click="BtnZForward_Click">
                            <Image Source="{StaticResource EDIcons.ZForward}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button x:Name="BtnZBackward" Style="{StaticResource ToolbarButton}" ToolTip="{td:Tip SendBackward}" Click="BtnZBackward_Click">
                            <Image Source="{StaticResource EDIcons.ZBackward}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button x:Name="BtnZFront" Style="{StaticResource ToolbarButton}" ToolTip="{td:Tip BringToFront}" Click="BtnZFront_Click">
                            <Image Source="{StaticResource EDIcons.ZFront}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button x:Name="BtnZBack" Style="{StaticResource ToolbarButton}" ToolTip="{td:Tip SendToBack}" Click="BtnZBack_Click">
                            <Image Source="{StaticResource EDIcons.ZBack}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Vrstva" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 6. Zarovnat ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Zarovnat vlevo" Click="BtnAlignLeft_Click">
                            <Image Source="{StaticResource EDIcons.AlignLeft}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Zarovnat na střed (vodorovně)" Click="BtnAlignCenterH_Click">
                            <Image Source="{StaticResource EDIcons.AlignCenterH}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Zarovnat vpravo" Click="BtnAlignRight_Click">
                            <Image Source="{StaticResource EDIcons.AlignRight}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Zarovnat nahoru" Click="BtnAlignTop_Click">
                            <Image Source="{StaticResource EDIcons.AlignTop}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Zarovnat na střed (svisle)" Click="BtnAlignMiddleV_Click">
                            <Image Source="{StaticResource EDIcons.AlignCenterV}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Zarovnat dolů" Click="BtnAlignBottom_Click">
                            <Image Source="{StaticResource EDIcons.AlignBottom}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Border Width="1" Background="{DynamicResource EDTheme.Border.Light}" Margin="3,2" VerticalAlignment="Stretch"/>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Rozložit rovnoměrně vodorovně (min 3)" Click="BtnDistributeH_Click">
                            <Image Source="{StaticResource EDIcons.DistributeH}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Rozložit rovnoměrně svisle (min 3)" Click="BtnDistributeV_Click">
                            <Image Source="{StaticResource EDIcons.DistributeV}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Zarovnat" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 7. Mřížka & snap ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Mřížka: zobrazit + velikost -->
                        <ToggleButton x:Name="BtnGrid" Style="{StaticResource ToolbarToggle}" ToolTip="Zobrazit mřížku plátna"
                                      IsChecked="{Binding ShowGrid, Mode=TwoWay}">
                            <Image Source="{StaticResource EDIcons.Grid}" Style="{StaticResource ToolbarIconStyle}"/>
                        </ToggleButton>
                        <ComboBox x:Name="CmbGridSize" Width="Auto" MinWidth="64" VerticalAlignment="Center" Margin="2,0"
                                  ToolTip="Velikost mřížky plátna" SelectedIndex="2"
                                  SelectionChanged="CmbGridSize_SelectionChanged">
                            <ComboBoxItem Content="0,2 mm" Tag="0.2"/>
                            <ComboBoxItem Content="0,5 mm" Tag="0.5"/>
                            <ComboBoxItem Content="1 mm"   Tag="1"/>
                            <ComboBoxItem Content="2 mm"   Tag="2"/>
                            <ComboBoxItem Content="5 mm"   Tag="5"/>
                            <ComboBoxItem Content="10 mm"  Tag="10"/>
                        </ComboBox>

                        <!-- Vizuální oddělovač podskupin "Mřížka" vs "Snap" -->
                        <Border Width="1" Background="{DynamicResource EDTheme.Border.Light}" Margin="6,2" VerticalAlignment="Stretch"/>

                        <!-- Snap k mřížce -->
                        <ToggleButton x:Name="BtnSnap" Style="{StaticResource ToolbarToggle}" ToolTip="Přichytit k mřížce plátna"
                                      IsChecked="{Binding SnapToGrid, Mode=TwoWay}"
                                      Content="M" FontSize="{DynamicResource EDTheme.FontSize.Body}" FontWeight="SemiBold"/>

                        <!-- Snap k objektům + mezera -->
                        <ToggleButton x:Name="BtnSnapElements" Style="{StaticResource ToolbarToggle}" ToolTip="Přichytávat k objektům (prvky + okraje sekce)"
                                      IsChecked="{Binding SnapToElements, Mode=TwoWay}"
                                      Content="O" FontSize="{DynamicResource EDTheme.FontSize.Body}" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbSnapGap" Width="Auto" MinWidth="64" VerticalAlignment="Center" Margin="2,0"
                                  ToolTip="Mezera mezi objekty při přichytávání a duplikaci"
                                  SelectedIndex="2"
                                  SelectionChanged="CmbSnapGap_SelectionChanged">
                            <ComboBoxItem Content="bez mezery" Tag="0"/>
                            <ComboBoxItem Content="1 mm"  Tag="1"/>
                            <ComboBoxItem Content="2 mm"  Tag="2"/>
                            <ComboBoxItem Content="3 mm"  Tag="3"/>
                            <ComboBoxItem Content="5 mm"  Tag="5"/>
                            <ComboBoxItem Content="10 mm" Tag="10"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="Mřížka plátna a přichytávání" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 8. Zoom (návrhové plátno + náhled) ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="CmbZoom" Width="Auto" MinWidth="64" SelectedIndex="2" VerticalAlignment="Center" Margin="4,0"
                                  ToolTip="Zoom návrháře"
                                  SelectionChanged="CmbZoom_SelectionChanged">
                            <ComboBoxItem Content=" 50 %"/>
                            <ComboBoxItem Content=" 75 %"/>
                            <ComboBoxItem Content="100 %"/>
                            <ComboBoxItem Content="150 %"/>
                            <ComboBoxItem Content="200 %"/>
                            <ComboBoxItem Content="300 %"/>
                            <ComboBoxItem Content="400 %"/>
                            <ComboBoxItem Content="500 %"/>
                        </ComboBox>
                        <Button x:Name="BtnFitPage" Style="{StaticResource ToolbarButton}"
                                ToolTip="{td:Tip FitToPage}"
                                Click="BtnFitPage_Click" Content="Fit" FontSize="{DynamicResource EDTheme.FontSize.Body}" FontWeight="SemiBold"/>
                        <Button x:Name="BtnResetView" Style="{StaticResource ToolbarButton}"
                                ToolTip="{td:Tip ActualSize, Text='Skutečná velikost 100 % (plátno i náhled)'}"
                                Click="BtnResetView_Click" Content="1:1" FontSize="{DynamicResource EDTheme.FontSize.Body}" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbPreviewZoom" Width="Auto" MinWidth="64" SelectedIndex="2" VerticalAlignment="Center" Margin="4,0"
                                  ToolTip="Zoom náhledu"
                                  SelectionChanged="CmbPreviewZoom_SelectionChanged">
                            <ComboBoxItem Content=" 50 %"/>
                            <ComboBoxItem Content=" 75 %"/>
                            <ComboBoxItem Content="100 %"/>
                            <ComboBoxItem Content="150 %"/>
                            <ComboBoxItem Content="200 %"/>
                            <ComboBoxItem Content="300 %"/>
                            <ComboBoxItem Content="400 %"/>
                            <ComboBoxItem Content="500 %"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="Zoom" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 9. Panely ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="BtnToggleLeftPanel" Style="{StaticResource ToolbarToggle}"
                                      ToolTip="{td:Tip ToggleLeftPanel}"
                                      IsChecked="True" Checked="BtnToggleLeftPanel_Changed" Unchecked="BtnToggleLeftPanel_Changed"
                                      Content="☰" FontSize="{DynamicResource EDTheme.FontSize.Header}"/>
                        <ToggleButton x:Name="BtnPreview" Style="{StaticResource ToolbarToggle}" ToolTip="Zobrazit/skrýt živý náhled"
                                      IsChecked="True" Checked="BtnPreview_Changed" Unchecked="BtnPreview_Changed">
                            <Image Source="{StaticResource EDIcons.Eye}" Style="{StaticResource ToolbarIconStyle}"/>
                        </ToggleButton>
                    </StackPanel>
                    <TextBlock Text="Panely" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── Data + Export (u pravého okraje, logicky nad náhledem) ── -->
                <!-- ── Data (obnovit data náhledu) ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnRefreshData" Style="{StaticResource ToolbarButton}"
                                Command="{Binding RefreshDataCommand}"
                                ToolTip="{td:Tip RefreshData}"
                                Content="↻" FontSize="{DynamicResource EDTheme.FontSize.Header}"/>
                    </StackPanel>
                    <TextBlock Text="Data" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── Export ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnKontrola" Style="{StaticResource ToolbarButton}" Click="BtnKontrola_Click"
                                ToolTip="{Binding KontrolaTooltip}">
                            <!-- Lupa kreslená obrysem v barvě textu - obrázková sada (EDIcons) ji nemá
                               a znak písma se vykreslil plný černý, proti obrysovým ikonám okolo. -->
                            <Viewbox Width="{DynamicResource EDTheme.IconSize.Default}" Height="{DynamicResource EDTheme.IconSize.Default}">
                                <Canvas Width="16" Height="16">
                                    <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="9" Height="9"
                                             Stroke="{DynamicResource EDTheme.Text.Primary}" StrokeThickness="1.5"/>
                                    <Line X1="9.2" Y1="9.2" X2="14.5" Y2="14.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stroke="{DynamicResource EDTheme.Text.Primary}" StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="BtnPrint" Style="{StaticResource ToolbarButton}" ToolTip="{td:Tip Print}" Click="MenuPrint_Click">
                            <Image Source="{StaticResource EDIcons.Print}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Tisk" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ═══ Hlavní obsah ═══ -->
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <!-- Panel sekcí -->
                <ColumnDefinition x:Name="SectionsColumn" Width="200" MinWidth="120"/>
                <ColumnDefinition x:Name="SectionsSplitterColumn" Width="4"/>
                <!-- Canvas -->
                <ColumnDefinition x:Name="CanvasColumn" Width="*" MinWidth="300"/>
                <ColumnDefinition Width="4"/>
                <!-- Live preview -->
                <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <!-- Hlavní plocha -->
                <RowDefinition Height="*" MinHeight="100"/>
                <!-- Status bar -->
                <RowDefinition Height="Auto" MinHeight="26"/>
            </Grid.RowDefinitions>

            <!-- ── Panel sekcí + pole agendy ── -->
            <Border Grid.Column="0" Grid.Row="0"
                    BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,0,1,0">
                <TabControl x:Name="LeftTabControl" SelectionChanged="LeftTabControl_SelectionChanged">
                    <!-- ── Záložka Sekce ── -->
                    <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource EDIcons.Sections}" Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Sekce" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom"
                                    BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,1,0,0"
                                    Padding="6" Background="{DynamicResource EDTheme.Bg.Footer}">
                                <UniformGrid Columns="2">
                                    <Button x:Name="BtnAddSectionPanel" Content="Přidat sekci"
                                            Click="BtnAddSection_Click" HorizontalAlignment="Stretch" Padding="4,4" Margin="0,0,3,0"/>
                                    <Button x:Name="BtnAddPagePanel" Content="Přidat stránku"
                                            ToolTip="Nová stránka dokladu, třeba rub stazky - na plátně vlastní list"
                                            Click="BtnAddPage_Click" HorizontalAlignment="Stretch" Padding="4,4" Margin="3,0,0,0"/>
                                </UniformGrid>
                            </Border>
                            <!-- Data-bound sections list. Scrolluje ListBox sám: obalený ScrollViewerem
                                 by kolečko myši spolkl jeho vnitřní scroller. CanContentScroll=False
                                 = plynulý posun po pixelech a bez virtualizace, drag&drop sekcí
                                 potřebuje kontejnery všech položek (ContainerFromIndex). -->
                            <ListBox x:Name="SectionsList"
                                     ItemsSource="{Binding Sections}"
                                     ItemTemplate="{StaticResource SectionItemTemplate}"
                                     Margin="6,4"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="False"
                                     SelectionChanged="SectionsList_SelectionChanged"
                                     MouseDoubleClick="SectionsList_MouseDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding"         Value="0"/>
                                        <Setter Property="Margin"          Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <!-- Remove default selection highlight - SectionVM.IsActive drives the visual -->
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>
                    </TabItem>

                    <!-- ── Záložka Datová pole ── -->
                    <TabItem x:Name="TabFields"><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource EDIcons.Fields}" Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Datová pole" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                        <DockPanel>
                            <!-- Záhlaví: název agendy -->
                            <Border DockPanel.Dock="Top"
                                    BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,0,0,1"
                                    Background="{DynamicResource EDTheme.Bg.Panel}" Padding="8,5"
                                    Cursor="Hand"
                                    ToolTip="{td:Tip ChangeAgenda}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding ChangeAgendaCommand}"/>
                                </Border.InputBindings>
                                <TextBlock x:Name="AgendaNameTextBlock"
                                           Text="{Binding AgendaNameText}"
                                           FontSize="{DynamicResource EDTheme.FontSize.Body}" Foreground="{DynamicResource EDTheme.Text.Secondary}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <!-- Tip dole -->
                            <Border DockPanel.Dock="Bottom"
                                    BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,1,0,0"
                                    Background="{DynamicResource EDTheme.Bg.Footer}" Padding="6,4">
                                <TextBlock Text="Tip: dvojklik = vložit {POLE}"
                                           FontSize="{DynamicResource EDTheme.FontSize.Caption}" Foreground="{DynamicResource EDTheme.Text.Muted}"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <!-- Data-bound schema tree + empty-state -->
                            <Grid>
                            <TreeView x:Name="SchemaTree"
                                      ItemsSource="{Binding SchemaGroups}"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      MouseDoubleClick="SchemaTree_MouseDoubleClick">
                                <TreeView.Resources>
                                    <!-- SchemaGroupVM: expandable group -->
                                    <HierarchicalDataTemplate DataType="{x:Type local:SchemaGroupVM}"
                                                              ItemsSource="{Binding Fields}">
                                        <TextBlock Text="{Binding Header}"
                                                   FontWeight="SemiBold" FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                                   Foreground="{DynamicResource EDTheme.Text.Header}"/>
                                    </HierarchicalDataTemplate>
                                    <!-- SchemaFieldVM: leaf field. Tooltip ukáže plný název + label
                                         (řádek se při úzkém panelu ořízne clipem, „…" TreeView nedělá). -->
                                    <DataTemplate DataType="{x:Type local:SchemaFieldVM}">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FieldName}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Label}"/>
                                                </StackPanel>
                                            </StackPanel.ToolTip>
                                            <TextBlock Text="{Binding FieldName}"
                                                       FontFamily="Consolas" FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                                       Foreground="{DynamicResource EDTheme.Accent.BlueDark}"/>
                                            <TextBlock Text="{Binding LabelDisplay}"
                                                       FontSize="{DynamicResource EDTheme.FontSize.Caption}" Foreground="{DynamicResource EDTheme.Text.Muted}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="True"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                            <!-- Empty-state: bez agendy/DB nebo obecná šablona → žádná pole -->
                            <TextBlock Visibility="{Binding ShowFieldsEmptyState, Converter={StaticResource BoolToVis}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="16" MaxWidth="220" TextAlignment="Center" TextWrapping="Wrap"
                                       FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                       Foreground="{DynamicResource EDTheme.Text.Muted}"
                                       Text="Tato agenda nemá databázová pole. Pro práci s daty přepni agendu (Ctrl+Shift+A)."/>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                    <!-- ── Záložka Vlastnosti (inline properties panel) ── -->
                    <TabItem x:Name="TabProperties"><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource EDIcons.Properties}" Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Vlastnosti" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                        <DockPanel>
                            <controls:FormatToolbar x:Name="FormatToolbar" DockPanel.Dock="Top"/>
                            <!-- Jeden element = EDInputForm (W4-10); 0/více = starý PropertyDescriptor panel (message/multi). -->
                            <Grid>
                                <controls:InlinePropertiesForm x:Name="InlineElementForm" Visibility="Collapsed"/>
                                <controls:PropertiesPanel x:Name="InlinePropertiesPanel"/>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                    <!-- ── Záložka Strom šablony ── -->
                    <TabItem x:Name="TabTree"><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource EDIcons.Tree}" Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Strom" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                        <controls:TemplateTreePanel x:Name="TreePanel"/>
                    </TabItem>
                    <!-- ── Záložka AI průvodce ── -->
                    <TabItem x:Name="TabAiGuide"><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource EDIcons.Assistant}" Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Pomocník" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                        <aiguide:AiGuidePanel DataContext="{Binding AiGuide}"/>
                    </TabItem>
                    <!-- ── Záložka Parametry sestavy ── -->
                    <TabItem x:Name="TabParams"><TabItem.Header><StackPanel Orientation="Horizontal"><Viewbox Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center"><Canvas Width="16" Height="16"><Line X1="1" Y1="4" X2="15" Y2="4" Stroke="{DynamicResource EDTheme.Text.Header}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Line X1="1" Y1="8" X2="15" Y2="8" Stroke="{DynamicResource EDTheme.Text.Header}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Line X1="1" Y1="12" X2="15" Y2="12" Stroke="{DynamicResource EDTheme.Text.Header}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Ellipse Canvas.Left="9" Canvas.Top="2" Width="4" Height="4" Fill="{DynamicResource EDTheme.Text.Header}"/><Ellipse Canvas.Left="3" Canvas.Top="6" Width="4" Height="4" Fill="{DynamicResource EDTheme.Text.Header}"/><Ellipse Canvas.Left="8" Canvas.Top="10" Width="4" Height="4" Fill="{DynamicResource EDTheme.Text.Header}"/></Canvas></Viewbox><TextBlock Text="Parametry" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                        <Grid>
                            <!-- Parametry sestavy renderuje EDInputForm z Caché (AgendaParams, includeExport=0)
                                 - stejný stack jako tiskový dialog, jen bez export skupiny. Skupiny (Seznam
                                 zastávek / Minuty odjezdů / Poznámky) řídí `group` z GetParameters.
                                 CacheClass + InitParams + FieldChanged/visibleWhen wiring je v code-behindu. -->
                            <!-- Bez vnějšího ScrollVieweru: EDInputForm scrolluje sám. Vnější scroller by mu dal
                                 nekonečnou výšku a vnitřní by kolečko myši spolkl, aniž by posunul. -->
                            <eif:EDInputForm x:Name="ParamsTabForm" Margin="4"
                                             Visibility="{Binding HasParameters, Converter={StaticResource BoolToVis}}"/>
                            <!-- Empty-state: šablona bez parametrů (obecná / faktura) -->
                            <TextBlock Text="Tato šablona nemá parametry." TextWrapping="Wrap"
                                       Foreground="{DynamicResource EDTheme.Text.Secondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasParameters}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- ── GridSplitter levý ── -->
            <!-- Pozadí = plocha plátna a FocusVisualStyle vypnutý: dělič nesmí po tažení nechat
                 tečkovaný rámeček ani světlejší linku (dohromady působily jako „zdvojený pruh"). -->
            <GridSplitter x:Name="SectionsSplitter" Grid.Column="1" Grid.Row="0" FocusVisualStyle="{x:Null}"
                          HorizontalAlignment="Stretch" Background="{DynamicResource EDTheme.Bg.Canvas}" Cursor="SizeWE"/>

            <!-- ── Canvas ── -->
            <DockPanel Grid.Column="2" Grid.Row="0">
            <!-- Přepínač stránek šablony (`B184`) - stejný 34px pruh jako stránkování nad náhledem
                 a na stejném místě, rezervovaný vždy, aby plátno začínalo ve stejné výšce jako
                 náhled. Obsah jen u šablony o víc stránkách; jednostránková (jízdní řády) má jen
                 souvislý horní okraj. Text má pevnou šířku jako nabídka nad náhledem, aby šipky
                 při přepnutí neposkakovaly. -->
            <Grid DockPanel.Dock="Top" Height="34" Background="{DynamicResource EDTheme.Bg.Canvas}">
                <Border Visibility="{Binding MaPredlohy, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource EDTheme.Bg.PanelAlt}"
                        BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="◀" Command="{Binding PredchoziPredlohaCommand}" ToolTip="Předchozí stránka šablony"
                                    FontSize="{DynamicResource EDTheme.FontSize.Body}" Padding="8,1" MinWidth="28"/>
                            <TextBlock Text="{Binding PredlohaText}" Width="120" Margin="8,0"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                       ToolTip="Stránka šablony, kterou navrhujete. Kolik stránek z ní vyjde s daty, ukazuje náhled."/>
                            <Button Content="▶" Command="{Binding DalsiPredlohaCommand}" ToolTip="Další stránka šablony"
                                    FontSize="{DynamicResource EDTheme.FontSize.Body}" Padding="8,1" MinWidth="28"/>
                        </StackPanel>
                        <Button Content="Přidat stránku" Click="BtnAddPage_Click" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,8,0" Padding="8,1"
                                ToolTip="Přidat stránku šablony, třeba rub stazky"
                                FontSize="{DynamicResource EDTheme.FontSize.Body}"/>
                    </Grid>
                </Border>
            </Grid>
            <Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource EDTheme.Bg.Canvas}"
                          x:Name="CanvasScrollViewer">
                <Grid>
                    <skia:SKElement x:Name="skCanvas" Width="900" Height="1200"/>
                    <!-- Overlay pro inline edit TextElement. Canvas bez Backgroundu nezachycuje
                         hit testy mimo TextBox; SKElement dostává mouse eventy normálně.
                         Velikost se synchronizuje se skCanvas přes ElementName binding. -->
                    <Canvas x:Name="InlineEditOverlay"
                            Width="{Binding ElementName=skCanvas, Path=Width}"
                            Height="{Binding ElementName=skCanvas, Path=Height}">
                        <!-- White záměrně mimo theme: editace textu probíhá NAD papírem šablony,
                             který je vždy bílý (tiskne se) - pozadí boxu musí splynout s papírem. -->
                        <TextBox x:Name="InlineEditBox" Visibility="Collapsed"
                                 BorderThickness="1.5" BorderBrush="{DynamicResource EDTheme.Accent.Blue}"
                                 Background="White" Padding="2"
                                 AcceptsReturn="True" AcceptsTab="False"
                                 PreviewKeyDown="InlineEditBox_PreviewKeyDown"
                                 TextChanged="InlineEditBox_TextChanged"
                                 LostKeyboardFocus="InlineEditBox_LostKeyboardFocus"/>

                        <!-- Našeptávač datových polí v buňce tabulky - otevře se po napsání „{".
                             Ručně psané {LOKALNI_OZNACENI_LINKY} je pozvánka k překlepu, který se
                             pozná až na výtisku jako vytištěná složená závorka. -->
                        <ListBox x:Name="CellFieldSuggestBox" Visibility="Collapsed"
                                 MaxHeight="180" MinWidth="220"
                                 DisplayMemberPath="Label"
                                 BorderThickness="1" BorderBrush="{DynamicResource EDTheme.Accent.Blue}"
                                 Background="{DynamicResource EDTheme.Bg.Panel}"
                                 MouseLeftButtonUp="CellFieldSuggestBox_MouseLeftButtonUp"/>
                    </Canvas>
                </Grid>
            </ScrollViewer>
            </Grid>
            </DockPanel>

            <!-- ── GridSplitter pravý ── -->
            <GridSplitter Grid.Column="3" Grid.Row="0" FocusVisualStyle="{x:Null}"
                          HorizontalAlignment="Stretch" Background="{DynamicResource EDTheme.Bg.Canvas}" Cursor="SizeWE"/>

            <!-- ── Live Preview (výchozí: skrytý, panel se zobrazí togglem) ── -->
            <Border Grid.Column="4" Grid.Row="0"
                    BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- Stránkování dat (pager) - pevný 34px pruh NAHOŘE, rezervovaný vždy (i bez dat),
                         aby náhled začínal ve stejné výšce jako plátno vlevo (34 + 66 padding = 100 =
                         horní okraj stránky návrháře). Bez čeho přepínat je to jen souvislý horní okraj
                         v barvě plochy plátna. -->
                    <Grid DockPanel.Dock="Top" Height="34" Background="{DynamicResource EDTheme.Bg.Canvas}">
                        <Border Visibility="{Binding MaListuNadNahledem, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource EDTheme.Bg.PanelAlt}"
                                BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,0,0,1">
                          <Grid>
                            <!-- Střed panelu. Zarovnání doleva nad stránku se 14. 9. zkusilo a zahodilo:
                                 vypadalo to odstrčeně a šipky patří doprostřed toho, co uživatel vidí.
                                 Že lišta „ustřelovala doprava", nedělalo centrování, ale přetékající
                                 panel (viz OrizniSirkuNahledu v code-behind). -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal"
                                          Visibility="{Binding HasPageNavigation, Converter={StaticResource BoolToVis}}">
                                <Button Content="◀" Command="{Binding PreviousPageCommand}" ToolTip="{Binding PreviousPageTooltip}"
                                        FontSize="{DynamicResource EDTheme.FontSize.Body}" Padding="8,1" MinWidth="28"/>
                                <!-- Přímý skok na stránku dat (zastávka × směr) - bez proklikávání ◀▶.
                                     Pevná šířka: různě dlouhé názvy nesmí posouvat tlačítka ◀▶ pod myší
                                     (dropdown se obsahu přizpůsobí, zavřený box ořízne). -->
                                <ComboBox x:Name="CmbPreviewPage"
                                          ItemsSource="{Binding PreviewPageItems}"
                                          SelectedIndex="{Binding RealPreviewIndex, Mode=TwoWay}"
                                          FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                          VerticalAlignment="Center" Margin="8,0"
                                          Width="230"
                                          ToolTip="Co náhled ukazuje"/>
                                <!-- Druhá osa stránkování: nabídka vlevo přepíná stránky DAT, tenhle
                                     údaj říká, kolik stran sazby té jedné položky leží pod sebou ve
                                     scrollu. Jediná strana se nehlásí - text, který nic neříká (`B131`). -->
                                <TextBlock Text="{Binding PocetStranSazbyText}"
                                           Visibility="{Binding HasPocetStranSazby, Converter={StaticResource BoolToVis}}"
                                           FontSize="{DynamicResource EDTheme.FontSize.Body}" Foreground="{DynamicResource EDTheme.Text.Secondary}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="▶" Command="{Binding NextPageCommand}" ToolTip="{Binding NextPageTooltip}"
                                        FontSize="{DynamicResource EDTheme.FontSize.Body}" Padding="8,1" MinWidth="28"/>
                              </StackPanel>
                              <!-- Týž přepínač stránek šablony jako nad plátnem (`B184`) - přepíná plátno
                                   i náhled naráz. -->
                              <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                                          Visibility="{Binding MaPredlohy, Converter={StaticResource BoolToVis}}">
                                <Button Content="◀" Command="{Binding PredchoziPredlohaCommand}" ToolTip="Předchozí stránka šablony"
                                        FontSize="{DynamicResource EDTheme.FontSize.Body}" Padding="8,1" MinWidth="28"/>
                                <TextBlock Text="{Binding PredlohaText}" Width="120" Margin="8,0"
                                           TextAlignment="Center" VerticalAlignment="Center"
                                           FontSize="{DynamicResource EDTheme.FontSize.Body}"/>
                                <Button Content="▶" Command="{Binding DalsiPredlohaCommand}" ToolTip="Další stránka šablony"
                                        FontSize="{DynamicResource EDTheme.FontSize.Body}" Padding="8,1" MinWidth="28"/>
                              </StackPanel>
                            </StackPanel>
                            <!-- Jen u šablony o víc stránkách (`B184`); jednostránková ho nemá. -->
                            <CheckBox Content="Náhled všech stránek" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Visibility="{Binding MaPredlohy, Converter={StaticResource BoolToVis}}"
                                      IsChecked="{Binding NahledVsechStranek, Mode=TwoWay}"
                                      FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                      ToolTip="Zapnuto: všechny stránky pod sebou, posun náhledu přepíná stránku v návrhu. Vypnuto: jen stránky z otevřené stránky šablony."/>
                          </Grid>
                        </Border>
                    </Grid>

                    <!-- Scrollovatelný canvas náhledu - vyplní zbytek, začíná nahoře (zarovnané s návrhářem).
                         Pozadí = tentýž token jako plocha, kterou kreslí Skia (CanvasTheme.Background),
                         aby pod kratším obsahem neprosvítala jiná barva. -->
                    <ScrollViewer x:Name="PreviewScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="{DynamicResource EDTheme.Bg.Canvas}">
                        <skia:SKElement x:Name="skPreview" HorizontalAlignment="Left" Height="800"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ── Status bar ── -->
            <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="5"
                    Background="{DynamicResource EDTheme.Bg.Panel}"
                    BorderBrush="{DynamicResource EDTheme.Border.Light}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1) Agenda chip (klikatelný - ChangeAgendaCommand) -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource EDTheme.Accent.GreenBg}" Padding="10,3" CornerRadius="3" Margin="0,2"
                            Cursor="Hand"
                            ToolTip="{td:Tip ChangeAgenda}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ChangeAgendaCommand}"/>
                        </Border.InputBindings>
                        <TextBlock Text="{Binding AgendaNameText}"
                                   FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                   Foreground="{DynamicResource EDTheme.Accent.GreenDark}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="1" Width="1" Background="{DynamicResource EDTheme.Border.Light}"/>

                    <!-- 2) Instance chip (klikatelný - OpenInstancePicker) -->
                    <Border x:Name="InstanceChip" Grid.Column="2"
                            Background="{DynamicResource EDTheme.Accent.BlueBg}" Padding="10,3" CornerRadius="3" Margin="0,2"
                            Cursor="Hand"
                            ToolTip="{Binding InstancePickerHint}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenInstancePickerCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="◀" Command="{Binding PreviousInstanceCommand}"
                                    Visibility="{Binding HasMultipleActiveInstances, Converter={StaticResource BoolToVis}}"
                                    Background="Transparent" BorderThickness="0" Padding="4,0"
                                    FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                    Foreground="{DynamicResource EDTheme.Accent.BlueDark}"
                                    Cursor="Hand" Margin="0,0,4,0"
                                    ToolTip="{Binding PreviousInstanceTooltip}"/>
                            <!-- Pevná šířka jen při více instancích - různě dlouhé názvy linek jinak
                                 posouvají tlačítko ▶ pod myší při proklikávání. -->
                            <TextBlock Text="{Binding ActiveInstanceText}"
                                       FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                       Foreground="{DynamicResource EDTheme.Accent.BlueDark}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ActiveInstanceText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMultipleActiveInstances}" Value="True">
                                                <Setter Property="Width" Value="260"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Šipka nahoru drží vzhled sousedních šipek; seznam se rozbaluje nad lištu. -->
                            <Button Content="▲" Command="{Binding OpenInstanceListCommand}"
                                    Visibility="{Binding HasMultipleActiveInstances, Converter={StaticResource BoolToVis}}"
                                    Background="Transparent" BorderThickness="0" Padding="4,0"
                                    FontSize="{DynamicResource EDTheme.FontSize.Header}"
                                    Foreground="{DynamicResource EDTheme.Accent.BlueDark}"
                                    Cursor="Hand" Margin="4,0,0,0"
                                    ToolTip="{Binding InstancePickerHint}"/>
                            <Button Content="▶" Command="{Binding NextInstanceCommand}"
                                    Visibility="{Binding HasMultipleActiveInstances, Converter={StaticResource BoolToVis}}"
                                    Background="Transparent" BorderThickness="0" Padding="4,0"
                                    FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                    Foreground="{DynamicResource EDTheme.Accent.BlueDark}"
                                    Cursor="Hand" Margin="4,0,0,0"
                                    ToolTip="{Binding NextInstanceTooltip}"/>
                            <!-- Načítání dat linky (jen když trvá déle) - tady u linky, ne ve stavovém řádku. -->
                            <TextBlock Text="načítám…"
                                       Visibility="{Binding NacitaniDat, Converter={StaticResource BoolToVis}}"
                                       FontSize="{DynamicResource EDTheme.FontSize.Body}" FontStyle="Italic"
                                       Foreground="{DynamicResource EDTheme.Text.Secondary}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <!-- Zvolená skupina linek (filtr) - viditelná jen když je zvolená -->
                            <TextBlock Text="{Binding ActiveSkupinaText}"
                                       Visibility="{Binding HasActiveSkupina, Converter={StaticResource BoolToVis}}"
                                       FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                       Foreground="{DynamicResource EDTheme.Accent.BlueDark}"
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>

                            <!-- Seznam vybraných instancí. Popup je v logickém stromu chipu, takže
                                 dědí DataContext okna a položky se vážou přímo na ViewModel. -->
                            <Popup IsOpen="{Binding IsInstanceListOpen, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=InstanceChip}"
                                   Placement="Top" VerticalOffset="-4"
                                   StaysOpen="False" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource EDTheme.Bg.Surface}"
                                        BorderBrush="{DynamicResource EDTheme.Border.Light}"
                                        BorderThickness="1" CornerRadius="3"
                                        MinWidth="220" MaxWidth="340" Padding="0,4">
                                    <StackPanel>
                                        <edstx:EDSearchTextBox Text="{Binding InstanceFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding ShowInstanceFilter, Converter={StaticResource BoolToVis}}"
                                                 Placeholder="{Binding InstanceFilterHint}"
                                                 Margin="8,4" Padding="4,2"
                                                 FontSize="{DynamicResource EDTheme.FontSize.Body}"/>
                                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding InstanceVolby}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource InstanceListItemRow}">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick"
                                                                              Command="{Binding DataContext.SelectInstanceCommand,
                                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                              CommandParameter="{Binding Index}"/>
                                                            </Border.InputBindings>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="16"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="✓"
                                                                           Foreground="{DynamicResource EDTheme.Accent.BlueDark}"
                                                                           Visibility="{Binding JeAktualni, Converter={StaticResource BoolToVis}}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Display}"
                                                                           Foreground="{DynamicResource EDTheme.Text.Primary}"
                                                                           FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Width="1" Background="{DynamicResource EDTheme.Border.Light}"/>

                    <!-- 3a) Stav výběru (klidová zóna - element / sekce) -->
                    <TextBlock x:Name="SelectionStatusText" Grid.Column="4"
                               Text="{Binding SelectionStatusText}"
                               VerticalAlignment="Center" Margin="10,0"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource EDTheme.FontSize.Body}"
                               Foreground="{DynamicResource EDTheme.Text.Secondary}"/>

                    <!-- 3b) Akce / progres (transientní zóna - uloženo / chyba / export N/N; nepřepíše se výběrem) -->
                    <TextBlock x:Name="StatusText" Grid.Column="5"
                               Text="{Binding StatusText}"
                               VerticalAlignment="Center" Margin="10,0"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource EDTheme.FontSize.Body}"
                               Foreground="{DynamicResource EDTheme.Text.Primary}"/>

                    <!-- 4) Hlášky (B178): jeden kompaktní blok - chyba (na papíře něco chybí nebo přetéká),
                         upozornění (vytiskne se jinak, než je nastavené), informace (návrhář něco upravil,
                         jak má - nesmí vypadat jako vada). V bloku jen ikony
                         s počty; klik rozbalí seznam nahoru, klik na řádek vybere prvek. -->
                    <StackPanel x:Name="HlaseniPanel" Grid.Column="6" Grid.ColumnSpan="4"
                                Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Right">
                        <StackPanel.Resources>
                            <Style x:Key="HlaseniOdznak" TargetType="Button">
                                <Setter Property="Padding" Value="10,3"/>
                                <Setter Property="Margin" Value="6,2,0,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4">
                                                <Run Text="Hlášky k sestavě"/><Run Text=" (kliknutím zobrazíte seznam)" FontWeight="Normal"/>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <controls:HlaseniIkona Zavaznost="Chyba" Margin="0,0,6,0"/>
                                                <TextBlock><Run Text="Problém" FontWeight="SemiBold"/><Run Text=" - část obsahu se nevytiskne: ořízne se nebo přeteče"/></TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <controls:HlaseniIkona Zavaznost="Upozorneni" Margin="0,0,6,0"/>
                                                <TextBlock><Run Text="Upozornění" FontWeight="SemiBold"/><Run Text=" - výstup se liší od nastavení šablony: náhradní font, příliš malý kód, nesplněný počet stran"/></TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <controls:HlaseniIkona Zavaznost="Informace" Margin="0,0,6,0"/>
                                                <TextBlock><Run Text="Informace" FontWeight="SemiBold"/><Run Text=" - obsah je upravený podle nastavení šablony: zmenšené písmo, zmenšení na zadaný počet stran"/></TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>

                        <Button Style="{StaticResource HlaseniOdznak}" Command="{Binding OpenHlaseniListCommand}"
                                Background="{DynamicResource EDTheme.Bg.Surface}" BorderBrush="{DynamicResource EDTheme.Border.Light}"
                                Visibility="{Binding HasHlaseni, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Ikona a počet za každou závažnost, která je - text je až v rozbaleném seznamu,
                                     aby šířka bloku nezávisela na délce hlášky (rozhodnutí Jan 24. 9.). -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                                Visibility="{Binding HasChyby, Converter={StaticResource BoolToVis}}">
                                        <controls:HlaseniIkona Zavaznost="Chyba" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding PocetChyb}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource EDTheme.Text.Primary}" FontSize="{DynamicResource EDTheme.FontSize.Body}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                                Visibility="{Binding HasUpozorneni, Converter={StaticResource BoolToVis}}">
                                        <controls:HlaseniIkona Zavaznost="Upozorneni" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding PocetUpozorneni}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource EDTheme.Text.Primary}" FontSize="{DynamicResource EDTheme.FontSize.Body}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0"
                                                Visibility="{Binding HasInformace, Converter={StaticResource BoolToVis}}">
                                        <controls:HlaseniIkona Zavaznost="Informace" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding PocetInformaci}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource EDTheme.Text.Primary}" FontSize="{DynamicResource EDTheme.FontSize.Body}"/>
                                    </StackPanel>
                                </StackPanel>

                            </StackPanel>
                        </Button>

                        <Popup IsOpen="{Binding IsHlaseniListOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=HlaseniPanel}"
                               Placement="Top" VerticalOffset="-4"
                               StaysOpen="False" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource EDTheme.Bg.Surface}"
                                    BorderBrush="{DynamicResource EDTheme.Border.Light}"
                                    BorderThickness="1" CornerRadius="3"
                                    MinWidth="320" MaxWidth="640" Padding="0,4">
                                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Hlaseni}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Radek" Padding="10,4" Background="Transparent">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.VybratPrvekHlaseniCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <controls:HlaseniIkona Zavaznost="{Binding Zavaznost}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                        <!-- Jednotný tvar: kde (tučně) · co se stalo → krátká rada (šedě). -->
                                                        <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource EDTheme.Text.Primary}"
                                                                   FontSize="{DynamicResource EDTheme.FontSize.Body}">
                                                            <Run Text="{Binding Kde, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding Co, Mode=OneWay}"/><Run Text="{Binding RadaVRadku, Mode=OneWay}" Foreground="{DynamicResource EDTheme.Text.Secondary}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <!-- Řádek s prvkem je klikací - kurzor a podbarvení to napoví. -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsMouseOver, ElementName=Radek}" Value="True"/>
                                                            <Condition Binding="{Binding MaPrvek}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="Radek" Property="Background" Value="{DynamicResource EDTheme.Bg.Hover}"/>
                                                        <Setter TargetName="Radek" Property="Cursor" Value="Hand"/>
                                                    </MultiDataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </DockPanel>

    <!-- Úvodní obrazovka po spuštění bez linky: karta přes celé okno nad ztlumeným návrhářem, aby ji
         nepřekryl ani neodsunul žádný panel (Jan 3. 11.). Zmizí volbou, křížkem, Esc nebo klikem vedle karty -
         viz StartPanelViewModel. -->
    <Grid DataContext="{Binding StartPanel}"
          Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
        <Border Background="{DynamicResource EDTheme.Bg.Scrim}" MouseLeftButtonDown="StartPanelScrim_MouseLeftButtonDown"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <!-- Karta bez stínu a bez společného podkladu: stín posuvná oblast ořízne do obdélníku a pod
                 zakulaceným záhlavím by prosvítal podklad karty (Jan 3. 11.). Okraj tvoří záhlaví, tělo
                 a patička samy, od okna kartu oddělí ztlumení. -->
            <Border Width="600">
                <Border.Resources>
                    <!-- Šablona na jeden klik: řádek se zarovnáním vlevo, vpravo kdy byla upravena. Vlastní
                         šablona tlačítka - výchozí vzhled tlačítka obsah centruje a řádky pak působily rozházeně. -->
                    <DataTemplate x:Key="StartPanelSablona">
                        <Button Command="{Binding DataContext.OpenTemplateCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="ToolTip" Value="Otevřít šablonu"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMline}" Value="True">
                                            <Setter Property="ToolTip" Value="Otevře se jako kopie - po úpravě ji uložíte jako šablonu vaší firmy."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <!-- Řádek s rámečkem a šipkou, ať je vidět, že se vybírá. -->
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Pozadi" Background="{DynamicResource EDTheme.Bg.Surface}" CornerRadius="6" Padding="12,9"
                                            BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pozadi" Property="Background" Value="{DynamicResource EDTheme.Accent.BlueBg}"/>
                                            <Setter TargetName="Pozadi" Property="BorderBrush" Value="{DynamicResource EDTheme.Accent.Blue}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Pozadi" Property="Background" Value="{DynamicResource EDTheme.Accent.BlueBg}"/>
                                            <Setter TargetName="Pozadi" Property="BorderBrush" Value="{DynamicResource EDTheme.Accent.Blue}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Pozadi" Property="Background" Value="{DynamicResource EDTheme.Accent.BlueSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <DockPanel>
                                <Image Width="20" Height="20" Margin="0,0,12,0"
                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Source" Value="{StaticResource EDIcons.Document}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMline}" Value="True">
                                                    <Setter Property="Source" Value="{StaticResource EDIcons.MlineLogo}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="›" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,-2,0,0"
                                           FontSize="{DynamicResource EDTheme.FontSize.Title}"
                                           Foreground="{DynamicResource EDTheme.Accent.Blue}"/>
                                <TextBlock Text="{Binding Detail}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                           FontSize="{DynamicResource EDTheme.FontSize.Small}"
                                           Foreground="{DynamicResource EDTheme.Text.Muted}"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           FontWeight="SemiBold" FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                           Foreground="{DynamicResource EDTheme.Text.Primary}"/>
                            </DockPanel>
                        </Button>
                    </DataTemplate>

                    <!-- Nadpis oddílu vedle akcentové značky. -->
                    <Style x:Key="StartPanelNadpis" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="{DynamicResource EDTheme.FontSize.Body}"/>
                        <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Header}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </Border.Resources>
                <StackPanel>
                    <!-- Záhlaví: logo, název a k čemu obrazovka je, na brandovém pruhu jako hlavičky seznamů a formulářů. -->
                    <Border CornerRadius="8,8,0,0" Padding="24,18,12,18" Background="{DynamicResource EDTheme.Accent.Header}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="×" Command="{Binding CloseCommand}" ToolTip="Zavřít"
                                    VerticalAlignment="Top" Margin="12,-8,0,0" Cursor="Hand"
                                    FontSize="{DynamicResource EDTheme.FontSize.Title}" Foreground="{DynamicResource EDTheme.OnAccent.Text}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Pozadi" Background="Transparent" CornerRadius="4" Padding="8,0,8,2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Pozadi" Property="Background" Value="{DynamicResource EDTheme.OnAccent.HoverOverlay}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Pozadi" Property="Background" Value="{DynamicResource EDTheme.OnAccent.PressedOverlay}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Image Source="{StaticResource EDIcons.MoleculeLarge}" Width="40" Height="40" Margin="0,0,16,0"
                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Návrhář sestav" FontSize="{DynamicResource EDTheme.FontSize.Large}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource EDTheme.OnAccent.Text}"/>
                                <TextBlock Text="Otevřete šablonu, se kterou chcete pracovat, nebo založte novou." Margin="0,2,0,0"
                                           TextWrapping="Wrap" FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                           Foreground="{DynamicResource EDTheme.OnAccent.Text}" Opacity="0.85"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Background="{DynamicResource EDTheme.Bg.Surface}" Padding="24,18,24,18">
                    <StackPanel>
                        <!-- Poslední otevřené šablony: šablony, se kterými uživatel naposledy pracoval, v kterékoli agendě -
                             proto nad kartou agendy, ne v ní. -->
                        <StackPanel Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="3" Height="14" CornerRadius="1.5" Margin="0,0,8,0" Background="{DynamicResource EDTheme.Accent.Blue}"/>
                                <TextBlock Text="Poslední otevřené šablony" Style="{StaticResource StartPanelNadpis}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource StartPanelSablona}"/>
                        </StackPanel>

                        <!-- Karta agendy: nahoře agenda nové šablony a její změna, pod ní šablony té agendy
                             (šablony firmy, na konci výchozí šablona M-line s ikonou M-line). Žádné „Doporučeno":
                             kterou šablonu vzít, si uživatel rozhodne sám (Jan 30. 10.). -->
                        <Border CornerRadius="8" BorderBrush="{DynamicResource EDTheme.Accent.BlueBorder}" BorderThickness="1">
                            <StackPanel>
                                <Border Padding="14,10" CornerRadius="7,7,0,0" Background="{DynamicResource EDTheme.Accent.BlueBg}"
                                        BorderBrush="{DynamicResource EDTheme.Accent.BlueBorder}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Změnit agendu…" Command="{Binding ChangeAgendaCommand}"
                                                ToolTip="{td:Tip ChangeAgenda}" Padding="10,3" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Agenda" FontSize="{DynamicResource EDTheme.FontSize.Small}"
                                                       Foreground="{DynamicResource EDTheme.Text.Muted}"/>
                                            <TextBlock Text="{Binding AgendaName}" FontWeight="SemiBold" FontSize="{DynamicResource EDTheme.FontSize.Header}"
                                                       Foreground="{DynamicResource EDTheme.Text.Primary}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <StackPanel Margin="12,12,12,10">
                                    <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                        <Border Width="3" Height="14" CornerRadius="1.5" Margin="0,0,8,0" Background="{DynamicResource EDTheme.Accent.Blue}"/>
                                        <TextBlock Text="Vyberte šablonu" Style="{StaticResource StartPanelNadpis}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding AgendaTemplates}" ItemTemplate="{StaticResource StartPanelSablona}"/>
                                    <TextBlock Text="Pro tuto agendu zatím nejsou žádné šablony." Margin="2,0,0,4"
                                               Visibility="{Binding HasNoAgendaTemplates, Converter={StaticResource BoolToVis}}"
                                               FontSize="{DynamicResource EDTheme.FontSize.Body}" Foreground="{DynamicResource EDTheme.Text.Muted}"/>
                                    <TextBlock FontSize="{DynamicResource EDTheme.FontSize.Body}" Margin="4,6,0,0">
                                        <Hyperlink Command="{Binding OpenFromDatabaseCommand}" Foreground="{DynamicResource EDTheme.Accent.Blue}"
                                                   ToolTip="{td:Tip Open}">Všechny šablony…</Hyperlink>
                                        <Run Text="   "/>
                                        <Hyperlink Command="{Binding StartBlankCommand}" Foreground="{DynamicResource EDTheme.Accent.Blue}"
                                                   ToolTip="{td:Tip New}">Začít s prázdnou šablonou</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </Border>

                    <!-- Patička s odkazy na pomoc. -->
                    <Border Padding="24,10" CornerRadius="0,0,8,8" Background="{DynamicResource EDTheme.Bg.PanelAlt}"
                            BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,1,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource EDTheme.FontSize.Small}">
                            <Hyperlink Click="StartPanelManual_Click" Foreground="{DynamicResource EDTheme.Accent.Blue}"
                                       ToolTip="Otevře nápovědu návrháře v prohlížeči">Nápověda</Hyperlink>
                            <Run Text="   "/>
                            <Hyperlink Click="StartPanelNews_Click" Foreground="{DynamicResource EDTheme.Accent.Blue}"
                                       ToolTip="Otevře novinky v prohlížeči">Novinky</Hyperlink>
                            <Run Text="   "/>
                            <Hyperlink Click="StartPanelShortcuts_Click" Foreground="{DynamicResource EDTheme.Accent.Blue}">Klávesové zkratky (F1)</Hyperlink>
                            <Run Text="   "/>
                            <Hyperlink Click="StartPanelGuide_Click" Foreground="{DynamicResource EDTheme.Accent.Blue}">Zeptat se Pomocníka</Hyperlink>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
    </Grid>
</Window>
