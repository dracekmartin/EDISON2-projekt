<Window x:Class="TemplateDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:local="clr-namespace:TemplateDesigner"
        xmlns:controls="clr-namespace:TemplateDesigner.Controls"
        xmlns:aiguide="clr-namespace:TemplateDesigner.Windows.AiGuideDialog"
        xmlns:eif="clr-namespace:EDControls.EDInputForm;assembly=EDControls"
        Title="Návrhář sestav" Height="768" Width="1280"
        Icon="{StaticResource EDIcons.Molecule}"
        WindowState="Maximized"
        Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Sdílené šablony parametrů (preview lišta + PrintDialog používají stejné). -->
                <ResourceDictionary Source="/Controls/ParameterTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PanelHeader" TargetType="TextBlock">
                <Setter Property="Background"   Value="{DynamicResource EDTheme.Bg.Panel}"/>
                <Setter Property="Padding"      Value="8,6"/>
                <Setter Property="FontWeight"   Value="SemiBold"/>
                <Setter Property="FontSize"     Value="{DynamicResource EDTheme.FontSize.Header}"/>
                <Setter Property="Foreground"   Value="{DynamicResource EDTheme.Text.Primary}"/>
            </Style>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Rozměr ikon v toolbaru/paletě — FontService škáluje token spolu s user fontem. -->
            <Style x:Key="ToolbarIconStyle" TargetType="Image">
                <Setter Property="Width"  Value="{DynamicResource EDTheme.IconSize.Default}"/>
                <Setter Property="Height" Value="{DynamicResource EDTheme.IconSize.Default}"/>
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            </Style>

            <!-- ── Section item DataTemplate ── -->
            <DataTemplate x:Key="SectionItemTemplate" DataType="{x:Type local:SectionVM}">
                <Border Margin="0,2,0,0"
                        Padding="8,5,4,5"
                        CornerRadius="3"
                        Cursor="Hand"
                        Tag="{Binding}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"       Value="{DynamicResource EDTheme.Bg.PanelAlt}"/>
                            <Setter Property="BorderBrush"      Value="{DynamicResource EDTheme.Border.Light}"/>
                            <Setter Property="BorderThickness"  Value="1"/>
                            <Style.Triggers>
                                <!-- Dynamic (non-active) -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsDynamic}" Value="True"/>
                                        <Condition Binding="{Binding IsActive}"  Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background"  Value="{DynamicResource EDTheme.Accent.BlueBg}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource EDTheme.Accent.BlueBorder}"/>
                                </MultiDataTrigger>
                                <!-- Active -->
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Background"      Value="{DynamicResource EDTheme.Accent.BlueSelected}"/>
                                    <Setter Property="BorderBrush"     Value="{DynamicResource EDTheme.Accent.Blue}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.Tag,
                                      RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Vlastnosti sekce…"
                                      Command="{Binding ShowPropertiesCommand}"/>
                            <MenuItem Header="Přesunout nahoru"
                                      Command="{Binding MoveUpCommand}"/>
                            <MenuItem Header="Přesunout dolů"
                                      Command="{Binding MoveDownCommand}"/>
                            <MenuItem Header="Uložit jako šablonu…"
                                      Command="{Binding SaveTemplateCommand}"/>
                            <Separator/>
                            <MenuItem Header="Smazat sekci"
                                      Foreground="{DynamicResource EDTheme.Semantic.Danger}"
                                      Command="{Binding DeleteCommand}"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="▼" MinWidth="18" Padding="2,0" FontSize="{DynamicResource EDTheme.FontSize.Small}"
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding MoveDownCommand}"
                                ToolTip="Přesunout dolů — Ctrl+Shift+↓"/>
                        <Button DockPanel.Dock="Right"
                                Content="▲" MinWidth="18" Padding="2,0" FontSize="{DynamicResource EDTheme.FontSize.Small}"
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding MoveUpCommand}"
                                ToolTip="Přesunout nahoru — Ctrl+Shift+↑"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="{DynamicResource EDTheme.FontSize.Header}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Subtitle}"
                                       FontSize="{DynamicResource EDTheme.FontSize.Caption}"
                                       Foreground="{DynamicResource EDTheme.Text.Muted}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSubtitle}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </DataTemplate>

            <!-- Parameter DataTemplates jsou ve sdílené ResourceDictionary (viz MergedDictionaries výše).
                 Klíče: ParamBoolTemplate, ParamEnumTemplate, ParamStringTemplate, ParamCommitStringTemplate, ParamTemplateSelector. -->
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ═══ Menu ═══ -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource EDTheme.Bg.Footer}">
            <MenuItem Header="Soubor">
                <MenuItem x:Name="MenuNew"    Header="Nová šablona"  InputGestureText="Ctrl+N" Click="MenuNew_Click"/>
                <MenuItem x:Name="MenuOpen"   Header="Otevřít z databáze…"  InputGestureText="Ctrl+O" Click="MenuOpen_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuSave"   Header="Uložit do databáze"        InputGestureText="Ctrl+S" Click="MenuSave_Click"/>
                <MenuItem x:Name="MenuSaveAs" Header="Uložit do databáze jako…"                  Click="MenuSaveAs_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuImportJson" Header="Importovat ze souboru…" Command="{Binding ImportJsonCommand}"/>
                <MenuItem x:Name="MenuExportJson" Header="Exportovat do souboru…" Command="{Binding ExportJsonCommand}"/>
                <MenuItem x:Name="MenuRecentFiles" Header="Otevřít poslední soubor"/>
                <Separator/>
                <MenuItem x:Name="MenuExportPdf" Header="Exportovat náhled jako PDF…" Click="MenuExportPdf_Click"/>
                <MenuItem x:Name="MenuExportPng" Header="Exportovat náhled jako PNG…" Click="MenuExportPng_Click"/>
                <MenuItem x:Name="MenuPrint" Header="Tisk…" InputGestureText="Ctrl+P" Click="MenuPrint_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuPageProps" Header="Vlastnosti stránky…" InputGestureText="Ctrl+Shift+P" Click="MenuPageProps_Click"/>
                <Separator/>
                <MenuItem Header="Konec" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Upravit">
                <MenuItem x:Name="MenuUndo"   Header="Zpět"   InputGestureText="Ctrl+Z"
                          Command="{Binding UndoCommand}"/>
                <MenuItem x:Name="MenuRedo"   Header="Vpřed"  InputGestureText="Ctrl+Y"
                          Command="{Binding RedoCommand}"/>
                <Separator/>
                <MenuItem x:Name="MenuDelete" Header="Smazat" InputGestureText="Del"    Click="MenuDelete_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuZForward"  Header="Přenést dopředu"       InputGestureText="Ctrl+PgUp"       Click="BtnZForward_Click"/>
                <MenuItem x:Name="MenuZBackward" Header="Odeslat dozadu"        InputGestureText="Ctrl+PgDn"       Click="BtnZBackward_Click"/>
                <MenuItem x:Name="MenuZFront"    Header="Přenést zcela dopředu" InputGestureText="Ctrl+Shift+PgUp" Click="BtnZFront_Click"/>
                <MenuItem x:Name="MenuZBack"     Header="Odeslat zcela dozadu"  InputGestureText="Ctrl+Shift+PgDn" Click="BtnZBack_Click"/>
                <Separator/>
                <MenuItem Header="Zarovnat vlevo"               Click="BtnAlignLeft_Click"/>
                <MenuItem Header="Zarovnat vpravo"              Click="BtnAlignRight_Click"/>
                <MenuItem Header="Zarovnat na střed (vodorovně)" Click="BtnAlignCenterH_Click"/>
                <MenuItem Header="Zarovnat nahoru"              Click="BtnAlignTop_Click"/>
                <MenuItem Header="Zarovnat dolů"                Click="BtnAlignBottom_Click"/>
                <MenuItem Header="Zarovnat na střed (svisle)"  Click="BtnAlignMiddleV_Click"/>
                <Separator/>
                <MenuItem Header="Rozložit vodorovně"           Click="BtnDistributeH_Click"/>
                <MenuItem Header="Rozložit svisle"              Click="BtnDistributeV_Click"/>
                <Separator/>
                <MenuItem Header="Normalizovat pozice…" InputGestureText="Ctrl+Shift+N" Click="MenuNormalizePositions_Click"/>
                <Separator/>
                <MenuItem Header="Škálovat šablonu">
                    <MenuItem Header="50 %"  Tag="0.5"  Click="MenuScale_Click"/>
                    <MenuItem Header="75 %"  Tag="0.75" Click="MenuScale_Click"/>
                    <MenuItem Header="90 %"  Tag="0.9"  Click="MenuScale_Click"/>
                    <MenuItem Header="100 %" Tag="1.0"  Click="MenuScale_Click"/>
                    <MenuItem Header="110 %" Tag="1.1"  Click="MenuScale_Click"/>
                    <MenuItem Header="125 %" Tag="1.25" Click="MenuScale_Click"/>
                    <MenuItem Header="150 %" Tag="1.5"  Click="MenuScale_Click"/>
                    <MenuItem Header="200 %" Tag="2.0"  Click="MenuScale_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Kopírovat styl"  InputGestureText="Ctrl+Shift+C" Click="MenuCopyStyle_Click"/>
                <MenuItem Header="Vložit styl"     InputGestureText="Ctrl+Shift+V" Click="MenuPasteStyle_Click"/>
            </MenuItem>
            <MenuItem Header="Zobrazit">
                <MenuItem x:Name="MenuGrid" Header="Mřížka" IsCheckable="True"
                          IsChecked="{Binding ShowGrid, Mode=TwoWay}"/>
                <MenuItem x:Name="MenuSnap" Header="Přichytit na mřížku" IsCheckable="True"
                          IsChecked="{Binding SnapToGrid, Mode=TwoWay}"/>
                <MenuItem x:Name="MenuSnapElements" Header="Přichytit k elementům" IsCheckable="True"
                          IsChecked="{Binding SnapToElements, Mode=TwoWay}"/>
                <MenuItem Header="Záhlaví sekcí" IsCheckable="True"
                          IsChecked="{Binding ShowSectionHeaders, Mode=TwoWay}"/>
                <MenuItem Header="Pravítka" IsCheckable="True"
                          IsChecked="{Binding ShowRuler, Mode=TwoWay}"/>
                <Separator/>
                <MenuItem x:Name="MenuSectionsPanel" Header="Panel sekcí" IsCheckable="True" IsChecked="True"
                          Checked="MenuPanelSection_Changed" Unchecked="MenuPanelSection_Changed"/>
                <MenuItem x:Name="MenuPreview" Header="Živý náhled" IsCheckable="True" IsChecked="True"
                          Checked="MenuPreview_Changed" Unchecked="MenuPreview_Changed"/>
            </MenuItem>
            <MenuItem Header="Nástroje">
                <MenuItem x:Name="MenuChangeAgenda" Header="Změnit agendu…" InputGestureText="Ctrl+Shift+A"
                          Command="{Binding ChangeAgendaCommand}"/>
                <MenuItem x:Name="MenuManageCacheTemplates" Header="Šablony v databázi…"
                          Command="{Binding OpenFromCacheCommand}"/>
                <Separator/>
                <MenuItem x:Name="MenuAiAssistant" Header="AI Asistent šablon…" Click="MenuAiAssistant_Click"/>
                <MenuItem x:Name="MenuImportPdf" Header="Import PDF…" Click="MenuImportPdf_Click"/>
                <Separator x:Name="MenuDevSep" Visibility="Collapsed"/>
                <MenuItem x:Name="MenuDevSwitchFirm" Header="Přepnout firmu (DEV)" Visibility="Collapsed"/>
            </MenuItem>
            <MenuItem Header="Nápověda">
                <MenuItem x:Name="MenuHelp" Header="Klávesové zkratky a ovládání" InputGestureText="F1" Click="MenuHelp_Click"/>
            </MenuItem>
        </Menu>

        <!-- ═══ Toolbar ═══ -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource EDTheme.Bg.Footer}" BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,0,0,1" Padding="4,2">
            <StackPanel Orientation="Horizontal">

                <!-- ── 1. Soubor ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnNew" Style="{StaticResource ToolbarButton}" ToolTip="Nová šablona — Ctrl+N" Click="MenuNew_Click">
                            <Image Source="{StaticResource EDIcons.New}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button x:Name="BtnOpen" Style="{StaticResource ToolbarButton}" ToolTip="Otevřít — Ctrl+O" Click="MenuOpen_Click">
                            <Image Source="{StaticResource EDIcons.Open}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button x:Name="BtnSave" Style="{StaticResource ToolbarButton}" ToolTip="Uložit — Ctrl+S" Click="MenuSave_Click">
                            <Image Source="{StaticResource EDIcons.Save}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Soubor" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 2. Upravit ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnUndo" Style="{StaticResource ToolbarButton}" ToolTip="Zpět — Ctrl+Z" Command="{Binding UndoCommand}">
                            <Image Source="{StaticResource EDIcons.Undo}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button x:Name="BtnRedo" Style="{StaticResource ToolbarButton}" ToolTip="Vpřed — Ctrl+Y" Command="{Binding RedoCommand}">
                            <Image Source="{StaticResource EDIcons.Redo}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Upravit" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── Stránka (nastavení dokumentu) ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnPageProps" Style="{StaticResource ToolbarButton}" ToolTip="Vlastnosti stránky — Ctrl+Shift+P" Click="MenuPageProps_Click">
                            <Image Source="{StaticResource EDIcons.Document}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Stránka" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 3. Sekce ── (elementy se přetahují z palety, ne přes seznam) -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnAddSection" Style="{StaticResource ToolbarButton}" ToolTip="Přidat sekci" Click="BtnAddSection_Click">
                            <Image Source="{StaticResource EDIcons.AddSection}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Sekce" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 4. Elementy (drag-to-canvas paleta) ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PaletteButton}" ToolTip="Text" Tag="TextElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.TextElement}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource PaletteButton}" ToolTip="Obdélník" Tag="RectangleElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.RectElement}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource PaletteButton}" ToolTip="Čára" Tag="LineElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.LineElement}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource PaletteButton}" ToolTip="Obrázek" Tag="ImageElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.ImageElement}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource PaletteButton}" ToolTip="Kód (QR, čárový, EAN, ...)" Tag="BarcodeElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.QrCode}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource PaletteButton}" ToolTip="Tabulka (dynamická — řádky z dat)" Tag="DynamicTableElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.TableElement}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Border Width="1" Background="{DynamicResource EDTheme.Border.Light}" Margin="3,2" VerticalAlignment="Stretch"/>
                        <!-- JŘ elementy — viditelnost přepíná UpdatePaletteForAgenda() dle agendy šablony -->
                        <Button x:Name="BtnPalStopList" Style="{StaticResource PaletteButton}" ToolTip="Seznam zastávek" Tag="StopListElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.StopList}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button x:Name="BtnPalDepartureGrid" Style="{StaticResource PaletteButton}" ToolTip="Mřížka odjezdů" Tag="DepartureGridElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.DepartureGrid}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button x:Name="BtnPalNotesLegend" Style="{StaticResource PaletteButton}" ToolTip="Legenda poznámek" Tag="NotesLegendElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.NotesLegend}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button x:Name="BtnPalLineTable" Style="{StaticResource PaletteButton}" ToolTip="Linkový JŘ (zastávky × spoje)" Tag="LineTableElement"
                                PreviewMouseLeftButtonDown="ElementPalette_MouseDown">
                            <Image Source="{StaticResource EDIcons.StopList}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Elementy" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 5. Vrstva (Z-order) ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnZForward" Style="{StaticResource ToolbarButton}" ToolTip="Přenést dopředu — Ctrl+PgUp" Click="BtnZForward_Click">
                            <Image Source="{StaticResource EDIcons.ZForward}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button x:Name="BtnZBackward" Style="{StaticResource ToolbarButton}" ToolTip="Odeslat dozadu — Ctrl+PgDn" Click="BtnZBackward_Click">
                            <Image Source="{StaticResource EDIcons.ZBackward}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button x:Name="BtnZFront" Style="{StaticResource ToolbarButton}" ToolTip="Přenést zcela dopředu — Ctrl+Shift+PgUp" Click="BtnZFront_Click">
                            <Image Source="{StaticResource EDIcons.ZFront}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button x:Name="BtnZBack" Style="{StaticResource ToolbarButton}" ToolTip="Odeslat zcela dozadu — Ctrl+Shift+PgDn" Click="BtnZBack_Click">
                            <Image Source="{StaticResource EDIcons.ZBack}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Vrstva" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 6. Zarovnat ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Zarovnat vlevo" Click="BtnAlignLeft_Click">
                            <Image Source="{StaticResource EDIcons.AlignLeft}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Zarovnat na střed (vodorovně)" Click="BtnAlignCenterH_Click">
                            <Image Source="{StaticResource EDIcons.AlignCenterH}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Zarovnat vpravo" Click="BtnAlignRight_Click">
                            <Image Source="{StaticResource EDIcons.AlignRight}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Zarovnat nahoru" Click="BtnAlignTop_Click">
                            <Image Source="{StaticResource EDIcons.AlignTop}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Zarovnat na střed (svisle)" Click="BtnAlignMiddleV_Click">
                            <Image Source="{StaticResource EDIcons.AlignCenterV}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Zarovnat dolů" Click="BtnAlignBottom_Click">
                            <Image Source="{StaticResource EDIcons.AlignBottom}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Border Width="1" Background="{DynamicResource EDTheme.Border.Light}" Margin="3,2" VerticalAlignment="Stretch"/>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Rozložit rovnoměrně vodorovně (min 3)" Click="BtnDistributeH_Click">
                            <Image Source="{StaticResource EDIcons.DistributeH}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Rozložit rovnoměrně svisle (min 3)" Click="BtnDistributeV_Click">
                            <Image Source="{StaticResource EDIcons.DistributeV}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Zarovnat" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 7. Mřížka & snap ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Mřížka: zobrazit + velikost -->
                        <ToggleButton x:Name="BtnGrid" Style="{StaticResource ToolbarToggle}" ToolTip="Zobrazit mřížku"
                                      IsChecked="{Binding ShowGrid, Mode=TwoWay}">
                            <Image Source="{StaticResource EDIcons.Grid}" Style="{StaticResource ToolbarIconStyle}"/>
                        </ToggleButton>
                        <ComboBox x:Name="CmbGridSize" Width="Auto" MinWidth="64" VerticalAlignment="Center" Margin="2,0"
                                  ToolTip="Velikost mřížky" SelectedIndex="2"
                                  SelectionChanged="CmbGridSize_SelectionChanged">
                            <ComboBoxItem Content="0,2 mm" Tag="0.2"/>
                            <ComboBoxItem Content="0,5 mm" Tag="0.5"/>
                            <ComboBoxItem Content="1 mm"   Tag="1"/>
                            <ComboBoxItem Content="2 mm"   Tag="2"/>
                            <ComboBoxItem Content="5 mm"   Tag="5"/>
                            <ComboBoxItem Content="10 mm"  Tag="10"/>
                        </ComboBox>

                        <!-- Vizuální oddělovač podskupin "Mřížka" vs "Snap" -->
                        <Border Width="1" Background="{DynamicResource EDTheme.Border.Light}" Margin="6,2" VerticalAlignment="Stretch"/>

                        <!-- Snap k mřížce -->
                        <ToggleButton x:Name="BtnSnap" Style="{StaticResource ToolbarToggle}" ToolTip="Přichytit k mřížce"
                                      IsChecked="{Binding SnapToGrid, Mode=TwoWay}"
                                      Content="M" FontSize="{DynamicResource EDTheme.FontSize.Body}" FontWeight="SemiBold"/>

                        <!-- Snap k objektům + mezera -->
                        <ToggleButton x:Name="BtnSnapElements" Style="{StaticResource ToolbarToggle}" ToolTip="Přichytávat k objektům (elementy + okraje sekce)"
                                      IsChecked="{Binding SnapToElements, Mode=TwoWay}"
                                      Content="O" FontSize="{DynamicResource EDTheme.FontSize.Body}" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbSnapGap" Width="Auto" MinWidth="64" VerticalAlignment="Center" Margin="2,0"
                                  ToolTip="Mezera mezi objekty při přichytávání a duplikaci"
                                  SelectedIndex="2"
                                  SelectionChanged="CmbSnapGap_SelectionChanged">
                            <ComboBoxItem Content="bez mezery" Tag="0"/>
                            <ComboBoxItem Content="1 mm"  Tag="1"/>
                            <ComboBoxItem Content="2 mm"  Tag="2"/>
                            <ComboBoxItem Content="3 mm"  Tag="3"/>
                            <ComboBoxItem Content="5 mm"  Tag="5"/>
                            <ComboBoxItem Content="10 mm" Tag="10"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="Mřížka a přichytávání" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 8. Zoom (návrhové plátno + náhled) ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="CmbZoom" Width="Auto" MinWidth="64" SelectedIndex="2" VerticalAlignment="Center" Margin="4,0"
                                  ToolTip="Zoom návrháře"
                                  SelectionChanged="CmbZoom_SelectionChanged">
                            <ComboBoxItem Content=" 50 %"/>
                            <ComboBoxItem Content=" 75 %"/>
                            <ComboBoxItem Content="100 %"/>
                            <ComboBoxItem Content="150 %"/>
                            <ComboBoxItem Content="200 %"/>
                            <ComboBoxItem Content="300 %"/>
                            <ComboBoxItem Content="400 %"/>
                            <ComboBoxItem Content="500 %"/>
                        </ComboBox>
                        <Button x:Name="BtnFitPage" Style="{StaticResource ToolbarButton}"
                                ToolTip="Přizpůsobit stránce — Ctrl+0"
                                Click="BtnFitPage_Click" Content="Fit" FontSize="{DynamicResource EDTheme.FontSize.Body}" FontWeight="SemiBold"/>
                        <Button x:Name="BtnResetView" Style="{StaticResource ToolbarButton}"
                                ToolTip="Skutečná velikost 100 % (designer i náhled) — Ctrl+1"
                                Click="BtnResetView_Click" Content="1:1" FontSize="{DynamicResource EDTheme.FontSize.Body}" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbPreviewZoom" Width="Auto" MinWidth="64" SelectedIndex="2" VerticalAlignment="Center" Margin="4,0"
                                  ToolTip="Zoom náhledu"
                                  SelectionChanged="CmbPreviewZoom_SelectionChanged">
                            <ComboBoxItem Content=" 50 %"/>
                            <ComboBoxItem Content=" 75 %"/>
                            <ComboBoxItem Content="100 %"/>
                            <ComboBoxItem Content="150 %"/>
                            <ComboBoxItem Content="200 %"/>
                            <ComboBoxItem Content="300 %"/>
                            <ComboBoxItem Content="400 %"/>
                            <ComboBoxItem Content="500 %"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="Zoom" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── 9. Panely ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="BtnToggleLeftPanel" Style="{StaticResource ToolbarToggle}"
                                      ToolTip="Skrýt/zobrazit panel sekcí — Ctrl+B"
                                      IsChecked="True" Checked="BtnToggleLeftPanel_Changed" Unchecked="BtnToggleLeftPanel_Changed"
                                      Content="☰" FontSize="{DynamicResource EDTheme.FontSize.Header}"/>
                        <ToggleButton x:Name="BtnPreview" Style="{StaticResource ToolbarToggle}" ToolTip="Zobrazit/skrýt živý náhled"
                                      IsChecked="True" Checked="BtnPreview_Changed" Unchecked="BtnPreview_Changed">
                            <Image Source="{StaticResource EDIcons.Eye}" Style="{StaticResource ToolbarIconStyle}"/>
                        </ToggleButton>
                    </StackPanel>
                    <TextBlock Text="Panely" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── Data + Export (u pravého okraje, logicky nad náhledem) ── -->
                <!-- ── Data (obnovit data náhledu) ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnRefreshData" Style="{StaticResource ToolbarButton}"
                                Command="{Binding RefreshDataCommand}"
                                ToolTip="Obnovit data náhledu — F5"
                                Content="↻" FontSize="{DynamicResource EDTheme.FontSize.Header}"/>
                    </StackPanel>
                    <TextBlock Text="Data" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>
                <Border Style="{StaticResource ToolbarGroupSep}"/>

                <!-- ── Export ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnPrint" Style="{StaticResource ToolbarButton}" ToolTip="Tisk — Ctrl+P" Click="MenuPrint_Click">
                            <Image Source="{StaticResource EDIcons.Print}" Style="{StaticResource ToolbarIconStyle}"/>
                        </Button>
                        <Button x:Name="BtnExportPdf" Style="{StaticResource ToolbarButton}"
                                Click="MenuExportPdf_Click"
                                ToolTip="Exportovat náhled jako PDF…"
                                Content="PDF" FontSize="{DynamicResource EDTheme.FontSize.Body}" FontWeight="SemiBold"/>
                        <Button x:Name="BtnExportPng" Style="{StaticResource ToolbarButton}"
                                Click="MenuExportPng_Click"
                                ToolTip="Exportovat náhled jako PNG…"
                                Content="PNG" FontSize="{DynamicResource EDTheme.FontSize.Body}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="Export" Style="{StaticResource ToolbarGroupLabel}"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ═══ Hlavní obsah ═══ -->
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <!-- Panel sekcí -->
                <ColumnDefinition x:Name="SectionsColumn" Width="200" MinWidth="120"/>
                <ColumnDefinition x:Name="SectionsSplitterColumn" Width="4"/>
                <!-- Canvas -->
                <ColumnDefinition x:Name="CanvasColumn" Width="*" MinWidth="300"/>
                <ColumnDefinition Width="4"/>
                <!-- Live preview -->
                <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <!-- Hlavní plocha -->
                <RowDefinition Height="*" MinHeight="100"/>
                <!-- Status bar -->
                <RowDefinition Height="Auto" MinHeight="26"/>
            </Grid.RowDefinitions>

            <!-- ── Panel sekcí + pole agendy ── -->
            <Border Grid.Column="0" Grid.Row="0"
                    BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,0,1,0">
                <TabControl x:Name="LeftTabControl" SelectionChanged="LeftTabControl_SelectionChanged">
                    <!-- ── Záložka Sekce ── -->
                    <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource EDIcons.Sections}" Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Sekce" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom"
                                    BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,1,0,0"
                                    Padding="6" Background="{DynamicResource EDTheme.Bg.Footer}">
                                <Button x:Name="BtnAddSectionPanel" Content="+ Přidat sekci"
                                        Click="BtnAddSection_Click" HorizontalAlignment="Stretch" Padding="4,4"/>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <!-- Data-bound sections list -->
                                <ListBox x:Name="SectionsList"
                                         ItemsSource="{Binding Sections}"
                                         ItemTemplate="{StaticResource SectionItemTemplate}"
                                         Margin="6,4"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         SelectionChanged="SectionsList_SelectionChanged"
                                         MouseDoubleClick="SectionsList_MouseDoubleClick">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding"         Value="0"/>
                                            <Setter Property="Margin"          Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <!-- Remove default selection highlight — SectionVM.IsActive drives the visual -->
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- ── Záložka Pole agendy ── -->
                    <TabItem x:Name="TabFields"><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource EDIcons.Fields}" Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Pole agendy" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                        <DockPanel>
                            <!-- Záhlaví: název agendy -->
                            <Border DockPanel.Dock="Top"
                                    BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,0,0,1"
                                    Background="{DynamicResource EDTheme.Bg.Panel}" Padding="8,5"
                                    Cursor="Hand"
                                    ToolTip="Změnit agendu — Ctrl+Shift+A">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding ChangeAgendaCommand}"/>
                                </Border.InputBindings>
                                <TextBlock x:Name="AgendaNameTextBlock"
                                           Text="{Binding AgendaNameText}"
                                           FontSize="{DynamicResource EDTheme.FontSize.Body}" Foreground="{DynamicResource EDTheme.Text.Secondary}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <!-- Tip dole -->
                            <Border DockPanel.Dock="Bottom"
                                    BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,1,0,0"
                                    Background="{DynamicResource EDTheme.Bg.Footer}" Padding="6,4">
                                <TextBlock Text="Tip: dvojklik = vložit {POLE}"
                                           FontSize="{DynamicResource EDTheme.FontSize.Caption}" Foreground="{DynamicResource EDTheme.Text.Muted}"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <!-- Data-bound schema tree + empty-state -->
                            <Grid>
                            <TreeView x:Name="SchemaTree"
                                      ItemsSource="{Binding SchemaGroups}"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      MouseDoubleClick="SchemaTree_MouseDoubleClick">
                                <TreeView.Resources>
                                    <!-- SchemaGroupVM: expandable group -->
                                    <HierarchicalDataTemplate DataType="{x:Type local:SchemaGroupVM}"
                                                              ItemsSource="{Binding Fields}">
                                        <TextBlock Text="{Binding Header}"
                                                   FontWeight="SemiBold" FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                                   Foreground="{DynamicResource EDTheme.Text.Header}"/>
                                    </HierarchicalDataTemplate>
                                    <!-- SchemaFieldVM: leaf field. Tooltip ukáže plný název + label
                                         (řádek se při úzkém panelu ořízne clipem, „…" TreeView nedělá). -->
                                    <DataTemplate DataType="{x:Type local:SchemaFieldVM}">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FieldName}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Label}"/>
                                                </StackPanel>
                                            </StackPanel.ToolTip>
                                            <TextBlock Text="{Binding FieldName}"
                                                       FontFamily="Consolas" FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                                       Foreground="{DynamicResource EDTheme.Accent.BlueDark}"/>
                                            <TextBlock Text="{Binding LabelDisplay}"
                                                       FontSize="{DynamicResource EDTheme.FontSize.Caption}" Foreground="{DynamicResource EDTheme.Text.Muted}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="True"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                            <!-- Empty-state: bez agendy/DB nebo obecná šablona → žádná pole -->
                            <TextBlock Visibility="{Binding ShowFieldsEmptyState, Converter={StaticResource BoolToVis}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="16" MaxWidth="220" TextAlignment="Center" TextWrapping="Wrap"
                                       FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                       Foreground="{DynamicResource EDTheme.Text.Muted}"
                                       Text="Tato agenda nemá databázová pole. Pro práci s daty přepni agendu (Ctrl+Shift+A)."/>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                    <!-- ── Záložka Vlastnosti (inline properties panel) ── -->
                    <TabItem x:Name="TabProperties"><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource EDIcons.Properties}" Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Vlastnosti" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                        <DockPanel>
                            <controls:FormatToolbar x:Name="FormatToolbar" DockPanel.Dock="Top"/>
                            <!-- Jeden element = EDInputForm (W4-10); 0/více = starý PropertyDescriptor panel (message/multi). -->
                            <Grid>
                                <controls:InlinePropertiesForm x:Name="InlineElementForm" Visibility="Collapsed"/>
                                <controls:PropertiesPanel x:Name="InlinePropertiesPanel"/>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                    <!-- ── Záložka Strom šablony ── -->
                    <TabItem x:Name="TabTree"><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource EDIcons.Tree}" Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Strom" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                        <controls:TemplateTreePanel x:Name="TreePanel"/>
                    </TabItem>
                    <!-- ── Záložka AI průvodce ── -->
                    <TabItem x:Name="TabAiGuide"><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource EDIcons.Assistant}" Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Pomocník" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                        <aiguide:AiGuidePanel DataContext="{Binding AiGuide}"/>
                    </TabItem>
                    <!-- ── Záložka Parametry sestavy ── -->
                    <TabItem x:Name="TabParams"><TabItem.Header><StackPanel Orientation="Horizontal"><Viewbox Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center"><Canvas Width="16" Height="16"><Line X1="1" Y1="4" X2="15" Y2="4" Stroke="{DynamicResource EDTheme.Text.Header}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Line X1="1" Y1="8" X2="15" Y2="8" Stroke="{DynamicResource EDTheme.Text.Header}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Line X1="1" Y1="12" X2="15" Y2="12" Stroke="{DynamicResource EDTheme.Text.Header}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Ellipse Canvas.Left="9" Canvas.Top="2" Width="4" Height="4" Fill="{DynamicResource EDTheme.Text.Header}"/><Ellipse Canvas.Left="3" Canvas.Top="6" Width="4" Height="4" Fill="{DynamicResource EDTheme.Text.Header}"/><Ellipse Canvas.Left="8" Canvas.Top="10" Width="4" Height="4" Fill="{DynamicResource EDTheme.Text.Header}"/></Canvas></Viewbox><TextBlock Text="Parametry" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                        <Grid>
                            <!-- Parametry sestavy renderuje EDInputForm z Caché (AgendaParams, includeExport=0)
                                 — stejný stack jako tiskový dialog, jen bez export skupiny. Skupiny (Seznam
                                 zastávek / Mřížka odjezdů / Poznámky a legenda) řídí `group` z GetParameters.
                                 CacheClass + InitParams + FieldChanged/visibleWhen wiring je v code-behindu. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasParameters, Converter={StaticResource BoolToVis}}">
                                <eif:EDInputForm x:Name="ParamsTabForm" Margin="4"/>
                            </ScrollViewer>
                            <!-- Empty-state: šablona bez parametrů (obecná / faktura) -->
                            <TextBlock Text="Tato šablona nemá parametry." TextWrapping="Wrap"
                                       Foreground="{DynamicResource EDTheme.Text.Secondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasParameters}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- ── GridSplitter levý ── -->
            <!-- Pozadí = plocha plátna a FocusVisualStyle vypnutý: dělič nesmí po tažení nechat
                 tečkovaný rámeček ani světlejší linku (dohromady působily jako „zdvojený pruh"). -->
            <GridSplitter Grid.Column="1" Grid.Row="0" FocusVisualStyle="{x:Null}"
                          HorizontalAlignment="Stretch" Background="{DynamicResource EDTheme.Bg.Canvas}" Cursor="SizeWE"/>

            <!-- ── Canvas ── -->
            <ScrollViewer Grid.Column="2" Grid.Row="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource EDTheme.Bg.Canvas}"
                          x:Name="CanvasScrollViewer">
                <Grid>
                    <skia:SKElement x:Name="skCanvas" Width="900" Height="1200"/>
                    <!-- Overlay pro inline edit TextElement. Canvas bez Backgroundu nezachycuje
                         hit testy mimo TextBox; SKElement dostává mouse eventy normálně.
                         Velikost se synchronizuje se skCanvas přes ElementName binding. -->
                    <Canvas x:Name="InlineEditOverlay"
                            Width="{Binding ElementName=skCanvas, Path=Width}"
                            Height="{Binding ElementName=skCanvas, Path=Height}">
                        <TextBox x:Name="InlineEditBox" Visibility="Collapsed"
                                 BorderThickness="1.5" BorderBrush="{DynamicResource EDTheme.Accent.Blue}"
                                 Background="White" Padding="2"
                                 AcceptsReturn="True" AcceptsTab="False"
                                 PreviewKeyDown="InlineEditBox_PreviewKeyDown"
                                 LostKeyboardFocus="InlineEditBox_LostKeyboardFocus"/>
                    </Canvas>
                </Grid>
            </ScrollViewer>

            <!-- ── GridSplitter pravý ── -->
            <GridSplitter Grid.Column="3" Grid.Row="0" FocusVisualStyle="{x:Null}"
                          HorizontalAlignment="Stretch" Background="{DynamicResource EDTheme.Bg.Canvas}" Cursor="SizeWE"/>

            <!-- ── Live Preview (výchozí: skrytý, panel se zobrazí togglem) ── -->
            <Border Grid.Column="4" Grid.Row="0"
                    BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- Stránkování dat (pager) — pevný 34px pruh NAHOŘE, rezervovaný vždy (i bez dat),
                         aby náhled začínal ve stejné výšce jako plátno vlevo (34 + 66 padding = 100 =
                         horní okraj stránky návrháře). Pozadí pruhu = plocha plátna → v mock režimu
                         (bez pageru) je to jen souvislý horní okraj. Obsah (◀ combo ▶) jen s daty. -->
                    <Grid DockPanel.Dock="Top" Height="34" Background="{DynamicResource EDTheme.Bg.Canvas}">
                        <Border Visibility="{Binding HasPageNavigation, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource EDTheme.Bg.PanelAlt}"
                                BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Content="◀" Command="{Binding PreviousPageCommand}" ToolTip="Předchozí stránka"
                                        FontSize="{DynamicResource EDTheme.FontSize.Body}" Padding="8,1" MinWidth="28"/>
                                <!-- Přímý skok na stránku dat (zastávka × směr) — bez proklikávání ◀▶.
                                     Pevná šířka: různě dlouhé názvy nesmí posouvat tlačítka ◀▶ pod myší
                                     (dropdown se obsahu přizpůsobí, zavřený box ořízne). -->
                                <ComboBox x:Name="CmbPreviewPage"
                                          ItemsSource="{Binding PreviewPageItems}"
                                          SelectedIndex="{Binding RealPreviewIndex, Mode=TwoWay}"
                                          FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                          VerticalAlignment="Center" Margin="8,0"
                                          Width="230"
                                          ToolTip="Skok na stránku dat"/>
                                <TextBlock Text="{Binding RealPreviewPageCount, StringFormat='/ {0}'}"
                                           FontSize="{DynamicResource EDTheme.FontSize.Body}" Foreground="{DynamicResource EDTheme.Text.Secondary}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="28"/>
                                <Button Content="▶" Command="{Binding NextPageCommand}" ToolTip="Další stránka"
                                        FontSize="{DynamicResource EDTheme.FontSize.Body}" Padding="8,1" MinWidth="28"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Scrollovatelný canvas náhledu — vyplní zbytek, začíná nahoře (zarovnané s návrhářem).
                         Pozadí = tentýž token jako plocha, kterou kreslí Skia (CanvasTheme.Background),
                         aby pod kratším obsahem neprosvítala jiná barva. -->
                    <ScrollViewer x:Name="PreviewScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="{DynamicResource EDTheme.Bg.Canvas}">
                        <skia:SKElement x:Name="skPreview" HorizontalAlignment="Left" Height="800"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ── Status bar ── -->
            <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="5"
                    Background="{DynamicResource EDTheme.Bg.Panel}"
                    BorderBrush="{DynamicResource EDTheme.Border.Light}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1) Agenda chip (klikatelný — ChangeAgendaCommand) -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource EDTheme.Accent.GreenBg}" Padding="10,3" CornerRadius="3" Margin="0,2"
                            Cursor="Hand"
                            ToolTip="Změnit agendu — Ctrl+Shift+A">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ChangeAgendaCommand}"/>
                        </Border.InputBindings>
                        <TextBlock Text="{Binding AgendaNameText}"
                                   FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                   Foreground="{DynamicResource EDTheme.Accent.GreenDark}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="1" Width="1" Background="{DynamicResource EDTheme.Border.Light}"/>

                    <!-- 2) Instance chip (klikatelný — OpenInstancePicker) -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource EDTheme.Accent.BlueBg}" Padding="10,3" CornerRadius="3" Margin="0,2"
                            Cursor="Hand"
                            ToolTip="{Binding InstancePickerHint}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenInstancePickerCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="◀" Command="{Binding PreviousInstanceCommand}"
                                    Visibility="{Binding HasMultipleActiveInstances, Converter={StaticResource BoolToVis}}"
                                    Background="Transparent" BorderThickness="0" Padding="4,0"
                                    FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                    Foreground="{DynamicResource EDTheme.Accent.BlueDark}"
                                    Cursor="Hand" Margin="0,0,4,0"
                                    ToolTip="{Binding PreviousInstanceTooltip}"/>
                            <!-- Pevná šířka jen při více instancích — různě dlouhé názvy linek jinak
                                 posouvají tlačítko ▶ pod myší při proklikávání. -->
                            <TextBlock Text="{Binding ActiveInstanceText}"
                                       FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                       Foreground="{DynamicResource EDTheme.Accent.BlueDark}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ActiveInstanceText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMultipleActiveInstances}" Value="True">
                                                <Setter Property="Width" Value="260"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="▶" Command="{Binding NextInstanceCommand}"
                                    Visibility="{Binding HasMultipleActiveInstances, Converter={StaticResource BoolToVis}}"
                                    Background="Transparent" BorderThickness="0" Padding="4,0"
                                    FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                    Foreground="{DynamicResource EDTheme.Accent.BlueDark}"
                                    Cursor="Hand" Margin="4,0,0,0"
                                    ToolTip="{Binding NextInstanceTooltip}"/>
                            <!-- Zvolená skupina linek (filtr) — viditelná jen když je zvolená -->
                            <TextBlock Text="{Binding ActiveSkupinaText}"
                                       Visibility="{Binding HasActiveSkupina, Converter={StaticResource BoolToVis}}"
                                       FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                       Foreground="{DynamicResource EDTheme.Accent.BlueDark}"
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Width="1" Background="{DynamicResource EDTheme.Border.Light}"/>

                    <!-- 3a) Stav výběru (klidová zóna — element / sekce) -->
                    <TextBlock x:Name="SelectionStatusText" Grid.Column="4"
                               Text="{Binding SelectionStatusText}"
                               VerticalAlignment="Center" Margin="10,0"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource EDTheme.FontSize.Body}"
                               Foreground="{DynamicResource EDTheme.Text.Secondary}"/>

                    <!-- 3b) Akce / progres (transientní zóna — uloženo / chyba / export N/N; nepřepíše se výběrem) -->
                    <TextBlock x:Name="StatusText" Grid.Column="5"
                               Text="{Binding StatusText}"
                               VerticalAlignment="Center" Margin="10,0"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource EDTheme.FontSize.Body}"
                               Foreground="{DynamicResource EDTheme.Text.Primary}"/>

                    <!-- 4) Varování o přetečení preview (červený blok, jen když obsah přetéká) -->
                    <Border Grid.Column="6"
                            Background="{DynamicResource EDTheme.Semantic.Danger}" Padding="10,3" CornerRadius="3" Margin="6,2,0,2"
                            VerticalAlignment="Stretch"
                            Visibility="{Binding HasPreviewOverflow, Converter={StaticResource BoolToVis}}"
                            ToolTip="Obsah některé stránky se nevejde — zvětši stránku (PageSize) nebo zmenši obsah">
                        <TextBlock Text="Obsah se nevejde na stránku"
                                   Foreground="White" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource EDTheme.FontSize.Body}"/>
                    </Border>
