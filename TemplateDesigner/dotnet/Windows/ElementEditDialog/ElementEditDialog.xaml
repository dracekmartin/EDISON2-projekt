<Window x:Class="TemplateDesigner.ElementEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:eif="clr-namespace:EDControls.EDInputForm;assembly=EDControls"
        Title="Vlastnosti"
        Width="720" Height="460"
        MinWidth="640" MinHeight="320"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="{StaticResource EDStrings.Ok}" IsDefault="True"
                    Click="SaveButton_Click"
                    Width="80" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Content="{StaticResource EDStrings.Cancel}" IsCancel="True" Width="80"/>
        </Grid>

        <eif:EDInputForm x:Name="TheForm"/>
    </DockPanel>
</Window>
