<Window x:Class="TemplateDesigner.DepartureGroupEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TemplateDesigner.Controls"
        xmlns:eif="clr-namespace:EDControls.EDInputForm;assembly=EDControls"
        Title="Odjezdy - nastavení"
        Width="680" Height="640"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <controls:NotNullToVisibleConverter x:Key="NotNullToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl>

            <!-- ── Tab 1: Obecné (EDInputForm - schéma z Caché DepartureGridElementEdit) ── -->
            <TabItem Header="Obecné">
                <eif:EDInputForm x:Name="GeneralForm"/>
            </TabItem>

            <!-- ── Tab 2: Sloupce ─────────────────────────────────── -->
            <TabItem Header="Sloupce">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" MinWidth="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vlevo: sdílený seznam sloupců (ColumnListEditor) -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Skupiny dnů:" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <controls:ColumnListEditor Grid.Row="1"
                            ItemsSource="{Binding GroupVMs}"
                            SelectedItem="{Binding SelectedGroupVM, Mode=TwoWay}"
                            MoveUpCommand="{Binding MoveUpCommand}"
                            MoveDownCommand="{Binding MoveDownCommand}"/>
                    </Grid>

                    <!-- Vpravo: detail vybraného sloupce -->
                    <ScrollViewer Grid.Column="1" Margin="8,0,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  IsEnabled="{Binding HasSelection}">
                        <StackPanel>

                            <!-- ── Struktura sloupce - nadpis (override výchozí hodnoty) ──────────────────── -->
                            <TextBlock Text="Struktura sloupce" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Záhlaví:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <!-- Víceřádkové jako u nadpisů sloupců zastávek: Enter uvnitř pole udělá
                                     druhý řádek záhlaví, ne potvrzení dialogu. Funguje i token „\n". -->
                                <TextBox Width="160" Text="{Binding SelectedGroupVM.HeaderOverride, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0"
                                         AcceptsReturn="True" MaxLines="3" VerticalScrollBarVisibility="Auto"
                                         ToolTip="Přepis nadpisu skupiny. Víc řádků: Enter nebo token \n - všechny řádky mají stejný styl."/>
                                <TextBlock Text="Šířka (mm):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Width="50" Text="{Binding SelectedGroupVM.WidthText, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                            <TextBlock Text="Šířka prázdná = automaticky dle obsahu." FontStyle="Italic"
                                       Foreground="{DynamicResource EDTheme.Text.Muted}" FontSize="{DynamicResource EDTheme.FontSize.Body}" Margin="0,0,0,8"/>

                            <Separator Margin="0,8,0,8"/>

                            <TextBlock Text="Prázdné pole = dědí výchozí styl elementu."
                                       FontStyle="Italic" Foreground="{DynamicResource EDTheme.Text.Muted}" FontSize="{DynamicResource EDTheme.FontSize.Body}" Margin="0,0,0,8"/>

                            <!-- ── Záhlaví ──────────────────── -->
                            <TextBlock Text="Styl záhlaví sloupce" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <controls:CellStyleEditor
                                DataContext="{Binding SelectedGroupVM.Header}"
                                EditOptions="{Binding DataContext.HeaderEditOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                PickTextColorCommand="{Binding DataContext.PickHeaderTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ClearTextColorCommand="{Binding DataContext.ClearHeaderTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                PickBgColorCommand="{Binding DataContext.PickHeaderBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ClearBgColorCommand="{Binding DataContext.ClearHeaderBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>

                            <Separator Margin="0,8,0,8"/>

                            <!-- ── Datové buňky ──────────────── -->
                            <TextBlock Text="Datové buňky" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <controls:CellStyleEditor
                                DataContext="{Binding SelectedGroupVM.Data}"
                                EditOptions="{Binding DataContext.DataEditOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                PickTextColorCommand="{Binding DataContext.PickDataTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ClearTextColorCommand="{Binding DataContext.ClearDataTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                PickBgColorCommand="{Binding DataContext.PickDataBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ClearBgColorCommand="{Binding DataContext.ClearDataBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>

                            <!-- ── Střídání řádků (per skupina) ────────────────
                                 Celý blok mizí u sloupce hodin: zebra se kreslí per skupina dnů
                                 a hodinový pruh si barvu bere od nich, takže by tam hodnota nic
                                 neudělala (nález Jan 11. 9.). -->
                            <StackPanel Visibility="{Binding SelectedGroupVM.SupportsZebra, Converter={StaticResource BoolToVis}}">
                            <Separator Margin="0,8,0,8"/>

                            <!-- Vlastní pole, ne součást stylu buňky: kreslí se pod buňky a platí
                                 jen pro každý druhý řádek. Prázdné = barva z tabu Obecné. -->
                            <TextBlock Text="Střídání řádků" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBox Width="90" VerticalAlignment="Center" Margin="0,0,6,0"
                                         Text="{Binding SelectedGroupVM.AlternatingRowColor, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Barva každého druhého řádku v této skupině. Prázdné = barva nastavená pro celý prvek."/>
                                <Button Content="Vybrat…" Padding="8,2" Margin="0,0,6,0"
                                        Command="{Binding DataContext.PickZebraColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Button Content="×" Padding="8,2" ToolTip="Zpět na barvu celého prvku"
                                        Command="{Binding DataContext.ClearZebraColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                            <TextBlock Text="Prázdné = použije se barva z tabu Obecné." FontStyle="Italic"
                                       Foreground="{DynamicResource EDTheme.Text.Muted}" FontSize="{DynamicResource EDTheme.FontSize.Body}" Margin="0,0,0,8"/>

                            </StackPanel>

                            <!-- Resetovat -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Resetovat styl sloupce"
                                        Command="{Binding DataContext.ResetStyleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Padding="10,3" Margin="0,0,6,0"/>
                                <Button Content="Resetovat všechny sloupce"
                                        Command="{Binding DataContext.ResetAllColumnStylesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Smaže úpravy jednotlivých sloupců - všechny sloupce budou dědit z tabu Obecné"
                                        Padding="10,3"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ── Tab 3: Vlastní definice sloupců (dny + značky + období; tab Sloupce zůstává vzhled) ── -->
            <TabItem Header="Vlastní definice sloupců">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <RadioButton Content="Automaticky (dle linky)" IsChecked="{Binding AutomaticColumns}"
                                     Margin="0,0,0,2"
                                     ToolTip="Sloupce podle nastavení linky - dnešní chování beze změny"/>
                        <RadioButton Content="Vlastní sloupce" IsChecked="{Binding UseCustomColumns}"
                                     ToolTip="Sloupce definuje šablona (dny v týdnu a značky); nastavení linky se nepoužije"/>
                        <StackPanel Orientation="Horizontal" Margin="18,6,0,2" IsEnabled="{Binding UseCustomColumns}">
                            <TextBlock Text="Vzor:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox Width="290" ItemsSource="{Binding Presets}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedPreset}"/>
                            <Button Content="Použít vzor" Command="{Binding ApplyPresetCommand}" Padding="10,3" Margin="6,0,0,0"
                                    ToolTip="Nahradí sloupce vybraným vzorem - čtyři dnešní rozvržení"/>
                        </StackPanel>
                        <TextBlock Text="Nejvýše 5 sloupců. Nevyplněná podmínka sloupec neomezuje; spoj může být ve více sloupcích."
                                   FontStyle="Italic" Foreground="{DynamicResource EDTheme.Text.Muted}"
                                   FontSize="{DynamicResource EDTheme.FontSize.Body}" Margin="18,0,0,6"/>
                        <TextBlock Text="{Binding CustomColumnsError}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource EDTheme.Semantic.Danger}" FontWeight="SemiBold"
                                   FontSize="{DynamicResource EDTheme.FontSize.Body}" Margin="18,0,0,6"
                                   Visibility="{Binding CustomColumnsError, Converter={StaticResource NotNullToVis}}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" IsEnabled="{Binding UseCustomColumns}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" MinWidth="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Vlevo: seznam vlastních sloupců -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox ItemsSource="{Binding CustomColumnVMs}"
                                     SelectedItem="{Binding SelectedCustomVM, Mode=TwoWay}"
                                     DisplayMemberPath="DisplayName"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Přidat" Command="{Binding AddCustomColumnCommand}"
                                        IsEnabled="{Binding CanAddCustomColumn}" Padding="8,3" Margin="0,0,4,0"/>
                                <Button Content="Odebrat" Command="{Binding RemoveCustomColumnCommand}"
                                        IsEnabled="{Binding HasCustomSelection}" Padding="8,3" Margin="0,0,4,0"/>
                                <Button Content="▲" Command="{Binding MoveCustomUpCommand}" Width="26" Padding="0,3"
                                        Margin="0,0,2,0" ToolTip="Posunout nahoru"/>
                                <Button Content="▼" Command="{Binding MoveCustomDownCommand}" Width="26" Padding="0,3"
                                        ToolTip="Posunout dolů"/>
                            </StackPanel>
                        </Grid>

                        <!-- Vpravo: podmínky vybraného sloupce -->
                        <ScrollViewer Grid.Column="1" Margin="8,0,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      IsEnabled="{Binding HasCustomSelection}">
                            <StackPanel>
                                <TextBlock Text="Nadpis sloupce" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Nadpis:" VerticalAlignment="Center" Width="90"/>
                                    <TextBox Width="220" Text="{Binding SelectedCustomVM.Header, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Druhý řádek:" VerticalAlignment="Center" Width="90"/>
                                    <TextBox Width="220" Text="{Binding SelectedCustomVM.Header2, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <Separator Margin="0,4,0,8"/>

                                <TextBlock Text="Týdenní platnost" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox Content="Po" IsChecked="{Binding SelectedCustomVM.Po}" IsEnabled="{Binding SelectedCustomVM.LzePoPa}" Margin="0,0,8,4"/>
                                    <CheckBox Content="Út" IsChecked="{Binding SelectedCustomVM.Ut}" IsEnabled="{Binding SelectedCustomVM.LzePoPa}" Margin="0,0,8,4"/>
                                    <CheckBox Content="St" IsChecked="{Binding SelectedCustomVM.St}" IsEnabled="{Binding SelectedCustomVM.LzePoPa}" Margin="0,0,8,4"/>
                                    <CheckBox Content="Čt" IsChecked="{Binding SelectedCustomVM.Ct}" IsEnabled="{Binding SelectedCustomVM.LzePoPa}" Margin="0,0,8,4"/>
                                    <CheckBox Content="Pá" IsChecked="{Binding SelectedCustomVM.Pa}" IsEnabled="{Binding SelectedCustomVM.LzePoPa}" Margin="0,0,8,4"/>
                                    <CheckBox Content="So" IsChecked="{Binding SelectedCustomVM.So}" Margin="0,0,8,4"/>
                                    <CheckBox Content="Ne" IsChecked="{Binding SelectedCustomVM.Ne}"
                                              IsEnabled="{Binding SelectedCustomVM.LzeNe}" Margin="0,0,8,4"/>
                                    <CheckBox Content="Pracovní dny (X)" IsChecked="{Binding SelectedCustomVM.Pracovni}"
                                              IsEnabled="{Binding SelectedCustomVM.LzePracovni}" Margin="0,0,8,4"
                                              ToolTip="Značka X - na rozdíl od zaškrtnutého Po-Pá nezahrnuje svátky"/>
                                    <CheckBox Content="Neděle a svátky (+)" IsChecked="{Binding SelectedCustomVM.Svatek}"
                                              IsEnabled="{Binding SelectedCustomVM.LzeSvatek}" Margin="0,0,8,4"
                                              ToolTip="Značka + - jedna značka pro neděli i státem uznané svátky. Nejde zaškrtnout spolu s Ne, protože neděli už obsahuje."/>
                                </WrapPanel>

                                <Separator Margin="0,4,0,8"/>

                                <TextBlock Text="Negativní značky" FontWeight="SemiBold" Margin="0,0,0,6"
                                           ToolTip="Číslo negativní značky dostává spoj v jízdních řádech spolu s datovým omezením (např. „10 - nejede od 1. 7. do 31. 8.“). Vývěska značku bere jako fakt: filtruje spoje podle čísla a text omezení tiskne do legendy - platnost samotnou nevyhodnocuje."/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Jen spoje se značkami:" VerticalAlignment="Center" Width="150"
                                               ToolTip="Do sloupce patří jen spoje s některou z těchto značek"/>
                                    <TextBox Width="160" Text="{Binding SelectedCustomVM.IncludeMarks, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Bez spojů se značkami:" VerticalAlignment="Center" Width="150"
                                               ToolTip="Spoj s některou z těchto značek se do sloupce nezařadí, i když by dny seděl"/>
                                    <TextBox Width="160" Text="{Binding SelectedCustomVM.ExcludeMarks, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Nevypisovat značky:" VerticalAlignment="Center" Width="150"
                                               ToolTip="Spoj se vytiskne, jen se u minuty nezopakuje značka (např. když ji už říká nadpis sloupce)"/>
                                    <TextBox Width="160" Text="{Binding SelectedCustomVM.SuppressedMarks, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <TextBlock Text="Čísla značek oddělená čárkou (např. 52, 53). Prázdné = neomezuje."
                                           FontStyle="Italic" Foreground="{DynamicResource EDTheme.Text.Muted}"
                                           FontSize="{DynamicResource EDTheme.FontSize.Body}" Margin="0,0,0,8"/>

                                <Separator Margin="0,4,0,8"/>

                                <TextBlock Text="Období" FontWeight="SemiBold" Margin="0,0,0,6"
                                           ToolTip="Do sloupce patří spoj, který v zadaném období jede aspoň jeden den. Kdo jede celé období, nemá u minuty negativní značku - nemá co vysvětlovat; kdo jen část (v létě nejede, na podzim ano), značku dostane."/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Rozsahy dat:" VerticalAlignment="Center" Width="150"
                                               ToolTip="Víc rozsahů oddělte čárkou - např. prázdniny jako 14.2.-18.2., 1.7.-31.8., 29.10.-30.10."/>
                                    <TextBox Width="260" Text="{Binding SelectedCustomVM.Period, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <TextBlock Text="Datum bez roku platí každý rok (1.7.-31.8.), s rokem jednorázově (27.12.2026-29.12.2026). Prázdné = neomezuje."
                                           FontStyle="Italic" Foreground="{DynamicResource EDTheme.Text.Muted}"
                                           FontSize="{DynamicResource EDTheme.FontSize.Body}" Margin="0,0,0,8"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ── OK / Storno ───────────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{StaticResource EDStrings.Ok}"     Width="80" IsDefault="True" Click="OkButton_Click" Padding="10,3" Margin="0,0,6,0"/>
            <Button Content="{StaticResource EDStrings.Cancel}" Width="80" IsCancel="True"  Padding="10,3" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
