<Window x:Class="TemplateDesigner.DepartureGroupEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skupiny dnů — nastavení sloupců"
        Width="480" Height="520"
        MinWidth="400" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Seznam skupin s checkboxy ─────────────────────── -->
        <TextBlock Text="Skupiny dnů:" FontWeight="SemiBold" Margin="0,0,0,4"/>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding GroupVMs}"
                 SelectedItem="{Binding SelectedGroupVM, Mode=TwoWay}"
                 BorderThickness="1" BorderBrush="#CCCCCC">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}"
                              Content="{Binding Name}"
                              Margin="2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ── Vlastnosti vybrané skupiny ────────────────────── -->
        <Border Grid.Row="2" BorderThickness="1" BorderBrush="#CCCCCC"
                Padding="8" Margin="0,8,0,0"
                IsEnabled="{Binding HasSelection}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Záhlaví -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Text="Záhlaví sloupce" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Zarovnání:" VerticalAlignment="Center" Margin="0,0,6,2"/>
                <ComboBox Grid.Row="2" Grid.Column="1"
                          ItemsSource="{Binding DataContext.AlignmentOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedIndex="{Binding SelectedGroupVM.HeaderAlignmentIndex, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,2"/>

                <TextBlock Grid.Row="2" Grid.Column="3" Text="Svisle:" VerticalAlignment="Center" Margin="0,0,6,2"/>
                <ComboBox Grid.Row="2" Grid.Column="4"
                          ItemsSource="{Binding DataContext.VAlignmentOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedIndex="{Binding SelectedGroupVM.HeaderVAlignIndex, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,2"/>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,2">
                    <TextBlock Text="Velikost:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox IsEditable="True" Width="55"
                              ItemsSource="{Binding DataContext.FontSizeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                              Text="{Binding SelectedGroupVM.HeaderFontSize, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                              Margin="0,0,10,0"/>
                    <CheckBox Content="Tučné" IsChecked="{Binding SelectedGroupVM.HeaderBold}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox Content="Kurzíva" IsChecked="{Binding SelectedGroupVM.HeaderItalic}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,2"
                            VerticalAlignment="Center">
                    <TextBlock Text="Barva textu:" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <Button Content="▪" Width="24" Command="{Binding DataContext.PickHeaderTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,1" Margin="0,0,2,0"/>
                    <Button Content="✕" Width="20" Command="{Binding DataContext.ClearHeaderTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="2,1" FontSize="10"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,2"
                            VerticalAlignment="Center">
                    <TextBlock Text="Pozadí záhlaví:" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <Button Content="▪" Width="24" Command="{Binding DataContext.PickHeaderBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,1" Margin="0,0,2,0"/>
                    <Button Content="✕" Width="20" Command="{Binding DataContext.ClearHeaderBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="2,1" FontSize="10"/>
                </StackPanel>

                <!-- Data -->
                <TextBlock Grid.Row="7" Grid.ColumnSpan="5" Text="Datový sloupec" FontWeight="SemiBold"/>

                <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,2">
                    <TextBlock Text="Velikost:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox IsEditable="True" Width="55"
                              ItemsSource="{Binding DataContext.FontSizeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                              Text="{Binding SelectedGroupVM.DataFontSize, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                              Margin="0,0,10,0"/>
                    <CheckBox Content="Tučné" IsChecked="{Binding SelectedGroupVM.DataBold}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox Content="Kurzíva" IsChecked="{Binding SelectedGroupVM.DataItalic}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="8" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,2"
                            VerticalAlignment="Center">
                    <TextBlock Text="Pozadí dat:" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <Button Content="▪" Width="24" Command="{Binding DataContext.PickColumnBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,1" Margin="0,0,2,0"/>
                    <Button Content="✕" Width="20" Command="{Binding DataContext.ClearColumnBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="2,1" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── OK / Storno ───────────────────────────────────── -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{StaticResource EDStrings.Ok}"     Width="80" IsDefault="True" Command="{Binding OkCommand}" Padding="10,3" Margin="0,0,6,0"/>
            <Button Content="{StaticResource EDStrings.Cancel}" Width="80" IsCancel="True"  Padding="10,3" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
