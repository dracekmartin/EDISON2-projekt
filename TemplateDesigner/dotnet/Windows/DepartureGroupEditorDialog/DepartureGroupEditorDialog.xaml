<Window x:Class="TemplateDesigner.DepartureGroupEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TemplateDesigner.Controls"
        Title="Odjezdy — nastavení"
        Width="620" Height="580"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl>

            <!-- ── Tab 1: Obecné ──────────────────────────────────── -->
            <TabItem Header="Obecné">
                <controls:PropertiesPanel x:Name="GeneralPanel" Margin="6"/>
            </TabItem>

            <!-- ── Tab 2: Sloupce ─────────────────────────────────── -->
            <TabItem Header="Sloupce">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" MinWidth="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vlevo: seznam skupin -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Skupiny dnů:" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding GroupVMs}"
                                 SelectedItem="{Binding SelectedGroupVM, Mode=TwoWay}"
                                 BorderThickness="1" BorderBrush="#CCCCCC">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <CheckBox IsChecked="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Content="▲" Width="28" Padding="2,1"
                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="0,0,4,0"/>
                            <Button Content="▼" Width="28" Padding="2,1"
                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Vpravo: detail vybraného sloupce -->
                    <ScrollViewer Grid.Column="1" Margin="8,0,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  IsEnabled="{Binding HasSelection}">
                        <StackPanel>

                            <!-- ── Záhlaví ──────────────────── -->
                            <TextBlock Text="Záhlaví sloupce" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <!-- Font + velikost + B/I -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Font:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Width="90" Text="{Binding SelectedGroupVM.Header.FontFamily, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0"/>
                                <TextBlock Text="Velikost:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox IsEditable="True" Width="55"
                                          ItemsSource="{Binding DataContext.FontSizeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Text="{Binding SelectedGroupVM.Header.FontSize, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                          Margin="0,0,10,0"/>
                                <CheckBox Content="Tučné" IsChecked="{Binding SelectedGroupVM.Header.Bold}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <CheckBox Content="Kurzíva" IsChecked="{Binding SelectedGroupVM.Header.Italic}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Zarovnání -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Zarovnání:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Width="90"
                                          ItemsSource="{Binding DataContext.AlignmentOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedIndex="{Binding SelectedGroupVM.Header.HAlignmentIndex, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Barva textu -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Barva textu:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="▪" Width="24" Command="{Binding DataContext.PickHeaderTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,1" Margin="0,0,2,0"/>
                                <Button Content="✕" Width="20" Command="{Binding DataContext.ClearHeaderTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="2,1" FontSize="10" Margin="0,0,10,0"/>
                                <TextBlock Text="Pozadí:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="▪" Width="24" Command="{Binding DataContext.PickHeaderBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,1" Margin="0,0,2,0"/>
                                <Button Content="✕" Width="20" Command="{Binding DataContext.ClearHeaderBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="2,1" FontSize="10"/>
                            </StackPanel>

                            <!-- Padding -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Padding (mm):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="↑" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBox Width="35" Text="{Binding SelectedGroupVM.Header.PaddingTop, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Margin="0,0,6,0"/>
                                <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBox Width="35" Text="{Binding SelectedGroupVM.Header.PaddingRight, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Margin="0,0,6,0"/>
                                <TextBlock Text="↓" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBox Width="35" Text="{Binding SelectedGroupVM.Header.PaddingBottom, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Margin="0,0,6,0"/>
                                <TextBlock Text="←" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBox Width="35" Text="{Binding SelectedGroupVM.Header.PaddingLeft, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
                            </StackPanel>

                            <!-- ── Oddělovač ──────────────────── -->
                            <Separator Margin="0,8,0,8"/>

                            <!-- ── Datové buňky ──────────────── -->
                            <TextBlock Text="Datové buňky" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <!-- Font + velikost + B/I -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Font:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Width="90" Text="{Binding SelectedGroupVM.Data.FontFamily, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0"/>
                                <TextBlock Text="Velikost:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox IsEditable="True" Width="55"
                                          ItemsSource="{Binding DataContext.FontSizeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Text="{Binding SelectedGroupVM.Data.FontSize, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                          Margin="0,0,10,0"/>
                                <CheckBox Content="Tučné" IsChecked="{Binding SelectedGroupVM.Data.Bold}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <CheckBox Content="Kurzíva" IsChecked="{Binding SelectedGroupVM.Data.Italic}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Zarovnání -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Zarovnání:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Width="90"
                                          ItemsSource="{Binding DataContext.AlignmentOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedIndex="{Binding SelectedGroupVM.Data.HAlignmentIndex, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Barva textu + pozadí -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Barva textu:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="▪" Width="24" Command="{Binding DataContext.PickDataTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,1" Margin="0,0,2,0"/>
                                <Button Content="✕" Width="20" Command="{Binding DataContext.ClearDataTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="2,1" FontSize="10" Margin="0,0,10,0"/>
                                <TextBlock Text="Pozadí:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="▪" Width="24" Command="{Binding DataContext.PickDataBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,1" Margin="0,0,2,0"/>
                                <Button Content="✕" Width="20" Command="{Binding DataContext.ClearDataBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="2,1" FontSize="10"/>
                            </StackPanel>

                            <!-- Padding -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Padding (mm):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="↑" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBox Width="35" Text="{Binding SelectedGroupVM.Data.PaddingTop, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Margin="0,0,6,0"/>
                                <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBox Width="35" Text="{Binding SelectedGroupVM.Data.PaddingRight, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Margin="0,0,6,0"/>
                                <TextBlock Text="↓" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBox Width="35" Text="{Binding SelectedGroupVM.Data.PaddingBottom, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Margin="0,0,6,0"/>
                                <TextBlock Text="←" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBox Width="35" Text="{Binding SelectedGroupVM.Data.PaddingLeft, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
                            </StackPanel>

                            <!-- Resetovat -->
                            <Button Content="Resetovat styl" Command="{Binding DataContext.ResetStyleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    HorizontalAlignment="Left" Padding="10,3" Margin="0,12,0,0"/>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ── OK / Storno ───────────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{StaticResource EDStrings.Ok}"     Width="80" IsDefault="True" Command="{Binding OkCommand}" Padding="10,3" Margin="0,0,6,0"/>
            <Button Content="{StaticResource EDStrings.Cancel}" Width="80" IsCancel="True"  Padding="10,3" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
