<Window x:Class="TemplateDesigner.DepartureGroupEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TemplateDesigner.Controls"
        Title="Odjezdy — nastavení"
        Width="680" Height="640"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl>

            <!-- ── Tab 1: Obecné ──────────────────────────────────── -->
            <TabItem Header="Obecné">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <TextBlock Text="Výchozí styl pro všechny sloupce. V tabu Sloupce můžete nastavení jednotlivých sloupců přepsat."
                                   FontStyle="Italic" Foreground="#888" FontSize="11" Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Styl záhlaví" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <controls:CellStyleEditor
                            DataContext="{Binding ElementHeaderStyle}"
                            EditOptions="{Binding DataContext.HeaderEditOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                            PickTextColorCommand="{Binding DataContext.PickElementHeaderTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ClearTextColorCommand="{Binding DataContext.ClearElementHeaderTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            PickBgColorCommand="{Binding DataContext.PickElementHeaderBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ClearBgColorCommand="{Binding DataContext.ClearElementHeaderBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>

                        <Separator Margin="0,8,0,8"/>

                        <TextBlock Text="Styl datových buněk" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <controls:CellStyleEditor
                            DataContext="{Binding ElementDataStyle}"
                            EditOptions="{Binding DataContext.DataEditOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                            PickTextColorCommand="{Binding DataContext.PickElementDataTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ClearTextColorCommand="{Binding DataContext.ClearElementDataTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            PickBgColorCommand="{Binding DataContext.PickElementDataBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ClearBgColorCommand="{Binding DataContext.ClearElementDataBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>

                        <Button Content="Resetovat výchozí styl" Command="{Binding ResetElementStyleCommand}"
                                HorizontalAlignment="Left" Padding="10,3" Margin="0,12,0,12"/>

                        <Separator Margin="0,4,0,8"/>

                        <TextBlock Text="Ostatní nastavení elementu" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <controls:PropertiesPanel x:Name="GeneralPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Tab 2: Sloupce ─────────────────────────────────── -->
            <TabItem Header="Sloupce">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" MinWidth="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vlevo: seznam skupin -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Skupiny dnů:" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding GroupVMs}"
                                 SelectedItem="{Binding SelectedGroupVM, Mode=TwoWay}"
                                 BorderThickness="1" BorderBrush="#CCCCCC">
                            <ListBox.Resources>
                                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <CheckBox IsChecked="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <Ellipse Width="7" Height="7" Fill="#2196F3" Margin="6,0,0,0"
                                                 VerticalAlignment="Center"
                                                 ToolTip="Má vlastní nastavení stylu (přepisuje výchozí z Obecné)"
                                                 Visibility="{Binding HasAnyOverride, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Content="▲" Width="28" Padding="2,1"
                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="0,0,4,0"/>
                            <Button Content="▼" Width="28" Padding="2,1"
                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Vpravo: detail vybraného sloupce -->
                    <ScrollViewer Grid.Column="1" Margin="8,0,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  IsEnabled="{Binding HasSelection}">
                        <StackPanel>

                            <TextBlock Text="Prázdné pole = dědí výchozí styl elementu."
                                       FontStyle="Italic" Foreground="#888" FontSize="11" Margin="0,0,0,8"/>

                            <!-- ── Záhlaví ──────────────────── -->
                            <TextBlock Text="Záhlaví sloupce" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <controls:CellStyleEditor
                                DataContext="{Binding SelectedGroupVM.Header}"
                                EditOptions="{Binding DataContext.HeaderEditOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                PickTextColorCommand="{Binding DataContext.PickHeaderTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ClearTextColorCommand="{Binding DataContext.ClearHeaderTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                PickBgColorCommand="{Binding DataContext.PickHeaderBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ClearBgColorCommand="{Binding DataContext.ClearHeaderBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>

                            <Separator Margin="0,8,0,8"/>

                            <!-- ── Datové buňky ──────────────── -->
                            <TextBlock Text="Datové buňky" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <controls:CellStyleEditor
                                DataContext="{Binding SelectedGroupVM.Data}"
                                EditOptions="{Binding DataContext.DataEditOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                PickTextColorCommand="{Binding DataContext.PickDataTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ClearTextColorCommand="{Binding DataContext.ClearDataTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                PickBgColorCommand="{Binding DataContext.PickDataBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ClearBgColorCommand="{Binding DataContext.ClearDataBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>

                            <!-- Resetovat -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Resetovat styl sloupce"
                                        Command="{Binding DataContext.ResetStyleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Padding="10,3" Margin="0,0,6,0"/>
                                <Button Content="Resetovat všechny sloupce"
                                        Command="{Binding DataContext.ResetAllColumnStylesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Smaže per-sloupec overrides — všechny sloupce budou dědit z tabu Obecné"
                                        Padding="10,3"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ── OK / Storno ───────────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{StaticResource EDStrings.Ok}"     Width="80" IsDefault="True" Command="{Binding OkCommand}" Padding="10,3" Margin="0,0,6,0"/>
            <Button Content="{StaticResource EDStrings.Cancel}" Width="80" IsCancel="True"  Padding="10,3" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
