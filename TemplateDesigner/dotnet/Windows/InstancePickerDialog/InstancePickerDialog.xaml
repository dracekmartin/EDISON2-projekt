<Window x:Class="TemplateDesigner.InstancePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:el="clr-namespace:EDControls.EDList;assembly=EDControls"
        Title="{Binding WindowTitle}"
        Width="700" Height="560"
        MinWidth="500" MinHeight="380"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Skupina linek - filtr (searchable). Výběr přenačte seznam instancí níže.
             Viditelnost + naplnění řeší code-behind (jen agendy se skupinami). -->
        <Grid Grid.Row="0" x:Name="SkupinaRow" Margin="0,0,0,10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Skupina linek:" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Grid.Column="1" x:Name="CmbSkupina"
                      IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                      MaxDropDownHeight="360" DisplayMemberPath="Display"/>
        </Grid>

        <!-- EDList - server data + multi-select + persist sloupců + client-side search -->
        <el:EDList x:Name="TheList" Grid.Row="1"
                   CacheClass="ALVA.TemplateDesigner.EDList.Instance"
                   HostId="TemplateDesigner.InstancePicker"
                   Title="{Binding WindowTitle}"
                   SelectionMode="Check"/>

        <!-- Status -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                       FontSize="{DynamicResource EDTheme.FontSize.Body}"
                       Foreground="{DynamicResource EDTheme.Text.Muted}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold">
                <Run Text="Vybráno: "/>
                <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
            </TextBlock>
        </Grid>

        <!-- Tlačítka -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Použít" IsDefault="True"
                    Command="{Binding OkCommand}"
                    Width="90" Padding="14,4" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="{StaticResource EDStrings.Cancel}" IsCancel="True" Width="80"/>
        </Grid>
    </Grid>
</Window>
