<Window x:Class="TemplateDesigner.CacheTemplatePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:el="clr-namespace:EDControls.EDList;assembly=EDControls"
        xmlns:td="clr-namespace:TemplateDesigner"
        Title="Šablony v databázi"
        Width="980" Height="560"
        MinWidth="640" MinHeight="360"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Šablona, kterou tisk agendy vezme (výchozí firmy nebo M-line), je tučně - pozná se na první pohled. -->
        <Style x:Key="TemplateCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding [vychozi]}" Value="firma">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding [vychozi]}" Value="mline">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- Akce -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Přejmenovat…" Command="{Binding RenameCommand}"
                    Padding="10,4" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="Smazat"         Command="{Binding DeleteTemplateCommand}"
                    Padding="10,4" Margin="0,0,8,0"/>
            <!-- Nastavení výchozí šablony do příští verze schované (Jan 3. 11.): tisk z okna JŘ, kterému slouží,
                 do verze nejde a ovládání se ještě ladí. Uživatel vidí jen výchozí šablonu M-line. -->
            <Button Grid.Column="2" Content="{Binding DefaultButtonText}" Command="{Binding ToggleDefaultCommand}"
                    Visibility="Collapsed" Padding="10,4"
                    ToolTip="Šablona, kterou vezme tisk z modulu (okno jízdních řádů), když uživatel nevybere jinou. Bez výchozí šablony firmy tiskne výchozí šablona M-line."/>

            <Button Grid.Column="4" Content="Nová šablona" Command="{Binding NewTemplateCommand}"
                    Padding="10,4" Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Prázdná šablona ve vybrané agendě. Ve stromu vyberte agendu, u jízdních řádů i AD nebo MHD."/>
            <Button Grid.Column="5" Content="Otevřít" IsDefault="True"
                    Command="{Binding OpenCommand}"
                    Padding="14,4" Width="90" Margin="0,0,8,0"/>
            <Button Grid.Column="6" Content="{StaticResource EDStrings.Cancel}"  IsCancel="True" Width="80"/>
        </Grid>

        <!-- Nabídka nových šablon z kanálu M-line. Není to modální otázka: zobrazí se, jen když
             je co stáhnout, a přehled je použitelný i bez ní (bez sítě se prostě neukáže). -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,6"
                Background="{DynamicResource EDTheme.Bg.InfoBanner}"
                BorderBrush="{DynamicResource EDTheme.Accent.Blue}" BorderThickness="1" CornerRadius="3"
                Visibility="{Binding HasAvailable, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Stáhnout" Padding="12,3" Margin="12,0,0,0"
                        Command="{Binding DownloadCommand}"/>
                <TextBlock Text="{Binding AvailableText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Strom podle oblasti práce, agendy a varianty - skládá ho server z registru agend. -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="1">
                <!-- Bez vodorovného posuvníku: druhý řádek uzlu se zkrátí na šířku panelu, místo aby ho rozšiřoval. -->
                <TreeView x:Name="Tree" ItemsSource="{Binding Nodes}" BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          FontSize="{DynamicResource EDTheme.FontSize.Body}">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type td:TemplateCatalogNodeVM}" ItemsSource="{Binding Children}">
                            <StackPanel Margin="0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}"/>
                                    <TextBlock Text="{Binding Count}" Margin="6,0,0,0"
                                               Foreground="{DynamicResource EDTheme.Text.Secondary}"/>
                                </StackPanel>
                                <!-- Šablona pro tisk z okna jízdních řádů: do jeho vydání skrytá, uživatel ten tisk
                                     nemá a informace mátla (Jan 3. 11.). Vrátit: Visibility na HasDetail. -->
                                <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"
                                           ToolTip="{Binding Detail}"
                                           FontSize="{DynamicResource EDTheme.FontSize.Caption}"
                                           Foreground="{DynamicResource EDTheme.Text.Secondary}"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Šablony vybraného uzlu (Caché-driven přes EDList) -->
            <el:EDList x:Name="TheList" Grid.Column="2"
                       CacheClass="ALVA.TemplateDesigner.EDList.Sablony"
                       HostId="TemplateDesigner.TemplatePicker"
                       Title="Šablony v databázi"/>
            <!-- Tučná šablona pro tisk (CellStyle="{StaticResource TemplateCell}") se vrátí s tiskem z okna jízdních řádů. -->
        </Grid>

    </DockPanel>
</Window>
