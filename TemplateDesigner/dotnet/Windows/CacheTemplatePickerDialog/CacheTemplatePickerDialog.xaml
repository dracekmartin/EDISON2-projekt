<Window x:Class="TemplateDesigner.CacheTemplatePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:el="clr-namespace:EDControls.EDList;assembly=EDControls"
        xmlns:edct="clr-namespace:EDControls.EDComponentToolbar;assembly=EDControls"
        xmlns:ef="clr-namespace:EDControls.EDFooter;assembly=EDControls"
        xmlns:td="clr-namespace:TemplateDesigner"
        Title="Šablony v databázi"
        Width="980" Height="560"
        MinWidth="640" MinHeight="360"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Šablona, kterou tisk agendy vezme (výchozí firmy nebo M-line), je tučně - pozná se na první pohled. -->
        <Style x:Key="TemplateCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding [vychozi]}" Value="firma">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding [vychozi]}" Value="mline">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
    <!-- Výběrové okno jako legacy BaseForm2 ve výběru s úpravami: OK otevře vybranou šablonu (i dvojklik, Ctrl+Enter),
         Storno a Esc zavřou, vlevo nabídka Akce se stejnými akcemi jako ikony nad seznamem. -->
    <ef:EDFooter DockPanel.Dock="Bottom" FooterMode="OkCancel"/>

    <DockPanel Margin="12">

        <!-- Nabídka nových šablon z kanálu M-line. Není to modální otázka: zobrazí se, jen když
             je co stáhnout, a přehled je použitelný i bez ní (bez sítě se prostě neukáže). -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,6"
                Background="{DynamicResource EDTheme.Bg.InfoBanner}"
                BorderBrush="{DynamicResource EDTheme.Accent.Blue}" BorderThickness="1" CornerRadius="3"
                Visibility="{Binding HasAvailable, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Stáhnout" Padding="12,3" Margin="12,0,0,0"
                        Command="{Binding DownloadCommand}"/>
                <TextBlock Text="{Binding AvailableText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Strom podle oblasti práce, agendy a varianty - skládá ho server z registru agend. Vzhled jako úvodní
                 obrazovka: oblast je nadpis s modrou značkou, agenda tučně, počet šablon ve štítku u pravého okraje. -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="1">
                <DockPanel>
                    <!-- Týž pruh jako seznam vpravo; výšku mu code-behind srovná se seznamem, který má navíc hledání. -->
                    <edct:EDComponentToolbar x:Name="TreeHeader" DockPanel.Dock="Top" Title="Agendy"
                                             ShowSearch="False" ShowHelp="False"/>
                    <!-- Bez vodorovného posuvníku: řádek uzlu má šířku panelu, štítek počtu tak drží u pravého okraje. -->
                    <TreeView x:Name="Tree" ItemsSource="{Binding Nodes}" BorderThickness="0" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="4,6"
                              FontSize="{DynamicResource EDTheme.FontSize.Body}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="6,5"/>
                                <Style.Triggers>
                                    <!-- Mezera nad oblastí se zkoušela a strom roztahovala (Jan 3. 11.), oblast odliší nadpis. -->
                                    <!-- Všechny šablony nemají co rozbalit: bez místa pro šipku stojí u levého okraje
                                         a čtou se jako položka nad stromem (Jan 3. 11.). Barvy jako sdílený styl uzlu. -->
                                    <DataTrigger Binding="{Binding Kind}" Value="All">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TreeViewItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}" CornerRadius="2" SnapsToDevicePixels="True">
                                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" SourceName="Bd" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Bg.Hover}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Accent.BlueSelected}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type td:TemplateCatalogNodeVM}" ItemsSource="{Binding Children}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border x:Name="Znacka" Width="3" Height="16" CornerRadius="1.5" Margin="0,0,8,0"
                                            Background="{DynamicResource EDTheme.Accent.Blue}" Visibility="Collapsed"/>
                                    <TextBlock x:Name="Popisek" Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border x:Name="Pocet" Grid.Column="2" CornerRadius="9" Padding="7,1" MinWidth="24" Margin="8,0,2,0"
                                            VerticalAlignment="Center" Background="{DynamicResource EDTheme.Bg.Panel}"
                                            BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="1">
                                        <TextBlock Text="{Binding Count}" HorizontalAlignment="Center"
                                                   FontSize="{DynamicResource EDTheme.FontSize.Caption}"
                                                   Foreground="{DynamicResource EDTheme.Text.Secondary}"/>
                                    </Border>
                                    <!-- Šablona pro tisk z okna jízdních řádů: do jeho vydání skrytá, uživatel ten tisk
                                         nemá a informace mátla (Jan 3. 11.). Vrátit: Visibility na HasDetail. -->
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                               Text="{Binding Detail}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"
                                               ToolTip="{Binding Detail}"
                                               FontSize="{DynamicResource EDTheme.FontSize.Caption}"
                                               Foreground="{DynamicResource EDTheme.Text.Secondary}"
                                               Visibility="Collapsed"/>
                                </Grid>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="All">
                                        <Setter TargetName="Popisek" Property="FontWeight" Value="SemiBold"/>
                                        <!-- Všechny šablony počet nemají - patří k nim i šablony agend mimo strom. -->
                                        <Setter TargetName="Pocet" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Area">
                                        <Setter TargetName="Znacka" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Popisek" Property="FontWeight" Value="SemiBold"/>
                                        <Setter TargetName="Popisek" Property="Foreground" Value="{DynamicResource EDTheme.Text.Header}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Agenda">
                                        <Setter TargetName="Popisek" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <!-- Zásilky od jiných firem jsou nadpis jako oblast; počet přijde až z ISYCloudu. -->
                                    <DataTrigger Binding="{Binding Kind}" Value="Received">
                                        <Setter TargetName="Znacka" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Popisek" Property="FontWeight" Value="SemiBold"/>
                                        <Setter TargetName="Popisek" Property="Foreground" Value="{DynamicResource EDTheme.Text.Header}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Count}" Value="{x:Null}">
                                        <Setter TargetName="Pocet" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Šablony vybraného uzlu (Caché-driven přes EDList), pruh nese vybranou agendu. Pod seznamem řádek,
                 co uživatel nad výběrem může udělat; s tiskem z okna JŘ do něj přibude výchozí šablona pro tisk. -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,7" CornerRadius="3"
                        Background="{DynamicResource EDTheme.Bg.Panel}"
                        BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="1">
                    <DockPanel>
                        <Image Source="{StaticResource EDIcons.Info}" Width="16" Height="16" Margin="0,1,10,0"
                               VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource EDTheme.Text.Secondary}"/>
                    </DockPanel>
                </Border>
                <el:EDList x:Name="TheList"
                           CacheClass="ALVA.TemplateDesigner.EDList.Sablony"
                           HostId="TemplateDesigner.TemplatePicker"
                           Title="{Binding ListTitle}" Actions="{Binding Actions}"
                           SelectionMode="{Binding ListSelectionMode}"/>
            </DockPanel>
            <!-- Tučnou výchozí šablonu pro tisk (TemplateCell) zapíná code-behind jen se zapnutým tiskem z okna JŘ. -->
        </Grid>

    </DockPanel>
    </DockPanel>
</Window>
