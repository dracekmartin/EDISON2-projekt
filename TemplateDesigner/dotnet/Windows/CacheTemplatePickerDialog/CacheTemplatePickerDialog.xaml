<Window x:Class="TemplateDesigner.CacheTemplatePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:el="clr-namespace:EDControls.EDList;assembly=EDControls"
        Title="Šablony v Caché"
        Width="720" Height="480"
        MinWidth="500" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Agenda filter (host-specific) -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Agenda:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding AgendaFilters}"
                      SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                      DisplayMemberPath="Label"/>
        </Grid>

        <!-- List šablon (Caché-driven přes EDList) -->
        <el:EDList x:Name="TheList" Grid.Row="1"/>

        <!-- Akce -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Přejmenovat..." Command="{Binding RenameCommand}"
                    Padding="10,4" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="Smazat"          Command="{Binding DeleteCommand}"
                    Padding="10,4"/>

            <Button Grid.Column="3" Content="Otevřít" IsDefault="True"
                    Command="{Binding OpenCommand}"
                    Padding="14,4" Width="90" Margin="0,0,8,0"/>
            <Button Grid.Column="4" Content="Zrušit"  IsCancel="True" Width="80"/>
        </Grid>
    </Grid>
</Window>
