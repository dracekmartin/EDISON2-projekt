<Window x:Class="TemplateDesigner.StopColumnsEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TemplateDesigner.Controls"
        xmlns:eif="clr-namespace:EDControls.EDInputForm;assembly=EDControls"
        Title="Zastávky — nastavení"
        Width="680" Height="640"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl>

            <!-- ── Tab 1: Obecné ──────────────────────────────────── -->
            <!-- Výchozí nastavení celého elementu (styl záhlaví/buněk = báze pro sloupce).
                 Per-sloupec overridy v tabu Sloupce. -->
            <TabItem Header="Obecné">
                <eif:EDInputForm x:Name="GeneralForm"/>
            </TabItem>

            <!-- ── Tab 2: Sloupce ─────────────────────────────────── -->
            <TabItem Header="Sloupce">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" MinWidth="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vlevo: seznam sloupců -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Sloupce:" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding ColumnVMs}"
                                 SelectedItem="{Binding SelectedColumnVM, Mode=TwoWay}"
                                 BorderThickness="1" BorderBrush="#CCCCCC">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Visible, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Key}" Foreground="#888888" FontSize="11"/>
                                        </StackPanel>
                                        <Ellipse Grid.Column="2" Width="7" Height="7" Fill="#2196F3"
                                                 Margin="6,0,0,0" VerticalAlignment="Center"
                                                 ToolTip="Má vlastní nastavení stylu (přepisuje výchozí z Obecné)"
                                                 Visibility="{Binding HasAnyOverride, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                                   Foreground="#888888" FontSize="11" Margin="4,0,0,0"
                                                   Text="{Binding Width, StringFormat='{}{0} mm'}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="▲" Width="28" Padding="2,1"
                                        Command="{Binding MoveUpCommand}" Margin="0,0,4,0"/>
                                <Button Content="▼" Width="28" Padding="2,1"
                                        Command="{Binding MoveDownCommand}" Margin="0,0,12,0"/>
                                <Button Content="Výchozí" Padding="6,1"
                                        Command="{Binding ResetCommand}"/>
                            </StackPanel>

                            <!-- Warning při přesahu šířky -->
                            <TextBlock Text="{Binding ColumnOverflowText}"
                                       Foreground="#C62828" FontSize="12" Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasColumnOverflow, Converter={StaticResource BoolToVis}}"/>

                            <Button Content="Přizpůsobit sloupce k šířce elementu"
                                    Command="{Binding FitColumnsToWidthCommand}"
                                    ToolTip="Proporcionálně zmenší/zvětší šířky všech sloupců, aby součet odpovídal šířce elementu."
                                    HorizontalAlignment="Stretch" Padding="6,3" Margin="0,4,0,0"
                                    Visibility="{Binding HasColumnOverflow, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Vpravo: detail vybraného sloupce -->
                    <ScrollViewer Grid.Column="1" Margin="8,0,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  IsEnabled="{Binding HasSelection}">
                        <StackPanel>

                            <!-- ── Struktura sloupce ────────────── -->
                            <TextBlock Text="Struktura sloupce" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Záhlaví:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Width="100" Text="{Binding SelectedColumnVM.Header, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0"/>
                                <TextBlock Text="Šířka (mm):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Width="50" Text="{Binding SelectedColumnVM.Width, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0"/>
                                <TextBlock Text="Zarovnání:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Width="80"
                                          ItemsSource="{Binding DataContext.AlignmentOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding SelectedColumnVM.AlignmentLabel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- ── Oddělovač ──────────────────── -->
                            <Separator Margin="0,8,0,8"/>

                            <TextBlock Text="Prázdné pole = dědí výchozí styl elementu."
                                       FontStyle="Italic" Foreground="#888" FontSize="12" Margin="0,0,0,8"/>

                            <!-- ── Styl záhlaví ──────────────── -->
                            <TextBlock Text="Styl záhlaví" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <controls:CellStyleEditor
                                DataContext="{Binding SelectedColumnVM.HeaderStyle}"
                                EditOptions="{Binding DataContext.HeaderEditOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                PickTextColorCommand="{Binding DataContext.PickHeaderTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ClearTextColorCommand="{Binding DataContext.ClearHeaderTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                PickBgColorCommand="{Binding DataContext.PickHeaderBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ClearBgColorCommand="{Binding DataContext.ClearHeaderBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>

                            <Separator Margin="0,8,0,8"/>

                            <!-- ── Styl dat ──────────────────── -->
                            <TextBlock Text="Styl datových buněk" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <controls:CellStyleEditor
                                DataContext="{Binding SelectedColumnVM.DataStyle}"
                                EditOptions="{Binding DataContext.DataEditOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                PickTextColorCommand="{Binding DataContext.PickDataTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ClearTextColorCommand="{Binding DataContext.ClearDataTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                PickBgColorCommand="{Binding DataContext.PickDataBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ClearBgColorCommand="{Binding DataContext.ClearDataBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>

                            <!-- Resetovat -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Resetovat styl sloupce"
                                        Command="{Binding DataContext.ResetStyleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Padding="10,3" Margin="0,0,6,0"/>
                                <Button Content="Resetovat všechny sloupce"
                                        Command="{Binding DataContext.ResetAllColumnStylesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Smaže per-sloupec overrides — všechny sloupce budou dědit z tabu Obecné"
                                        Padding="10,3"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ── OK / Storno ───────────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{StaticResource EDStrings.Ok}"     Width="80" IsDefault="True" Click="OkButton_Click" Padding="10,3" Margin="0,0,6,0"/>
            <Button Content="{StaticResource EDStrings.Cancel}" Width="80" IsCancel="True"  Padding="10,3" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
