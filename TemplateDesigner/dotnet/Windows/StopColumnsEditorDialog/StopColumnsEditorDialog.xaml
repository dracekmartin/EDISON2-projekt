<Window x:Class="TemplateDesigner.StopColumnsEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TemplateDesigner.Controls"
        Title="Zastávky — nastavení"
        Width="620" Height="580"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl>

            <!-- ── Tab 1: Obecné ──────────────────────────────────── -->
            <TabItem Header="Obecné">
                <controls:PropertiesPanel x:Name="GeneralPanel" Margin="6"/>
            </TabItem>

            <!-- ── Tab 2: Sloupce ─────────────────────────────────── -->
            <TabItem Header="Sloupce">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" MinWidth="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vlevo: seznam sloupců -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Sloupce:" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding ColumnVMs}"
                                 SelectedItem="{Binding SelectedColumnVM, Mode=TwoWay}"
                                 BorderThickness="1" BorderBrush="#CCCCCC">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Visible, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Key}" Foreground="#888888" FontSize="10"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                   Foreground="#888888" FontSize="10" Margin="4,0,0,0"
                                                   Text="{Binding Width, StringFormat='{}{0} mm'}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Content="▲" Width="28" Padding="2,1"
                                    Command="{Binding MoveUpCommand}" Margin="0,0,4,0"/>
                            <Button Content="▼" Width="28" Padding="2,1"
                                    Command="{Binding MoveDownCommand}" Margin="0,0,12,0"/>
                            <Button Content="Výchozí" Padding="6,1"
                                    Command="{Binding ResetCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Vpravo: detail vybraného sloupce -->
                    <ScrollViewer Grid.Column="1" Margin="8,0,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  IsEnabled="{Binding HasSelection}">
                        <StackPanel>

                            <!-- ── Struktura sloupce ────────────── -->
                            <TextBlock Text="Struktura sloupce" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Záhlaví:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Width="100" Text="{Binding SelectedColumnVM.Header, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0"/>
                                <TextBlock Text="Šířka (mm):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Width="50" Text="{Binding SelectedColumnVM.Width, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0"/>
                                <TextBlock Text="Zarovnání:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Width="80"
                                          ItemsSource="{Binding DataContext.AlignmentOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding SelectedColumnVM.AlignmentLabel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- ── Oddělovač ──────────────────── -->
                            <Separator Margin="0,8,0,8"/>

                            <!-- ── Styl záhlaví ──────────────── -->
                            <TextBlock Text="Styl záhlaví" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <!-- Font + velikost + B/I -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Font:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Width="90" Text="{Binding SelectedColumnVM.HeaderStyle.FontFamily, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0"/>
                                <TextBlock Text="Velikost:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox IsEditable="True" Width="55"
                                          ItemsSource="{Binding DataContext.FontSizeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Text="{Binding SelectedColumnVM.HeaderStyle.FontSize, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                          Margin="0,0,10,0"/>
                                <CheckBox Content="Tučné" IsChecked="{Binding SelectedColumnVM.HeaderStyle.Bold}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <CheckBox Content="Kurzíva" IsChecked="{Binding SelectedColumnVM.HeaderStyle.Italic}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Zarovnání stylu -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Zarovnání:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Width="90"
                                          ItemsSource="{Binding DataContext.AlignmentOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedIndex="{Binding SelectedColumnVM.HeaderStyle.HAlignmentIndex, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Barva textu -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Barva textu:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="▪" Width="24" Command="{Binding DataContext.PickHeaderTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,1" Margin="0,0,2,0"/>
                                <Button Content="✕" Width="20" Command="{Binding DataContext.ClearHeaderTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="2,1" FontSize="10" Margin="0,0,10,0"/>
                                <TextBlock Text="Pozadí:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="▪" Width="24" Command="{Binding DataContext.PickHeaderBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,1" Margin="0,0,2,0"/>
                                <Button Content="✕" Width="20" Command="{Binding DataContext.ClearHeaderBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="2,1" FontSize="10"/>
                            </StackPanel>

                            <!-- Padding -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Padding (mm):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="↑" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBox Width="35" Text="{Binding SelectedColumnVM.HeaderStyle.PaddingTop, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Margin="0,0,6,0"/>
                                <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBox Width="35" Text="{Binding SelectedColumnVM.HeaderStyle.PaddingRight, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Margin="0,0,6,0"/>
                                <TextBlock Text="↓" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBox Width="35" Text="{Binding SelectedColumnVM.HeaderStyle.PaddingBottom, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Margin="0,0,6,0"/>
                                <TextBlock Text="←" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBox Width="35" Text="{Binding SelectedColumnVM.HeaderStyle.PaddingLeft, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
                            </StackPanel>

                            <!-- ── Oddělovač ──────────────────── -->
                            <Separator Margin="0,8,0,8"/>

                            <!-- ── Styl dat ──────────────────── -->
                            <TextBlock Text="Styl datových buněk" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <!-- Font + velikost + B/I -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Font:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Width="90" Text="{Binding SelectedColumnVM.DataStyle.FontFamily, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0"/>
                                <TextBlock Text="Velikost:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox IsEditable="True" Width="55"
                                          ItemsSource="{Binding DataContext.FontSizeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Text="{Binding SelectedColumnVM.DataStyle.FontSize, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                          Margin="0,0,10,0"/>
                                <CheckBox Content="Tučné" IsChecked="{Binding SelectedColumnVM.DataStyle.Bold}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <CheckBox Content="Kurzíva" IsChecked="{Binding SelectedColumnVM.DataStyle.Italic}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Zarovnání -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Zarovnání:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Width="90"
                                          ItemsSource="{Binding DataContext.AlignmentOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedIndex="{Binding SelectedColumnVM.DataStyle.HAlignmentIndex, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Barva textu + pozadí -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Barva textu:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="▪" Width="24" Command="{Binding DataContext.PickDataTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,1" Margin="0,0,2,0"/>
                                <Button Content="✕" Width="20" Command="{Binding DataContext.ClearDataTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="2,1" FontSize="10" Margin="0,0,10,0"/>
                                <TextBlock Text="Pozadí:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="▪" Width="24" Command="{Binding DataContext.PickDataBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,1" Margin="0,0,2,0"/>
                                <Button Content="✕" Width="20" Command="{Binding DataContext.ClearDataBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="2,1" FontSize="10"/>
                            </StackPanel>

                            <!-- Padding -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Padding (mm):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="↑" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBox Width="35" Text="{Binding SelectedColumnVM.DataStyle.PaddingTop, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Margin="0,0,6,0"/>
                                <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBox Width="35" Text="{Binding SelectedColumnVM.DataStyle.PaddingRight, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Margin="0,0,6,0"/>
                                <TextBlock Text="↓" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBox Width="35" Text="{Binding SelectedColumnVM.DataStyle.PaddingBottom, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Margin="0,0,6,0"/>
                                <TextBlock Text="←" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBox Width="35" Text="{Binding SelectedColumnVM.DataStyle.PaddingLeft, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
                            </StackPanel>

                            <!-- Resetovat -->
                            <Button Content="Resetovat styl" Command="{Binding DataContext.ResetStyleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    HorizontalAlignment="Left" Padding="10,3" Margin="0,12,0,0"/>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ── OK / Storno ───────────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{StaticResource EDStrings.Ok}"     Width="80" IsDefault="True" Command="{Binding OkCommand}" Padding="10,3" Margin="0,0,6,0"/>
            <Button Content="{StaticResource EDStrings.Cancel}" Width="80" IsCancel="True"  Padding="10,3" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
