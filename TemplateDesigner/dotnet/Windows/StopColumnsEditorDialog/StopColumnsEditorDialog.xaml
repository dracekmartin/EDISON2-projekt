<Window x:Class="TemplateDesigner.StopColumnsEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor sloupců zastávek"
        Width="580" Height="360"
        MinWidth="480" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="ColumnsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  BorderThickness="1"
                  BorderBrush="#CCCCCC"
                  ItemsSource="{Binding ColumnVMs}"
                  SelectedItem="{Binding SelectedColumnVM, Mode=TwoWay}"
                  PreviewKeyDown="Grid_PreviewKeyDown">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Viditelný" Binding="{Binding Visible, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <DataGridTextColumn Header="Klíč" Binding="{Binding Key}" IsReadOnly="True" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#888888"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Záhlaví" Binding="{Binding Header, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                <DataGridTextColumn Header="Šířka (mm)" Binding="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridComboBoxColumn Header="Zarovnání"
                                       SelectedItemBinding="{Binding AlignmentLabel, UpdateSourceTrigger=PropertyChanged}"
                                       Width="90">
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="ItemsSource" Value="{Binding DataContext.AlignmentOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="ItemsSource" Value="{Binding DataContext.AlignmentOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                </DataGridComboBoxColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="↑" Width="28" Command="{Binding MoveUpCommand}" Padding="10,3" Margin="0,0,6,0"/>
            <Button Content="↓" Width="28" Command="{Binding MoveDownCommand}" Padding="10,3" Margin="0,0,6,0"/>
            <Button Content="Výchozí" Command="{Binding ResetCommand}" Padding="10,3" Margin="16,0,6,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{StaticResource EDStrings.Ok}"     Width="80" IsDefault="True" Command="{Binding OkCommand}" Padding="10,3" Margin="0,0,6,0"/>
            <Button Content="{StaticResource EDStrings.Cancel}" Width="80" IsCancel="True"  Padding="10,3" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
