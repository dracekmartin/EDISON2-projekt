<Window x:Class="TemplateDesigner.DynamicTableEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TemplateDesigner.Controls"
        xmlns:eif="clr-namespace:EDControls.EDInputForm;assembly=EDControls"
        Width="700" Height="640"
        MinWidth="580" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs">

            <!-- ── Tab 1: Obecné ──────────────────────────────────── -->
            <!-- Výchozí nastavení celého elementu (zdroj dat, styl záhlaví/buněk = báze pro sloupce).
                 Per-sloupec overridy v tabu Sloupce. -->
            <TabItem Header="Obecné">
                <eif:EDInputForm x:Name="GeneralForm"/>
            </TabItem>

            <!-- ── Tab 2: Sloupce ─────────────────────────────────── -->
            <TabItem Header="Sloupce">
                <controls:ColumnsTab DataContext="{Binding Columns}" IsVisibleChanged="ColumnsTab_IsVisibleChanged">
                    <!-- Odkud sloupec bere hodnotu - jen Tabulka z dat (DataContext = vybraný sloupec). -->
                    <controls:ColumnsTab.ExtraColumnTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Pole" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox Width="200" IsEditable="True"
                                              Text="{Binding Field, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding DataContext.AvailableFields, RelativeSource={RelativeSource AncestorType=Window}}"
                                              ToolTip="Datové pole kolekce, ze kterého se plní buňky sloupce (např. POPIS)."/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Výraz" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Width="200"
                                             Text="{Binding Expression, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="Počítané pole - aritmetika nad poli řádku, např. {CENA} * {POCET}. Má-li hodnotu, přebíjí Pole."/>
                                    <TextBlock Text="Formát" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                    <TextBox Width="80"
                                             Text="{Binding Format, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="Formát hodnoty, např. N2 (2 desetinná místa), dd.MM.yyyy. Prázdné = beze změny."/>
                                </StackPanel>
                                <TextBlock Text="Výraz (počítané pole) přebíjí Pole. Číselný výsledek naformátujte přes Formát (např. N2)."
                                           FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{DynamicResource EDTheme.Text.Muted}" FontSize="{DynamicResource EDTheme.FontSize.Body}"/>
                            </StackPanel>
                        </DataTemplate>
                    </controls:ColumnsTab.ExtraColumnTemplate>
                </controls:ColumnsTab>
            </TabItem>

        </TabControl>

        <!-- ── OK / Storno ───────────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{StaticResource EDStrings.Ok}"     Width="80" IsDefault="True" Click="OkButton_Click" Padding="10,3" Margin="0,0,6,0"/>
            <Button Content="{StaticResource EDStrings.Cancel}" Width="80" IsCancel="True"  Padding="10,3" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
