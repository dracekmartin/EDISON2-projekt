<Window x:Class="TemplateDesigner.TemplateTreeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strom šablony"
        Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">

    <DockPanel Margin="8">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#F0F4F8" Padding="10" Margin="-8,-8,-8,8"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <TextBlock Text="Strom šablony — přehled struktury"
                       FontSize="13" FontWeight="SemiBold" Foreground="#1A5276"/>
        </Border>

        <!-- Footer -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{StaticResource EDStrings.Close}" Padding="16,6" IsCancel="True"/>
        </StackPanel>

        <!-- TreeView -->
        <TreeView x:Name="Tree" FontFamily="Consolas" FontSize="12"
                  BorderThickness="1" BorderBrush="#CCCCCC">
            <TreeView.Resources>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True"/>
                </Style>
            </TreeView.Resources>
        </TreeView>
    </DockPanel>
</Window>
