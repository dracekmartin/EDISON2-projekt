<Window x:Class="TemplateDesigner.SkupinyPoznamekDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Druhy poznámek"
        Width="680" Height="470"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource EDTheme.Text.Secondary}">
            Každý druh začíná v legendě na novém řádku, v pořadí shora dolů.
        </TextBlock>

        <!-- Záhlaví sloupců seznamu - šířky shodné s šablonou řádku -->
        <Grid Grid.Row="1" Margin="6,0,104,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Druh poznámek" Foreground="{DynamicResource EDTheme.Text.Secondary}"/>
            <TextBlock Grid.Column="1" Text="Tisknout" Foreground="{DynamicResource EDTheme.Text.Secondary}"/>
            <TextBlock Grid.Column="2" Text="Sloupců" Foreground="{DynamicResource EDTheme.Text.Secondary}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Skupiny}"
                     SelectedItem="{Binding Vybrana}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Nazev}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding Tisknout}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding DataContext.VolbySloupcu, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Sloupcu}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <!-- Šipky jako tvar, ne znak: ▲ a ▼ mají ve fontu jinou velikost i výšku (nález Jan 9. 10.).
                     Posun jen šipkou bez textu jako v ostatních oknech se seznamem (rozhodnutí Jan 26. 10.). -->
                <Button Command="{Binding NahoruCommand}" Width="28" Padding="2,4" Margin="0,0,0,4" ToolTip="Posunout nahoru">
                    <Path Data="M0,6 L4.5,0 L9,6 Z" Width="9" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Command="{Binding DoluCommand}" Width="28" Padding="2,4" ToolTip="Posunout dolů">
                    <Path Data="M0,0 L4.5,6 L9,0 Z" Width="9" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{StaticResource EDStrings.Ok}"     Width="80" IsDefault="True" Command="{Binding OkCommand}" Padding="10,3" Margin="0,0,6,0"/>
            <Button Content="{StaticResource EDStrings.Cancel}" Width="80" IsCancel="True"  Padding="10,3"/>
        </StackPanel>
    </Grid>
</Window>
