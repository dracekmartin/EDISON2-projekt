<Window x:Class="TemplateDesigner.AiTemplateAssistantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Asistent šablon"
        Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource EDTheme.Bg.InfoBanner}" Padding="12" Margin="-16,-16,-16,0" BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="🤖 AI Asistent pro generování šablon"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource EDTheme.Accent.BlueDark}"/>
                <TextBlock Text="Popište šablonu, kterou chcete vytvořit, a AI vygeneruje kompletní JSON strukturu."
                           FontSize="12"
                           Foreground="{DynamicResource EDTheme.Text.Muted}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Footer s tlačítky -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource EDTheme.Bg.Footer}" Padding="12" Margin="-16,16,-16,-16" BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0"
                             Height="24"
                             Margin="0,0,12,0"
                             IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <Button Grid.Column="1"
                        Content="Vygenerovat šablonu"
                        Command="{Binding GenerateCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        Padding="16,6"
                        Margin="0,0,8,0"
                        IsDefault="True"/>

                <Button Grid.Column="2"
                        Content="{StaticResource EDStrings.Close}"
                        Padding="16,6"
                        IsCancel="True"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel>
                <!-- Volba agendy -->
                <TextBlock Text="Agenda (volitelné)" Style="{StaticResource SectionHeader}"/>
                <ComboBox SelectedValue="{Binding SelectedAgenda}"
                          SelectedValuePath="Tag"
                          SelectedIndex="0"
                          Margin="0,0,0,0">
                    <ComboBoxItem Content="Obecná šablona" Tag=""/>
                    <ComboBoxItem Content="Jízdní řád (JR)" Tag="JR"/>
                    <ComboBoxItem Content="Faktury" Tag="FAKTURY"/>
                </ComboBox>
                <TextBlock Text="Vyberte agendu, pokud chcete použít specifická datová pole."
                           FontSize="11"
                           Foreground="{DynamicResource EDTheme.Text.Muted}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>

                <!-- Popis šablony -->
                <TextBlock Text="Popis šablony *" Style="{StaticResource SectionHeader}"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         x:Name="DescriptionTextBox"
                         Height="200"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Segoe UI"
                         Padding="8"/>
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource EDTheme.Text.Muted}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap">
                    <Run Text="Příklad:"/>
                    <LineBreak/>
                    <Run Text="&quot;Vytvoř fakturační šablonu s hlavičkou obsahující logo a název firmy, tabulku položek s 5 sloupci (název, množství, cena, DPH, celkem) a patičku s platebními údaji.&quot;"/>
                </TextBlock>

                <!-- API Key (volitelné) -->
                <TextBlock Text="Anthropic API Key (volitelné)" Style="{StaticResource SectionHeader}"/>
                <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                         x:Name="ApiKeyTextBox"
                         FontFamily="Consolas"
                         Padding="8"/>
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource EDTheme.Text.Muted}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap">
                    <Run Text="Pokud není zadán API klíč zde, použije se klíč z templatedesigner.appsettings.json. Získat API klíč můžete na "/>
                    <Hyperlink NavigateUri="https://console.anthropic.com/" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="console.anthropic.com"/>
                    </Hyperlink>
                </TextBlock>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
