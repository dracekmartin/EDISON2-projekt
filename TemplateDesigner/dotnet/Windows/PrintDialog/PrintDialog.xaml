<Window x:Class="TemplateDesigner.PrintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TemplateDesigner"
        xmlns:eif="clr-namespace:EDControls.EDInputForm;assembly=EDControls"
        xmlns:controls="clr-namespace:TemplateDesigner.Controls"
        Title="Tisk šablony"
        Width="620" Height="860"
        MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Patička - status + tlačítka -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource EDTheme.FontSize.Body}"
                           Foreground="{DynamicResource EDTheme.Text.Muted}" TextTrimming="CharacterEllipsis"/>
                <!-- Průběh načítání a kontroly po linkách - u skupiny linek to trvá, ať je vidět, že se pracuje. -->
                <ProgressBar Height="4" Margin="0,4,0,0" Minimum="0" Maximum="1" Value="{Binding Prubeh, Mode=OneWay}"
                             Visibility="{Binding Probiha, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Zobrazit hlášky" Command="{Binding ZobrazitHlaseniCommand}"
                        Visibility="{Binding HasHlaseni, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,2"
                        ToolTip="Znovu otevře okno s hláškami poslední kontroly"/>
            </StackPanel>

            <!-- Vystředěno: po kontrole přibude vlevo „Zobrazit hlášky" a tlačítka by se natáhla na výšku obou řádků. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Zkontrolovat" Padding="16,6"
                        Command="{Binding KontrolaCommand}"
                        Visibility="{Binding CanExportRealData, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding KontrolaTooltip}"
                        Margin="0,0,16,0"/>
                <TextBlock Text="Formát:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding Formaty}" SelectedItem="{Binding Format}" Width="70"
                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="{Binding TlacitkoVytvorit}" Padding="16,6"
                        Command="{Binding VytvoritCommand}"
                        ToolTip="{Binding VytvoritTooltip}"
                        Margin="0,0,8,0"/>
                <!-- IsDefault + IsCancel na jednom tlačítku záměrně: dialog nemá OK/Storno pár -
                     tisk/export jsou samostatné akce a Zavřít je jediný způsob odchodu (Enter i Esc). -->
                <Button Content="{StaticResource EDStrings.Close}" Padding="16,6" IsDefault="True" IsCancel="True"/>
            </StackPanel>
        </Grid>

        <!-- Uspořádání na list (`B186`) - nákres pod formulářem, ne ve formuláři: formulář je z Caché
             a vlastní kreslicí prvek se do něj vložit nedá (míchat obojí se nesmí, rozbíjí se to
             při obnovení formuláře). -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0"
                BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="1"
                CornerRadius="4" Padding="12" Background="{DynamicResource EDTheme.Bg.Footer}"
                Visibility="{Binding UkazatUsporadani, Converter={StaticResource BoolToVis}}">
            <controls:UsporadaniListuPanel x:Name="UsporadaniPanel"/>
        </Border>

        <!-- Obsah - parametry + export (formulář řízený z Caché přes EDInputForm / AgendaParams;
             AgendaParams přidává universální skupinu „Export" s členěním výstupu + názvem souboru) -->
        <Border BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="1"
                CornerRadius="4" Padding="12" Background="{DynamicResource EDTheme.Bg.Footer}">
            <Grid>
                <!-- Stav: je agenda - formulář se staví v code-behindu (CacheClass + InitParams) -->
                <eif:EDInputForm x:Name="ParamForm"
                                 Visibility="{Binding HasForm, Converter={StaticResource BoolToVis}}"/>

                <!-- Stav: bez agendy (GENERAL) -->
                <TextBlock Text="Tato šablona nemá parametry."
                           FontSize="{DynamicResource EDTheme.FontSize.Header}"
                           Foreground="{DynamicResource EDTheme.Border.Strong}"
                           VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasForm}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </DockPanel>
</Window>
