<Window x:Class="TemplateDesigner.PrintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TemplateDesigner"
        xmlns:eif="clr-namespace:EDControls.EDInputForm;assembly=EDControls"
        Title="Tisk šablony"
        Width="480" Height="540"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Patička — status + tlačítka -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                       VerticalAlignment="Center" FontSize="{DynamicResource EDTheme.FontSize.Body}"
                       Foreground="{DynamicResource EDTheme.Text.Muted}" TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Tisk s daty" Padding="16,6"
                        Command="{Binding ExportRealDataPdfCommand}"
                        Visibility="{Binding CanExportRealData, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,8,0"/>
                <Button Content="Exportovat PDF" Padding="16,6"
                        Command="{Binding ExportPdfCommand}" Margin="0,0,8,0"/>
                <Button Content="Zavřít" Padding="16,6" IsCancel="True"/>
            </StackPanel>
        </Grid>

        <!-- Obsah — parametry (formulář řízený z Caché přes EDInputForm / AgendaParams) -->
        <Border BorderBrush="{DynamicResource EDTheme.Border.Light}" BorderThickness="1"
                CornerRadius="4" Padding="12" Background="{DynamicResource EDTheme.Bg.Footer}">
            <Grid>
                <!-- Stav: má parametry — formulář se staví v code-behindu (CacheClass + InitParams) -->
                <eif:EDInputForm x:Name="ParamForm"
                                 Visibility="{Binding HasParameters, Converter={StaticResource BoolToVis}}"/>

                <!-- Stav: nemá parametry -->
                <TextBlock Text="Šablona nemá žádné parametry."
                           FontSize="{DynamicResource EDTheme.FontSize.Header}"
                           Foreground="{DynamicResource EDTheme.Border.Strong}"
                           VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasParameters}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </DockPanel>
</Window>
