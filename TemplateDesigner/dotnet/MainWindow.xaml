<Window x:Class="TemplateDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Template Designer" Height="768" Width="1280"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="Background"   Value="#F0F0F0"/>
            <Setter Property="Padding"      Value="8,6"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="#333333"/>
        </Style>
        <Style x:Key="ToolbarSep" TargetType="Separator">
            <Setter Property="Margin" Value="4,2"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ═══ Menu ═══ -->
        <Menu DockPanel.Dock="Top" Background="#F8F8F8">
            <MenuItem Header="Soubor">
                <MenuItem x:Name="MenuNew"    Header="Nová šablona"  InputGestureText="Ctrl+N" Click="MenuNew_Click"/>
                <MenuItem x:Name="MenuOpen"   Header="Otevřít..."    InputGestureText="Ctrl+O" Click="MenuOpen_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuSave"   Header="Uložit"        InputGestureText="Ctrl+S" Click="MenuSave_Click"/>
                <MenuItem x:Name="MenuSaveAs" Header="Uložit jako..."                          Click="MenuSaveAs_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuExportPdf" Header="Exportovat náhled jako PDF..." Click="MenuExportPdf_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuPageProps" Header="Vlastnosti stránky…" InputGestureText="Ctrl+Shift+P" Click="MenuPageProps_Click"/>
                <Separator/>
                <MenuItem Header="Konec" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Upravit">
                <MenuItem x:Name="MenuUndo"   Header="Zpět"   InputGestureText="Ctrl+Z" Click="MenuUndo_Click"/>
                <MenuItem x:Name="MenuRedo"   Header="Vpřed"  InputGestureText="Ctrl+Y" Click="MenuRedo_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuDelete" Header="Smazat" InputGestureText="Del"    Click="MenuDelete_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuZForward"  Header="Přenést dopředu"       InputGestureText="Ctrl+PgUp"       Click="BtnZForward_Click"/>
                <MenuItem x:Name="MenuZBackward" Header="Odeslat dozadu"        InputGestureText="Ctrl+PgDn"       Click="BtnZBackward_Click"/>
                <MenuItem x:Name="MenuZFront"    Header="Přenést zcela dopředu" InputGestureText="Ctrl+Shift+PgUp" Click="BtnZFront_Click"/>
                <MenuItem x:Name="MenuZBack"     Header="Odeslat zcela dozadu"  InputGestureText="Ctrl+Shift+PgDn" Click="BtnZBack_Click"/>
                <Separator/>
                <MenuItem Header="Zarovnat vlevo"               Click="BtnAlignLeft_Click"/>
                <MenuItem Header="Zarovnat vpravo"              Click="BtnAlignRight_Click"/>
                <MenuItem Header="Zarovnat na střed (vodorovně)" Click="BtnAlignCenterH_Click"/>
                <MenuItem Header="Zarovnat nahoru"              Click="BtnAlignTop_Click"/>
                <MenuItem Header="Zarovnat dolů"                Click="BtnAlignBottom_Click"/>
                <MenuItem Header="Zarovnat na střed (svisle)"  Click="BtnAlignMiddleV_Click"/>
                <Separator/>
                <MenuItem Header="Rozložit vodorovně"           Click="BtnDistributeH_Click"/>
                <MenuItem Header="Rozložit svisle"              Click="BtnDistributeV_Click"/>
            </MenuItem>
            <MenuItem Header="Zobrazit">
                <MenuItem x:Name="MenuGrid" Header="Mřížka" IsCheckable="True"
                          Checked="MenuGrid_Changed" Unchecked="MenuGrid_Changed"/>
                <MenuItem x:Name="MenuSnap" Header="Přichytit na mřížku" IsCheckable="True"
                          Checked="MenuSnap_Changed" Unchecked="MenuSnap_Changed"/>
                <Separator/>
                <MenuItem x:Name="MenuSectionsPanel" Header="Panel sekcí" IsCheckable="True" IsChecked="True"
                          Checked="MenuPanelSection_Changed" Unchecked="MenuPanelSection_Changed"/>
                <MenuItem x:Name="MenuPreview" Header="Live náhled" IsCheckable="True"
                          Checked="MenuPreview_Changed" Unchecked="MenuPreview_Changed"/>
            </MenuItem>
        </Menu>

        <!-- ═══ Toolbar ═══ -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True" Background="#F8F8F8">
            <ToolBar Band="0" BandIndex="0">
                <Button x:Name="BtnAddSection" Content="+ Sekce"   ToolTip="Přidat sekci"   Click="BtnAddSection_Click" Padding="6,3"/>
                <Button x:Name="BtnAddElement" Content="+ Element" ToolTip="Přidat element" Click="BtnAddElement_Click" Padding="6,3"/>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <Button x:Name="BtnUndo" Content="↩" ToolTip="Zpět (Ctrl+Z)"  Click="MenuUndo_Click"  Padding="6,3" FontSize="14"/>
                <Button x:Name="BtnRedo" Content="↪" ToolTip="Vpřed (Ctrl+Y)" Click="MenuRedo_Click"  Padding="6,3" FontSize="14"/>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="4,0" Foreground="#555555"/>
                <ComboBox x:Name="CmbZoom" Width="80" SelectedIndex="2"
                          SelectionChanged="CmbZoom_SelectionChanged">
                    <ComboBoxItem Content=" 50 %"/>
                    <ComboBoxItem Content=" 75 %"/>
                    <ComboBoxItem Content="100 %"/>
                    <ComboBoxItem Content="150 %"/>
                    <ComboBoxItem Content="200 %"/>
                </ComboBox>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <ToggleButton x:Name="BtnGrid" Content="Mřížka" Padding="6,3"
                              Checked="BtnGrid_Changed" Unchecked="BtnGrid_Changed"
                              ToolTip="Zobrazit/skrýt mřížku"/>
                <ToggleButton x:Name="BtnSnap" Content="Snap" Padding="6,3"
                              Checked="BtnSnap_Changed" Unchecked="BtnSnap_Changed"
                              ToolTip="Přichytit na mřížku"/>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <Button x:Name="BtnZForward"  Content="↑Z" ToolTip="Přenést dopředu (Ctrl+PgUp)"         Click="BtnZForward_Click"  Padding="6,3"/>
                <Button x:Name="BtnZBackward" Content="↓Z" ToolTip="Odeslat dozadu (Ctrl+PgDn)"           Click="BtnZBackward_Click" Padding="6,3"/>
                <Button x:Name="BtnZFront"    Content="⤒Z" ToolTip="Přenést zcela dopředu (Ctrl+Shift+PgUp)" Click="BtnZFront_Click"    Padding="6,3"/>
                <Button x:Name="BtnZBack"     Content="⤓Z" ToolTip="Odeslat zcela dozadu (Ctrl+Shift+PgDn)"  Click="BtnZBack_Click"     Padding="6,3"/>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <Button x:Name="BtnSave" Content="Uložit" Click="MenuSave_Click" Padding="6,3" FontWeight="SemiBold"/>
                <Button x:Name="BtnOpen" Content="Otevřít" Click="MenuOpen_Click" Padding="6,3"/>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <ToggleButton x:Name="BtnPreview" Content="👁 Náhled" Padding="6,3"
                              Checked="BtnPreview_Changed" Unchecked="BtnPreview_Changed"
                              ToolTip="Zobrazit/skrýt live náhled (vzorová data ze schématu)"/>
            </ToolBar>
            <ToolBar Band="1" BandIndex="0">
                <TextBlock Text="Zarovnat:" VerticalAlignment="Center" Margin="4,0,2,0" Foreground="#555555" FontSize="11"/>
                <Button Content="←" ToolTip="Zarovnat vlevo"               Click="BtnAlignLeft_Click"    Padding="5,3" FontSize="13"/>
                <Button Content="→" ToolTip="Zarovnat vpravo"              Click="BtnAlignRight_Click"   Padding="5,3" FontSize="13"/>
                <Button Content="↔" ToolTip="Zarovnat na střed (vodorovně)" Click="BtnAlignCenterH_Click" Padding="5,3" FontSize="13"/>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <Button Content="↑" ToolTip="Zarovnat nahoru"              Click="BtnAlignTop_Click"     Padding="5,3" FontSize="13"/>
                <Button Content="↓" ToolTip="Zarovnat dolů"                Click="BtnAlignBottom_Click"  Padding="5,3" FontSize="13"/>
                <Button Content="↕" ToolTip="Zarovnat na střed (svisle)"   Click="BtnAlignMiddleV_Click" Padding="5,3" FontSize="13"/>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <Button Content="⇔" ToolTip="Rozložit rovnoměrně vodorovně (min 3 elementy)" Click="BtnDistributeH_Click" Padding="5,3" FontSize="13"/>
                <Button Content="⇕" ToolTip="Rozložit rovnoměrně svisle (min 3 elementy)"   Click="BtnDistributeV_Click" Padding="5,3" FontSize="13"/>
            </ToolBar>
        </ToolBarTray>

        <!-- ═══ Hlavní obsah ═══ -->
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <!-- Panel sekcí -->
                <ColumnDefinition x:Name="SectionsColumn" Width="200" MinWidth="120"/>
                <ColumnDefinition Width="4"/>
                <!-- Canvas -->
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="4"/>
                <!-- Live preview (skrytý) -->
                <ColumnDefinition x:Name="PreviewColumn" Width="0" MinWidth="0"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <!-- Hlavní plocha -->
                <RowDefinition Height="*" MinHeight="100"/>
                <!-- Status bar -->
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- ── Panel sekcí + pole agendy ── -->
            <Border Grid.Column="0" Grid.Row="0"
                    BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
                <TabControl x:Name="LeftTabControl" SelectionChanged="LeftTabControl_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- ── Záložka Sekce ── -->
                    <TabItem Header="▣ Sekce">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom"
                                    BorderBrush="#DDDDDD" BorderThickness="0,1,0,0"
                                    Padding="6" Background="#FAFAFA">
                                <Button x:Name="BtnAddSectionPanel" Content="+ Přidat sekci"
                                        Click="BtnAddSection_Click" HorizontalAlignment="Stretch" Padding="4,4"/>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SectionsList" Margin="6,4"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- ── Záložka Pole agendy ── -->
                    <TabItem Header="⊞ Pole agendy" x:Name="TabFields">
                        <DockPanel>
                            <!-- Záhlaví: název agendy -->
                            <Border DockPanel.Dock="Top"
                                    BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                                    Background="#F0F0F0" Padding="8,5">
                                <TextBlock x:Name="AgendaNameText"
                                           FontSize="11" Foreground="#555555"
                                           Text="Agenda: —"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <!-- Tip dole -->
                            <Border DockPanel.Dock="Bottom"
                                    BorderBrush="#DDDDDD" BorderThickness="0,1,0,0"
                                    Background="#FAFAFA" Padding="6,4">
                                <TextBlock Text="💡 Dvojklik = vložit {POLE}"
                                           FontSize="10" Foreground="#888888"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <!-- Strom polí: skalární pole / kolekce / parametry -->
                            <TreeView x:Name="SchemaTree"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      MouseDoubleClick="SchemaTree_MouseDoubleClick"/>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- ── GridSplitter levý ── -->
            <GridSplitter Grid.Column="1" Grid.Row="0"
                          HorizontalAlignment="Stretch" Background="#DDDDDD" Cursor="SizeWE"/>

            <!-- ── Canvas ── -->
            <ScrollViewer Grid.Column="2" Grid.Row="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="#E0E0E0"
                          x:Name="CanvasScrollViewer">
                <skia:SKElement x:Name="skCanvas" Width="900" Height="1200"/>
            </ScrollViewer>

            <!-- ── GridSplitter pravý ── -->
            <GridSplitter Grid.Column="3" Grid.Row="0"
                          HorizontalAlignment="Stretch" Background="#DDDDDD" Cursor="SizeWE"/>

            <!-- ── Live Preview (výchozí: skrytý, panel se zobrazí togglem) ── -->
            <Border Grid.Column="4" Grid.Row="0"
                    BorderBrush="#DDDDDD" BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- Záhlaví preview panelu -->
                    <Border DockPanel.Dock="Top"
                            Background="#F0F0F0"
                            BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="PDF"
                                    Click="MenuExportPdf_Click" Padding="8,2"
                                    ToolTip="Exportovat náhled jako PDF..."/>
                            <TextBlock Text="Náhled  ·  vzorová data ze schématu"
                                       FontSize="11" Foreground="#666666"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <!-- Parametry sestavy (skrytý pokud agenda nemá parametry) -->
                    <Border x:Name="PreviewParamsBorder" DockPanel.Dock="Top"
                            Visibility="Collapsed"
                            Background="#FAFAFA"
                            BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <WrapPanel x:Name="PreviewParamsPanel" Orientation="Horizontal"/>
                    </Border>

                    <!-- Scrollovatelný canvas náhledu — pevná šířka (75 % zoom), panel lze tahat -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="#E8E8E8">
                        <skia:SKElement x:Name="skPreview" HorizontalAlignment="Left" Height="800"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ── Status bar ── -->
            <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="5"
                    Background="#F0F0F0" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center" Margin="10,0"
                           FontSize="11" Foreground="#555555"/>
            </Border>

        </Grid>
    </DockPanel>
</Window>
