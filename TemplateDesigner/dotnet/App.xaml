<Application x:Class="TemplateDesigner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TemplateDesigner">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/EDControls;component/EDTheme/EDTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/EDControls;component/EDIcons/EDIcons.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/EDControls;component/EDStrings/EDStrings.xaml"/>
                <ResourceDictionary Source="Styles/ToolbarStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Default Window icon — aplikuje se na všechna okna (MainWindow + dialogy) bez explicit Icon -->
            <Style TargetType="Window">
                <Setter Property="Icon" Value="{StaticResource EDIcons.Molecule}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
