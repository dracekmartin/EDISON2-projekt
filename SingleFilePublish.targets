<Project>

  <!-- Sdílená publish logika aplikačních projektů (profil SingleFileCEdison).
       Importuje EDISONMAIN2.csproj a TemplateDesigner.csproj. -->

  <!-- EDControls je sdílená knihovna obou aplikací — vedle exe jako volná DLL, ať jde
       nasadit samostatně (nové pole v EDInputFormu → do produkce stačí DLL + exe, který
       ho používá; druhý exe se nepřebuildí a novou DLL jen převezme).
       Cena: veřejné API a klíče theme resource se musí měnit ADITIVNĚ — starý exe načte
       novou DLL a odebraný/přejmenovaný člen by shodil až za běhu, build to nezachytí. -->
  <ItemGroup>
    <LooseFromSingleFile Include="EDControls" />
  </ItemGroup>

  <!-- Hook musí být po ComputeResolvedFilesToPublishList (ne ComputeFilesToPublish — ten
       má bundling už v dependencies, takže by změny přišly pozdě). Sidecar .pdb/.xml
       do publish výstupu nepatří vůbec. -->
  <Target Name="MarkLooseSingleFileAssemblies" AfterTargets="ComputeResolvedFilesToPublishList">
    <PropertyGroup>
      <_LooseFromSingleFileList>;@(LooseFromSingleFile);</_LooseFromSingleFileList>
    </PropertyGroup>
    <ItemGroup>
      <ResolvedFileToPublish Condition="'%(Extension)' == '.dll' And $(_LooseFromSingleFileList.Contains(';%(Filename);'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.pdb' Or '%(Extension)' == '.xml'" />
    </ItemGroup>
  </Target>

</Project>
