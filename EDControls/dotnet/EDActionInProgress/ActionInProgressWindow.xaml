    <!-- Margin = prostor pro rozptyl stínu (BlurRadius 18) - SizeToContent by ho jinak ořízl. -->
    <Grid Margin="24">
        <!-- Stín na samostatné vrstvě - Effect na kartě s animací by se přerendroval každý frame -->
        <Border Background="{DynamicResource EDTheme.Bg.Surface}" CornerRadius="4">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.35"/>
            </Border.Effect>
        </Border>
        <Border Background="{DynamicResource EDTheme.Bg.Surface}"
                BorderBrush="{DynamicResource EDTheme.Border.Contrast}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="0,18">
            <StackPanel>

                <!-- Průhledové okno - sprite jím projíždí (clip). Konkrétní sprite vkládá code-behind
                     do SpriteHost; transform (flip + posun) je na hostovi, ne na spritu → animace
                     je společná všem spritům. -->
                <Border x:Name="SpriteViewport" Width="160" Height="48" ClipToBounds="True">
                    <ContentControl x:Name="SpriteHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <ContentControl.RenderTransform>
                            <TransformGroup>
                                <!-- Otáčí kolem horizontálního středu spritu (60 šír. → 30) při obratu -->
                                <ScaleTransform x:Name="FlipTransform" ScaleX="1" CenterX="30"/>
                                <!-- X=-60 (mimo záběr vlevo) = klidová hodnota: první frame před náběhem
                                     storyboardu (a stav po Stop) sprite neukáže uprostřed karty. -->
                                <TranslateTransform x:Name="SlideTranslate" X="-60"/>
                            </TransformGroup>
                        </ContentControl.RenderTransform>
                    </ContentControl>
                </Border>

                <TextBlock Text="Akce probíhá" FontSize="{DynamicResource EDTheme.FontSize.Large}" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="24,8,24,0"/>
            </StackPanel>
        </Border>
    </Grid>

</Window>
