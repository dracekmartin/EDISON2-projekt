<Window x:Class="EDControls.EDActionInProgress.ActionInProgressWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Storyboard řízen z code-behind podle Show/Hide - Loaded trigger s RepeatBehavior=Forever
             by tikal i pro skryté okno (animační clock běží bez ohledu na viditelnost).
             Cílí transform HOSTA (SpriteHost), ne konkrétní sprite → je společný všem. -->
        <Storyboard x:Key="WalkAnimation">

            <DoubleAnimation Storyboard.TargetName="SlideTranslate"
                             Storyboard.TargetProperty="X"
                             From="-60" To="160"
                             Duration="0:0:2.5"
                             AutoReverse="True"
                             RepeatBehavior="Forever"/>

            <!-- Perioda 5 s musí odpovídat AutoReverse cyklu posunu, jinak se obrat rozejde. -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FlipTransform"
                                           Storyboard.TargetProperty="ScaleX"
                                           Duration="0:0:5"
                                           RepeatBehavior="Forever">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0"   Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.5" Value="-1"/>
            </DoubleAnimationUsingKeyFrames>

        </Storyboard>

        <!-- ==== Sprity ====
             Každý = pixel-art Canvas 60×48, čelem doprava (flip ho na zpáteční cestě otočí).
             Nová věc = přidej sem další <Canvas x:Key="Sprite.Xxx" .../>; code-behind si klíče
             s prefixem "Sprite." najde sám a náhodně jeden vybere - nic dalšího registrovat netřeba.
             Rozměr 60×48 je povinný (flip CenterX=30 = půlka, slide From=-60 = plná šířka mimo záběr).
             Klíč s další tečkou ("Sprite.Money.Note") = kus VYHRAZENÉ SADY: v náhodném poolu není,
             sada se vybírá jen explicitně (EDViewModel.ActionInProgress("Money")) a její kusy
             padají shora na náhodných pozicích (fall režim, řídí code-behind). Kusy mají vlastní
             rozměry (menší než 60×48, ať se jich do průhledu vejde víc). -->

