<UserControl x:Class="EDControls.EDComponentToolbar.EDComponentToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EDControls.EDComponentToolbar"
             xmlns:edstx="clr-namespace:EDControls.EDSearchTextBox"
             mc:Ignorable="d"
             d:DesignHeight="32" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:IntZeroToCollapsedConverter x:Key="IntNonZeroToVis"/>
        <local:NonEmptyStringToVisibleConverter x:Key="NonEmptyToVis"/>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource EDTheme.OnAccent.Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.OnAccent.HoverOverlay}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.OnAccent.PressedOverlay}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Texty toolbaru (Title, počitadlo matchů) - bílé na brandovém pruhu. -->
        <Style x:Key="ToolbarTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource EDTheme.OnAccent.Text}"/>
        </Style>
    </UserControl.Resources>

    <!-- Brandový pruh - jediný vzhled komponentové hlavičky (EDList i EDInputForm). -->
    <Border Background="{DynamicResource EDTheme.Accent.Header}" Padding="6,4">
        <!-- Grid, ne DockPanel: search má být pružný. V dlaždici miniaplikace (min 200 px)
             by se pevný box nevešel a DockPanel by ho ořízl místo zmenšení. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*" MinWidth="90" MaxWidth="228"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title - left edge, prominent. Anchor co je v komponentě. -->
            <TextBlock Grid.Column="0"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Style="{StaticResource ToolbarTextStyle}"
                       FontWeight="SemiBold" FontSize="{DynamicResource EDTheme.FontSize.Title}"
                       VerticalAlignment="Center" Margin="2,0,12,0"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NonEmptyToVis}}"/>

            <!-- Search + match nav (▲ ▼ counter) - vpravo, vedle standardních ikon. -->
            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                  Visibility="{Binding ShowSearch, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Placeholder, křížek i Esc řeší EDSearchTextBox interně. -->
                <edstx:EDSearchTextBox Grid.Column="0" x:Name="SearchTextBox" VerticalAlignment="Center"
                                       Placeholder="{Binding SearchPlaceholder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Visibility="{Binding TotalMatches, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntNonZeroToVis}}">
                    <Button Content="▲" FontSize="{DynamicResource EDTheme.FontSize.Small}"
                            Margin="6,0,0,0" Padding="6,2"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Předchozí výsledek (Shift+Enter)"
                            Command="{Binding FindPreviousCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="▼" FontSize="{DynamicResource EDTheme.FontSize.Small}"
                            Margin="2,0,0,0" Padding="6,2"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Další výsledek (Enter)"
                            Command="{Binding FindNextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <TextBlock Style="{StaticResource ToolbarTextStyle}" VerticalAlignment="Center"
                               Margin="6,0,0,0" FontSize="{DynamicResource EDTheme.FontSize.Caption}">
                        <Run Text="{Binding CurrentMatchIndex, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding TotalMatches, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- Standardní akční ikony (opt-in přes ShowX props) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="📊" FontSize="{DynamicResource EDTheme.FontSize.Header}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Export"
                        Command="{Binding ExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Visibility="{Binding ShowExport, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                <Button Content="🖨" FontSize="{DynamicResource EDTheme.FontSize.Header}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Tisk"
                        Command="{Binding PrintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Visibility="{Binding ShowPrint, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Nápověda"
                        Command="{Binding HelpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Visibility="{Binding ShowHelp, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <Image Source="{StaticResource EDIcons.Help}"
                           Width="{DynamicResource EDTheme.IconSize.Default}"
                           Height="{DynamicResource EDTheme.IconSize.Default}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
                <Button Content="⚙" FontSize="{DynamicResource EDTheme.FontSize.Title}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Nastavení"
                        Command="{Binding SettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Visibility="{Binding ShowSettings, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
