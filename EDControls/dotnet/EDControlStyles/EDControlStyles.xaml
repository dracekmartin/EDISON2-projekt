<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:edfc="clr-namespace:EDControls.EDFilterComboBox"
                    xmlns:edstx="clr-namespace:EDControls.EDSearchTextBox"
                    xmlns:edib="clr-namespace:EDControls.EDInfoBar"
                    xmlns:edtb="clr-namespace:EDControls.EDToolbar">

    <!--
        EDControlStyles — implicitní styly pro WPF kontrolky.

        Sjednocuje vzhled tlačítek, textboxů, comboboxů atd. napříč EDControls knihovnou
        a hostitelskou aplikací. Používá design tokens z EDTheme.xaml.

        Charakter: moderní desktop look (flat, jemně zaoblené rohy 3px, žádné gradienty,
        subtilní hover/pressed). Referenční inspirace: Fluent UI / Office 365 / VS Code.

        Font: každý style bere FontFamily i FontSize z EDTheme tokenů (DynamicResource).
        Aplikace overridne tokeny v Application.Resources runtime (např. FontService
        v EDISONMAIN2 podle uživatelské preference) a všechny ovládací prvky se okamžitě
        překreslí — FontFamily i FontSize.

        Když potřebuješ rozšířit o nový control typ (DataGrid, GroupBox, RadioButton, ...),
        přidej implicit Style sem; jiná místa nikoli (aby propagace fontu fungovala globálně).

        Konzumace v aplikacích (opt-in):
          <Application.Resources>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="pack://application:,,,/EDControls;component/EDTheme/EDTheme.xaml"/>
              <ResourceDictionary Source="pack://application:,,,/EDControls;component/EDControlStyles/EDControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
          </Application.Resources>

        Buttons s explicit Style="..." nejsou ovlivněny (mají vlastní vizuál — ToolbarButton,
        PaletteButton apod.). Inline atributy (Background, BorderThickness) také vítězí.
    -->

    <!-- Sdílený jemný stín pod plovoucími plochami (menu, dropdown, contextmenu) — hloubka.
         Směr dolů-doprava → pravý/spodní margin borderu dá stínu prostor bez posunu zarovnání. -->
    <DropShadowEffect x:Key="EDTheme.Shadow.Popup" Color="#000000" Direction="315" ShadowDepth="2" BlurRadius="8" Opacity="0.22"/>

    <!-- ═══════════════════════════════════════════════════════════════════
         MenuItem — flat menu s 4 role templates + Separator
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Submenu Popup container — sdílený border pro submenu popups -->
    <ControlTemplate x:Key="EDTheme.MenuItem.SubmenuPopup" TargetType="ContentControl">
        <Border Background="{DynamicResource EDTheme.Bg.Surface}"
                BorderBrush="{DynamicResource EDTheme.Border.Medium}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="2"
                SnapsToDevicePixels="True">
            <ContentPresenter/>
        </Border>
    </ControlTemplate>

    <!-- Separator uvnitř menu -->
    <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="6,4"/>
        <Setter Property="Background" Value="{DynamicResource EDTheme.Border.Light}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Templates pro 4 role MenuItem -->

    <!-- TopLevelHeader: položka v hlavním menu strip s submenu (Soubor, Upravit...) -->
    <ControlTemplate x:Key="EDTheme.MenuItem.TopLevelHeader" TargetType="MenuItem">
        <Grid>
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="3"
                    SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal">
                    <ContentPresenter x:Name="Icon" ContentSource="Icon"
                                      Margin="0,0,6,0" VerticalAlignment="Center"
                                      RenderOptions.BitmapScalingMode="HighQuality"/>
                    <ContentPresenter ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Popup x:Name="PART_Popup"
                   Placement="Bottom"
                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="None">
                <Border Background="{DynamicResource EDTheme.Bg.Surface}"
                        BorderBrush="{DynamicResource EDTheme.Border.Medium}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="2"
                        SnapsToDevicePixels="True"
                        Effect="{StaticResource EDTheme.Shadow.Popup}"
                        Margin="0,2,10,10">
                    <ScrollViewer CanContentScroll="True"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                        Grid.IsSharedSizeScope="True"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Bg.Hover}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Bg.Pressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- TopLevelItem: položka v hlavním menu bez submenu (vzácné) -->
    <ControlTemplate x:Key="EDTheme.MenuItem.TopLevelItem" TargetType="MenuItem">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}"
                CornerRadius="3"
                SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header"
                              RecognizesAccessKey="True"
                              VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Bg.Hover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuItem: leaf položka v dropdown (Nová šablona, Otevřít...) -->
    <ControlTemplate x:Key="EDTheme.MenuItem.SubmenuItem" TargetType="MenuItem">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                Padding="0"
                CornerRadius="2"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" SharedSizeGroup="MenuIcon"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuShortcut"/>
                    <ColumnDefinition Width="14"/>
                </Grid.ColumnDefinitions>

                <!-- Icon area: IsCheckable checkmark nebo IconSource -->
                <Border x:Name="IconArea" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ContentPresenter ContentSource="Icon" Width="{DynamicResource EDTheme.IconSize.Default}" Height="{DynamicResource EDTheme.IconSize.Default}" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Path x:Name="CheckMark"
                      Grid.Column="0"
                      Visibility="Collapsed"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      Stroke="{DynamicResource EDTheme.Accent.Blue}"
                      StrokeThickness="1.5"
                      Data="M 2 6 L 5 9 L 11 3"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"/>

                <!-- Header text -->
                <ContentPresenter Grid.Column="1"
                                  Margin="4,4,8,4"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center"/>

                <!-- Keyboard shortcut display (InputGestureText) -->
                <TextBlock Grid.Column="2"
                           Margin="8,4,8,4"
                           Text="{TemplateBinding InputGestureText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource EDTheme.Text.Muted}"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconArea" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                <Setter TargetName="IconArea" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Bg.Hover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuHeader: položka v dropdown s vnořeným submenu -->
    <ControlTemplate x:Key="EDTheme.MenuItem.SubmenuHeader" TargetType="MenuItem">
        <Grid>
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    Padding="0"
                    CornerRadius="2"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" SharedSizeGroup="MenuIcon"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuShortcut"/>
                        <ColumnDefinition Width="14"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconArea" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ContentPresenter ContentSource="Icon" Width="{DynamicResource EDTheme.IconSize.Default}" Height="{DynamicResource EDTheme.IconSize.Default}" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <ContentPresenter Grid.Column="1"
                                      Margin="4,4,8,4"
                                      ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"/>

                    <!-- Šipka indikující vnořené submenu -->
                    <Path Grid.Column="3"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Data="M 0 0 L 4 4 L 0 8 Z"
                          Fill="{DynamicResource EDTheme.Text.Secondary}"/>
                </Grid>
            </Border>
            <Popup x:Name="PART_Popup"
                   Placement="Right"
                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="None">
                <Border Background="{DynamicResource EDTheme.Bg.Surface}"
                        BorderBrush="{DynamicResource EDTheme.Border.Medium}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="2"
                        SnapsToDevicePixels="True"
                        Effect="{StaticResource EDTheme.Shadow.Popup}"
                        Margin="2,0,10,10">
                    <ScrollViewer CanContentScroll="True"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                        Grid.IsSharedSizeScope="True"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconArea" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Bg.Hover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- MenuItem hlavní style — vybírá template podle Role -->
    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"   Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="Padding"    Value="8,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource EDTheme.MenuItem.TopLevelHeader}"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource EDTheme.MenuItem.TopLevelItem}"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource EDTheme.MenuItem.SubmenuItem}"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource EDTheme.MenuItem.SubmenuHeader}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Menu (horní strip) — odstranit gradient + sjednotit pozadí -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource EDTheme.Bg.Footer}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource EDTheme.Border.Light}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- TextBlock — sjednocuje typografii i mimo styled container (DP inheritance pokrývá jen TextBlocky uvnitř Menu/StatusBar/atd.). -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource EDTheme.FontSize.Body}"/>
    </Style>

    <!-- ContextMenu — popup pro right-click menus -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource EDTheme.Bg.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource EDTheme.Border.Medium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True"
                            Effect="{StaticResource EDTheme.Shadow.Popup}"
                            Margin="0,0,10,10">
                        <ScrollViewer CanContentScroll="True"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                            Grid.IsSharedSizeScope="True"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         CheckBox — flat box + accent checkmark
         ═══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground"      Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="Background"      Value="{DynamicResource EDTheme.Bg.Surface}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource EDTheme.Border.Medium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Bd"
                                Width="14" Height="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True"
                                VerticalAlignment="Center">
                            <Path x:Name="CheckMark"
                                  Visibility="Collapsed"
                                  Stroke="{DynamicResource EDTheme.OnAccent.Text}"
                                  StrokeThickness="1.5"
                                  Data="M 2 6 L 5 9 L 11 3"
                                  SnapsToDevicePixels="True"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Border>
                        <ContentPresenter Margin="6,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource EDTheme.Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource EDTheme.Accent.Blue}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource EDTheme.Accent.Blue}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource EDTheme.Accent.Blue}"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         TabItem — moderní underline tabs (Chrome/VS Code styl)
         ═══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="TabItem">
        <Setter Property="Padding"    Value="12,6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Secondary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"   Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- Cursor jen na header Border — na TabItem by se dědil do Content. -->
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}"
                            Cursor="Hand"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Content"
                                          ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="Normal"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Bg.Hover}"/>
                            <Setter TargetName="Content" Property="TextElement.Foreground"
                                    Value="{DynamicResource EDTheme.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource EDTheme.Accent.Blue}"/>
                            <Setter TargetName="Content" Property="TextElement.Foreground"
                                    Value="{DynamicResource EDTheme.Text.Primary}"/>
                            <Setter TargetName="Content" Property="TextElement.FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TabControl — odstranění defaultního borderu/pozadí, čistá tab strip area -->
    <Style TargetType="TabControl">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource EDTheme.Border.Light}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Tab strip -->
                        <Border Grid.Row="0"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <!-- WrapPanel místo TabPanelu — ten při zalomení tabů do více řádků
                                 přesouvá řádek s vybraným tabem dolů k obsahu (taby „skáčou"). -->
                            <WrapPanel IsItemsHost="True"
                                       Margin="0"
                                       Background="Transparent"
                                       KeyboardNavigation.TabIndex="1"/>
                        </Border>
                        <!-- Content -->
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         ComboBox — flat dropdown s focus accent
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Interní ToggleButton ComboBoxu — pokrývá celou šířku, šipka vpravo.
         Kliknutí kdekoliv na ComboBox toggluje dropdown (standard WPF chování). -->
    <Style x:Key="EDTheme.ComboBox.ToggleStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="1"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                  Fill="{DynamicResource EDTheme.Text.Secondary}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Položka v dropdown -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding"    Value="8,4"/>
        <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"   Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Accent.BlueSelected}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Padding"         Value="6,4"/>
        <Setter Property="Background"      Value="{DynamicResource EDTheme.Bg.Surface}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource EDTheme.Border.Medium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground"      Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- ToggleButton pokrývá celou plochu — klik kdekoliv otevře dropdown.
                                     Šipka uvnitř jeho template je vpravo (20px sloupec). -->
                                <ToggleButton x:Name="PART_ToggleButton"
                                              Style="{StaticResource EDTheme.ComboBox.ToggleStyle}"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>

                                <!-- Selected item display — překryv ToggleButton, IsHitTestVisible=False
                                     aby kliknutí prošlo na ToggleButton pod ním. Margin vpravo 20px = místo pro šipku. -->
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="6,4,26,4"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"
                                                  TextElement.Foreground="{TemplateBinding Foreground}">
                                    <!-- Stretch + ellipsis: při zvětšeném fontu se dlouhý text neořízne natvrdo,
                                         ale zkrátí na "…". Platí pro string položky (auto-generovaný TextBlock);
                                         combo s vlastním ItemTemplate si trimming řeší samo. ToolTip-on-trim
                                         nelze deklarativně (WPF nemá IsTextTrimmed + ContentSite je hit-test
                                         invisible) — řešitelné jen attached behaviorem, zatím vynecháno. -->
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>

                                <!-- Editable TextBox — pro IsEditable=True ComboBox -->
                                <TextBox x:Name="PART_EditableTextBox"
                                         Visibility="Collapsed"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Margin="6,4,26,4"
                                         Padding="0"
                                         Foreground="{TemplateBinding Foreground}"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"
                                         VerticalContentAlignment="Center"
                                         Focusable="True"/>
                            </Grid>
                        </Border>

                        <!-- Dropdown popup -->
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource EDTheme.Bg.Surface}"
                                    BorderBrush="{DynamicResource EDTheme.Border.Medium}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Effect="{StaticResource EDTheme.Shadow.Popup}"
                                    Margin="0,2,10,10"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EDTheme.Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EDTheme.Accent.Blue}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- EDFilterComboBox je podtřída ComboBox → implicitní styl ComboBoxu se na ni neaplikuje.
         BasedOn ji napojí na stejný vzhled i font tokeny (template má PART_EditableTextBox). -->
    <Style TargetType="{x:Type edfc:EDFilterComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}"/>

    <!-- ═══════════════════════════════════════════════════════════════════
         TextBox — flat input s focus accent
         ═══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="TextBox">
        <Setter Property="Padding"         Value="6,4"/>
        <Setter Property="Background"      Value="{DynamicResource EDTheme.Bg.Surface}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource EDTheme.Border.Medium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground"      Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EDTheme.Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EDTheme.Accent.Blue}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Bg.Panel}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         EDSearchTextBox — TextBox s placeholderem uvnitř pole, křížkem a Esc.
         Template se nahrazuje celý → triggery z TextBoxu se replikují.
         ═══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type edstx:EDSearchTextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type edstx:EDSearchTextBox}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Focusable="False"/>
                                <!-- Placeholder překrývá PART_ContentHost; skrytý při neprázdném textu (trigger níže). -->
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Placeholder}"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource EDTheme.Text.Secondary}"
                                           Visibility="Collapsed"/>
                            </Grid>
                            <!-- Clear (✕) — viditelný jen při neprázdném textu (trigger níže). -->
                            <Button x:Name="PART_ClearButton" Grid.Column="1"
                                    Focusable="False" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="4,0" Margin="0,0,2,0"
                                    VerticalAlignment="Stretch"
                                    ToolTip="Vyčistit (Esc)">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <TextBlock x:Name="Glyph" Text="✕"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                                       Foreground="{DynamicResource EDTheme.Text.Secondary}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource EDTheme.Text.Primary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EDTheme.Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EDTheme.Accent.Blue}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Bg.Panel}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder"      Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         EDInfoBar — nenápadný info proužek: ikona + text + akční odkaz.
         Prázdný ActionText / null Icon příslušnou část schová (triggery).
         ═══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type edib:EDInfoBar}">
        <Setter Property="Background"      Value="{DynamicResource EDTheme.Bg.InfoBanner}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource EDTheme.Border.Light}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Foreground"      Value="{DynamicResource EDTheme.Text.Secondary}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource EDTheme.FontSize.Caption}"/>
        <Setter Property="Padding"         Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type edib:EDInfoBar}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <DockPanel LastChildFill="True">
                            <Image x:Name="IconImage" DockPanel.Dock="Left"
                                   Source="{TemplateBinding Icon}"
                                   Width="16" Height="16" Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <!-- Akční odkaz (link-style tlačítko) vpravo; schová se bez ActionText. -->
                            <Button x:Name="ActionButton" DockPanel.Dock="Right"
                                    Margin="8,0,0,0" Focusable="False" Cursor="Hand"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding ActionText}"
                                    Command="{TemplateBinding ActionCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock x:Name="ActionGlyph" Text="{TemplateBinding Content}"
                                                   Foreground="{DynamicResource EDTheme.Accent.Blue}"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ActionGlyph" Property="TextDecorations" Value="Underline"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock x:Name="MessageText" Text="{TemplateBinding Text}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ActionText" Value="">
                            <Setter TargetName="ActionButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PasswordBox — minimální styl. WPF default šablona stačí, jen sjednotit typografii. -->
    <Style TargetType="PasswordBox">
        <Setter Property="Padding"         Value="6,4"/>
        <Setter Property="Background"      Value="{DynamicResource EDTheme.Bg.Surface}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource EDTheme.Border.Medium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground"      Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         Button — flat moderní desktop look
         ═══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="Button">
        <Setter Property="Padding"         Value="12,4"/>
        <Setter Property="Background"      Value="{DynamicResource EDTheme.Bg.Surface}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource EDTheme.Border.Medium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground"      Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource EDTheme.Bg.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EDTheme.Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Bg.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         StatusBar / StatusBarItem — bind fontu na user-theme tokeny
         ═══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="StatusBar">
        <Setter Property="Background"      Value="{DynamicResource EDTheme.Bg.Panel}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource EDTheme.Border.Light}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Foreground"      Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource EDTheme.FontSize.Body}"/>
    </Style>

    <Style TargetType="StatusBarItem">
        <Setter Property="Foreground"      Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource EDTheme.FontSize.Body}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         ScrollBar — tenký moderní (rounded thumb, bez koncových šipek).
         Thumb ztmavne při hoveru/tažení. Track je průhledný (RepeatButtons
         jen pro page-scroll klik, bez vizuálu).
         ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="EDTheme.ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="3" Margin="2"
                            Background="{DynamicResource EDTheme.Border.Strong}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Text.Muted}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Text.Secondary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EDTheme.ScrollBar.PageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="EDTheme.ScrollBar.Vertical" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource EDTheme.ScrollBar.PageButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource EDTheme.ScrollBar.Thumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource EDTheme.ScrollBar.PageButton}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="EDTheme.ScrollBar.Horizontal" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource EDTheme.ScrollBar.PageButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource EDTheme.ScrollBar.Thumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource EDTheme.ScrollBar.PageButton}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template" Value="{StaticResource EDTheme.ScrollBar.Vertical}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template" Value="{StaticResource EDTheme.ScrollBar.Horizontal}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         ToolTip — flat bílá karta místo default bledě žlutého rámečku
         ═══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="ToolTip">
        <Setter Property="Background"      Value="{DynamicResource EDTheme.Bg.Surface}"/>
        <Setter Property="Foreground"      Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource EDTheme.Border.Medium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily"      Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="Padding"         Value="8,5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         TreeView / TreeViewItem — chevron expander, bez tečkovaných spojnic,
         hover + selekce v accent barvě. Odsazení dětí dělá Auto sloupec expanderu.
         ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="EDTheme.TreeView.ExpandCollapseToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Width="16" Height="16">
                        <Path x:Name="Arrow"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 0 0 L 4 4 L 0 8 Z"
                              Fill="{DynamicResource EDTheme.Text.Muted}"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource EDTheme.Text.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="Padding"         Value="4,3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ToggleButton x:Name="Expander"
                                      Grid.Row="0" Grid.Column="0"
                                      Style="{StaticResource EDTheme.TreeView.ExpandCollapseToggle}"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>

                        <Border x:Name="Bd"
                                Grid.Row="0" Grid.Column="1"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <!-- Stretch → header DataTemplate pokryje celý řádek; klik/ContextMenu
                                 tak funguje i napravo od textu, ne jen na něm. -->
                            <ContentPresenter x:Name="PART_Header"
                                              ContentSource="Header"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" SourceName="Bd" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Accent.BlueSelected}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground"      Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         ListBox / ListBoxItem — flat, hover + selekce v accent barvě
         ═══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="ListBox">
        <Setter Property="Background"      Value="{DynamicResource EDTheme.Bg.Surface}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource EDTheme.Border.Light}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground"      Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding"         Value="8,4"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Accent.BlueSelected}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         DataGrid — flat, tenké horizontální linky, bez row-header gutteru,
         moderní hlavička. Selekce se řeší na buňce (funguje i pro FullRow).
         Konzervativní: NEretemplatuje celý DataGrid (default drží scrollviewer/
         řazení/resize), jen setters + hlavička + buňka.
         ═══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="DataGrid">
        <Setter Property="Background"             Value="{DynamicResource EDTheme.Bg.Surface}"/>
        <Setter Property="BorderBrush"            Value="{DynamicResource EDTheme.Border.Light}"/>
        <Setter Property="BorderThickness"        Value="1"/>
        <Setter Property="Foreground"             Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily"             Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"               Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="RowBackground"          Value="{DynamicResource EDTheme.Bg.Surface}"/>
        <Setter Property="GridLinesVisibility"    Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource EDTheme.Border.Light}"/>
        <Setter Property="HeadersVisibility"      Value="Column"/>
        <Setter Property="RowHeaderWidth"         Value="0"/>
        <Setter Property="ColumnHeaderHeight"     Value="30"/>
        <Setter Property="CanUserResizeRows"      Value="False"/>
        <Setter Property="SnapsToDevicePixels"    Value="True"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"      Value="{DynamicResource EDTheme.Bg.Panel}"/>
        <Setter Property="Foreground"      Value="{DynamicResource EDTheme.Text.Header}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Padding"         Value="8,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource EDTheme.Border.Light}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="8,4"/>
        <Setter Property="Foreground"      Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Accent.BlueSelected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         ToolBar — default WPF chrome je šedý gradient + overflow, netémovaný.
         Flat themovaný template. Tlačítka uvnitř nejsou přímé ToolBar items
         (EDToolbar je hostí přes vnitřní ItemsControl) → berou implicit Button styl,
         ToolBar.ButtonStyleKey se neuplatní. Overflow vynechán (ikonové toolbary krátké).
         ═══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="ToolBar">
        <Setter Property="Background"  Value="{DynamicResource EDTheme.Bg.Panel}"/>
        <Setter Property="Foreground"  Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource EDTheme.Border.Light}"/>
        <Setter Property="FontFamily"  Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"    Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="4,2">
                        <ToolBarPanel x:Name="PART_ToolBarPanel"
                                      IsItemsHost="True"
                                      Orientation="Horizontal"
                                      VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicitní styly se dědí dle PŘESNÉHO typu → EDToolbar (: ToolBar) by jinak
         spadl zpět na default ToolBar theme template. Napojení na styl výše. -->
    <Style TargetType="{x:Type edtb:EDToolbar}" BasedOn="{StaticResource {x:Type ToolBar}}"/>

    <!-- ═══════════════════════════════════════════════════════════════════
         DatePicker / Calendar — defaultní WPF templaty mají zadrátované bílé pozadí
         (VisualState storyboardy) a stock kalendářový glyph, takže pouhé Background/
         Foreground settery je nepřebijou. Proto plné ControlTemplaty s tokeny.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Tlačítko rozbalení kalendáře — vektorová ikona kreslená token brushem (reaguje
         na dark mode); nahrazuje ošklivý stock glyph z defaultního DatePicker templatu. -->
    <Style x:Key="DatePickerCalendarButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Width"           Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="2" Margin="1">
                        <Viewbox Width="16" Height="16" Margin="4">
                            <Path Stroke="{DynamicResource EDTheme.Text.Secondary}"
                                  StrokeThickness="1.3"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M5,3 L5,1.5 M11,3 L11,1.5 M3,3 H13 A1,1 0 0 1 14,4 V13 A1,1 0 0 1 13,14 H3 A1,1 0 0 1 2,13 V4 A1,1 0 0 1 3,3 Z M2,6 H14"/>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource EDTheme.Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource EDTheme.Bg.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Textové pole DatePickeru: průhledné pozadí (dark pozadí prosvítá z PART_Root),
         žádné bílé focus/watermark storyboardy z defaultu. PART_ContentHost je povinný. -->
    <Style TargetType="prim:DatePickerTextBox">
        <Setter Property="Foreground"      Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="CaretBrush"      Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="6,3"/>
        <Setter Property="FontFamily"      Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="prim:DatePickerTextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <!-- Bez PART_Watermark: default watermark ("<Enter text here>") by se bez
                             Watermarked/Unwatermarked visual states nikdy neschoval a překrýval hodnotu. -->
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Background"               Value="{DynamicResource EDTheme.Bg.Surface}"/>
        <Setter Property="Foreground"               Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="BorderBrush"              Value="{DynamicResource EDTheme.Border.Medium}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="FontFamily"               Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"                 Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- DatePicker binduje Style svého interního Calendaru na CalendarStyle → nastavit
             tady, jinak implicitní Calendar styl (dark mode) na popup kalendář nedosáhne. -->
        <Setter Property="CalendarStyle"            Value="{DynamicResource EDCalendarStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               Focusable="{TemplateBinding Focusable}"
                                               Foreground="{TemplateBinding Foreground}"
                                               VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <Button x:Name="PART_Button" Grid.Column="1" Focusable="False"
                                    Style="{StaticResource DatePickerCalendarButtonStyle}"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                   Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Root}"
                                   PopupAnimation="Slide" StaysOpen="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Root"    Property="Background"  Value="{DynamicResource EDTheme.Bg.Panel}"/>
                            <Setter TargetName="PART_Root"    Property="BorderBrush" Value="{DynamicResource EDTheme.Border.Light}"/>
                            <Setter TargetName="PART_TextBox" Property="Foreground"  Value="{DynamicResource EDTheme.Text.Muted}"/>
                            <Setter TargetName="PART_Button"  Property="Visibility"  Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kalendář: default Calendar template dává CalendarItem/Day/Button styl přes
         Style="{TemplateBinding Calendar…Style}"; když je property null, Style se nastaví
         explicitně na null → implicitní styl se NEuplatní. Proto musí být tyto styly
         keyed a přiřazené přes settery na Calendar (ne implicitně dle typu). -->

    <!-- Šipky prev/next v hlavičce kalendáře — vektorové glyphy token brushem. -->
    <Style x:Key="CalendarPrevNextButtonStyle" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width"     Value="26"/>
        <Setter Property="Height"    Value="24"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource EDTheme.Bg.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hlavička (měsíc/rok) — text button přepínající zobrazení. -->
    <Style x:Key="CalendarHeaderButtonStyle" TargetType="Button">
        <Setter Property="Focusable"  Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="3" Padding="8,2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource EDTheme.Bg.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CalendarItem = vnitřek kalendáře; default template má bílé pozadí napevno →
         plný token-driven template. PART_MonthView (7×7) / PART_YearView (4×3) musí mít
         přesně tolik Row/Column definic, kolik Calendar kód plní. -->
    <Style x:Key="EDCalendarItemStyle" TargetType="prim:CalendarItem">
        <Setter Property="Background" Value="{DynamicResource EDTheme.Bg.Surface}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="prim:CalendarItem">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static prim:CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Text="{Binding}"
                                       Foreground="{DynamicResource EDTheme.Text.Muted}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,2,0,4"/>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource EDTheme.Border.Strong}"
                            BorderThickness="1" CornerRadius="4" Padding="6"
                            Margin="4" Effect="{DynamicResource EDTheme.Shadow.Popup}">
                        <Grid x:Name="PART_Root">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PART_PreviousButton" Grid.Column="0"
                                        Style="{StaticResource CalendarPrevNextButtonStyle}">
                                    <Path Stroke="{DynamicResource EDTheme.Text.Secondary}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M6,1 L2,5 L6,9"/>
                                </Button>
                                <Button x:Name="PART_HeaderButton" Grid.Column="1"
                                        Style="{StaticResource CalendarHeaderButtonStyle}"/>
                                <Button x:Name="PART_NextButton" Grid.Column="2"
                                        Style="{StaticResource CalendarPrevNextButtonStyle}">
                                    <Path Stroke="{DynamicResource EDTheme.Text.Secondary}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M2,1 L6,5 L2,9"/>
                                </Button>
                            </Grid>
                            <Grid x:Name="PART_MonthView" Grid.Row="1" Margin="0,4,0,0" Visibility="Visible">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                            </Grid>
                            <Grid x:Name="PART_YearView" Grid.Row="1" Margin="0,4,0,0" Visibility="Hidden">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Den v měsíci — stavy přes read-only DP (IsToday/IsSelected/IsInactive/…). -->
    <Style x:Key="EDCalendarDayButtonStyle" TargetType="prim:CalendarDayButton">
        <Setter Property="MinWidth"                   Value="30"/>
        <Setter Property="MinHeight"                  Value="28"/>
        <Setter Property="Foreground"                 Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily"                 Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"                   Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="prim:CalendarDayButton">
                    <Border x:Name="bg" Background="Transparent" BorderThickness="1"
                            BorderBrush="Transparent" CornerRadius="3" Margin="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Disabled}"/>
                            <Setter Property="Opacity"    Value="0.55"/>
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource EDTheme.Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource EDTheme.Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource EDTheme.Bg.Checked}"/>
                            <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Disabled}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Měsíc/rok v year/decade view. -->
    <Style x:Key="EDCalendarButtonStyle" TargetType="prim:CalendarButton">
        <Setter Property="MinWidth"                   Value="42"/>
        <Setter Property="MinHeight"                  Value="42"/>
        <Setter Property="Foreground"                 Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="FontFamily"                 Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"                   Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="prim:CalendarButton">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="3" Margin="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Disabled}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource EDTheme.Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource EDTheme.Bg.Checked}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Keyed (ne jen implicitní), protože DatePicker si Style svého interního Calendaru
         BINDuje na DatePicker.CalendarStyle — ta lokální hodnota potlačí implicitní styl
         dle typu. Proto se přiřazuje i přes DatePicker.CalendarStyle (viz DatePicker styl). -->
    <Style x:Key="EDCalendarStyle" TargetType="Calendar">
        <Setter Property="Background"             Value="{DynamicResource EDTheme.Bg.Surface}"/>
        <Setter Property="Foreground"             Value="{DynamicResource EDTheme.Text.Primary}"/>
        <Setter Property="BorderBrush"            Value="{DynamicResource EDTheme.Border.Medium}"/>
        <Setter Property="FontFamily"             Value="{DynamicResource EDTheme.FontFamily}"/>
        <Setter Property="FontSize"               Value="{DynamicResource EDTheme.FontSize.Body}"/>
        <Setter Property="CalendarItemStyle"      Value="{StaticResource EDCalendarItemStyle}"/>
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource EDCalendarDayButtonStyle}"/>
        <Setter Property="CalendarButtonStyle"    Value="{StaticResource EDCalendarButtonStyle}"/>
    </Style>

    <Style TargetType="Calendar" BasedOn="{StaticResource EDCalendarStyle}"/>

    <!-- Sdílené ikonové tlačítko toolbaru (nad seznamy/stromy): ploché, transparentní,
         jemný hover/pressed z theme tokenů (dark mode přes DynamicResource). Keyed —
         opt-in, nepřebíjí implicitní Button. Obsah = <Image> s ikonou. -->
    <Style x:Key="EDTheme.ToolbarButton" TargetType="Button">
        <Setter Property="Padding" Value="4"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Bg.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EDTheme.Bg.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EDTheme.Bg.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
