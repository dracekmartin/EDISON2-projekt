<UserControl x:Class="EDControls.EDInputForm.EDInputForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EDControls.EDInputForm"
             xmlns:edfc="clr-namespace:EDControls.EDFilterComboBox"
             xmlns:edct="clr-namespace:EDControls.EDComponentToolbar"
             xmlns:designTime="clr-namespace:EDControls.EDInputForm.DesignTimeData"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="420">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:HexToBrushConverter x:Key="HexToBrush"/>
        <local:Base64ToImageSourceConverter x:Key="Base64ToImage"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource EDTheme.Bg.Surface}">
        <!-- IsSharedSizeScope na outer Grid → column header bar a všechny field rows
             sdílí stejný ItemLabel column width.
             2 rows: Column header bar (nese i toolbar) | Items -->
        <Grid Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Column header bar: Položka | Hodnota | toolbar (hledání + nápověda).
                 Modern PropertyGrid layout: 2 logické sloupce — label + input. Errors/help
                 inline pod inputem (Material Design pattern).
                 Responzivní šířka: label Auto (fit obsahu, floor MinWidth), hodnota "*" s
                 MaxWidth → při dostatku místa se zastaví na 320 a přebytek zůstane prázdný
                 vpravo (jako fixní sloupec + spacer dřív); při nedostatku se hodnota zmenší
                 první až na MinWidth, teprve pak tlačí na label. Sloupce 0/1 musí sedět
                 s field row níž; sloupec 2 je jen hlavičkový (field row má sloupce dva).
                 Padding.Left=16 align s indented field rows pod skupinou. -->
            <Border Grid.Row="0"
                    Background="{DynamicResource EDTheme.Accent.BlueBg}"
                    BorderBrush="{DynamicResource EDTheme.Border.Light}"
                    BorderThickness="0,0,0,1"
                    Padding="16,3,4,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="ItemLabel"/>
                        <ColumnDefinition Width="*" MinWidth="120" MaxWidth="320"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Položka"
                               Foreground="{DynamicResource EDTheme.Text.Header}"
                               FontWeight="SemiBold" FontSize="{DynamicResource EDTheme.FontSize.Body}"
                               Margin="6,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Hodnota"
                               Foreground="{DynamicResource EDTheme.Text.Header}"
                               FontWeight="SemiBold" FontSize="{DynamicResource EDTheme.FontSize.Body}"
                               Margin="2,0,0,0" VerticalAlignment="Center"/>

                    <!-- EDComponentToolbar - sdílená komponenta napříč EDInputForm / EDList /
                         budoucími tabulkovými komponentami; Flat, protože pruh kreslí Border výš.
                         Ikona nápovědy otevírá popup zkratek přes HelpCommand (WireToolbarSearch).
                         Settings vypnutý dokud nemá reálný Command. -->
                    <edct:EDComponentToolbar Grid.Column="2"
                                             x:Name="Toolbar"
                                             Flat="True"
                                             ShowSearch="True"
                                             ShowHelp="True"
                                             ShowSettings="False"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <ItemsControl Grid.Row="1" x:Name="TheItemsControl"
                          ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType={x:Type local:EDInputForm}}}"
                          d:ItemsSource="{Binding Items, Source={d:DesignInstance designTime:EDInputFormDesignTimeData, IsDesignTimeCreatable=True}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Resources>
                <!-- Sdílený error styl polí s TextBoxem. BasedOn dědí implicitní
                     EDControlStyles.xaml TextBox (modern flat look + focus accent). -->
                <Style x:Key="FieldTextBoxStyle" TargetType="TextBox"
                       BasedOn="{StaticResource {x:Type TextBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource EDTheme.Semantic.Danger}"/>
                            <Setter Property="BorderThickness" Value="1.5"/>
                        </DataTrigger>
                        <!-- Needitovatelné: readonly (text zůstává čitelný/kopírovatelný), ale
                             panelové pozadí + ztlumený text/rámeček → vypadá staticky, ne jako input.
                             Doplňuje zámek u labelu. Funguje v light i dark (tokeny). -->
                        <DataTrigger Binding="{Binding Editable}" Value="False">
                            <Setter Property="IsReadOnly" Value="True"/>
                            <!-- Pozadí dodá recessed wrapper kolem hodnoty (viz Field DataTemplate);
                                 TextBox sám transparentní, ať nevznikne dvojité pozadí/rámeček. -->
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource EDTheme.Field.ReadOnly.Fg}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <!-- Sdílený error styl polí s ComboBoxem. BasedOn dědí implicitní EDControlStyles ComboBox. -->
                <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox"
                       BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource EDTheme.Semantic.Danger}"/>
                            <Setter Property="BorderThickness" Value="1.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <!-- Sdílený styl ikony nápovědy (tooltip mode) -->
                <Style x:Key="HelpIconStyle" TargetType="Image">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HelpTextVisibility}" Value="Visible"/>
                                <Condition Binding="{Binding HelpTextMode, RelativeSource={RelativeSource AncestorType={x:Type local:EDInputForm}}}" Value="{x:Static local:EHelpTextMode.Tooltip}"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>

                <!-- Help text ve sloupci Status (column mode, jen když není chyba — chyba má prioritu).
                     Používá se pro Field (s podmínkou HasError) i Group (chybu mít nemůže). -->
                <Style x:Key="HelpTextColumnStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HelpTextVisibility}" Value="Visible"/>
                                <Condition Binding="{Binding HelpTextMode, RelativeSource={RelativeSource AncestorType={x:Type local:EDInputForm}}}" Value="{x:Static local:EHelpTextMode.Column}"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>

                <!-- Help text pole ve sloupci Status — skryje se při HasError=True (chyba má prioritu). -->
                <Style x:Key="FieldHelpTextColumnStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HelpTextVisibility}" Value="Visible"/>
                                <Condition Binding="{Binding HelpTextMode, RelativeSource={RelativeSource AncestorType={x:Type local:EDInputForm}}}" Value="{x:Static local:EHelpTextMode.Column}"/>
                                <Condition Binding="{Binding HasError}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>

                <DataTemplate x:Key="TextFieldTemplate">
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                             ToolTip="{Binding ValidationError}"
                             Style="{StaticResource FieldTextBoxStyle}"/>
                </DataTemplate>

                <DataTemplate x:Key="NumberFieldTemplate">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding Unit}"
                                   Visibility="{Binding UnitVisibility}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Opacity="0.7"/>
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                 TextAlignment="Right"
                                 local:NumericInput.Mode="Integer"
                                 ToolTip="{Binding ValidationError}"
                                 Style="{StaticResource FieldTextBoxStyle}"/>
                    </DockPanel>
                </DataTemplate>

                <DataTemplate x:Key="DecimalFieldTemplate">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding Unit}"
                                   Visibility="{Binding UnitVisibility}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Opacity="0.7"/>
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                 TextAlignment="Right"
                                 local:NumericInput.Mode="Decimal"
                                 ToolTip="{Binding ValidationError}"
                                 Style="{StaticResource FieldTextBoxStyle}"/>
                    </DockPanel>
                </DataTemplate>

                <DataTemplate x:Key="DateFieldTemplate">
                    <DatePicker SelectedDate="{Binding DateValue}"
                                IsEnabled="{Binding Editable}"
                                ToolTip="{Binding ValidationError}">
                        <DatePicker.Style>
                            <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource EDTheme.Semantic.Danger}"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DatePicker.Style>
                    </DatePicker>
                </DataTemplate>

                <DataTemplate x:Key="BoolFieldTemplate">
                    <CheckBox IsChecked="{Binding BoolValue}"
                              IsEnabled="{Binding Editable}"
                              VerticalAlignment="Center"
                              ToolTip="{Binding ValidationError}"/>
                </DataTemplate>

                <DataTemplate x:Key="ButtonFieldTemplate">
                    <Button Content="{Binding Value}"
                            IsEnabled="{Binding Editable}"
                            Click="ButtonField_Click"
                            ToolTip="{Binding ValidationError}"
                            HorizontalAlignment="Left"
                            Padding="12,2"/>
                </DataTemplate>

                <DataTemplate x:Key="ListFieldTemplate">
                    <ComboBox ItemsSource="{Binding ListItemsForDisplay}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Key"
                              SelectedValue="{Binding Value}"
                              IsEnabled="{Binding Editable}"
                              ToolTip="{Binding ValidationError}"
                              Style="{StaticResource FieldComboBoxStyle}"/>
                </DataTemplate>

                <DataTemplate x:Key="FileFieldTemplate">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="{Binding ValidationError}"
                                 Style="{StaticResource FieldTextBoxStyle}"/>
                        <Button Grid.Column="1"
                                Content="..."
                                Click="FileField_BrowseClick"
                                Width="28" Padding="0" Margin="2,0,0,0"
                                IsEnabled="{Binding Editable}"
                                ToolTip="Procházet..."/>
                    </Grid>
                </DataTemplate>

                <!-- ComboBox: editovatelný s autocomplete — uživatel může napsat i hodnotu mimo list -->
                <DataTemplate x:Key="ComboBoxFieldTemplate">
                    <edfc:EDFilterComboBox
                        Suggestions="{Binding ListItems}"
                        Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                        IsEnabled="{Binding Editable}"
                        ToolTip="{Binding ValidationError}"
                        Style="{StaticResource FieldComboBoxStyle}"/>
                </DataTemplate>

                <DataTemplate x:Key="ColorFieldTemplate">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Swatch: Button s custom templatem = jen barevný Border (žádné default Button chrome). -->
                        <Button Grid.Column="0" Width="22" Height="22"
                                Click="ColorField_PickClick"
                                IsEnabled="{Binding Editable}"
                                ToolTip="Vybrat barvu..."
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border BorderBrush="{DynamicResource EDTheme.Border.Strong}" BorderThickness="1" CornerRadius="2"
                                            Background="{Binding Value, Converter={StaticResource HexToBrush}}"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBox Grid.Column="1" Margin="4,0,0,0"
                                 Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="{Binding ValidationError}"
                                 FontFamily="Consolas" FontSize="{DynamicResource EDTheme.FontSize.Caption}"
                                 Style="{StaticResource FieldTextBoxStyle}"/>
                        <Button Grid.Column="2"
                                Content="..."
                                Click="ColorField_PickClick"
                                Width="28" Padding="0" Margin="2,0,0,0"
                                IsEnabled="{Binding Editable}"
                                ToolTip="Vybrat barvu..."/>
                    </Grid>
                </DataTemplate>

                <!-- Image: náhled + Nahrát + vymazat. Value = Base64 string.
                     Tlačítka Auto vedle náhledu (u sebe vlevo), spacer * pohltí zbytek. -->
                <DataTemplate x:Key="ImageFieldTemplate">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Náhled (prázdný rámeček když není obrázek) -->
                        <Border Grid.Column="0" Width="44" Height="44" BorderBrush="{DynamicResource EDTheme.Border.Medium}"
                                BorderThickness="1" CornerRadius="2" Background="{DynamicResource EDTheme.Bg.PanelAlt}">
                            <Image Source="{Binding Value, Converter={StaticResource Base64ToImage}}"
                                   Stretch="Uniform" Margin="2"/>
                        </Border>
                        <Button Grid.Column="1" Content="Nahrát…"
                                Click="ImageField_PickClick"
                                Margin="6,0,0,0" Padding="8,2"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding Editable}"
                                ToolTip="Vybrat obrázek ze souboru"/>
                        <Button Grid.Column="2" Content="×"
                                Click="ImageField_ClearClick"
                                Width="24" Padding="0" Margin="4,0,0,0" VerticalAlignment="Center"
                                IsEnabled="{Binding Editable}"
                                ToolTip="Vymazat obrázek"/>
                    </Grid>
                </DataTemplate>

                <!-- Field row: 2-column modern PropertyGrid layout (Položka | Hodnota).
                     Položka Auto SharedSize MinWidth=120 → konzistentní label width napříč rows
                     (fit obsahu, jen floor). Hodnota "*" MinWidth=120 MaxWidth=320 → responzivní:
                     do 320 fixní vzhled + prázdno vpravo, při zúžení se zmenší první až na 120,
                     teprve pak tlačí na label. Definice sloupců musí sedět s column header barem.
                     Row 1 pod inputem zobrazí error/help inline (Material Design pattern).
                     Margin.Left=16 → fields indented pod group header pro vizuální hierarchii. -->
                <DataTemplate DataType="{x:Type local:Field}">
                    <Grid Margin="16,3,2,3" Visibility="{Binding EffectiveVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="ItemLabel"/>
                            <ColumnDefinition Width="*" MinWidth="120" MaxWidth="320"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                            <!-- Col 0 / Row 0: Položka — label + help/validate ikona + asterisk.
                                 StackPanel s HorizontalAlignment="Left" → hugs left edge, nedrift. -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="6,0,12,0">
                                <Ellipse Width="6" Height="6" Fill="CornflowerBlue"
                                         Margin="0,0,4,0" VerticalAlignment="Center"
                                         Visibility="{Binding ValidateIndicatorVisibility}"
                                         ToolTip="Automatická validace"/>
                                <Image Source="{StaticResource EDIcons.Help}"
                                       Width="14" Height="14" Margin="0,0,4,0"
                                       ToolTip="{Binding HelpText}" Cursor="Help"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource HelpIconStyle}"/>
                                <!-- Zámek u needitovatelných polí — monochromatický glyph (Segoe MDL2),
                                     barví se z tokenu → čitelný v light i dark. -->
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="{DynamicResource EDTheme.FontSize.Caption}" Margin="0,0,4,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource EDTheme.Field.ReadOnly.Fg}"
                                           Visibility="{Binding NonEditableIndicatorVisibility}"
                                           ToolTip="Needitovatelné (jen pro čtení)"/>
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap"
                                           MaxWidth="280" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <!-- BasedOn povinné — bez něj se v editable stavu ztratí themed Foreground → v dark černý (neviditelný) label. -->
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Editable}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource EDTheme.Field.ReadOnly.Fg}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="*" Foreground="{DynamicResource EDTheme.Semantic.Danger}"
                                           Visibility="{Binding RequiredIndicatorVisibility}"
                                           ToolTip="Povinné pole" Margin="4,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Col 1 / Row 0: Hodnota — input (template per FieldType).
                                 Needitovatelné: recessed pozadí (Field.ReadOnly.Bg) obalí hodnotu
                                 nezávisle na typu pole (text i disabled controly) → sjednocený
                                 „vypnutý" vzhled v light i dark. Editovatelné = Transparent (beze změny). -->
                            <Border Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" CornerRadius="3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Editable}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource EDTheme.Field.ReadOnly.Bg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            <ContentControl VerticalAlignment="Center"
                                            Content="{Binding}" Focusable="False">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextFieldTemplate}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FieldType}" Value="{x:Static local:EFieldType.Number}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource NumberFieldTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FieldType}" Value="{x:Static local:EFieldType.Decimal}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource DecimalFieldTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FieldType}" Value="{x:Static local:EFieldType.Date}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource DateFieldTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FieldType}" Value="{x:Static local:EFieldType.Bool}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource BoolFieldTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FieldType}" Value="{x:Static local:EFieldType.Button}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ButtonFieldTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FieldType}" Value="{x:Static local:EFieldType.List}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ListFieldTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FieldType}" Value="{x:Static local:EFieldType.File}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource FileFieldTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FieldType}" Value="{x:Static local:EFieldType.Color}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ColorFieldTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FieldType}" Value="{x:Static local:EFieldType.ComboBox}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ComboBoxFieldTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FieldType}" Value="{x:Static local:EFieldType.Image}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ImageFieldTemplate}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                            </Border>

                            <!-- Row 1 / Col 1: inline error/help pod inputem (Material Design pattern).
                                 Error má prioritu (červený text), jinak help text (italic muted).
                                 Žádný layout shift — Row 1 je Auto height, prázdná = 0px. -->
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding ValidationError}"
                                       Foreground="{DynamicResource EDTheme.Semantic.Danger}" FontSize="{DynamicResource EDTheme.FontSize.Caption}"
                                       TextWrapping="Wrap" MaxWidth="320"
                                       Margin="2,2,2,2"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding HelpText}"
                                       Foreground="{DynamicResource EDTheme.Text.Muted}"
                                       FontSize="{DynamicResource EDTheme.FontSize.Caption}" FontStyle="Italic"
                                       TextWrapping="Wrap" MaxWidth="320"
                                       Margin="2,2,2,2"
                                       Style="{StaticResource FieldHelpTextColumnStyle}"/>
                        </Grid>
                </DataTemplate>

                <!-- Group header: modern flat section header s 3px modrým accent vlevo.
                     Outer Border = accent line (BorderThickness="3,0,0,0"), inner Border = bg + bottom rule.
                     Vizuálně silnější hierarchie sekce → fields (které jsou indented pod skupinou). -->
                <DataTemplate DataType="{x:Type local:Group}">
                    <Border Margin="0,0,0,0" Visibility="{Binding EffectiveVisibility}"
                            BorderBrush="{DynamicResource EDTheme.Accent.Blue}"
                            BorderThickness="3,0,0,0">
                    <Border Background="{DynamicResource EDTheme.Bg.Panel}"
                            BorderBrush="{DynamicResource EDTheme.Border.Light}"
                            BorderThickness="0,0,0,1"
                            Padding="6,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="HelpText"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="0"
                                          IsChecked="{Binding IsExpanded}"
                                          Background="Transparent" BorderThickness="0"
                                          Padding="2,0" Margin="0,0,6,0"
                                          VerticalAlignment="Center"
                                          Focusable="False" Cursor="Hand"
                                          Content="&#x25BC;" FontSize="{DynamicResource EDTheme.FontSize.Small}">
                                <ToggleButton.RenderTransformOrigin>0.5,0.5</ToggleButton.RenderTransformOrigin>
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <!-- Vlastní flat template — default template kreslí v checked
                                             stavu modré chrome pozadí (ošklivé, netémované). -->
                                        <Setter Property="Foreground" Value="{DynamicResource EDTheme.Text.Primary}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Bd" Background="Transparent"
                                                            Padding="{TemplateBinding Padding}"
                                                            CornerRadius="3">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource EDTheme.Bg.Hover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="-90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding GroupName}"
                                       FontWeight="SemiBold" FontSize="{DynamicResource EDTheme.FontSize.Body}"
                                       VerticalAlignment="Center"/>
                            <Image Grid.Column="2" Source="{StaticResource EDIcons.Help}"
                                   Width="14" Height="14" Margin="0,0,4,0"
                                   ToolTip="{Binding HelpText}" Cursor="Help"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource HelpIconStyle}"/>
                            <!-- Help text (column mode) — zarovnán s help texty polí přes SharedSizeGroup -->
                            <TextBlock Grid.Column="3"
                                       Text="{Binding HelpText}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource EDTheme.Text.Muted}" FontSize="{DynamicResource EDTheme.FontSize.Caption}"
                                       VerticalAlignment="Center" Margin="8,0,4,0"
                                       MaxWidth="200"
                                       Style="{StaticResource HelpTextColumnStyle}"/>
                        </Grid>
                    </Border>
                    </Border>
                </DataTemplate>
            </ItemsControl.Resources>
        </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>
