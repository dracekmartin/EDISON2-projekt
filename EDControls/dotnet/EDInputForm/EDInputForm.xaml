<UserControl x:Class="EDControls.EDInputForm.EDInputForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EDControls.EDInputForm"
             xmlns:designTime="clr-namespace:EDControls.EDInputForm.DesignTimeData"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="420">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="White">
        <ItemsControl ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType={x:Type local:EDInputForm}}}"
                      d:ItemsSource="{Binding Items, Source={d:DesignInstance designTime:EDInputFormDesignTimeData, IsDesignTimeCreatable=True}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Grid.IsSharedSizeScope="True"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Resources>
                <!-- Field row: label in column 0, input control in column 1 -->
                <DataTemplate DataType="{x:Type local:Field}">
                    <Grid Margin="2,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Debug-only dot: visible only in DEBUG builds when ValidateOnChange=true -->
                            <Ellipse Width="6" Height="6" Fill="CornflowerBlue" Margin="4,0,3,0"
                                     Visibility="{Binding ValidateIndicatorVisibility}"
                                     ToolTip="Automatická validace"/>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="0,2,2,2"/>
                            <!-- Required asterisk: always visible when Required=true -->
                            <TextBlock Text="*" Foreground="Red" VerticalAlignment="Center"
                                       Visibility="{Binding RequiredIndicatorVisibility}"
                                       ToolTip="Povinné pole" Margin="0,2,6,2"/>
                            <!-- Spacer so non-required labels align with the asterisk gap -->
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="{Binding ValidationError}"
                                 Margin="2,1">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FieldType}" Value="{x:Static local:EFieldType.Number}">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="BorderBrush" Value="Red"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </DataTemplate>

                <!-- Group separator: spans both columns as a labelled horizontal rule -->
                <DataTemplate DataType="{x:Type local:Group}">
                    <Grid Margin="2,8,2,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding GroupName}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,8,0"/>
                        <Separator Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.Resources>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
