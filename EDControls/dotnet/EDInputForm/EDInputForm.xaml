<UserControl x:Class="EDControls.EDInputForm.EDInputForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EDControls.EDInputForm"
             xmlns:designTime="clr-namespace:EDControls.EDInputForm.DesignTimeData"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="420">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="White">
        <ItemsControl x:Name="TheItemsControl"
                      ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType={x:Type local:EDInputForm}}}"
                      d:ItemsSource="{Binding Items, Source={d:DesignInstance designTime:EDInputFormDesignTimeData, IsDesignTimeCreatable=True}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Grid.IsSharedSizeScope="True"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Resources>
                <!-- Shared error style for TextBox-based fields -->
                <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="BorderBrush" Value="Red"/>
                            <Setter Property="BorderThickness" Value="1.5"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Editable}" Value="False">
                            <Setter Property="IsReadOnly" Value="True"/>
                            <Setter Property="Background" Value="#F0F0F0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <!-- Shared style for help icon (tooltip mode) -->
                <Style x:Key="HelpIconStyle" TargetType="Image">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HelpTextVisibility}" Value="Visible"/>
                                <Condition Binding="{Binding HelpTextMode, RelativeSource={RelativeSource AncestorType={x:Type local:EDInputForm}}}" Value="{x:Static local:EHelpTextMode.Tooltip}"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>

                <!-- Shared style for help text column (column mode) -->
                <Style x:Key="HelpTextColumnStyle" TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HelpTextVisibility}" Value="Visible"/>
                                <Condition Binding="{Binding HelpTextMode, RelativeSource={RelativeSource AncestorType={x:Type local:EDInputForm}}}" Value="{x:Static local:EHelpTextMode.Column}"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>

                <!-- Text: plain TextBox -->
                <DataTemplate x:Key="TextFieldTemplate">
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                             ToolTip="{Binding ValidationError}"
                             Style="{StaticResource FieldTextBoxStyle}"/>
                </DataTemplate>

                <!-- Number: right-aligned, integer-only input -->
                <DataTemplate x:Key="NumberFieldTemplate">
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                             TextAlignment="Right"
                             local:NumericInput.Mode="Integer"
                             ToolTip="{Binding ValidationError}"
                             Style="{StaticResource FieldTextBoxStyle}"/>
                </DataTemplate>

                <!-- Decimal: right-aligned, decimal input -->
                <DataTemplate x:Key="DecimalFieldTemplate">
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                             TextAlignment="Right"
                             local:NumericInput.Mode="Decimal"
                             ToolTip="{Binding ValidationError}"
                             Style="{StaticResource FieldTextBoxStyle}"/>
                </DataTemplate>

                <!-- Date: DatePicker with calendar -->
                <DataTemplate x:Key="DateFieldTemplate">
                    <DatePicker SelectedDate="{Binding DateValue}"
                                IsEnabled="{Binding Editable}"
                                ToolTip="{Binding ValidationError}">
                        <DatePicker.Style>
                            <Style TargetType="DatePicker">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="BorderBrush" Value="Red"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DatePicker.Style>
                    </DatePicker>
                </DataTemplate>

                <!-- Bool: CheckBox -->
                <DataTemplate x:Key="BoolFieldTemplate">
                    <CheckBox IsChecked="{Binding BoolValue}"
                              IsEnabled="{Binding Editable}"
                              VerticalAlignment="Center"
                              ToolTip="{Binding ValidationError}"/>
                </DataTemplate>

                <!-- Button: clickable action button -->
                <DataTemplate x:Key="ButtonFieldTemplate">
                    <Button Content="{Binding Value}"
                            IsEnabled="{Binding Editable}"
                            Click="ButtonField_Click"
                            ToolTip="{Binding ValidationError}"
                            HorizontalAlignment="Left"
                            Padding="12,2"/>
                </DataTemplate>

                <!-- List: ComboBox dropdown -->
                <DataTemplate x:Key="ListFieldTemplate">
                    <ComboBox ItemsSource="{Binding ListItemsForDisplay}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Key"
                              SelectedValue="{Binding Value}"
                              IsEnabled="{Binding Editable}"
                              ToolTip="{Binding ValidationError}">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="BorderBrush" Value="Red"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                </DataTemplate>

                <!-- Field row: fixed 130px label column, input fills the rest, optional help column -->
                <DataTemplate DataType="{x:Type local:Field}">
                    <Grid Margin="2,1" Visibility="{Binding EffectiveVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="HelpText"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" VerticalAlignment="Top">
                            <!-- Item number for keyboard navigation (Ctrl+number) -->
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding Number, StringFormat='{}{0}.'}"
                                       Foreground="Gray" FontSize="10"
                                       VerticalAlignment="Top" Margin="2,3,3,0"/>
                            <!-- Debug-only dot: visible only in DEBUG builds when ValidateOnChange=true -->
                            <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="CornflowerBlue"
                                     Margin="4,4,3,0"
                                     Visibility="{Binding ValidateIndicatorVisibility}"
                                     ToolTip="Automatická validace"/>
                            <!-- Help icon (tooltip mode): visible when HelpText is set and mode is Tooltip -->
                            <Image DockPanel.Dock="Left" Source="{StaticResource EDIcons.Help}"
                                   Width="14" Height="14" Margin="2,2,2,0"
                                   ToolTip="{Binding HelpText}" Cursor="Help"
                                   VerticalAlignment="Top"
                                   Style="{StaticResource HelpIconStyle}"/>
                            <!-- Required asterisk -->
                            <TextBlock DockPanel.Dock="Right" Text="*" Foreground="Red"
                                       Visibility="{Binding RequiredIndicatorVisibility}"
                                       ToolTip="Povinné pole" Margin="0,2,6,2"/>
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap"
                                       VerticalAlignment="Top" Margin="0,2,2,2"/>
                        </DockPanel>
                        <ContentControl Grid.Column="1" VerticalAlignment="Top"
                                        Content="{Binding}" Margin="2,1" Focusable="False">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TextFieldTemplate}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FieldType}" Value="{x:Static local:EFieldType.Number}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource NumberFieldTemplate}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FieldType}" Value="{x:Static local:EFieldType.Decimal}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource DecimalFieldTemplate}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FieldType}" Value="{x:Static local:EFieldType.Date}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource DateFieldTemplate}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FieldType}" Value="{x:Static local:EFieldType.Bool}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource BoolFieldTemplate}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FieldType}" Value="{x:Static local:EFieldType.Button}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource ButtonFieldTemplate}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FieldType}" Value="{x:Static local:EFieldType.List}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource ListFieldTemplate}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                        <!-- Help text column (column mode): visible when HelpText is set and mode is Column -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding HelpText}" TextWrapping="Wrap"
                                   Foreground="Gray" FontSize="11"
                                   VerticalAlignment="Top" Margin="8,2,4,2"
                                   MaxWidth="200"
                                   Style="{StaticResource HelpTextColumnStyle}"/>
                    </Grid>
                </DataTemplate>

                <!-- Group separator: labelled horizontal rule, help text shares column with fields -->
                <DataTemplate DataType="{x:Type local:Group}">
                    <Grid Margin="2,8,2,2" Visibility="{Binding EffectiveVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="HelpText"/>
                        </Grid.ColumnDefinitions>
                        <!-- Collapse/expand toggle -->
                        <ToggleButton Grid.Column="0"
                                      IsChecked="{Binding IsExpanded}"
                                      Background="Transparent" BorderThickness="0"
                                      Padding="2,0" VerticalAlignment="Center"
                                      Focusable="False" Cursor="Hand">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Content" Value="&#x25BC;"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="Content" Value="&#x25BA;"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <!-- Item number for keyboard navigation (Ctrl+number) -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Number, StringFormat='{}{0}.'}"
                                   Foreground="Gray" FontSize="10"
                                   VerticalAlignment="Bottom" Margin="2,0,4,1"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding GroupName}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Bottom"
                                   Margin="2,0,4,0"/>
                        <!-- Help icon (tooltip mode) next to group name -->
                        <Image Grid.Column="3" Source="{StaticResource EDIcons.Help}"
                               Width="14" Height="14" Margin="0,0,8,0"
                               ToolTip="{Binding HelpText}" Cursor="Help"
                               VerticalAlignment="Center"
                               Style="{StaticResource HelpIconStyle}"/>
                        <Separator Grid.Column="4" VerticalAlignment="Center"/>
                        <!-- Help text (column mode): aligned with field help texts -->
                        <TextBlock Grid.Column="5"
                                   Text="{Binding HelpText}" TextWrapping="Wrap"
                                   Foreground="Gray" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,4,0"
                                   MaxWidth="200"
                                   Style="{StaticResource HelpTextColumnStyle}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.Resources>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
