<UserControl x:Class="EDControls.EDFooter.EDFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Border Padding="8,6,8,6"
            BorderBrush="{DynamicResource EDTheme.Border.Light}"
            BorderThickness="0,1,0,0"
            Background="{DynamicResource EDTheme.Bg.Footer}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!-- Tlačítko „Akce" - jako v legacy BaseForm2 vypadá jako OK a Storno a klik otevře nabídku akcí VM.
                     Zobrazí se samo, když má VM neprázdné Actions (code-behind). -->
                <Button x:Name="ActionsBtn" MinWidth="80" Padding="10,4" Margin="0,0,6,0"
                        Click="ActionsBtn_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Akce"/>
                        <TextBlock Text="▾" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <ContentPresenter x:Name="LeftContentPresenter"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="OkBtn"
                        Content="{StaticResource EDStrings.Ok}" Width="80"
                        Margin="0,0,6,0" Padding="0,4"
                        Click="OkBtn_Click"
                        Visibility="Collapsed"/>
                <Button x:Name="StornoBtn"
                        Content="{StaticResource EDStrings.Cancel}" Width="80"
                        Padding="0,4"
                        Click="CancelBtn_Click"
                        Visibility="Collapsed"/>
                <Button x:Name="CloseBtn"
                        Content="{StaticResource EDStrings.Close}" Width="80"
                        Padding="0,4"
                        Click="CancelBtn_Click"/>
            </StackPanel>
        </Grid>
    </Border>

</UserControl>
