<UserControl x:Class="EDControls.EDFooter.EDFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Border Padding="8,6,8,6"
            BorderBrush="#DDDDDD"
            BorderThickness="0,1,0,0"
            Background="#F8F8F8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Optional left-side content (set via LeftContent property) -->
            <ContentPresenter x:Name="LeftContentPresenter" Grid.Column="0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <!-- OkCancel mode -->
                <Button x:Name="OkBtn"
                        Content="{StaticResource EDStrings.Ok}" Width="80" IsDefault="True"
                        Margin="0,0,6,0" Padding="0,4"
                        Click="OkBtn_Click"
                        Visibility="Collapsed"/>
                <Button x:Name="StornoBtn"
                        Content="{StaticResource EDStrings.Cancel}" Width="80"
                        Padding="0,4"
                        Click="CancelBtn_Click"
                        Visibility="Collapsed"/>
                <!-- Close mode (default) -->
                <Button x:Name="CloseBtn"
                        Content="{StaticResource EDStrings.Close}" Width="80"
                        Padding="0,4"
                        Click="CancelBtn_Click"/>
            </StackPanel>
        </Grid>
    </Border>

</UserControl>
