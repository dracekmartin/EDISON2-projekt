<UserControl x:Class="EDControls.EDFooter.EDFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Border Padding="8,6,8,6"
            BorderBrush="{DynamicResource EDTheme.Border.Light}"
            BorderThickness="0,1,0,0"
            Background="{DynamicResource EDTheme.Bg.Footer}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!-- Actions dropdown menu (visible when Actions property is set) -->
                <Menu VerticalAlignment="Center" Margin="0,0,4,0"
                      Visibility="{Binding HasItems, ElementName=ActionsMenuItem, Converter={StaticResource BoolToVisibility}}">
                    <MenuItem x:Name="ActionsMenuItem" Header="Akce" ItemsSource="{Binding Actions}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header"           Value="{Binding Label}"/>
                                <Setter Property="Command"          Value="{Binding Command}"/>
                                <Setter Property="InputGestureText" Value="{Binding ShortcutText}"/>
                                <Setter Property="Icon"             Value="{Binding IconElement}"/>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                </Menu>
                <!-- Optional left-side content (set via LeftContent property) -->
                <ContentPresenter x:Name="LeftContentPresenter"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <!-- OkCancel mode -->
                <Button x:Name="OkBtn"
                        Content="{StaticResource EDStrings.Ok}" Width="80"
                        Margin="0,0,6,0" Padding="0,4"
                        Click="OkBtn_Click"
                        Visibility="Collapsed"/>
                <Button x:Name="StornoBtn"
                        Content="{StaticResource EDStrings.Cancel}" Width="80"
                        Padding="0,4"
                        Click="CancelBtn_Click"
                        Visibility="Collapsed"/>
                <!-- Close mode (default) -->
                <Button x:Name="CloseBtn"
                        Content="{StaticResource EDStrings.Close}" Width="80"
                        Padding="0,4"
                        Click="CancelBtn_Click"/>
            </StackPanel>
        </Grid>
    </Border>

</UserControl>
