<?xml version="1.0" encoding="utf-8"?>
<!-- Stejný název profilu jako u aplikačních projektů, aby se všechny tři vydávaly týmž
     příkazem. Knihovna nemá co bundlovat - „SingleFile" je tu jen kvůli jednotnému názvu;
     obsahem profilu je publish jediné assembly do C:\Edison\ (viz PublishOwnAssemblyOnly
     v SingleFilePublish.targets). Bez Platform/RuntimeIdentifier: EDControls je AnyCPU
     managed knihovna, RID by na výstupní DLL nic nezměnil. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <PublishDir>C:\Edison\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
</Project>
