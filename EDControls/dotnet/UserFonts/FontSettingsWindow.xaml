<Window x:Class="EDControls.UserFonts.FontSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edsp="clr-namespace:EDControls.EDSupportPanel"
        Title="Nastavení fontu" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        edsp:EDSupportPanel.Suppress="True">

    <Border Padding="20,16,20,14"
            Background="{DynamicResource EDTheme.Bg.Surface}">
        <!-- MinWidth, ne Width: řádek tlačítek je širší (popisek výchozí hodnoty)
             a SizeToContent na okně si šířku dorovná. -->
        <Grid MinWidth="380">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Rodina:" VerticalAlignment="Center"
                       Margin="0,0,8,8"/>
            <ComboBox x:Name="FamilyCombo" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                      Margin="0,0,0,8"
                      SelectionChanged="Choice_Changed"/>

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Velikost:" VerticalAlignment="Center"
                       Margin="0,0,8,12"/>
            <ComboBox x:Name="SizeCombo" Grid.Row="1" Grid.Column="1"
                      DisplayMemberPath="Label"
                      Margin="0,0,6,12"
                      SelectionChanged="Choice_Changed"/>
            <TextBlock Grid.Row="1" Grid.Column="2"
                       Text="pt" VerticalAlignment="Center"
                       Foreground="{DynamicResource EDTheme.Text.Muted}"
                       Margin="0,0,0,12"/>

            <!-- Náhled: FontFamily/FontSize se nastavují lokálně v code-behind, aby ukázka
                 ignorovala globální tokeny a šla vidět ještě před potvrzením dialogu. -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                    Margin="0,0,0,10" Padding="10,8"
                    Background="{DynamicResource EDTheme.Bg.PanelAlt}"
                    BorderBrush="{DynamicResource EDTheme.Border.Light}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Náhled"
                               Foreground="{DynamicResource EDTheme.Text.Muted}"
                               FontSize="{DynamicResource EDTheme.FontSize.Caption}"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="PreviewText"
                               Text="Příliš žluťoučký kůň úpěl ďábelské ódy"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="PreviewDigits" Text="0123456789"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="CurrentStateText" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                       Margin="0,0,0,12" TextWrapping="Wrap"
                       Foreground="{DynamicResource EDTheme.Text.Secondary}"/>

            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                        Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ResetBtn"
                        Padding="10,4" Margin="0,0,12,0"
                        Click="ResetBtn_Click"/>
                <!-- Content OK/Storno plní code-behind z EDStrings s fallbackem — EDControls
                     jako knihovna nemá zaručeno, že host slovník mergnul (viz EDPopup). -->
                <Button x:Name="OkBtn"
                        Width="80" Padding="0,4" Margin="0,0,6,0"
                        IsDefault="True"
                        Click="OkBtn_Click"/>
                <Button x:Name="CancelBtn"
                        Width="80" Padding="0,4"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
