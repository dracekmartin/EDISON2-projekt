<UserControl x:Class="EDControls.MiniApps.EDMiniAppBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edct="clr-namespace:EDControls.EDComponentToolbar">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <edct:NonEmptyStringToVisibleConverter x:Key="NonEmptyToVis"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource EDTheme.Bg.Footer}"
            BorderBrush="{DynamicResource EDTheme.Border.Light}"
            BorderThickness="0,0,0,1" Padding="8,6">
        <DockPanel LastChildFill="False">

            <!-- Status vpravo. Text i Visibility jdou setterem, ne lokálně - lokální hodnota
                 má přednost před triggerem, takže IsBusy by text nepřepsal. -->
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{DynamicResource EDTheme.Text.Muted}"
                       FontSize="{DynamicResource EDTheme.FontSize.Caption}"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Text"
                                Value="{Binding StatusText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <Setter Property="Visibility"
                                Value="{Binding StatusText, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NonEmptyToVis}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Text" Value="Načítám…"/>
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Filtrační kontrolky jako děti v XAML. WrapPanel je v úzkém panelu zalomí;
                 mezeru a zarovnání rozdává code-behind - ItemContainerStyle tu nejde, kontrolka
                 je sama sobě kontejnerem a styl cílený na ContentPresenter na ni nesedne. -->
            <ItemsControl DockPanel.Dock="Left"
                          ItemsSource="{Binding Filters, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Button DockPanel.Dock="Left" MinWidth="88" VerticalAlignment="Center"
                    Content="{Binding ActionText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Command="{Binding ActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Visibility="{Binding ShowAction, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
        </DockPanel>
    </Border>
</UserControl>
