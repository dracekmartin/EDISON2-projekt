<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        EDThemeDark - tmavá varianta barevných tokenů z EDTheme.xaml.
        NEmerguje se natrvalo; ThemeService ji za běhu přidá/odebere z Application.Resources
        (přidaná poslední → přebije brush klíče z EDTheme.xaml pro DynamicResource lookup).

        Přepisují se JEN barvy (brush klíče + jejich .Color). Typografie, spacing a icon size
        zůstávají z EDTheme.xaml. Klíče MUSÍ přesně odpovídat EDTheme.xaml.
    -->

    <!-- Borders -->
    <Color x:Key="EDTheme.Border.Light.Color">#FF3A3A3D</Color>
    <SolidColorBrush x:Key="EDTheme.Border.Light" Color="{StaticResource EDTheme.Border.Light.Color}"/>
    <Color x:Key="EDTheme.Border.Medium.Color">#FF4A4A4F</Color>
    <SolidColorBrush x:Key="EDTheme.Border.Medium" Color="{StaticResource EDTheme.Border.Medium.Color}"/>
    <Color x:Key="EDTheme.Border.Strong.Color">#FF6A6A70</Color>
    <SolidColorBrush x:Key="EDTheme.Border.Strong" Color="{StaticResource EDTheme.Border.Strong.Color}"/>
    <Color x:Key="EDTheme.Border.Contrast.Color">#FF8C8C8C</Color>
    <SolidColorBrush x:Key="EDTheme.Border.Contrast" Color="{StaticResource EDTheme.Border.Contrast.Color}"/>

    <!-- Backgrounds -->
    <Color x:Key="EDTheme.Bg.Surface.Color">#FF2D2D30</Color>
    <SolidColorBrush x:Key="EDTheme.Bg.Surface" Color="{StaticResource EDTheme.Bg.Surface.Color}"/>
    <Color x:Key="EDTheme.Bg.Base.Color">#FF1E1E1E</Color>
    <SolidColorBrush x:Key="EDTheme.Bg.Base" Color="{StaticResource EDTheme.Bg.Base.Color}"/>
    <Color x:Key="EDTheme.Bg.Sunken.Color">#FF1E1E1E</Color>
    <SolidColorBrush x:Key="EDTheme.Bg.Sunken" Color="{StaticResource EDTheme.Bg.Sunken.Color}"/>
    <Color x:Key="EDTheme.Bg.Panel.Color">#FF252526</Color>
    <SolidColorBrush x:Key="EDTheme.Bg.Panel" Color="{StaticResource EDTheme.Bg.Panel.Color}"/>
    <Color x:Key="EDTheme.Bg.PanelAlt.Color">#FF2A2A2C</Color>
    <SolidColorBrush x:Key="EDTheme.Bg.PanelAlt" Color="{StaticResource EDTheme.Bg.PanelAlt.Color}"/>
    <Color x:Key="EDTheme.Bg.Footer.Color">#FF252526</Color>
    <SolidColorBrush x:Key="EDTheme.Bg.Footer" Color="{StaticResource EDTheme.Bg.Footer.Color}"/>
    <Color x:Key="EDTheme.Bg.Hover.Color">#FF3A3A3D</Color>
    <SolidColorBrush x:Key="EDTheme.Bg.Hover" Color="{StaticResource EDTheme.Bg.Hover.Color}"/>
    <Color x:Key="EDTheme.Bg.Pressed.Color">#FF4A4A4F</Color>
    <SolidColorBrush x:Key="EDTheme.Bg.Pressed" Color="{StaticResource EDTheme.Bg.Pressed.Color}"/>
    <Color x:Key="EDTheme.Bg.Checked.Color">#FF264F78</Color>
    <SolidColorBrush x:Key="EDTheme.Bg.Checked" Color="{StaticResource EDTheme.Bg.Checked.Color}"/>
    <Color x:Key="EDTheme.Bg.Canvas.Color">#FF1B1B1B</Color>
    <SolidColorBrush x:Key="EDTheme.Bg.Canvas" Color="{StaticResource EDTheme.Bg.Canvas.Color}"/>
    <Color x:Key="EDTheme.Bg.InfoBanner.Color">#FF2A3742</Color>
    <SolidColorBrush x:Key="EDTheme.Bg.InfoBanner" Color="{StaticResource EDTheme.Bg.InfoBanner.Color}"/>
    <Color x:Key="EDTheme.Bg.Scrim.Color">#99000000</Color>
    <SolidColorBrush x:Key="EDTheme.Bg.Scrim" Color="{StaticResource EDTheme.Bg.Scrim.Color}"/>

    <!-- Text -->
    <Color x:Key="EDTheme.Text.Primary.Color">#FFECECEC</Color>
    <SolidColorBrush x:Key="EDTheme.Text.Primary" Color="{StaticResource EDTheme.Text.Primary.Color}"/>
    <Color x:Key="EDTheme.Text.Secondary.Color">#FFBFBFBF</Color>
    <SolidColorBrush x:Key="EDTheme.Text.Secondary" Color="{StaticResource EDTheme.Text.Secondary.Color}"/>
    <Color x:Key="EDTheme.Text.Muted.Color">#FF8C8C8C</Color>
    <SolidColorBrush x:Key="EDTheme.Text.Muted" Color="{StaticResource EDTheme.Text.Muted.Color}"/>
    <Color x:Key="EDTheme.Text.Header.Color">#FFDCDCDC</Color>
    <SolidColorBrush x:Key="EDTheme.Text.Header" Color="{StaticResource EDTheme.Text.Header.Color}"/>
    <Color x:Key="EDTheme.Text.Disabled.Color">#FF6A6A6A</Color>
    <SolidColorBrush x:Key="EDTheme.Text.Disabled" Color="{StaticResource EDTheme.Text.Disabled.Color}"/>

    <!-- Field states - agresivnější než v light: pozadí výrazně tmavší než surface (#2D2D30)
         → readonly pole zřetelně recessed; text silně ztlumený. -->
    <Color x:Key="EDTheme.Field.ReadOnly.Bg.Color">#FF1A1A1B</Color>
    <SolidColorBrush x:Key="EDTheme.Field.ReadOnly.Bg" Color="{StaticResource EDTheme.Field.ReadOnly.Bg.Color}"/>
    <Color x:Key="EDTheme.Field.ReadOnly.Fg.Color">#FF6A6A6A</Color>
    <SolidColorBrush x:Key="EDTheme.Field.ReadOnly.Fg" Color="{StaticResource EDTheme.Field.ReadOnly.Fg.Color}"/>

    <!-- Accent: Blue -->
    <Color x:Key="EDTheme.Accent.Blue.Color">#FF3B9EFF</Color>
    <SolidColorBrush x:Key="EDTheme.Accent.Blue" Color="{StaticResource EDTheme.Accent.Blue.Color}"/>
    <Color x:Key="EDTheme.Accent.BlueDark.Color">#FF8FC4F5</Color>
    <SolidColorBrush x:Key="EDTheme.Accent.BlueDark" Color="{StaticResource EDTheme.Accent.BlueDark.Color}"/>
    <Color x:Key="EDTheme.Accent.BlueBg.Color">#FF1B3A57</Color>
    <SolidColorBrush x:Key="EDTheme.Accent.BlueBg" Color="{StaticResource EDTheme.Accent.BlueBg.Color}"/>
    <Color x:Key="EDTheme.Accent.BlueSelected.Color">#FF2A4D6E</Color>
    <SolidColorBrush x:Key="EDTheme.Accent.BlueSelected" Color="{StaticResource EDTheme.Accent.BlueSelected.Color}"/>
    <Color x:Key="EDTheme.Accent.BlueBorder.Color">#FF3A5F86</Color>
    <SolidColorBrush x:Key="EDTheme.Accent.BlueBorder" Color="{StaticResource EDTheme.Accent.BlueBorder.Color}"/>

    <!-- Primární tlačítko - plocha zůstává sytá kvůli bílému textu, hover naopak zesvětlí (jako portál podpory) -->
    <Color x:Key="EDTheme.PrimaryButton.Bg.Color">#FF2563EB</Color>
    <SolidColorBrush x:Key="EDTheme.PrimaryButton.Bg" Color="{StaticResource EDTheme.PrimaryButton.Bg.Color}"/>
    <Color x:Key="EDTheme.PrimaryButton.BgHover.Color">#FF3B82F6</Color>
    <SolidColorBrush x:Key="EDTheme.PrimaryButton.BgHover" Color="{StaticResource EDTheme.PrimaryButton.BgHover.Color}"/>
    <Color x:Key="EDTheme.PrimaryButton.BgPressed.Color">#FF1D4ED8</Color>
    <SolidColorBrush x:Key="EDTheme.PrimaryButton.BgPressed" Color="{StaticResource EDTheme.PrimaryButton.BgPressed.Color}"/>

    <!-- Focus - ring jasnější než Accent.Blue (1,5px linka v accent odstínu je na
         Bg.Surface slabá), halo tmavé, aby ring vystoupil i na světlém brandovém pruhu. -->
    <Color x:Key="EDTheme.Focus.Ring.Color">#FF7CC4FF</Color>
    <SolidColorBrush x:Key="EDTheme.Focus.Ring" Color="{StaticResource EDTheme.Focus.Ring.Color}"/>
    <Color x:Key="EDTheme.Focus.RingContrast.Color">#FF141414</Color>
    <SolidColorBrush x:Key="EDTheme.Focus.RingContrast" Color="{StaticResource EDTheme.Focus.RingContrast.Color}"/>

    <!-- Accent: Green -->
    <Color x:Key="EDTheme.Accent.GreenDark.Color">#FF9BD6A3</Color>
    <SolidColorBrush x:Key="EDTheme.Accent.GreenDark" Color="{StaticResource EDTheme.Accent.GreenDark.Color}"/>
    <Color x:Key="EDTheme.Accent.GreenBg.Color">#FF1F3A25</Color>
    <SolidColorBrush x:Key="EDTheme.Accent.GreenBg" Color="{StaticResource EDTheme.Accent.GreenBg.Color}"/>

    <!-- Brand (o něco světlejší pro kontrast na tmavém) -->
    <Color x:Key="EDTheme.Brand.Color">#FFC79A5A</Color>
    <SolidColorBrush x:Key="EDTheme.Brand" Color="{StaticResource EDTheme.Brand.Color}"/>

    <!-- Logo M-line - sada log povoluje jen modrou, nebo bílou -->
    <Color x:Key="EDTheme.MlineLogo.Color">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="EDTheme.MlineLogo" Color="{StaticResource EDTheme.MlineLogo.Color}"/>

    <!-- Support panel. Accent nese bílou šipku úchytu i titulek na tmavé kartě - proto
         středně tmavá zelená (světlejší odstín by bílou šipku utopil, kontrast < 2:1). -->
    <Color x:Key="EDTheme.Support.Accent.Color">#FF2E9E63</Color>
    <SolidColorBrush x:Key="EDTheme.Support.Accent" Color="{StaticResource EDTheme.Support.Accent.Color}"/>
    <!-- Tlačítka: průsvitný nádech přes tmavou kartu a rozjasněný text (dark varianta widgetu edison2). -->
    <Color x:Key="EDTheme.Support.Feedback.Bg.Color">#1FF59E0B</Color>
    <SolidColorBrush x:Key="EDTheme.Support.Feedback.Bg" Color="{StaticResource EDTheme.Support.Feedback.Bg.Color}"/>
    <Color x:Key="EDTheme.Support.Feedback.Border.Color">#59F59E0B</Color>
    <SolidColorBrush x:Key="EDTheme.Support.Feedback.Border" Color="{StaticResource EDTheme.Support.Feedback.Border.Color}"/>
    <Color x:Key="EDTheme.Support.Feedback.Text.Color">#FFFBBF24</Color>
    <SolidColorBrush x:Key="EDTheme.Support.Feedback.Text" Color="{StaticResource EDTheme.Support.Feedback.Text.Color}"/>
    <Color x:Key="EDTheme.Support.Feedback.Icon.Color">#FFFBBF24</Color>
    <SolidColorBrush x:Key="EDTheme.Support.Feedback.Icon" Color="{StaticResource EDTheme.Support.Feedback.Icon.Color}"/>
    <Color x:Key="EDTheme.Support.Portal.Bg.Color">#1FEF4444</Color>
    <SolidColorBrush x:Key="EDTheme.Support.Portal.Bg" Color="{StaticResource EDTheme.Support.Portal.Bg.Color}"/>
    <Color x:Key="EDTheme.Support.Portal.Border.Color">#59EF4444</Color>
    <SolidColorBrush x:Key="EDTheme.Support.Portal.Border" Color="{StaticResource EDTheme.Support.Portal.Border.Color}"/>
    <Color x:Key="EDTheme.Support.Portal.Text.Color">#FFF87171</Color>
    <SolidColorBrush x:Key="EDTheme.Support.Portal.Text" Color="{StaticResource EDTheme.Support.Portal.Text.Color}"/>
    <Color x:Key="EDTheme.Support.Portal.Icon.Color">#FFF87171</Color>
    <SolidColorBrush x:Key="EDTheme.Support.Portal.Icon" Color="{StaticResource EDTheme.Support.Portal.Icon.Color}"/>
    <Color x:Key="EDTheme.Support.Help.Bg.Color">#268B5CF6</Color>
    <SolidColorBrush x:Key="EDTheme.Support.Help.Bg" Color="{StaticResource EDTheme.Support.Help.Bg.Color}"/>
    <Color x:Key="EDTheme.Support.Help.Border.Color">#598B5CF6</Color>
    <SolidColorBrush x:Key="EDTheme.Support.Help.Border" Color="{StaticResource EDTheme.Support.Help.Border.Color}"/>
    <Color x:Key="EDTheme.Support.Help.Text.Color">#FFA78BFA</Color>
    <SolidColorBrush x:Key="EDTheme.Support.Help.Text" Color="{StaticResource EDTheme.Support.Help.Text.Color}"/>
    <Color x:Key="EDTheme.Support.Help.Icon.Color">#FFA78BFA</Color>
    <SolidColorBrush x:Key="EDTheme.Support.Help.Icon" Color="{StaticResource EDTheme.Support.Help.Icon.Color}"/>
    <Color x:Key="EDTheme.Support.News.Bg.Color">#263B82F6</Color>
    <SolidColorBrush x:Key="EDTheme.Support.News.Bg" Color="{StaticResource EDTheme.Support.News.Bg.Color}"/>
    <Color x:Key="EDTheme.Support.News.Border.Color">#593B82F6</Color>
    <SolidColorBrush x:Key="EDTheme.Support.News.Border" Color="{StaticResource EDTheme.Support.News.Border.Color}"/>
    <Color x:Key="EDTheme.Support.News.Text.Color">#FF60A5FA</Color>
    <SolidColorBrush x:Key="EDTheme.Support.News.Text" Color="{StaticResource EDTheme.Support.News.Text.Color}"/>
    <Color x:Key="EDTheme.Support.News.Icon.Color">#FF60A5FA</Color>
    <SolidColorBrush x:Key="EDTheme.Support.News.Icon" Color="{StaticResource EDTheme.Support.News.Icon.Color}"/>

    <!-- Semantic (rozjasněné pro čitelnost na tmavém) -->
    <Color x:Key="EDTheme.Semantic.Danger.Color">#FFEF5350</Color>
    <SolidColorBrush x:Key="EDTheme.Semantic.Danger" Color="{StaticResource EDTheme.Semantic.Danger.Color}"/>
    <Color x:Key="EDTheme.Semantic.Warning.Color">#FFFFA726</Color>
    <SolidColorBrush x:Key="EDTheme.Semantic.Warning" Color="{StaticResource EDTheme.Semantic.Warning.Color}"/>
    <Color x:Key="EDTheme.Semantic.Success.Color">#FF66BB6A</Color>
    <SolidColorBrush x:Key="EDTheme.Semantic.Success" Color="{StaticResource EDTheme.Semantic.Success.Color}"/>
    <Color x:Key="EDTheme.Semantic.Condition.Color">#FFBA68C8</Color>
    <SolidColorBrush x:Key="EDTheme.Semantic.Condition" Color="{StaticResource EDTheme.Semantic.Condition.Color}"/>
    <!-- Favorite - jasnější zlatá pro kontrast na tmavém -->
    <Color x:Key="EDTheme.Semantic.Favorite.Color">#FFFFD54F</Color>
    <SolidColorBrush x:Key="EDTheme.Semantic.Favorite" Color="{StaticResource EDTheme.Semantic.Favorite.Color}"/>

</ResourceDictionary>
