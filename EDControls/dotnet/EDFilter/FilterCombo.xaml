<local:FilterFieldBase x:Class="EDControls.EDFilter.FilterCombo"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:local="clr-namespace:EDControls.EDFilter"
                       MinWidth="150">
    <StackPanel Orientation="Vertical" Margin="0,0,8,0">
        <TextBlock x:Name="labelText"
                   Text="{Binding Label, RelativeSource={RelativeSource AncestorType=local:FilterCombo}}"
                   FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
        <ComboBox x:Name="combo"
                  ItemsSource="{Binding ItemsSource,        RelativeSource={RelativeSource AncestorType=local:FilterCombo}}"
                  SelectedValue="{Binding SelectedValue,    RelativeSource={RelativeSource AncestorType=local:FilterCombo}, Mode=TwoWay}"
                  SelectedValuePath="{Binding SelectedValuePath, RelativeSource={RelativeSource AncestorType=local:FilterCombo}}"
                  DisplayMemberPath="{Binding DisplayMemberPath,  RelativeSource={RelativeSource AncestorType=local:FilterCombo}}"
                  VerticalAlignment="Center"/>
    </StackPanel>
</local:FilterFieldBase>
