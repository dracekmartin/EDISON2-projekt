<Window x:Class="EDControls.EDViewModel.EDErrorPopup"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edsp="clr-namespace:EDControls.EDSupportPanel"
        edsp:EDSupportPanel.Suppress="True"
        Title="Neočekávaná situace"
        MinWidth="600" MinHeight="460"
        Width="640" Height="520"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False">

    <Border Padding="20,16,20,14" Background="{DynamicResource EDTheme.Bg.Surface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Referenční číslo: uživatel ho hlásí na podporu, doplnění se páruje přes něj.
                 Skryté, když se hlášení neodeslalo — číslo, které nikam nedorazilo, jen mate. -->
            <Border Grid.Row="0"
                    x:Name="RefIdPanel"
                    Visibility="Collapsed"
                    Background="{DynamicResource EDTheme.Bg.Sunken}"
                    Padding="10,7"
                    Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Referenční číslo:"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource EDTheme.Text.Muted}"/>
                    <TextBox x:Name="RefIdText"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             FontWeight="Bold"
                             Foreground="{DynamicResource EDTheme.Text.Primary}"/>
                </StackPanel>
            </Border>

            <TextBox Grid.Row="1"
                     x:Name="ErrorText"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     FontFamily="{DynamicResource EDTheme.FontFamily.Mono}"
                     FontSize="{DynamicResource EDTheme.FontSize.Caption}"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     BorderThickness="1"
                     Padding="6"
                     Margin="0,0,0,10"/>

            <!-- Dobrovolné doplnění okolností. Jádro hlášení už odešlo automaticky. -->
            <StackPanel Grid.Row="2" x:Name="FollowUpPanel" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBlock Text="Co jste dělal, když k chybě došlo? (nepovinné, pomůže při hledání příčiny)"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"
                           Foreground="{DynamicResource EDTheme.Text.Muted}"/>
                <TextBox x:Name="FollowUpText"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="60"
                         VerticalScrollBarVisibility="Auto"
                         Padding="6"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="FollowUpSentText"
                           Text="Děkujeme, doplnění odesláno."
                           Visibility="Collapsed"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource EDTheme.Text.Muted}"/>
                <Button x:Name="SendFollowUpBtn"
                        Content="Odeslat doplnění"
                        Visibility="Collapsed"
                        Padding="14,4" Margin="0,0,6,0"
                        Click="SendFollowUpBtn_Click"/>
                <Button x:Name="SaveBtn"
                        Content="Uložit do souboru"
                        Padding="14,4" Margin="0,0,6,0"
                        Click="SaveBtn_Click"/>
                <Button Content="{StaticResource EDStrings.Ok}"
                        Padding="14,4"
                        MinWidth="80"
                        IsDefault="True" IsCancel="True"
                        Click="OkBtn_Click"/>
            </StackPanel>
        </Grid>
    </Border>

</Window>
