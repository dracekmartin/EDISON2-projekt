<Window x:Class="EDControls.EDViewModel.EDErrorPopup"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neočekávaná situace"
        MinWidth="600" MinHeight="400"
        Width="640" Height="440"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border Padding="20,16,20,14" Background="{DynamicResource EDTheme.Bg.Surface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0"
                     x:Name="ErrorText"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas"
                     FontSize="{DynamicResource EDTheme.FontSize.Caption}"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     BorderThickness="1"
                     Padding="6"
                     Margin="0,0,0,12"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveBtn"
                        Content="Uložit do souboru"
                        Padding="14,4" Margin="0,0,6,0"
                        Click="SaveBtn_Click"/>
                <Button Content="{StaticResource EDStrings.Ok}"
                        Padding="14,4"
                        MinWidth="80"
                        IsDefault="True" IsCancel="True"
                        Click="OkBtn_Click"/>
            </StackPanel>
        </Grid>
    </Border>

</Window>
