<Window x:Class="EDControls.EDViewModel.EDPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edsp="clr-namespace:EDControls.EDSupportPanel"
        Title="" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        edsp:EDSupportPanel.Suppress="True">

    <Border Padding="20,16,20,14"
            Background="{DynamicResource EDTheme.Bg.Surface}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- DynamicResource: EDControls jako knihovna nemá zaručeno, že host EDIcons mergnul. -->
            <Image x:Name="LogoImage"
                   Source="{DynamicResource EDIcons.MoleculeLarge}"
                   Width="48" Height="48"
                   Margin="0,0,16,16"
                   VerticalAlignment="Top"
                   Visibility="Collapsed"/>

            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       Margin="0,0,0,16"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="340"/>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                        Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PositiveBtn"
                        Width="80" IsDefault="True"
                        Padding="0,4" Margin="0,0,6,0"
                        Click="PositiveBtn_Click"/>
                <Button x:Name="NegativeBtn"
                        Width="80"
                        Padding="0,4" Margin="0,0,6,0"
                        Click="NegativeBtn_Click"/>
                <Button x:Name="CancelBtn"
                        Width="80" IsCancel="True"
                        Padding="0,4"
                        Visibility="Collapsed"
                        Click="CancelBtn_Click"/>
            </StackPanel>
        </Grid>
    </Border>

</Window>
