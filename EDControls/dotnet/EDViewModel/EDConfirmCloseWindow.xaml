<Window x:Class="EDControls.EDViewModel.EDConfirmCloseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border Padding="20,16,20,14"
            Background="White">
        <StackPanel>
            <TextBlock Text="Opravdu chcete zavřít okno bez uložení?"
                       Margin="0,0,0,16"
                       TextWrapping="Wrap"
                       MaxWidth="340"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Ano" Width="80" IsDefault="True"
                        Padding="0,4" Margin="0,0,6,0"
                        Click="OkBtn_Click"/>
                <Button Content="Ne" Width="80" IsCancel="True"
                        Padding="0,4"
                        Click="StornoBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>

</Window>
